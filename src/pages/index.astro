        ))}
      </ol>
      {services.hats.map((h: any, i: number) => {
        const list = (HAT_SVC[h.k] || []).map((id) => svcById[id]).filter(Boolean);
        const c = HAT_COL[i % 3];
        return (
          <dialog class="svc-dlg" id={`svc-${i}`} data-k={h.k} aria-labelledby={`svc-h-${i}`} style={`--hc:${c[0]};--hl:${c[1]}`}>
            <div class="svc-in">
              <button type="button" class="svc-x" data-close aria-label="關閉">×</button>
              <p class="svc-k">{h.provider}</p>
              <h3 id={`svc-h-${i}`}>{h.title}</h3>
              <p class="svc-desc">{String(h.desc).split(/(?<=。)/).map((t: string) => <span class="dl">{t}</span>)}</p>
              {list.length ? list.map((x: any) => (
                <section class="svc-card">
                  <h4>{x.name}{x.name_jp && <small>{x.name_jp}</small>}</h4>
                  <p class="svc-for">{x.for}</p>
                  <p>{x.desc}</p>
                  <ul class="svc-list">{(x.items || []).map((t: string) => <li>{t}</li>)}</ul>
                  {x.excludes && x.excludes.length > 0 && <p class="svc-ex">不含：{x.excludes.join('、')}</p>}
