    c.innerHTML=pad(Math.floor(r%DAY/36e5))+':'+pad(Math.floor(r%36e5/6e4))+':<b class="'+(RM?'':'tick')+'">'+pad(Math.floor(r%6e4/1e3))+'</b>';}
