f.addEventListener('click',function(e){e.stopPropagation();var o=m.classList.toggle('open');f.setAttribute('aria-expanded',o?'true':'false');if(o){var a=m.querySelector('.pay-t');if(a&&!window.matchMedia('(hover:hover)').matches){}}});
