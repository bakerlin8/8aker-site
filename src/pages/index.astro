  function loop(ts){if(!run)return;var dt=last?Math.min(.05,(ts-last)/1e3):0;last=ts;t+=dt;frame();raf=requestAnimationFrame(loop);}
  size();t=2;frame();var rz=0;addEventListener('resize',function(){clearTimeout(rz);rz=setTimeout(function(){size();frame();},150);});
  if(RM)return;
  new IntersectionObserver(function(es){es.forEach(function(e){run=e.isIntersecting;cancelAnimationFrame(raf);if(run){last=0;raf=requestAnimationFrame(loop);}});},{threshold:.05}).observe(cv);})();

/* 有點樣子：唱盤（目前那件在中間，其他沿著弧線轉到兩側；唱片從封套滑出、轉動） */
(function(){var D=document.getElementById('deck');if(!D)return;var C=[].slice.call(D.querySelectorAll('.work')),T=[].slice.call(document.querySelectorAll('#wTicks [data-go]')),NOW=document.getElementById('wNow'),VL=null,n=C.length,cur=0;
  function pad(x){return (x<10?'0':'')+x;}
  function lay(){var mob=innerWidth<640;C.forEach(function(el,k){var d=k-cur,a=Math.abs(d),x=d*(mob?62:58),z=-a*(mob?220:180),ry=-d*(mob?32:26);
      el.style.transform='translateX('+x+'%) translateZ('+z+'px) rotateY('+ry+'deg)';el.style.opacity=a>3?0:(1-a*.28).toFixed(2);el.style.filter=a?'brightness(.6) saturate(.8)':'none';el.style.zIndex=100-a;el.style.pointerEvents=a>3?'none':'auto';
      el.classList.toggle('on',d===0);el.setAttribute('aria-hidden',d===0?'false':'true');el.tabIndex=d===0?0:-1;});
    T.forEach(function(b,k){b.setAttribute('aria-current',k===cur?'true':'false');});var t=T[cur];if(t&&t.scrollIntoView)t.parentElement.parentElement.scrollLeft=t.offsetLeft-60;
    NOW.textContent=pad(cur+1);if(VL)VL.textContent=pad(cur+1);}
  function go(i){i=Math.max(0,Math.min(n-1,i));if(i===cur)return;cur=i;lay();}
  document.getElementById('wPrev').addEventListener('click',function(){go(cur-1);});document.getElementById('wNext').addEventListener('click',function(){go(cur+1);});
  T.forEach(function(b){b.addEventListener('click',function(){go(+b.dataset.go);});});
  C.forEach(function(el,k){el.addEventListener('click',function(e){if(k!==cur){e.preventDefault();go(k);}});});
  D.addEventListener('keydown',function(e){if(e.key==='ArrowRight'){go(cur+1);e.preventDefault();}if(e.key==='ArrowLeft'){go(cur-1);e.preventDefault();}});
  // 左右滑動（手機）／拖曳（滑鼠）
  var sx=null,sy=0,moved=false;D.addEventListener('pointerdown',function(e){sx=e.clientX;sy=e.clientY;moved=false;});
  D.addEventListener('pointermove',function(e){if(sx===null)return;if(Math.abs(e.clientX-sx)>10&&Math.abs(e.clientX-sx)>Math.abs(e.clientY-sy))moved=true;});
  D.addEventListener('pointerup',function(e){if(sx===null)return;var dx=e.clientX-sx;sx=null;if(moved&&Math.abs(dx)>40)go(cur+(dx<0?1:-1));});
  D.addEventListener('click',function(e){if(moved){e.preventDefault();e.stopPropagation();moved=false;}},true);
  // 觸控板左右滑
  var acc=0,lock=0;D.addEventListener('wheel',function(e){if(Math.abs(e.deltaX)<=Math.abs(e.deltaY))return;e.preventDefault();var now=Date.now();if(now<lock)return;acc+=e.deltaX;if(Math.abs(acc)>40){go(cur+(acc>0?1:-1));acc=0;lock=now+450;}},{passive:false});
  lay();addEventListener('resize',lay);})();

/* 連載: 第 0 話 … 第 11 話 → 第一卷 */
(function(){var C=D.chapters,now=Date.now(),T=function(d){return new Date(d+'T00:00:00+09:00').getTime();};
  var list=C.chapters.map(function(c){return Object.assign({},c);});list.push(Object.assign({final:true,no:12},C.volume));
  var nextIdx=list.findIndex(function(r){return T(r.date)>=now;});if(nextIdx<0)nextIdx=list.length;
  list.forEach(function(r,i){r.days=Math.floor((T(r.date)-now)/DAY);r.state=i<nextIdx?(r.on_break?'break':'done'):i===nextIdx?'next':'future';
    var a=(C.arcs||[]).filter(function(a){return !r.final&&r.no>=a.from&&r.no<=a.to;})[0];r.arc=a?a.name:'';});
  var md=function(r){return (+r.date.slice(5,7))+'.'+r.date.slice(8);},label=function(r){return r.final?'第一卷':'第 '+r.no+' 話';};
  var esc=function(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;');};
  var nr=list[Math.min(nextIdx,list.length-1)];
  var nrEl=document.getElementById('nextRel');if(nrEl)nrEl.innerHTML=(nr.no===0?'新連載・':'連載中・')+label(nr)+'・'+(+nr.date.slice(5,7))+' 月 '+(+nr.date.slice(8))+' 日刊出 <b>'+(nr.days<=0?'今天':nr.days+' 天後')+'</b>';
  /* ── 連載：三種版型（A 目次／B 年輪帳／C 縦書き帳），資料共用 ── */
  var CD=document.getElementById('chDash');
  var KN=['〇','一','二','三','四','五','六','七','八','九','十','十一'];
  var dan=function(c){return c>=100?'四段':c>=60?'三段':c>=30?'二段':c>=10?'初段':'見習';};
  var days={};D.entries.forEach(function(e){days[e.date]=1;});
  var streak=0,dd=new Date(now+9*3600e3);for(var g=0;g<400;g++){var key=dd.toISOString().slice(0,10);if(days[key])streak++;else if(g>0)break;dd.setUTCDate(dd.getUTCDate()-1);}
  var vol=list[list.length-1],SEL=Math.min(nextIdx,list.length-1);
  function items(arr,withDir){return '<ul class="ilist">'+arr.map(function(x){var d=withDir&&x.dir?dirOf(x.dir):null;return '<li'+(d?' style="--dc:'+col(d.id)+'"':'')+'><span class="k">'+(d?d.k:'・')+'</span><span>'+esc(x.text||x)+'</span></li>';}).join('')+'</ul>';}
  function info(i){var r=list[i],from=i>0?list[i-1].date:D.start.slice(0,10),inR=function(e){return (i>0?e.date>from:e.date>=from)&&e.date<=r.date;};
    var es=D.entries.filter(inR),live=!r.final&&r.state!=='future',cc={};D.dirs.forEach(function(d){cc[d.id]=es.filter(function(e){return e.dir===d.id;}).length;});
    var t0=T(from),t1=T(r.date),pct=Math.max(0,Math.min(1,(now-t0)/(t1-t0))),dayT=Math.round((t1-t0)/DAY),dayN=Math.max(0,Math.min(dayT,Math.floor((now-t0)/DAY)+1));
    var body='';
    if(r.state==='done'||r.state==='break'){body+=r.summary?'<p>'+esc(r.summary)+'</p>':'';body+=(r.keep&&r.keep.length)?'<h4>留下的</h4>'+items(r.keep):'';body+=(r.letgo&&r.letgo.length)?'<h4>放下的</h4>'+items(r.letgo):'';if(!body)body='<p class="mute">'+(r.state==='break'?'這個月休載。':'這一話的內容整理中。')+'</p>';}
    else if(r.final)body='<p>'+esc(r.summary)+'</p>';
    else if(r.plan&&r.plan.length)body='<h4>預計內容</h4>'+items(r.plan,true);
    else body='<p class="mute">這一話還在準備中，刊出當天公開。</p>';
    return {r:r,total:es.length,live:live,cc:cc,pct:pct,dayN:dayN,dayT:dayT,body:body,st:{done:'刊出',break:'休載',next:'製作中',future:'預定'}[r.state],
      link:'<a class="ch-link" href="/chapters/'+(r.final?'':r.no+'/')+'">'+(r.final?'看第一卷目次':'看完整的'+label(r))+' →</a>'};}
  var dirLine=function(c){return '<p class="dline">'+D.dirs.map(function(d){return '<a href="/pillars/'+d.id+'/" style="--dc:'+col(d.id)+'"><b>'+d.k+'</b>'+(c[d.id]||0)+'</a>';}).join('')+'</p>';};
  var repLine='<p class="rline"><span>報</span>每月 2 號，這個月的日常紀錄會依方向整理成月報，寄給天使投資人。</p>';
  var knum=function(r){return r.final?'巻':KN[r.no]||r.no;};
  /* 年輪：每一話是一圈，刊出的圈描金，這一話依月份進度畫到一半並發光 */
  function ringSvg(){var n=list.length,R0=44,R1=150,sv='';
    for(var i=0;i<n;i++){var q=list[i],rr=R0+(R1-R0)*i/(n-1),c=2*Math.PI*rr,dash='';
      if(q.state==='next'){dash=' stroke-dasharray="'+(c*Math.max(.02,info(i).pct)).toFixed(1)+' '+c.toFixed(1)+'"';}
      sv+='<circle class="rg '+q.state+(i===SEL?' on':'')+(q.final?' fin':'')+'" r="'+rr.toFixed(1)+'"'+dash+' transform="rotate(-90)" data-i="'+i+'"><title>'+label(q)+'</title></circle>';}
    var r=list[SEL];
    return '<div class="cb-ring"><svg viewBox="-160 -160 320 320" role="img" aria-label="連載年輪：每一話一圈">'+sv+'</svg><div class="cb-c"><b>'+knum(r)+'</b><small>'+(r.final?'第一卷':'話')+'</small></div></div>';}
  /* 連載帳：由左往右，一話一欄直書，刊出的蓋朱印；下方左邊是年輪，每一話一圈 */
  function vC(){var x=info(SEL),r=x.r;
    var cols=list.map(function(q,i){var stamp=q.state==='done'?'<span class="hk done">刊</span>':q.state==='next'?'<span class="hk next">今</span>':q.final?'<span class="hk fin">巻</span>':'';
      return '<li><button data-i="'+i+'" class="'+q.state+(i===SEL?' on':'')+(q.final?' fin':'')+'"><span class="vn">'+(q.final?'第一卷':'第'+KN[q.no]+'話')+'</span><span class="vt">'+esc(q.final?'四十歲・發售':q.title)+'</span><span class="vd">'+(+q.date.slice(5,7))+'月'+(+q.date.slice(8))+'日</span>'+stamp+'</button></li>';}).join('');
    return '<div class="cc"><ol class="cc-cols" aria-label="連載帳">'+cols+'</ol>'
      +'<article class="cc-now">'+ringSvg()+'<div><p class="ca-kick">'+x.st+(r.arc?'・'+r.arc:'')+'・'+r.date.replace(/-/g,'.')+'</p><h3><em>'+label(r)+'</em>'+esc(r.title)+'</h3>'
      +(r.state==='next'?'<div class="ca-prog"><i style="width:'+(x.pct*100).toFixed(1)+'%"></i></div><p class="ca-pn">第 <b>'+x.dayN+'</b> 天／'+x.dayT+' 天・還有 <b>'+r.days+'</b> 天刊出</p>':'')+x.body+x.link+'</div>'
      +'<div class="cc-side"><div class="ca-nums"><div><b class="num">'+(x.live?x.total:'—')+'</b><small>這一話</small></div><div><b class="num">'+D.entries.length+'</b><small>全卷累積</small></div><div><b class="num">'+streak+'</b><small>連續紀錄</small></div></div>'+dirLine(D.totals)+'</div></article></div>'+repLine;}
  function render(){CD.innerHTML=vC();
    var cc=CD.querySelector('.cc-cols');if(cc){var on=cc.querySelector('.on');if(on)cc.scrollLeft=on.parentElement.offsetLeft-cc.clientWidth/2;}}
  CD.addEventListener('click',function(e){var b=e.target.closest('[data-i]');if(!b)return;SEL=+b.getAttribute('data-i');render();});
  render();

  document.querySelectorAll('article.cho').forEach(function(c){c.addEventListener('click',function(){c.classList.toggle('open');});});
})();


/* 需求表：選服務 → 預先帶入；送出到私人收件匣 */
(function(){var F=document.getElementById('inquiry');if(!F)return;var M=document.getElementById('inqMsg'),SEL=F.querySelector('select[name=service]');
  document.addEventListener('click',function(e){var a=e.target.closest('[data-svc]');if(!a)return;var v=a.dataset.svc;if(v==='ai')v='ai';if([].some.call(SEL.options,function(o){return o.value===v;}))SEL.value=v;});
  F.addEventListener('submit',function(e){e.preventDefault();var fd=new FormData(F),b={};fd.forEach(function(v,k){b[k]=String(v);});b.lang=navigator.language||'';
    if(!b.name.trim()||!b.contact.trim()||b.message.trim().length<5){M.className='fmsg err';M.textContent='請填寫稱呼、聯絡方式和需求內容。';window.sfx&&sfx('error');return;}
    var btn=F.querySelector('button[type=submit]');btn.disabled=true;M.className='fmsg';M.textContent='送出中…';
    fetch('https://gsaqrjovipnfiedvjaeb.supabase.co/functions/v1/inquiry',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)})
      .then(function(r){return r.json().then(function(d){return {ok:r.ok,d:d};});})
      .then(function(x){if(!x.ok)throw new Error(x.d&&x.d.error||'送出失敗');F.reset();M.className='fmsg ok';M.textContent='已收到，我們會在 2 個工作天內回覆你。';window.sfx&&sfx('success');})
      .catch(function(err){M.className='fmsg err';M.textContent=(err&&err.message)||'送出失敗，請稍後再試。';window.sfx&&sfx('error');})
      .then(function(){btn.disabled=false;});});})();

/* 服務卡：游標位置的聚光 */
(function(){var H=document.getElementById('hats');if(!H)return;
  H.addEventListener('pointermove',function(e){var c=e.target.closest('.hat');if(!c)return;var r=c.getBoundingClientRect();c.style.setProperty('--mx',(e.clientX-r.left)+'px');c.style.setProperty('--my',(e.clientY-r.top)+'px');},{passive:true});})();

/* 實績數字：月台翻牌。捲到時每一格從 0 一張一張翻到目標字；滑鼠移上去會再翻一次 */
(function(){var els=document.querySelectorAll('.flap');if(!els.length)return;
  var SEQ='0123456789';
  function cell(ch){var c=document.createElement('span');c.className='fc';c.setAttribute('aria-hidden','true');
    c.innerHTML='<span class="t"><i></i></span><span class="b"><i></i></span><span class="ft"><i></i></span><span class="fb"><i></i></span>';set(c,ch);return c;}
  function set(c,ch){c._ch=ch;c.querySelectorAll('i').forEach(function(i){i.textContent=ch;});}
  function flip(c,to,dur){return new Promise(function(res){var from=c._ch;
    c.querySelector('.t i').textContent=to;c.querySelector('.fb i').textContent=to;c.querySelector('.ft i').textContent=from;c.querySelector('.b i').textContent=from;
    var ft=c.querySelector('.ft'),fb=c.querySelector('.fb');
    ft.animate([{transform:'rotateX(0deg)'},{transform:'rotateX(-90deg)'}],{duration:dur/2,easing:'ease-in',fill:'forwards'});
    fb.animate([{transform:'rotateX(90deg)'},{transform:'rotateX(0deg)'}],{duration:dur/2,delay:dur/2,easing:'ease-out',fill:'forwards'}).onfinish=function(){set(c,to);res();};});}
  function path(to){var d=SEQ.indexOf(to);if(d>=0){var a=[];for(var k=0;k<=d;k++)a.push(SEQ[k]);return a.length>1?a:['9','0'].slice(1).concat(a);}return ['7','3',to];}
  async function run(el){if(el._busy)return;el._busy=true;var cs=el._cells;
    await Promise.all(cs.map(async function(c,i){await new Promise(function(r){setTimeout(r,i*120);});var steps=path(c._to);for(var k=0;k<steps.length;k++)await flip(c,steps[k],k===steps.length-1?220:140);}));
    el._busy=false;}
  var RMf=matchMedia('(prefers-reduced-motion: reduce)').matches;
  els.forEach(function(el){var v=el.dataset.v||el.textContent;el.textContent='';el._cells=[].map.call(v,function(ch){var c=cell(RMf?ch:' ');c._to=ch;el.appendChild(c);return c;});
    if(RMf)return;el.closest('li').addEventListener('pointerenter',function(e){if(e.pointerType==='mouse'){el._cells.forEach(function(c){set(c,' ');});run(el);}});});
  if(RMf)return;
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){io.unobserve(e.target);e.target.querySelectorAll('.flap').forEach(function(el,i){setTimeout(function(){run(el);},i*260);});}});},{threshold:.4});
  var pr=document.querySelector('.proof');if(pr)io.observe(pr);})();

/* journal filter */
(function(){var F=document.getElementById('filters'),rows=[].slice.call(document.querySelectorAll('.jrow')),E=document.getElementById('jempty');
  F.addEventListener('click',function(e){var b=e.target.closest('.chip');if(!b)return;var f=b.dataset.f,n=0;
    F.querySelectorAll('.chip').forEach(function(c){c.setAttribute('aria-pressed',c===b);});
    rows.forEach(function(r){var on=f==='all'?!!r.dataset.top:(r.dataset.dir===f&&n<4);r.hidden=!on;if(on)n++;});E.hidden=n>0;
    var M=document.getElementById('jmore');if(M){var C=JSON.parse(M.dataset.counts||'{}'),c=C[f];
      if(f==='all'||!c){M.href='/journal/';M.firstChild.textContent=M.dataset.all;M.hidden=false;}
      else{M.href='/pillars/'+f+'/';M.firstChild.textContent='看「'+c.t+'」全部 '+c.n+' 篇';M.hidden=c.n===0;}}});})();
})();
