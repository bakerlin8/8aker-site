<section class="sec" id="kiganjo" aria-labelledby="kg-h">
  <div class="sec-grid">
    <div class="side" aria-hidden="true"><span class="sn">伍</span><span class="sl"></span><span class="se">Wishes</span></div>
    <div>
      <div class="sec-head"><p class="sub rv">40 歲生日（{fortieth}）前要完成的事</p><h2 id="kg-h" class="rv" style="--i:1">祈願所</h2></div>
      <div class="rv" style="--i:2">
        <div class="cho-wrap">
          
          <div class="cho-scroll"><div class="cho-row">
          {dreams.items.filter((d: any) => d.public).map((d: any) => ({ d, k: d.state === 'done' ? 1000 : d.state === 'doing' ? 100 + (Number.isFinite(Number(d.progress)) && d.progress !== '' && d.progress != null ? Number(d.progress) : 30) : 0 })).sort((a: any, b: any) => b.k - a.k).map(({ d }: any, i: number) => { const st = ({ idea: '許願', doing: '進行中', done: '已實現' } as any)[d.state] || '許願'; const raw = Number(d.progress); const hasPg = d.progress !== '' && d.progress != null && Number.isFinite(raw); const pg = d.state === 'done' ? 100 : d.state === 'idea' ? 0 : Math.max(5, Math.min(100, hasPg ? Math.round(raw) : 30)); const g = d.state === 'idea' ? 0 : (0.4 + pg / 100 * 0.6).toFixed(2);
            const href = safeHref(d.link); const cls = `cho ${d.state}${href ? ' go' : ''}`; const sty = `--n:${i};--g:${g}`;
            const inner = (<><div class="lan" aria-hidden="true">{href ? <span class="pin" title="可以點開">↗</span> : <span class="pin-none"></span>}<span class="str"></span><span class="cp"></span><span class="bd"><span class="gan">願</span><span class="pct"><b>{pg}</b><small>%</small></span>{d.state === 'done' && <span class="stamp">叶</span>}</span><span class="cp2"></span><span class="tas"></span></div>
              <h4>{d.title}</h4>
              <p class="st">{st}{d.state === 'doing' && `・${pg}%`}</p>
              {(d.why || d.note || d.help) && <div class="more"><div>
              {d.why && <p class="why">{d.why}</p>}
              {d.note && <p class="memo">── {d.note}</p>}
              {d.help && <p class="needs">需要幫忙：{d.help}</p>}</div></div>}</>);
            return href ? <a class={cls} style={sty} href={href} aria-label={`${d.title}（點開看相關內容）`}>{inner}</a> : <article class={cls} style={sty} tabindex="0">{inner}</article>; })}
          </div></div>
          <p class="cho-hint">← 左右滑動看全部 →</p>
        </div>
      </div>
    </div>
  </div>
</section>

