<script is:inline>

// MENU — toggle the panel, close on link click or outside click
(function(){
  const btn = document.getElementById('menuToggle');
  const panel = document.getElementById('menuPanel');
  if(!btn || !panel) return;
  function setOpen(open){
    btn.setAttribute('aria-expanded', open ? 'true':'false');
    panel.classList.toggle('open', open);
  }
  btn.addEventListener('click', ()=> setOpen(btn.getAttribute('aria-expanded')!=='true'));
  panel.querySelectorAll('[data-menu-link]').forEach(a=>a.addEventListener('click', ()=> setOpen(false)));
  document.addEventListener('click', (e)=>{
    if(!panel.contains(e.target) && !btn.contains(e.target)) setOpen(false);
  });
  document.addEventListener('keydown', (e)=>{ if(e.key==='Escape') setOpen(false); });
})();

// PILLAR CARD TILT + GLOW — mouse-tracked 3D tilt with a soft glow that follows the cursor
(function(){
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduced) return;
  const coarse = window.matchMedia('(pointer: coarse)').matches;
  if(coarse) return; // skip on touch devices
  document.querySelectorAll('.column').forEach(col=>{
    const inner = col.querySelector('.column-inner');
    if(!inner) return;
    col.addEventListener('mousemove', (e)=>{
      const r = col.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width;   // 0..1
      const py = (e.clientY - r.top) / r.height;    // 0..1
      const rotY = (px - 0.5) * 6;   // max 3deg each side
      const rotX = (0.5 - py) * 6;
      inner.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;
      col.style.setProperty('--gx', (px*100).toFixed(1)+'%');
      col.style.setProperty('--gy', (py*100).toFixed(1)+'%');
    });
    col.addEventListener('mouseleave', ()=>{
      inner.style.transform = 'rotateX(0deg) rotateY(0deg)';
    });
  });
})();

// SCROLL REVEAL — fade+rise up as sections enter the viewport
(function(){
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = document.querySelectorAll('.reveal');
  if(reduced){ items.forEach(el=>el.classList.add('visible')); return; }
  const obs = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){
        entry.target.classList.add('visible');
        obs.unobserve(entry.target);
      }
    });
  },{threshold:0.15, rootMargin:'0px 0px -40px 0px'});
  items.forEach(el=>obs.observe(el));
})();

// INK SPLASH — blooming ink blobs behind the prologue chapter
(function(){
  const cv = document.getElementById('inkSplash');
  if(!cv) return;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduced) return;
  const ctx = cv.getContext('2d');
  let W,H,dpr;
  function resize(){
    dpr = Math.min(devicePixelRatio||1,2);
    const rect = cv.parentElement.getBoundingClientRect();
    W = cv.width = rect.width*dpr; H = cv.height = rect.height*dpr;
    cv.style.width = rect.width+'px'; cv.style.height = rect.height+'px';
  }
  resize(); window.addEventListener('resize', resize);

  const colors = ['rgba(212,162,76,ALPHA)','rgba(107,31,47,ALPHA)','rgba(184,147,90,ALPHA)'];
  function makeBlob(){
    const points = 10 + Math.floor(Math.random()*4);
    const angles = Array.from({length:points},(_,i)=> (i/points)*Math.PI*2);
    const noise = angles.map(()=> 0.6+Math.random()*0.6);
    return {
      x: Math.random()*W, y: Math.random()*H,
      baseR: (Math.min(W,H))*(0.09+Math.random()*0.08),
      angles, noise,
      color: colors[Math.floor(Math.random()*colors.length)],
      life: 0, maxLife: 3.5+Math.random()*2.5,
      phase: Math.random()*Math.PI*2,
    };
  }
  let blobs = Array.from({length:5}, makeBlob);
  let last = performance.now();
  let running = true;

  function drawBlob(b, t){
    const growth = Math.min(1, b.life / (b.maxLife*0.4));
    const fade = b.life > b.maxLife*0.6 ? 1-((b.life-b.maxLife*0.6)/(b.maxLife*0.4)) : 1;
    const alpha = Math.max(0, 0.5*growth*fade);
    const r = b.baseR * (0.5+0.5*growth);
    ctx.beginPath();
    b.angles.forEach((a,i)=>{
      const wobble = 1 + Math.sin(t*0.0007 + b.phase + i)*0.09*b.noise[i];
      const rad = r * b.noise[i] * wobble;
      const x = b.x + Math.cos(a)*rad, y = b.y + Math.sin(a)*rad;
      i===0 ? ctx.moveTo(x,y) : ctx.lineTo(x,y);
    });
    ctx.closePath();
    ctx.fillStyle = b.color.replace('ALPHA', alpha.toFixed(3));
    ctx.filter = 'blur(' + (30*dpr) + 'px)';
    ctx.fill();
  }

  function loop(t){
    if(!running) return;
    const dt = (t-last)/1000; last = t;
    ctx.clearRect(0,0,W,H);
    blobs.forEach(b=>{
      b.life += dt;
      drawBlob(b,t);
      if(b.life > b.maxLife){ Object.assign(b, makeBlob()); }
    });
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);

  // pause when the chapter is off-screen to save battery/CPU
  const obs = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      running = e.isIntersecting;
      if(running){ last = performance.now(); requestAnimationFrame(loop); }
    });
  },{threshold:0.05});
  obs.observe(cv.parentElement);
})();

// HERO STATS — live "days since" counter
(function(){
  const el = document.getElementById('daysSince');
  if(!el) return;
  const start = new Date('2026-09-01');
  const days = Math.max(0, Math.floor((Date.now()-start)/86400000));
  el.textContent = days;
})();

// HIGHLIGHT MARKER — draws in once each marked phrase scrolls into view
(function(){
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const marks = document.querySelectorAll('.highlight-mark');
  if(!marks.length) return;
  if(reduced){ marks.forEach(m=>m.classList.add('active')); return; }
  const obs = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){
        entry.target.classList.add('active');
        obs.unobserve(entry.target);
      }
    });
  },{threshold:0.6});
  marks.forEach(m=>obs.observe(m));
})();


// PILLAR CAROUSEL — swipe/drag/wheel horizontal scroll with dots + center-focus fade
(function(){
  const track = document.getElementById('carouselTrack');
  if(!track) return;
  const cards = [...track.querySelectorAll('.pillar-card')];
  const dotsWrap = document.getElementById('carouselDots');
  const prevBtn = document.getElementById('carouselPrev');
  const nextBtn = document.getElementById('carouselNext');

  cards.forEach((_,i)=>{
    const d = document.createElement('div');
    d.className='dot';
    d.addEventListener('click', ()=> scrollToCard(i));
    dotsWrap.appendChild(d);
  });
  const dots = [...dotsWrap.querySelectorAll('.dot')];

  function scrollToCard(i){
    cards[i].scrollIntoView({behavior:'smooth', inline:'center', block:'nearest'});
  }

  function updateCentered(){
    const trackRect = track.getBoundingClientRect();
    const center = trackRect.left + trackRect.width/2;
    let closest = 0, closestDist = Infinity;
    cards.forEach((card,i)=>{
      const r = card.getBoundingClientRect();
      const cardCenter = r.left + r.width/2;
      const dist = Math.abs(cardCenter - center);
      card.classList.toggle('centered', dist < r.width*0.55);
      if(dist < closestDist){ closestDist = dist; closest = i; }
    });
    dots.forEach((d,i)=> d.classList.toggle('active', i===closest));
  }
  track.addEventListener('scroll', ()=> requestAnimationFrame(updateCentered), {passive:true});
  window.addEventListener('resize', updateCentered);
  updateCentered();

  prevBtn.addEventListener('click', ()=>{
    const active = dots.findIndex(d=>d.classList.contains('active'));
    scrollToCard((active-1+cards.length)%cards.length); // wraps: 0 → last
  });
  nextBtn.addEventListener('click', ()=>{
    const active = dots.findIndex(d=>d.classList.contains('active'));
    scrollToCard((active+1)%cards.length); // wraps: last → 0
  });

  // vertical wheel over the carousel moves it horizontally (desktop convenience)
  track.addEventListener('wheel', (e)=>{
    if(Math.abs(e.deltaY) > Math.abs(e.deltaX)){
      e.preventDefault();
      track.scrollLeft += e.deltaY;
    }
  }, {passive:false});

  // click-and-drag for mouse users
  let isDown=false, startX=0, startScroll=0;
  track.addEventListener('mousedown', (e)=>{
    isDown=true; track.classList.add('grabbing');
    startX = e.pageX; startScroll = track.scrollLeft;
  });
  window.addEventListener('mouseup', ()=>{ isDown=false; track.classList.remove('grabbing'); });
  window.addEventListener('mousemove', (e)=>{
    if(!isDown) return;
    track.scrollLeft = startScroll - (e.pageX - startX);
  });
})();

// CINEMATIC CHAPTERS — reveal + side-dot nav
(function(){
  const chapters = document.querySelectorAll('.chapter');
  const dotsWrap = document.getElementById('chDots');
  if(!chapters.length || !dotsWrap) return;
  chapters.forEach(()=>{
    const d = document.createElement('div');
    d.className='chapter-dot';
    dotsWrap.appendChild(d);
  });
  const dots = document.querySelectorAll('.chapter-dot');
  const obs = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting && e.intersectionRatio>0.5){
        e.target.classList.add('in-view');
        const idx = +e.target.dataset.idx;
        dots.forEach((d,i)=>d.classList.toggle('active', i===idx));
      }
    });
  },{threshold:[0.5]});
  chapters.forEach(ch=>obs.observe(ch));
})();


</script>
</BaseLayout>
