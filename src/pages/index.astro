    for(var i=1;i<=full;i++){var f,col,lw;
      if(i<MOVE){f=i/MOVE;col='rgba(209,122,140,'+(.07+.24*f*f).toFixed(3)+')';lw=(.7+.3*f)*dpr;}
      else if(i===MOVE){col='rgba(224,150,166,.6)';lw=1.3*dpr;}
      else{f=(i-MOVE)/Math.max(1,full-MOVE);col='rgba(212,162,76,'+(.2+.35*f).toFixed(3)+')';lw=(.9+.3*f)*dpr;}
      c.strokeStyle=col;c.lineWidth=lw;path(c,i,1,0);c.closePath();c.stroke();}
    path(c,o,1,0);c.closePath();c.strokeStyle='rgba(236,196,118,.35)';c.lineWidth=dpr;c.stroke();}
  function size(force){var nd=Math.min(devicePixelRatio||1,innerWidth<900?1.5:2),r=cv.parentElement.getBoundingClientRect(),nw=Math.round(r.width*nd),nh=Math.round(r.height*nd);
    if(!force&&nw===W&&Math.abs(nh-H)<160*nd)return false;dpr=nd;W=cv.width=nw;H=cv.height=nh;geom();return true;}
  function frame(dt){t+=dt;var g=Math.min(1,t/3.5),e=1-Math.pow(1-g,3);ctx.clearRect(0,0,W,H);
    smx+=(mx-smx)*.05;smy+=(my-smy)*.05;var qx=Math.round(smx*400)/400,qy=Math.round(smy*400)/400;YAW=-.35+qx*.5;TILT=1.0+qy*.25;cY=Math.cos(YAW);sY=Math.sin(YAW);cT=Math.cos(TILT);sT=Math.sin(TILT);
    var oS=S;S=oS*(.55+.45*e);ctx.globalAlpha=e;ctx.lineJoin='round';var o=full+1;
    if(g<1)slab(ctx);
    else{var key=W+'x'+H+':'+CX.toFixed(0)+','+CY.toFixed(0)+':'+Math.round(smx*400)+','+Math.round(smy*400);
      /* 滑鼠正在動（角度一直變）時直接畫；角度停穩幾幀後才存成暫存圖，之後每幀只要貼上 */
      if(key!==lkey){lkey=key;stab=0;}
      if(key===bkey)ctx.drawImage(bc,0,0);
      else{slab(ctx);if(++stab>8){if(bc.width!==W||bc.height!==H){bc.width=W;bc.height=H;}else bx.clearRect(0,0,W,H);slab(bx);bkey=key;}}}
    var p=frac*e,br=.5+.5*Math.sin(t*1.3);
    /* 梅花粉紅的那一圈（搬家前的最後一年）：柔光呼吸 */
    if(MOVE<=full){var pb=.5+.5*Math.sin(t*1.1+1.2);path(ctx,MOVE,1,0);ctx.closePath();ctx.strokeStyle='rgba(232,140,160,'+(.07+.07*pb).toFixed(3)+')';ctx.lineWidth=13*dpr;ctx.stroke();ctx.strokeStyle='rgba(236,150,170,'+(.14+.12*pb).toFixed(3)+')';ctx.lineWidth=5*dpr;ctx.stroke();ctx.strokeStyle='rgba(255,196,212,'+(.78+.12*pb).toFixed(3)+')';ctx.lineWidth=1.4*dpr;ctx.stroke();}
    path(ctx,o,p,0);ctx.strokeStyle='rgba(212,162,76,'+(.10+.08*br).toFixed(3)+')';ctx.lineWidth=7*dpr;ctx.stroke();
    ctx.strokeStyle='rgba(236,196,118,.92)';ctx.lineWidth=1.7*dpr;ctx.stroke();
    S=oS;ctx.globalAlpha=1;if(g>.98){tip(Math.floor(N*frac)%N);orbs(RM?30:t-3.5);}}

  /* 五珠：五系的光珠先繞著切片轉 → 旋進「今」匯聚 → 集結時一道五色漣漪從外圈盪進樹心 → 化成五顆小星一直繞著「今」 */
  var OB=[[196,86,107,'強'],[212,162,76,'放'],[111,147,173,'操'],[148,165,94,'具'],[176,143,164,'變']],TR=[[],[],[],[],[]];
  var ez=function(x){x=Math.max(0,Math.min(1,x));return x<.5?4*x*x*x:1-Math.pow(-2*x+2,3)/2;};
  function orbit(n,tt){var sp=.45+n*.07,ang=tt*sp+n/5*6.2832,R=(W>900*dpr?1.18:.98)+.06*n,z=.15+.12*Math.sin(tt*.8+n*1.3)+.08*n;return P(Math.cos(ang)*R,Math.sin(ang)*R,z);}
  function dot(p,c,k,al,sz){if(al<=0)return;var x=p[0],y=p[1],s=(sz||1)*(p[2]||1),g=ctx.createRadialGradient(x,y,0,x,y,24*dpr*s);
    g.addColorStop(0,'rgba('+c+','+(.85*al)+')');g.addColorStop(.35,'rgba('+c+','+(.35*al)+')');g.addColorStop(1,'rgba('+c+',0)');ctx.fillStyle=g;ctx.beginPath();ctx.arc(x,y,24*dpr*s,0,6.2832);ctx.fill();
    ctx.beginPath();ctx.arc(x,y,4.4*dpr*s,0,6.2832);ctx.fillStyle='rgba(255,246,228,'+al+')';ctx.fill();
    if(k&&s>.6){ctx.font=(13*dpr)+'px "Noto Serif TC","Noto Serif JP",serif';ctx.textAlign='center';ctx.fillStyle='rgba('+c+','+(.9*al)+')';ctx.fillText(k,x,y-19*dpr*s);}}
  function tail(n,p,c){var q=TR[n];q.push([p[0],p[1]]);if(q.length>24)q.shift();for(var m=1;m<q.length;m++){var al=m/q.length;ctx.beginPath();ctx.moveTo(q[m-1][0],q[m-1][1]);ctx.lineTo(q[m][0],q[m][1]);ctx.strokeStyle='rgba('+c+','+(.45*al).toFixed(3)+')';ctx.lineWidth=(1+2.2*al)*dpr;ctx.lineCap='round';ctx.stroke();}}
  function orbs(u){if(u<0)return;var o=full+1,k=Math.floor(N*frac)%N,a=P(RX[o][k],RY[o][k],0),G0=3,G1=5.2;
    if(u>G1&&u<G1+3){var dd=(u-G1)*15,fd=1-(u-G1)/3;
      for(var n=0;n<5;n++){var c0=OB[n].slice(0,3).join(','),ctr=o-dd+n*1.6;for(var m=1;m<=o;m++){var off=Math.abs(m-ctr);if(off<1.2){ctx.strokeStyle='rgba('+c0+','+((1-off/1.2)*.9*fd).toFixed(3)+')';ctx.lineWidth=(1.4+(1-off/1.2)*1.6)*dpr;path(ctx,m,1,0);ctx.closePath();ctx.stroke();}}}}
    for(var n2=0;n2<5;n2++){var c=OB[n2].slice(0,3).join(','),lab=OB[n2][3],pp,sz=1,al=1;
      if(u<G0){pp=orbit(n2,t);al=Math.min(1,u/1.2);}
      else if(u<G1){var e=ez((u-G0-n2*.08)/(G1-G0-.4)),ob=orbit(n2,t),sw=e*(1-e)*4,an=n2/5*6.2832+t*2;
        pp=[ob[0]+(a[0]-ob[0])*e+Math.cos(an)*29*dpr*sw*(1-e),ob[1]+(a[1]-ob[1])*e+Math.sin(an)*13*dpr*sw*(1-e),ob[2]];sz=1-.4*e;if(e>.7)lab=null;}
      else{TR[n2].length=0;var an2=t*1.6+n2/5*6.2832;pp=[a[0]+Math.cos(an2)*22*dpr,a[1]+Math.sin(an2)*9*dpr,.55];sz=.55;lab=null;al=Math.max(0,Math.min(1,(u-G1-.3)/.6));}
