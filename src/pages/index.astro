---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { pillars } from '../data/pillars';
import copy from '../data/site-copy.json';
import chapters from '../data/chapters.json';
import worksData from '../data/works.json';
import { safeImg } from '../data/work-utils';
import dreams from '../data/dreams.json';
import services from '../data/services.json';

const all = (await Promise.all(
  pillars.map(async (p) => (await getCollection(p.slug as any, ({ data }: any) => !data.draft)).map((e: any) => ({ dir: p.slug, e })))
)).flat();
all.sort((a, b) => b.e.data.date.valueOf() - a.e.data.date.valueOf());
const ymd = (d: Date) => d.toISOString().slice(0, 10);
const dot = (d: Date) => ymd(d).replaceAll('-', '.');
const counts = Object.fromEntries(pillars.map((p) => [p.slug, all.filter((a) => a.dir === p.slug).length]));
const prog = (c: number) => { const T = [0, 10, 30, 60, 100]; if (c >= 100) return 100; const k = T.findIndex((t) => c < t); return Math.round(((c - T[k - 1]) / (T[k] - T[k - 1])) * 100); };
const dan = (c: number) => (c >= 100 ? '四段' : c >= 60 ? '三段' : c >= 30 ? '二段' : c >= 10 ? '初段' : '見習');
const MAX = 30;

// pentagon geometry (viewBox centered on 0,0)
const R = 150;
const pt = (i: number, v: number) => { const a = -Math.PI / 2 + (i * 2 * Math.PI) / 5; return [Math.cos(a) * R * v, Math.sin(a) * R * v]; };
// the shape shows balance between directions, so it is scaled to the largest one
const top = Math.max(1, ...Object.values(counts) as number[]);
const val = (s: string) => 0.15 + (counts[s] / top) * 0.85;
const shape = pillars.map((p, i) => pt(i, val(p.slug)).map((n) => n.toFixed(1)).join(',')).join(' ');
const rings = [0.25, 0.5, 0.75, 1].map((l) => pillars.map((_, i) => pt(i, l).map((n) => n.toFixed(1)).join(',')).join(' '));

const journal = all.slice(0, 12);
const escH = (x: string) => String(x ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as any)[c]);
// 直排時，兩位以內的數字或英文字母橫躺排成一格（縦中横）
const tcy = (x: string) => escH(x).replace(/(?<![0-9A-Za-z])([0-9A-Za-z]{1,2})(?![0-9A-Za-z])/g, '<span class="tcy">$1</span>');
const kanjiYear = String(new Date().getFullYear()).split('').map((c) => '〇一二三四五六七八九'[+c]).join('');
const igHandle = String((copy as any).instagram_handle || '').replace(/^@/, '').trim();
const igUrl = /^[A-Za-z0-9._]{1,30}$/.test(igHandle) ? `https://ig.me/m/${igHandle}` : '';
const aboutPhoto = /^\/(about|works)\/[\w./-]+\.(webp|png|jpe?g)$/i.test(String((copy as any).about_photo || '')) ? (copy as any).about_photo : '';
const pageData = {
  dirs: pillars.map((p) => ({ id: p.slug, k: p.kanji, n: p.type })),
  entries: all.map((a) => ({ date: ymd(a.e.data.date), dir: a.dir, t: a.e.data.title, url: `/pillars/${a.dir}/${a.e.slug}` })),
  chapters,
  totals: counts,
  start: copy.countdown_start, target: copy.countdown_target, birth: copy.birth_date,
};
const safeHref = (u: string) => (/^(\/(?!\/)|https:\/\/)/.test(u || '') ? u : '');
const stays = (services.stays as any[]).filter((st) => /^https:\/\/(www\.)?airbnb\.[a-z.]+\//i.test(st.url || '') && st.name).map((st) => ({ ...st, img: /^https:\/\//.test(st.img || '') ? st.img : '' }));
const json = JSON.stringify(pageData).replace(/</g, '\\u003c');
---
<BaseLayout>
<style is:global>
/* ── hero ── */
.hero{position:relative;min-height:100vh;min-height:100svh;overflow:hidden;display:flex;align-items:center;background:radial-gradient(120% 80% at 70% 40%,#2A1520 0%,#1C0F14 60%);color:#EFE5D6;}
#art{position:absolute;inset:0;width:100%;height:100%;}
#smoke{position:fixed;inset:0;width:100%;height:100%;z-index:30;pointer-events:none;mix-blend-mode:screen;opacity:0;transition:opacity 2.4s var(--ease);}
#smoke.on{opacity:1;}
.hero-in{position:relative;z-index:2;width:100%;max-width:1240px;margin:0 auto;padding:120px 40px 80px;}
.hero-grid{max-width:660px;}
.hero .rv{--d:0}
h1.motto{font-family:var(--serif);font-weight:500;font-size:clamp(38px,5.6vw,72px);line-height:1.3;}
h1.motto span{display:block;}
h1.motto .l2{color:#3A1F29;transition:color 2.2s var(--ease) .9s;}
.hero.in h1.motto .l2{color:#B9A89E;}
.hero-lede{margin-top:20px;max-width:30em;color:#B9A89E;}
.cd{margin-top:30px;display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;}
.cd small{font-size:13px;color:#86707A;}
.cd-days{font-family:var(--serif);font-size:56px;line-height:1;}
.cd-clock{font-size:24px;display:inline-flex;}
.cd-clock b{font-weight:400;color:#D4A24C;display:inline-block;}
.cd-clock b.tick{animation:tick .45s var(--ease);}
@keyframes tick{from{transform:translateY(-40%);opacity:0;}}
.next-rel{display:inline-flex;gap:10px;align-items:baseline;margin-top:14px;font-size:13.5px;color:#B9A89E;border-bottom:1px solid rgba(239,229,214,.12);padding-bottom:3px;transition:color .3s,border-color .3s,gap .4s var(--ease);}
.next-rel b{font-weight:400;color:#D4A24C;}
.next-rel:hover{color:#EFE5D6;border-color:#D4A24C;gap:14px;}
.board{background:rgba(38,20,27,.72);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border:1px solid rgba(239,229,214,.12);padding:24px 24px 20px;}
.board-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px;}
.board-head h2{font-family:var(--serif);font-weight:500;font-size:17px;}
.board-head small,.board-foot{font-size:12.5px;color:#86707A;}
.brow{display:grid;grid-template-columns:26px minmax(0,1fr) auto;gap:12px;align-items:center;padding:11px 0;border-bottom:1px solid rgba(239,229,214,.1);transition:padding .35s var(--ease);}
.brow:last-of-type{border-bottom:0;}
.brow:hover{padding-left:6px;}
.brow .k{font-family:var(--jp);font-size:17px;color:var(--dc);text-align:center;}
.brow p{font-size:14px;line-height:1.5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.brow p small{display:block;font-size:12px;color:#86707A;}
.brow.todo p{color:#86707A;}
.brow .st{font-size:12px;color:#86707A;}
.brow.done .st{color:var(--dc);}
.board-foot{display:flex;justify-content:space-between;align-items:center;margin-top:14px;color:#B9A89E;}
.pips{display:flex;gap:4px;}
.pips i{width:18px;height:3px;background:rgba(239,229,214,.12);transition:background .6s var(--ease);}
.pips i.on{background:#D4A24C;}
.ledger-block{margin-top:48px;}
.ledger-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;font-size:13px;color:#B9A89E;margin-bottom:12px;}
.ledger-top b{font-family:var(--serif);font-weight:500;color:#EFE5D6;font-size:16px;}
.ledger-wrap{overflow-x:auto;padding:4px 2px 6px;scrollbar-width:none;}
.ledger-wrap::-webkit-scrollbar{display:none;}
.months{--cs:12px;display:grid;grid-auto-flow:column;grid-auto-columns:var(--cs);column-gap:3px;font-size:11.5px;color:#86707A;margin-bottom:6px;width:max-content;}
.months span{white-space:nowrap;}
.ledger{--cs:12px;display:grid;grid-auto-flow:column;grid-template-rows:repeat(7,var(--cs));grid-auto-columns:var(--cs);gap:3px;width:max-content;}
.cell{width:var(--cs);height:var(--cs);border:1px solid rgba(239,229,214,.1);transition:transform .25s var(--ease),box-shadow .25s;opacity:0;animation:cellIn .5s var(--ease) forwards;animation-delay:calc(var(--c) * 4ms + .6s);}
@keyframes cellIn{to{opacity:1;}}
.cell.future{border-color:rgba(239,229,214,.05);}
.cell.done{border:0;}
.cell.done:hover,.cell.today:hover{transform:scale(1.7);box-shadow:0 0 0 3px rgba(28,15,20,.8);position:relative;z-index:2;}
.cell.today{border:1.5px solid #D4A24C;animation:cellIn .5s var(--ease) forwards,breathe 2.6s ease-in-out 1.2s infinite;animation-delay:calc(var(--c) * 4ms + .6s),1.2s;}
@keyframes breathe{50%{box-shadow:0 0 0 4px rgba(212,162,76,.2);}}
.legend{display:flex;flex-wrap:wrap;gap:18px;margin-top:14px;font-size:12.5px;color:#B9A89E;}
.legend i{display:inline-block;width:9px;height:9px;margin-right:7px;}
.tip{position:fixed;z-index:80;pointer-events:none;background:#EFE5D6;color:#1C0F14;font-size:12.5px;padding:7px 11px;line-height:1.55;max-width:260px;opacity:0;transform:translateY(4px);transition:opacity .15s,transform .2s var(--ease);}
.tip.on{opacity:1;transform:none;}
@media(max-width:900px){.hero{align-items:flex-start;}.hero-in{padding:112px 20px 64px;}}

/* ── 壱 連載：五角形能力值 ── */
.story{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,560px);gap:44px;margin-top:26px;border-top:1px solid var(--line);padding-top:26px;align-items:start;}
.stat{background:var(--night-2);border:1px solid var(--line);padding:18px 18px 14px;}
.stat .tabs{display:flex;gap:4px;}
.stat .tabs button{font-size:12.5px;padding:3px 11px;border:1px solid var(--line);color:var(--bone-2);transition:all .25s;}
.stat .tabs button:hover{border-color:var(--bone-2);}
.stat .tabs button[aria-pressed="true"]{background:var(--bone);color:var(--night);border-color:var(--bone);}
.stat-top{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:13px;color:var(--bone-2);}
.pgrid{display:grid;grid-template-columns:minmax(0,210px) minmax(0,1fr);gap:22px;align-items:center;margin-top:8px;}
.penta{margin:0;max-width:210px;width:100%;}
.penta svg{width:100%;height:auto;overflow:visible;display:block;}
.penta .grow{transform:scale(.001);transition:transform 1.4s var(--ease) .3s;}
.in .penta .grow{transform:none;}
.shape{fill:var(--gold-soft);stroke:var(--gold);stroke-width:1.5;transition:all .8s var(--ease);}
.pdot{transition:cx .8s var(--ease),cy .8s var(--ease);}
.axis{font-family:var(--jp);font-size:26px;fill:var(--bone-2);transition:fill .3s;}
.penta a:hover .axis{fill:var(--gold);}

.plegend{list-style:none;margin:0;}
.plegend a{display:grid;grid-template-columns:26px minmax(0,1fr) auto;gap:10px;align-items:center;padding:9px 2px;border-bottom:1px solid var(--line);transition:background .3s,padding .35s var(--ease);}
.plegend li:last-child a{border-bottom:0;}
.plegend a:hover{background:var(--night-3);padding-left:8px;}
.plegend .k{font-family:var(--jp);font-size:19px;color:var(--dc);text-align:center;}
.plegend .n{font-size:14px;min-width:0;}
.plegend .n small{display:block;font-size:11.5px;color:var(--ash);margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.plegend .pbar{display:block;height:3px;background:var(--line);margin-top:6px;position:relative;overflow:hidden;}
.plegend .pbar i{position:absolute;left:0;top:0;bottom:0;background:var(--dc);transition:width 1s var(--ease);}
.plegend .nd{display:flex;flex-direction:column;align-items:flex-end;line-height:1.2;min-width:34px;}
.plegend b{font-weight:300;font-size:18px;}
.plegend .dan{font-family:var(--serif);font-size:11.5px;color:var(--bone-2);text-align:right;margin-top:2px;}
.dir-note{font-size:11.5px;color:var(--ash);margin-top:10px;}
@media(max-width:960px){.story{grid-template-columns:1fr;gap:28px;}}

/* ── 壱 祈願所：縦書き手帳 ── */
.kg{margin-top:26px;position:relative;background:#F3EEE3;color:#2B2522;border-radius:3px;box-shadow:0 30px 50px -28px rgba(0,0,0,.85);
  background-image:linear-gradient(90deg,rgba(176,69,58,.15) 1px,transparent 1px);background-size:64px 100%;}
.kg-scroll{overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:thin;}
.kg-row{display:flex;gap:6px;padding:36px 40px 32px;min-width:min-content;}
.kg-head{writing-mode:vertical-rl;height:440px;flex:none;padding-right:4px;margin-right:30px;font-family:var(--serif);position:relative;}
.kg-head::after{content:"";position:absolute;right:-16px;top:0;bottom:0;border-left:1px solid #2B2522;}
.kg-head>*{display:block;margin-left:14px;}
.kg-head .t{font-family:var(--serif);font-size:34px;letter-spacing:.3em;color:#B0453A;font-weight:500;}
.kg-head .y{font-size:15px;letter-spacing:.3em;}
.kg-head .s{font-size:12.5px;color:#7a716a;letter-spacing:.15em;line-height:2;}
.kg-col{writing-mode:vertical-rl;height:440px;flex:none;display:block;padding:0 12px;font-family:var(--serif);}
.kg-col>*{margin:0 0 0 10px;}
.kg-col .ema{writing-mode:horizontal-tb;display:block;width:34px;height:40px;margin:0 0 0 12px;}
.kg-col h4{margin:0;font-size:18px;font-weight:600;letter-spacing:.12em;line-height:1.65;}
.kg-col .why{margin:0;font-size:12.5px;color:#7a716a;letter-spacing:.1em;line-height:1.9;}
.kg-col .memo{margin:0;font-size:12.5px;color:#B0453A;letter-spacing:.1em;line-height:1.9;}
.kg-col .help,.kg-col .dlink{display:block;font-size:12.5px;color:#7A4E1E;letter-spacing:.1em;text-decoration:underline;text-decoration-color:rgba(122,78,30,.35);text-underline-offset:4px;}
.kg-col .help:hover,.kg-col .dlink:hover{color:#2B2522;}
.kg-col .stv{display:block;text-align:end;font-size:12px;letter-spacing:.3em;color:#B0453A;}
.kg-col .pgb{display:inline-block;width:2px;height:46px;margin-bottom:8px;vertical-align:middle;background:rgba(43,37,34,.12);position:relative;}
.kg-col .pgb i{position:absolute;left:0;right:0;top:0;height:var(--pg);background:#B0453A;}
.kg-col.idea{opacity:.55;}.kg-col.idea .stv{color:#7a716a;}
.kg-col.done .stv{color:#2B2522;}
.tcy{text-combine-upright:all;-webkit-text-combine:horizontal;}
.kg-hint{display:none;font-size:12px;color:var(--ash);margin-top:10px;}
#vDream:not([hidden]) .kg-col{animation:kgIn .6s var(--ease) both;animation-delay:calc(var(--n,0) * 80ms);}
@keyframes kgIn{from{opacity:0;transform:translateY(-10px);}}
#vDream:not([hidden]) .kg-col.idea{animation-name:kgInI;}@keyframes kgInI{from{opacity:0;transform:translateY(-10px);}to{opacity:.55;}}
@media (prefers-reduced-motion:reduce){#vDream:not([hidden]) .kg-col{animation:none;}}
@media(max-width:640px){.kg-row{padding:26px 20px 22px;}.kg-head,.kg-col{height:380px;}.kg-head .t{font-size:28px;}.kg-col h4{font-size:16.5px;}.kg-hint{display:block;}}

/* ── 弐 連載 ── */
.mv-toggle{display:inline-flex;margin-top:28px;border:1px solid var(--line);}
.mv-toggle button{font-size:13px;padding:5px 16px;color:var(--bone-2);transition:background .3s,color .3s;}
.mv-toggle button:hover{color:var(--bone);}
.mv-toggle button[aria-pressed="true"]{background:var(--bone);color:var(--night);}
.track-wrap{overflow-x:auto;margin-top:28px;padding:8px 2px 4px;scrollbar-width:none;}
.track-wrap::-webkit-scrollbar{display:none;}
.track{list-style:none;display:grid;grid-template-columns:repeat(13,minmax(64px,1fr));min-width:860px;position:relative;}
.track::before{content:'';position:absolute;left:32px;right:32px;top:15px;height:1px;background:var(--line);}
.track .fill{position:absolute;left:32px;top:15px;height:1px;background:var(--gold);transform-origin:left;transform:scaleX(0);transition:transform 1.6s var(--ease) .4s;}
.in .track .fill{transform:scaleX(1);}
.track li{position:relative;display:flex;justify-content:center;}
.node{display:flex;flex-direction:column;align-items:center;gap:8px;padding:0 2px 6px;}
.dot{width:14px;height:14px;border-radius:50%;border:1px solid var(--ash);background:var(--night);margin:8px 0;transition:transform .35s var(--ease),box-shadow .35s;}
.node:hover .dot{transform:scale(1.3);box-shadow:0 0 0 5px var(--gold-soft);}
.node.done .dot{background:var(--gold);border-color:var(--gold);}
.node.break .dot{background:repeating-linear-gradient(45deg,var(--ash) 0 2px,transparent 2px 4px);}
.node.next .dot{border:1.5px solid var(--gold);animation:breathe 2.6s ease-in-out infinite;}
.node.final .dot{width:30px;height:30px;margin:0;display:grid;place-items:center;font-size:14px;color:var(--gold);border-color:var(--gold);font-family:var(--jp);}
.node .d{font-size:12px;color:var(--ash);font-variant-numeric:tabular-nums;}
.node .r{font-size:12.5px;color:var(--bone-2);white-space:nowrap;transition:color .3s;}
.node:hover .r,.node[aria-current="true"] .r{color:var(--gold);}
.node[aria-current="true"] .dot{transform:scale(1.25);}
.mdetail{min-width:0;}
.mdetail>*{animation:detIn .6s var(--ease) both;}
.mnums{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:22px;}
.mnums div{border-top:1px solid var(--line);padding-top:10px;}
.mdetail .tag{font-size:12.5px;color:var(--ash);}
.mdetail .tag b{font-weight:400;color:var(--gold);margin-right:8px;}
.mdetail h3{font-family:var(--serif);font-weight:500;font-size:24px;margin-top:4px;line-height:1.45;}
.mdetail p{color:var(--bone-2);margin-top:10px;max-width:32em;}
.mdetail h4{font-family:var(--serif);font-weight:500;font-size:14px;color:var(--gold);margin-top:18px;}
.mdetail ul{list-style:none;margin-top:6px;}
.mdetail li{display:grid;grid-template-columns:30px minmax(0,1fr);gap:10px;padding:10px 0;border-top:1px solid var(--line);font-size:14.5px;}
.mdetail li .k{font-family:var(--jp);color:var(--dc,var(--ash));}
.ch-link{display:inline-block;margin-top:22px;font-size:13.5px;color:var(--bone-2);border-bottom:1px solid var(--line);padding-bottom:3px;transition:color .3s,border-color .3s,padding .4s var(--ease);}
.ch-link:hover{color:var(--bone);border-color:var(--gold);padding-left:6px;}
.mnums b{display:block;font-size:28px;font-weight:300;line-height:1.1;font-variant-numeric:tabular-nums;}
.mnums small{font-size:12.5px;color:var(--ash);}
.ygrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));margin-top:28px;padding:1px 0 0 1px;}
.ycard{background:var(--night);border:1px solid var(--line);margin:-1px 0 0 -1px;padding:18px 18px 16px;text-align:left;display:flex;flex-direction:column;gap:4px;min-height:150px;transition:background .3s,transform .4s var(--ease);position:relative;}
.ycard:hover{background:var(--night-2);z-index:1;transform:translateY(-3px);}
.ycard .n{font-size:12.5px;color:var(--ash);}
.ycard h4{font-family:var(--serif);font-weight:500;font-size:16px;line-height:1.5;}
.ycard .s{margin-top:auto;font-size:12.5px;color:var(--ash);}
.ycard.done .s{color:var(--gold);}
.ycard.next{background:var(--gold-soft);}
.ycard.final{background:var(--night-3);}
.ycard.final h4{color:var(--gold);}

/* ── 肆 works ── */
.strip{display:flex;gap:20px;overflow-x:auto;margin-top:36px;padding:10px 2px 14px;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:var(--ash) transparent;}
.work{flex:0 0 min(380px,82vw);gap:0;scroll-snap-align:start;background:var(--night-2);border:1px solid var(--line);padding:26px;display:flex;flex-direction:column;min-height:250px;position:relative;overflow:hidden;transition:transform .5s var(--ease),border-color .4s,box-shadow .5s var(--ease);}
.work::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--dc);transform:scaleX(0);transform-origin:left;transition:transform .6s var(--ease);}
.work::after{content:attr(data-k);position:absolute;right:-6px;bottom:-26px;font-family:var(--latin);font-weight:300;font-size:150px;line-height:1;color:var(--dc);opacity:0;transform:translateY(16px);transition:opacity .6s var(--ease),transform .6s var(--ease);pointer-events:none;}
.work:hover{transform:translateY(-6px);border-color:rgba(239,229,214,.2);box-shadow:0 18px 40px -20px rgba(0,0,0,.6);}
.work:hover::before{transform:scaleX(1);}
.work:hover::after{opacity:.1;transform:none;}
.work .meta{display:flex;justify-content:space-between;font-size:12px;letter-spacing:.06em;color:var(--ash);}
.work .meta span:first-child{color:var(--gold);}
.work h3{font-family:var(--serif);font-weight:500;font-size:21px;margin-top:14px;line-height:1.45;color:#EBD3A8;}
.work p{font-size:13.5px;color:var(--bone-2);margin-top:8px;}
.work .wq{margin:16px 0 0;padding-left:14px;border-left:2px solid var(--ash);font-family:var(--serif);font-size:15px;line-height:1.8;}
.work .wq small{display:block;font-family:var(--latin);font-size:12px;letter-spacing:.24em;margin-bottom:2px;}
.work .wq.bf{color:var(--bone-2);border-left-color:rgba(134,112,122,.55);}
.work .wq.bf small{color:var(--ash);}
.work .wq.af{color:var(--bone);border-left-color:var(--gold);margin-bottom:8px;}
.work .wthumb{display:block;margin:-26px -26px 20px;aspect-ratio:16/9;overflow:hidden;border-bottom:1px solid var(--line);background:var(--night-3);}
.work .wthumb img{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease);}
.work:hover .wthumb img{transform:scale(1.03);}
.work .wmore{margin-top:auto;padding-top:14px;font-size:13px;color:var(--gold);align-self:flex-end;position:relative;z-index:1;}
.work .wq.af small{color:var(--gold);}
.work .wfoot{margin-top:auto;padding-top:16px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;font-size:13px;color:var(--ash);position:relative;z-index:1;}
.work .wfoot{margin-top:auto;}.work .wq.af+.wfoot,.work .wq.bf+.wfoot{margin-top:auto;}
.work .wfoot .wsvc{color:var(--gold);padding:0;margin:0;}
.work .wsvc:hover{text-decoration:underline;text-underline-offset:4px;}
.work .nums{display:flex;gap:24px;margin-top:auto;padding-top:20px;}
.work .nums b{display:block;font-size:24px;font-weight:300;}
.work .nums small{font-size:11.5px;color:var(--ash);}

/* ── 伍 journal ── */
.filters{display:flex;flex-wrap:wrap;gap:6px;margin-top:28px;}
.chip{font-size:13px;padding:4px 14px;border:1px solid var(--line);color:var(--bone-2);transition:all .25s;}
.chip:hover{border-color:var(--bone-2);color:var(--bone);}
.chip[aria-pressed="true"]{border-color:var(--gold);color:var(--gold);}
.jlist{margin-top:10px;}
.jrow{display:grid;grid-template-columns:96px 36px minmax(0,1fr) 24px;gap:18px;padding:18px 0;border-bottom:1px solid var(--line);align-items:baseline;transition:opacity .4s,padding .4s var(--ease);}
.jrow[hidden]{display:none;}
.jrow time{font-size:13px;color:var(--ash);}
.jrow .k{font-family:var(--jp);font-size:19px;line-height:1;color:var(--dc);width:32px;height:32px;display:grid;place-items:center;border-radius:50%;align-self:start;margin-top:0;transition:background .35s,color .35s;}
.jrow h3{font-family:var(--serif);font-weight:500;font-size:17px;transition:color .3s,transform .45s var(--ease);}
.jrow p{font-size:13.5px;color:var(--bone-2);}
.jrow .arrow{color:var(--gold);opacity:0;transform:translateX(-8px);transition:opacity .35s,transform .45s var(--ease);}
.jrow:hover .k{background:var(--dc);color:var(--night);}
.jrow:hover h3{color:var(--gold);transform:translateX(4px);}
.jrow:hover .arrow{opacity:1;transform:none;}
.jempty{padding:20px 0;color:var(--ash);}
@media(max-width:640px){.jrow{grid-template-columns:1fr;gap:2px;}.jrow .arrow{display:none;}}

/* ── 陸 about ── */
.about{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:56px;margin-top:36px;}
.about .q{font-family:var(--serif);font-size:22px;line-height:1.7;}
.about p{color:var(--bone-2);margin-top:14px;max-width:32em;}
.motto-card{margin-top:28px;padding-top:20px;border-top:1px solid var(--line);font-family:var(--serif);font-size:18px;color:var(--bone);}
.motto-card small{display:block;font-family:var(--sans);font-size:13px;color:var(--ash);margin-top:4px;}
.support{background:#EFE5D6;color:#1C0F14;padding:28px;align-self:start;transition:transform .5s var(--ease),box-shadow .5s var(--ease);}
.support:hover{transform:translateY(-4px);box-shadow:0 20px 40px -20px rgba(0,0,0,.6);}
.support h3{font-family:var(--serif);font-weight:500;font-size:18px;}
.support p{font-size:13.5px;color:#5B4B4E;margin-top:8px;}
.support .r{display:flex;align-items:baseline;gap:10px;margin-top:18px;flex-wrap:wrap;}
.support .r b{font-size:30px;font-weight:400;}
.btn-ink{position:relative;overflow:hidden;margin-left:auto;background:#1C0F14;color:#EFE5D6;padding:10px 20px;font-size:13.5px;transition:background .3s;}
.btn-ink::after{content:'';position:absolute;top:0;left:-60%;width:40%;height:100%;background:linear-gradient(100deg,transparent,rgba(212,162,76,.35),transparent);transform:skewX(-20deg);transition:left .7s var(--ease);}
.btn-ink:hover{background:#3D0F1A;}
.btn-ink:hover::after{left:120%;}
@media(max-width:900px){.about{grid-template-columns:1fr;}}

/* ── 肆 服務 ── */
.svc{margin-top:64px;padding-top:40px;border-top:1px solid var(--line);}
.svc-h{font-family:var(--serif);font-weight:500;font-size:clamp(22px,2.6vw,30px);}
.svc-h2{font-family:var(--serif);font-weight:500;font-size:20px;}
.svc-lede{color:var(--bone-2);margin-top:8px;max-width:34em;font-size:16px;}
.proof{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;margin-top:24px;background:var(--line);border:1px solid var(--line);}
.proof li{background:var(--night);padding:14px 16px;}
.proof b{display:block;font-family:var(--serif);font-weight:500;font-size:28px;line-height:1.15;color:var(--gold);}
.proof small{font-size:12.5px;color:var(--bone-2);}
.scards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:22px;}
.scard{background:var(--night-2);border:1px solid var(--line);padding:22px 22px 18px;display:flex;flex-direction:column;scroll-margin-top:90px;transition:border-color .3s,transform .4s var(--ease);}
.scard:hover{border-color:rgba(212,162,76,.45);transform:translateY(-3px);}
.s-top{display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--ash);}
.badge{border:1px solid var(--gold);color:var(--gold);padding:0 8px;}
.scard h4{font-family:var(--serif);font-weight:500;font-size:22px;margin-top:10px;line-height:1.4;}
.scard h4 small{display:block;font-family:var(--jp);font-size:13px;color:var(--ash);margin-top:2px;}
.scard .for{font-size:13px;color:var(--gold);margin-top:8px;}
.sdesc{font-size:14.5px;color:var(--bone-2);margin-top:8px;}
.sitems{list-style:none;margin-top:12px;}
.sitems li{position:relative;padding:7px 0 7px 18px;border-top:1px solid var(--line);font-size:14px;}
.sitems li::before{content:'';position:absolute;left:2px;top:15px;width:6px;height:6px;border-radius:50%;background:var(--gold);}
.sex{font-size:12.5px;color:var(--ash);margin-top:10px;}
.sex b{font-weight:400;color:var(--bone-2);margin-right:8px;}
.s-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-top:auto;padding-top:16px;}
.price{font-size:12.5px;color:var(--bone-2);}
.btn-gold2{display:inline-flex;align-items:center;min-height:40px;padding:8px 16px;background:var(--gold);color:#1C0F14;font-size:13.5px;transition:transform .3s var(--ease),background .3s;}
.btn-gold2:hover{transform:translateY(-1px);background:#E2B35E;}
.ai-note{margin-top:16px;padding:14px 16px;border:1px dashed var(--line);font-size:13.5px;color:var(--bone-2);scroll-margin-top:90px;}
.ai-note span{font-family:var(--jp);color:var(--c-operate);margin-right:10px;font-size:18px;}
.ai-note a{color:var(--gold);}
.stays{margin-top:36px;}
.stays-note{font-size:13px;color:var(--ash);margin-top:2px;}
.sgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;margin-top:14px;}
.stay{display:flex;flex-direction:column;background:var(--night-2);border:1px solid var(--line);transition:border-color .3s,transform .4s var(--ease);}
.stay:hover{border-color:var(--gold);transform:translateY(-3px);}
.stay img{width:100%;aspect-ratio:4/3;object-fit:cover;}
.stay div{padding:12px 14px 4px;}
.stay h4{font-family:var(--serif);font-weight:500;font-size:16px;}
.stay p{font-size:13px;color:var(--bone-2);}
.stay small{font-size:12px;color:var(--gold);}
.stay .go{padding:8px 14px 12px;font-size:12.5px;color:var(--gold);}
.inq{margin-top:44px;background:#EFE5D6;color:#1C0F14;padding:26px;scroll-margin-top:80px;}
.inq .svc-h2{color:#1C0F14;}
.inq-note{font-size:13px;color:#5B4B4E;margin-top:4px;}
.inq label{display:block;font-size:13px;color:#5B4B4E;margin-top:14px;}
.inq input,.inq select,.inq textarea{display:block;width:100%;margin-top:5px;font:inherit;font-size:16px;color:#1C0F14;background:#FBF6F3;border:1px solid rgba(42,24,30,.18);padding:10px 12px;border-radius:0;transition:border-color .2s,box-shadow .2s;}
.inq input:focus,.inq select:focus,.inq textarea:focus{outline:none;border-color:#9E6F22;box-shadow:0 0 0 3px rgba(158,111,34,.15);}
.inq textarea{resize:vertical;line-height:1.7;}
.frow{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 14px;}
.hp{position:absolute!important;left:-9999px;width:1px;height:1px;opacity:0;}
.consent{font-size:12px;color:#806B72;margin-top:12px;}
.consent a{color:#9E6F22;text-decoration:underline;text-underline-offset:2px;}
.fsend{display:flex;align-items:center;gap:14px;margin-top:14px;flex-wrap:wrap;}
.fsend .btn-ink{margin-left:0;}
.fmsg{font-size:13.5px;}
.fmsg.ok{color:#4E6B3A;}.fmsg.err{color:#A1324A;}
.wsvc{display:inline-block;margin-top:12px;font-size:12.5px;color:var(--gold);}
@media(max-width:860px){.scards{grid-template-columns:1fr;}}

/* ── 手機版（≤640px）：版面收斂、觸控目標加大、橫向內容加提示 ── */
@media(max-width:640px){
  .hero-in{padding:96px 20px 32px;}
  h1.motto{font-size:clamp(32px,9.4vw,40px);}
  .hero-lede{font-size:14.5px;margin-top:16px;}
  .cd{margin-top:22px;gap:10px;}
  .cd-days{font-size:46px;}
  .cd-clock{font-size:20px;}
  .next-rel{min-height:44px;align-items:center;}


  .mv-toggle{margin-top:22px;}
  .mv-toggle button{padding:9px 18px;font-size:13.5px;}
  .track-wrap{margin:20px -20px 0;padding:8px 20px 4px;scroll-snap-type:x proximity;
    -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 20px,#000 calc(100% - 44px),transparent);
            mask-image:linear-gradient(90deg,transparent 0,#000 20px,#000 calc(100% - 44px),transparent);}
  .track{min-width:780px;grid-template-columns:repeat(13,minmax(58px,1fr));}
  .track li{scroll-snap-align:center;}
  .node{min-height:44px;}
  .swipe-hint{display:block;}
  .dgrid{grid-template-columns:1fr;}
  .stat .tabs button{padding:7px 12px;font-size:13px;}
  .stat{padding:14px 12px 12px;}
  .pgrid{grid-template-columns:minmax(0,130px) minmax(0,1fr);gap:12px;}
  .axis{font-size:30px;}
  .mdetail h3{font-size:21px;}
          .mnums b{font-size:22px;}
  .mnums small{font-size:11.5px;line-height:1.4;display:block;}
  .ygrid{grid-template-columns:repeat(2,minmax(0,1fr));}
  .ycard{min-height:118px;padding:14px 14px 12px;}
  .ycard h4{font-size:14.5px;}

  .filters{gap:8px;margin:22px -20px 0;padding:0 20px 4px;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;}
  .filters::-webkit-scrollbar{display:none;}
  .chip{flex:0 0 auto;}
  .chip{padding:8px 14px;font-size:13.5px;}
  .jrow{padding:16px 0;}
  .jrow h3{font-size:16.5px;line-height:1.6;}

  .strip{gap:14px;margin:28px -20px 0;padding:10px 20px 14px;scroll-padding-left:20px;}
  .work{flex-basis:84vw;padding:22px;min-height:220px;}
  .work .wthumb{margin:-22px -22px 18px;}
  .work h3{font-size:18px;}


  .about{gap:32px;margin-top:24px;}
  .about .q{font-size:19px;}
  .support{padding:22px 20px;}
  .support .r{gap:12px;}
  .btn-ink{margin-left:0;width:100%;text-align:center;padding:13px 20px;}
  .svc{margin-top:48px;padding-top:32px;}
  .proof b{font-size:22px;}
  .proof li{padding:12px 10px;}
  .proof small{font-size:11.5px;line-height:1.5;display:block;}
  .scard{padding:18px 16px 16px;}
  .scard h4{font-size:20px;}
  .btn-gold2{width:100%;justify-content:center;min-height:46px;}
  .inq{padding:20px 16px;margin:36px -4px 0;}
  .frow{grid-template-columns:1fr;}
}
/* ── 壱 初次見面：我在做什麼 ── */
.hero-id{margin-top:18px;font-size:14px;letter-spacing:.06em;color:#D4A24C;}
.me{display:grid;grid-template-columns:minmax(0,1fr);gap:28px;margin-top:30px;align-items:center;}
.me.has-photo{grid-template-columns:200px minmax(0,1fr);}
.me-photo{width:200px;aspect-ratio:4/5;object-fit:cover;border:1px solid var(--line);}
.me-intro{font-family:var(--serif);font-size:clamp(19px,2.2vw,23px);line-height:1.75;color:var(--bone);max-width:30em;}
.me-name{margin-top:12px;font-size:13.5px;color:var(--ash);max-width:34em;}
.hats{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:34px;}
.hat{display:grid;grid-template-columns:44px minmax(0,1fr);gap:12px;padding:20px 18px;background:var(--night-2);border:1px solid var(--line);transition:border-color .3s,transform .4s var(--ease);}
.hat:hover{border-color:rgba(212,162,76,.45);transform:translateY(-3px);}
.hitems{list-style:none;margin-top:10px;}
.hitems li{position:relative;padding-left:14px;font-size:13.5px;color:var(--bone);line-height:1.9;}
.hitems li::before{content:"";position:absolute;left:0;top:.85em;width:5px;height:1px;background:var(--gold);}
.hprov{display:block;margin-top:10px;font-size:11.5px;letter-spacing:.06em;color:var(--ash);}
.closing{padding-top:24px;}
.closing .about.end{margin-top:0;}
.hat .hk{font-family:var(--jp);font-size:24px;color:var(--gold);line-height:1.1;}
.hat h3{font-family:var(--serif);font-weight:500;font-size:17px;line-height:1.5;}
.hat p{font-size:13.5px;color:var(--bone-2);margin-top:6px;line-height:1.8;}
.hat a{display:inline-block;margin-top:10px;font-size:13px;color:var(--gold);}
.hat a:hover{text-decoration:underline;text-underline-offset:4px;}
.me-cta{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:26px;}
.ig-btn{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:8px 16px;border:1px solid rgba(239,229,214,.3);color:var(--bone);font-size:13.5px;transition:border-color .3s,background .3s;}
.ig-btn:hover{border-color:var(--gold);background:rgba(212,162,76,.08);}
.ig-btn span{color:var(--gold);}
.ig-btn.big{margin-top:14px;min-height:48px;padding:10px 20px;font-size:15px;}
.ig-mini{font-size:13px;color:var(--bone-2);border-bottom:1px solid var(--line);margin-right:12px;}
.ig-mini:hover{color:var(--gold);border-color:var(--gold);}
.s-acts{display:flex;align-items:center;}
.show{font-size:12.5px;color:var(--bone-2);margin-top:8px;}
.show b{font-weight:400;color:var(--gold);margin-right:8px;}
#services .svc{margin-top:28px;padding-top:0;border-top:0;}
.faq{margin-top:44px;}
.faq details{border-bottom:1px solid var(--line);padding:14px 0;}
.faq summary{cursor:pointer;font-family:var(--serif);font-size:16px;list-style:none;display:flex;justify-content:space-between;gap:12px;}
.faq summary::-webkit-details-marker{display:none;}
.faq summary::after{content:'+';color:var(--gold);font-size:18px;line-height:1;transition:transform .3s var(--ease);}
.faq details[open] summary::after{transform:rotate(45deg);}
.faq details p{font-size:14px;color:var(--bone-2);margin-top:8px;line-height:1.85;}
.contact{margin-top:44px;}
.about.end{margin-top:56px;padding-top:36px;border-top:1px solid var(--line);align-items:start;}
.about.end .motto-card{margin-top:0;border-top:0;padding-top:0;font-size:22px;}
@media(max-width:900px){.hats{grid-template-columns:1fr;}.me.has-photo{grid-template-columns:120px minmax(0,1fr);gap:18px;}.me-photo{width:120px;}}
@media(max-width:640px){.me.has-photo{grid-template-columns:1fr;}.me-photo{width:150px;}.s-foot{flex-direction:column;align-items:stretch;}.s-acts{justify-content:space-between;}.ig-btn{width:100%;justify-content:center;}.about.end{grid-template-columns:1fr;gap:28px;}}

.swipe-hint{display:none;font-size:12px;color:var(--ash);margin-top:8px;letter-spacing:.04em;}
</style>

<section class="hero" aria-labelledby="motto">
  <canvas id="art" aria-hidden="true"></canvas>
  <div class="hero-in">
    <div class="hero-grid">
      <div>
        <h1 class="motto rv" id="motto" style="--i:0"><span>{copy.motto_line1}</span><span class="l2">{copy.motto_line2}</span></h1>
        <p class="hero-id rv" style="--i:1">{copy.hero_identity}</p>
        <p class="hero-lede rv" style="--i:2">{copy.hero_lede}</p>
        <div class="cd rv" style="--i:3"><small>{copy.countdown_label}</small><span class="cd-days num" id="cdD">—</span><small>天</small><span class="cd-clock num" id="cdC">00:00:<b>00</b></span></div>
        <a class="next-rel rv" style="--i:4" href="#chapters" id="nextRel">&nbsp;</a>
      </div>
    </div>
  </div>
</section>

<section class="sec band-wine" id="about" aria-labelledby="a-h">
  <div class="sec-grid">
    <div class="side" aria-hidden="true"><span class="sn">壱</span><span class="sl"></span><span class="se">Hello</span></div>
    <div>
      <div class="sec-head"><p class="sub rv">{copy.about_meta}</p><h2 id="a-h" class="rv" style="--i:1">{copy.about_name}</h2></div>
      <div class={`me${aboutPhoto ? ' has-photo' : ''}`}>
        {aboutPhoto && <img class="me-photo rv" style="--i:2" src={aboutPhoto} alt="林子翔（巴）" loading="lazy" decoding="async" />}
        <div>
          <p class="me-intro rv" style="--i:2">{copy.about_intro}</p>
          <p class="me-name rv" style="--i:3">{copy.about_lede}</p>
        </div>
      </div>
      <ol class="hats">
        {services.hats.map((h: any, i: number) => (
          <li class="hat rv" style={`--i:${i + 3}`}><span class="hk">{h.k}</span><div><h3>{h.title}</h3><p>{h.desc}</p>{h.items && <ul class="hitems">{h.items.map((t: string) => <li>{t}</li>)}</ul>}{h.provider && <small class="hprov">{h.provider}</small>}</div></li>
        ))}
      </ol>
      <ul class="proof rv" style="--i:6">{services.proof.map((x) => <li><b class="num">{x.num}</b><small>{x.label}</small></li>)}</ul>
      <div class="me-cta rv" style="--i:7"><a class="btn-gold2" href="/chat/">有空聊聊 →</a><a class="ig-btn" href="#works">看我做過的東西 →</a></div>
    </div>
  </div>
</section>

<section class="sec" id="works" aria-labelledby="works-h">
  <div class="sec-grid">
    <div class="side" aria-hidden="true"><span class="sn">弐</span><span class="sl"></span><span class="se">Works</span></div>
    <div>
      <div class="sec-head"><p class="sub rv">{copy.works_sub}</p><h2 id="works-h" class="rv" style="--i:1">{copy.works_title}</h2></div>
      <div class="strip" tabindex="0" aria-label="成果列表，可左右捲動">
        {worksData.works.map((w, i) => { return (
          <a class="work rv" href={/^[a-z0-9-]+$/.test((w as any).slug || '') ? `/works/${(w as any).slug}/` : undefined} style={`--i:${i + 2};--dc:var(--gold)`} data-k={String(i + 1).padStart(2, '0')}>{safeImg(((w as any).images || [])[0]?.src ?? ((w as any).images || [])[0] ?? '') && <span class="wthumb"><img src={safeImg(((w as any).images || [])[0]?.src ?? ((w as any).images || [])[0])} alt="" loading="lazy" decoding="async" /></span>}<div class="meta"><span>No.{String(i + 1).padStart(2, '0')}</span><span>{w.date}</span></div><h3>{w.title}</h3>{(w as any).why ? <><blockquote class="wq bf"><small>BEFORE</small>{(w as any).why}</blockquote>{(w as any).result && <blockquote class="wq af"><small>AFTER</small>{(w as any).result}</blockquote>}</> : <p>{w.desc}</p>}{/^[a-z0-9-]+$/.test((w as any).slug || '') && <span class="wmore">看作品 →</span>}</a>
        ); })}
      </div>
    </div>
  </div>
</section>

