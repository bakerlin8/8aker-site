/* ── 服務卡 ── */
.hat{position:relative;overflow:hidden;isolation:isolate;}
.hat>*{position:relative;z-index:1;}
.hat .hk,.hat h3,.hat p,.hitems li{transition:color .45s var(--ease),border-color .45s var(--ease),transform .55s var(--ease),text-shadow .45s;}
/* 服務卡：光の縁＋三張卡各一色（酒・金・生成り：玫瑰紅／金／米白） */
@property --ang{syntax:'<angle>';initial-value:0deg;inherits:false;}
.hats .hat:nth-child(3n+1){--hc:196,86,107;--hl:236,160,176;}
.hats .hat:nth-child(3n+2){--hc:212,162,76;--hl:243,217,160;}
.hats .hat:nth-child(3n+3){--hc:214,196,172;--hl:245,234,218;}
.hats .hat{--hc:212,162,76;--hl:243,217,160;border-color:rgba(var(--hc),.26);background:radial-gradient(240px circle at var(--mx,50%) var(--my,50%),rgba(var(--hc),.20),transparent 70%),linear-gradient(160deg,rgba(var(--hc),.2),rgba(var(--hc),.05) 70%),var(--night-2);transition:transform .55s var(--ease),border-color .4s;}
.hats .hat .hk{color:rgb(var(--hc));}
.hats .hitems li{border-color:rgba(var(--hc),.42);}
.hats .hat::before{content:'';position:absolute;inset:0;padding:1.5px;z-index:0;background:conic-gradient(from var(--ang),transparent 0 60%,rgba(var(--hl),1) 78%,rgb(var(--hc)) 87%,transparent 97%);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:0;transition:opacity .4s;}
.hats .hat:hover{transform:translateY(-3px);border-color:rgba(var(--hc),.5);}
.hats .hat:hover::before{opacity:1;animation:hatSpin 2.4s linear infinite;}
.hats .hat:hover .hk{text-shadow:0 0 18px rgba(var(--hl),.8);color:rgb(var(--hl));}
.hats .hat:hover .hitems li{border-color:rgba(var(--hl),.6);}
@keyframes hatSpin{to{--ang:360deg;}}
@media(hover:none){.hats .hat{border-left:2px solid rgb(var(--hc));}}
@media(prefers-reduced-motion:reduce){.hats .hat,.hats .hat::before,.hats .hat::after{transition:none!important;animation:none!important;}}
/* ── 實績數字：月台翻牌（Solari board） ── */
.proof{grid-template-columns:repeat(auto-fit,minmax(170px,1fr));}
.proof .flap{display:flex!important;width:max-content;gap:3px;margin-bottom:8px;font-family:var(--latin)!important;font-size:32px!important;font-variant-numeric:lining-nums tabular-nums;}
.proof .flap+small{display:block;}
@media(max-width:640px){.proof li{align-items:center!important;}.proof .flap{font-size:24px!important;margin-bottom:0;min-width:96px;}}
.fc{position:relative;display:inline-block;width:.78em;height:1.18em;perspective:300px;font-size:1em;line-height:1.18em;text-align:center;color:#F3D9A0;}
.fc>span{position:absolute;left:0;right:0;height:50%;overflow:hidden;background:#1A0B10;backface-visibility:hidden;}
.fc .t,.fc .ft{top:0;border-radius:3px 3px 0 0;transform-origin:50% 100%;background:linear-gradient(#24101A,#1C0C12);}
.fc .b,.fc .fb{bottom:0;border-radius:0 0 3px 3px;transform-origin:50% 0;background:linear-gradient(#170A0E,#12070B);}
.fc>span>i{position:absolute;left:0;right:0;height:1.18em;font-style:normal;}
.fc .t>i,.fc .ft>i{top:0;}
.fc .b>i,.fc .fb>i{top:-.59em;}
.fc::after{content:'';position:absolute;left:0;right:0;top:50%;height:1px;margin-top:-.5px;background:rgba(0,0,0,.65);z-index:3;}
.fc .ft,.fc .fb{z-index:2;}
.fc .fb{transform:rotateX(90deg);}
.hat h3{font-family:var(--serif);font-weight:500;font-size:17px;line-height:1.5;}
.hat p{font-size:13.5px;color:var(--bone-2);margin-top:6px;line-height:1.8;}
.hat a{display:inline-block;margin-top:10px;font-size:13px;color:var(--gold);}
.hat a:hover{text-decoration:underline;text-underline-offset:4px;}
.me-cta{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:26px;}
.ig-btn{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:8px 16px;border:1px solid rgba(239,229,214,.3);color:var(--bone);font-size:13.5px;transition:border-color .3s,background .3s;}
.ig-btn:hover{border-color:var(--gold);background:rgba(212,162,76,.08);}
.ig-btn span{color:var(--gold);}
.ig-btn.big{margin-top:14px;min-height:48px;padding:10px 20px;font-size:15px;}
.ig-mini{font-size:13px;color:var(--bone-2);border-bottom:1px solid var(--line);margin-right:12px;}
.ig-mini:hover{color:var(--gold);border-color:var(--gold);}
.s-acts{display:flex;align-items:center;}
.show{font-size:12.5px;color:var(--bone-2);margin-top:8px;}
.show b{font-weight:400;color:var(--gold);margin-right:8px;}
#services .svc{margin-top:28px;padding-top:0;border-top:0;}
.faq{margin-top:44px;}
.faq details{border-bottom:1px solid var(--line);padding:14px 0;}
.faq summary{cursor:pointer;font-family:var(--serif);font-size:16px;list-style:none;display:flex;justify-content:space-between;gap:12px;}
.faq summary::-webkit-details-marker{display:none;}
.faq summary::after{content:'+';color:var(--gold);font-size:18px;line-height:1;transition:transform .3s var(--ease);}
.faq details[open] summary::after{transform:rotate(45deg);}
.faq details p{font-size:14px;color:var(--bone-2);margin-top:8px;line-height:1.85;}
.contact{margin-top:44px;}
.about.end{margin-top:56px;padding-top:36px;border-top:1px solid var(--line);align-items:start;}
.about.end .motto-card{margin-top:0;border-top:0;padding-top:0;font-size:22px;}
@media(max-width:900px){.hats{grid-template-columns:1fr;}.me.has-photo{grid-template-columns:120px minmax(0,1fr);gap:18px;}.me-photo{width:120px;}}
@media(max-width:640px){.me.has-photo{grid-template-columns:1fr;}.me-photo{width:150px;}.s-foot{flex-direction:column;align-items:stretch;}.s-acts{justify-content:space-between;}.ig-btn{width:100%;justify-content:center;}.about.end{grid-template-columns:1fr;gap:28px;}}

/* ── 弐 有點樣子：唱盤 ── */
.deck{position:relative;margin-top:24px;height:560px;perspective:1400px;overflow:hidden;outline:none;touch-action:pan-y;user-select:none;}
.deck-stage{position:absolute;inset:0;transform-style:preserve-3d;}
.deck .work{position:absolute;left:50%;top:70px;width:min(380px,78vw);margin-left:calc(min(380px,78vw) / -2);min-height:420px;transition:transform .8s var(--ease),opacity .6s var(--ease),filter .6s var(--ease),box-shadow .6s;will-change:transform;}
.deck .work:not(.on){cursor:pointer;}
.deck .work .wthumb{aspect-ratio:16/6;}
.deck:has(.wthumb){height:640px;}
@media(max-width:640px){.deck:has(.wthumb){height:620px;}}
.deck .work:not(.on) .wmore{opacity:0;}
.deck .work.on{box-shadow:0 30px 60px -30px rgba(0,0,0,.8);}
.deck .work.on::before{transform:scaleX(1);}
/* 作品卡色塊：顏色在 src/data/work-colors.ts，依順序六色輪替，也可在 Studio 指定；文字維持金與米白 */
.deck.tint .work{background:linear-gradient(165deg,var(--wb),var(--wb2));border-color:rgba(255,255,255,.08);}
.deck.tint .work .wthumb{border-bottom-color:rgba(255,255,255,.08);}
.deck.tint .work .meta span:first-child{color:var(--dc);}
.deck.tint .work .wq.bf{border-left-color:rgba(255,255,255,.18);}
.deck.tint .work::after{opacity:.16;}
.vinyl{position:absolute;left:50%;top:10px;width:540px;height:540px;margin-left:-270px;border-radius:50%;
  background:radial-gradient(circle,#D4A24C 0 9%,#1a0d12 9.5% 10.5%,transparent 11%),repeating-radial-gradient(circle,#140a0e 0 2px,#22121a 2.5px 3.5px),#140a0e;
  box-shadow:0 20px 50px -20px #000,inset 0 0 0 1px rgba(239,229,214,.06);transition:transform .9s var(--ease),opacity .6s;animation:spin 9s linear infinite;}
.vinyl::after{content:"";position:absolute;inset:0;border-radius:50%;background:conic-gradient(from 30deg,transparent 0 20%,rgba(255,255,255,.06) 25%,transparent 32% 70%,rgba(255,255,255,.05) 75%,transparent 82%);}
.vinyl .vlabel{display:none;}
.deck.switching .vinyl{transform:scale(.92);opacity:.7;}
@keyframes spin{to{rotate:360deg;}}
.wnav{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:6px;}
.wn-btn{width:42px;height:42px;border-radius:50%;border:1px solid var(--line);color:var(--bone-2);font-size:16px;transition:border-color .3s,color .3s;}
.wn-btn:hover{border-color:var(--gold);color:var(--gold);}
.wn-ticks{list-style:none;display:flex;gap:6px;align-items:center;max-width:60vw;overflow-x:auto;scrollbar-width:none;padding:4px 2px;}
.wn-ticks button{display:block;padding:6px 4px;}
.wn-ticks span{display:block;width:26px;height:2px;background:var(--line);font-size:0;transition:background .4s,width .4s var(--ease);}
.wn-ticks button[aria-current="true"] span{background:var(--gold);width:44px;}
.wn-ticks button:hover span{background:var(--bone-2);}
.wn-count{font-family:var(--latin);font-size:15px;color:var(--ash);letter-spacing:.08em;min-width:62px;text-align:center;}
.wn-count b{color:var(--gold);font-weight:500;}
@media(max-width:640px){.deck{height:540px;margin-left:-20px;margin-right:-20px;}.deck .work{top:60px;min-height:420px;}.vinyl{width:380px;height:380px;margin-left:-190px;top:80px;}.wnav{gap:10px;}}
@media(prefers-reduced-motion:reduce){.vinyl{animation:none;}}

/* ── 年輪：五個方向的段位小年輪 ── */
.plegend a{grid-template-columns:26px minmax(0,1fr) 36px auto !important;}
.dring{width:36px;height:36px;display:block;overflow:visible;}
.dring circle{fill:none;}

.swipe-hint{display:none;font-size:12px;color:var(--ash);margin-top:8px;letter-spacing:.04em;}
</style>

