---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { pillars } from '../data/pillars';
import copy from '../data/site-copy.json';
import chapters from '../data/chapters.json';
import worksData from '../data/works.json';
import body from '../data/body.json';

const all = (await Promise.all(
  pillars.map(async (p) => (await getCollection(p.slug as any, ({ data }: any) => !data.draft)).map((e: any) => ({ dir: p.slug, e })))
)).flat();
all.sort((a, b) => b.e.data.date.valueOf() - a.e.data.date.valueOf());
const ymd = (d: Date) => d.toISOString().slice(0, 10);
const dot = (d: Date) => ymd(d).replaceAll('-', '.');
const counts = Object.fromEntries(pillars.map((p) => [p.slug, all.filter((a) => a.dir === p.slug).length]));
const dan = (c: number) => (c >= 100 ? '四段' : c >= 60 ? '三段' : c >= 30 ? '二段' : c >= 10 ? '初段' : '見習');
const MAX = 30;

// pentagon geometry (viewBox centered on 0,0)
const R = 150;
const pt = (i: number, v: number) => { const a = -Math.PI / 2 + (i * 2 * Math.PI) / 5; return [Math.cos(a) * R * v, Math.sin(a) * R * v]; };
// the shape shows balance between directions, so it is scaled to the largest one
const top = Math.max(1, ...Object.values(counts) as number[]);
const val = (s: string) => 0.15 + (counts[s] / top) * 0.85;
const shape = pillars.map((p, i) => pt(i, val(p.slug)).map((n) => n.toFixed(1)).join(',')).join(' ');
const rings = [0.25, 0.5, 0.75, 1].map((l) => pillars.map((_, i) => pt(i, l).map((n) => n.toFixed(1)).join(',')).join(' '));

const journal = all.slice(0, 12);
const pageData = {
  dirs: pillars.map((p) => ({ id: p.slug, k: p.kanji, n: p.type })),
  entries: all.map((a) => ({ date: ymd(a.e.data.date), dir: a.dir, t: a.e.data.title, url: `/pillars/${a.dir}/${a.e.slug}` })),
  chapters, body,
  start: copy.countdown_start, target: copy.countdown_target, birth: copy.birth_date,
};
const json = JSON.stringify(pageData).replace(/</g, '\\u003c');
---
<BaseLayout>
<style is:global>
/* ── hero ── */
.hero{position:relative;min-height:100vh;min-height:100svh;overflow:hidden;display:flex;align-items:center;background:radial-gradient(120% 80% at 70% 40%,#2A1520 0%,#1C0F14 60%);color:#EFE5D6;}
#art{position:absolute;inset:0;width:100%;height:100%;}
.hero-in{position:relative;z-index:2;width:100%;max-width:1240px;margin:0 auto;padding:120px 40px 80px;}
.hero-grid{max-width:660px;}
.hero .rv{--d:0}
h1.motto{font-family:var(--serif);font-weight:500;font-size:clamp(38px,5.6vw,72px);line-height:1.3;}
h1.motto span{display:block;}
h1.motto .l2{color:#3A1F29;transition:color 2.2s var(--ease) .9s;}
.hero.in h1.motto .l2{color:#B9A89E;}
.hero-lede{margin-top:20px;max-width:30em;color:#B9A89E;}
.cd{margin-top:30px;display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;}
.cd small{font-size:13px;color:#86707A;}
.cd-days{font-family:var(--serif);font-size:56px;line-height:1;}
.cd-clock{font-size:24px;display:inline-flex;}
.cd-clock b{font-weight:400;color:#D4A24C;display:inline-block;}
.cd-clock b.tick{animation:tick .45s var(--ease);}
@keyframes tick{from{transform:translateY(-40%);opacity:0;}}
.next-rel{display:inline-flex;gap:10px;align-items:baseline;margin-top:14px;font-size:13.5px;color:#B9A89E;border-bottom:1px solid rgba(239,229,214,.12);padding-bottom:3px;transition:color .3s,border-color .3s,gap .4s var(--ease);}
.next-rel b{font-weight:400;color:#D4A24C;}
.next-rel:hover{color:#EFE5D6;border-color:#D4A24C;gap:14px;}
.board{background:rgba(38,20,27,.72);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border:1px solid rgba(239,229,214,.12);padding:24px 24px 20px;}
.board-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px;}
.board-head h2{font-family:var(--serif);font-weight:500;font-size:17px;}
.board-head small,.board-foot{font-size:12.5px;color:#86707A;}
.brow{display:grid;grid-template-columns:26px minmax(0,1fr) auto;gap:12px;align-items:center;padding:11px 0;border-bottom:1px solid rgba(239,229,214,.1);transition:padding .35s var(--ease);}
.brow:last-of-type{border-bottom:0;}
.brow:hover{padding-left:6px;}
.brow .k{font-family:var(--jp);font-size:17px;color:var(--dc);text-align:center;}
.brow p{font-size:14px;line-height:1.5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.brow p small{display:block;font-size:12px;color:#86707A;}
.brow.todo p{color:#86707A;}
.brow .st{font-size:12px;color:#86707A;}
.brow.done .st{color:var(--dc);}
.board-foot{display:flex;justify-content:space-between;align-items:center;margin-top:14px;color:#B9A89E;}
.pips{display:flex;gap:4px;}
.pips i{width:18px;height:3px;background:rgba(239,229,214,.12);transition:background .6s var(--ease);}
.pips i.on{background:#D4A24C;}
.ledger-block{margin-top:48px;}
.ledger-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;font-size:13px;color:#B9A89E;margin-bottom:12px;}
.ledger-top b{font-family:var(--serif);font-weight:500;color:#EFE5D6;font-size:16px;}
.ledger-wrap{overflow-x:auto;padding:4px 2px 6px;scrollbar-width:none;}
.ledger-wrap::-webkit-scrollbar{display:none;}
.months{--cs:12px;display:grid;grid-auto-flow:column;grid-auto-columns:var(--cs);column-gap:3px;font-size:11.5px;color:#86707A;margin-bottom:6px;width:max-content;}
.months span{white-space:nowrap;}
.ledger{--cs:12px;display:grid;grid-auto-flow:column;grid-template-rows:repeat(7,var(--cs));grid-auto-columns:var(--cs);gap:3px;width:max-content;}
.cell{width:var(--cs);height:var(--cs);border:1px solid rgba(239,229,214,.1);transition:transform .25s var(--ease),box-shadow .25s;opacity:0;animation:cellIn .5s var(--ease) forwards;animation-delay:calc(var(--c) * 4ms + .6s);}
@keyframes cellIn{to{opacity:1;}}
.cell.future{border-color:rgba(239,229,214,.05);}
.cell.done{border:0;}
.cell.done:hover,.cell.today:hover{transform:scale(1.7);box-shadow:0 0 0 3px rgba(28,15,20,.8);position:relative;z-index:2;}
.cell.today{border:1.5px solid #D4A24C;animation:cellIn .5s var(--ease) forwards,breathe 2.6s ease-in-out 1.2s infinite;animation-delay:calc(var(--c) * 4ms + .6s),1.2s;}
@keyframes breathe{50%{box-shadow:0 0 0 4px rgba(212,162,76,.2);}}
.legend{display:flex;flex-wrap:wrap;gap:18px;margin-top:14px;font-size:12.5px;color:#B9A89E;}
.legend i{display:inline-block;width:9px;height:9px;margin-right:7px;}
.tip{position:fixed;z-index:80;pointer-events:none;background:#EFE5D6;color:#1C0F14;font-size:12.5px;padding:7px 11px;line-height:1.55;max-width:260px;opacity:0;transform:translateY(4px);transition:opacity .15s,transform .2s var(--ease);}
.tip.on{opacity:1;transform:none;}
@media(max-width:900px){.hero{align-items:flex-start;}.hero-in{padding:112px 20px 64px;}}

/* ── 壱 five directions ── */
.dirs{display:grid;grid-template-columns:380px minmax(0,1fr);gap:56px;margin-top:40px;align-items:start;}
.penta svg{width:100%;height:auto;overflow:visible;}
.penta .grow{transform:scale(.001);transition:transform 1.4s var(--ease) .3s;}
.in .penta .grow{transform:none;}
.shape{fill:var(--gold-soft);stroke:var(--gold);stroke-width:1.5;}
.axis{font-family:var(--jp);font-size:21px;fill:var(--bone-2);cursor:pointer;transition:fill .3s;}
.axis:hover,.axis.on{fill:var(--gold);}
.idx{display:flex;flex-direction:column;border-top:1px solid var(--line);}
.idx button{display:grid;grid-template-columns:48px minmax(0,1fr) 110px 52px;gap:14px;align-items:center;padding:13px 6px;border-bottom:1px solid var(--line);text-align:left;transition:background .3s,padding .4s var(--ease);}
.idx button:hover{background:var(--night-2);}
.idx button[aria-selected="true"]{background:var(--night-2);padding-left:16px;}
.idx .k{font-family:var(--jp);font-size:30px;line-height:1;color:var(--ash);transition:color .3s,transform .5s var(--ease);display:inline-block;}
.idx button:hover .k{transform:rotate(-6deg) scale(1.08);}
.idx button[aria-selected="true"] .k,.idx button:hover .k{color:var(--dc);}
.idx .n{font-size:15px;}
.idx .n small{display:block;font-size:12px;color:var(--ash);}
.idx .bar{height:3px;background:var(--line);position:relative;overflow:hidden;}
.idx .bar i{position:absolute;inset:0 auto 0 0;background:var(--dc);transform:scaleX(0);transform-origin:left;transition:transform 1.2s var(--ease);}
.in .idx .bar i{transform:scaleX(1);}
.idx .dan{font-family:var(--serif);font-size:13.5px;text-align:right;}
.detail{position:relative;margin-top:28px;min-height:230px;overflow:hidden;}
.detail[hidden]{display:none;}
.detail .big{position:absolute;right:-8px;top:-30px;font-family:var(--jp);font-weight:300;font-size:220px;line-height:1;color:var(--dc);opacity:.09;pointer-events:none;animation:bigIn .9s var(--ease);}
@keyframes bigIn{from{opacity:0;transform:translateX(24px);}}
.detail>*:not(.big){animation:detIn .6s var(--ease) both;}
.detail>*:nth-child(3){animation-delay:.05s}.detail>*:nth-child(4){animation-delay:.1s}.detail>*:nth-child(5){animation-delay:.15s}
@keyframes detIn{from{opacity:0;transform:translateY(6px);}}
.detail h3{font-family:var(--serif);font-weight:500;font-size:24px;}
.detail .jp{font-family:var(--jp);font-size:13.5px;color:var(--ash);}
.detail .d{margin-top:12px;color:var(--bone-2);max-width:32em;}
.detail .es{margin-top:18px;}
.detail .es a{display:flex;gap:18px;padding:10px 0;border-top:1px solid var(--line);font-size:14.5px;transition:padding .35s var(--ease);}
.detail .es a:hover{padding-left:8px;}
.detail .es a:hover span{color:var(--gold);}
.detail .es time{color:var(--ash);font-size:13px;min-width:84px;}
.dir-note{font-size:12.5px;color:var(--ash);margin-top:14px;}
@media(max-width:960px){.dirs{grid-template-columns:1fr;}.penta svg{max-width:340px;margin:0 auto;display:block;}.idx button{grid-template-columns:40px minmax(0,1fr) 70px 48px;}.detail .big{font-size:150px;}}

/* ── 弐 連載 ── */
.mv-toggle{display:inline-flex;margin-top:28px;border:1px solid var(--line);}
.mv-toggle button{font-size:13px;padding:5px 16px;color:var(--bone-2);transition:background .3s,color .3s;}
.mv-toggle button:hover{color:var(--bone);}
.mv-toggle button[aria-pressed="true"]{background:var(--bone);color:var(--night);}
.track-wrap{overflow-x:auto;margin-top:28px;padding:8px 2px 4px;scrollbar-width:none;}
.track-wrap::-webkit-scrollbar{display:none;}
.track{list-style:none;display:grid;grid-template-columns:repeat(13,minmax(64px,1fr));min-width:860px;position:relative;}
.track::before{content:'';position:absolute;left:32px;right:32px;top:15px;height:1px;background:var(--line);}
.track .fill{position:absolute;left:32px;top:15px;height:1px;background:var(--gold);transform-origin:left;transform:scaleX(0);transition:transform 1.6s var(--ease) .4s;}
.in .track .fill{transform:scaleX(1);}
.track li{position:relative;display:flex;justify-content:center;}
.node{display:flex;flex-direction:column;align-items:center;gap:8px;padding:0 2px 6px;}
.dot{width:14px;height:14px;border-radius:50%;border:1px solid var(--ash);background:var(--night);margin:8px 0;transition:transform .35s var(--ease),box-shadow .35s;}
.node:hover .dot{transform:scale(1.3);box-shadow:0 0 0 5px var(--gold-soft);}
.node.done .dot{background:var(--gold);border-color:var(--gold);}
.node.break .dot{background:repeating-linear-gradient(45deg,var(--ash) 0 2px,transparent 2px 4px);}
.node.next .dot{border:1.5px solid var(--gold);animation:breathe 2.6s ease-in-out infinite;}
.node.final .dot{width:30px;height:30px;margin:0;display:grid;place-items:center;font-size:14px;color:var(--gold);border-color:var(--gold);font-family:var(--jp);}
.node .d{font-size:12px;color:var(--ash);font-variant-numeric:tabular-nums;}
.node .r{font-size:12.5px;color:var(--bone-2);white-space:nowrap;transition:color .3s;}
.node:hover .r,.node[aria-current="true"] .r{color:var(--gold);}
.node[aria-current="true"] .dot{transform:scale(1.25);}
.mdetail{margin-top:26px;border-top:1px solid var(--line);padding-top:26px;display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:40px;}
.mdetail>*{animation:detIn .6s var(--ease) both;}
.mdetail .tag{font-size:12.5px;color:var(--ash);}
.mdetail .tag b{font-weight:400;color:var(--gold);margin-right:8px;}
.mdetail h3{font-family:var(--serif);font-weight:500;font-size:24px;margin-top:4px;line-height:1.45;}
.mdetail p{color:var(--bone-2);margin-top:10px;max-width:32em;}
.mdetail h4{font-family:var(--serif);font-weight:500;font-size:14px;color:var(--gold);margin-top:18px;}
.mdetail ul{list-style:none;margin-top:6px;}
.mdetail li{display:grid;grid-template-columns:30px minmax(0,1fr);gap:10px;padding:10px 0;border-top:1px solid var(--line);font-size:14.5px;}
.mdetail li .k{font-family:var(--jp);color:var(--dc,var(--ash));}
.tally{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;margin-top:22px;border:1px solid var(--line);background:var(--line);}
.tally div{background:var(--night);padding:12px 8px 10px;text-align:center;transition:background .3s,transform .4s var(--ease);}
.tally div:hover{background:var(--night-2);transform:translateY(-2px);}
.tally .k{font-family:var(--jp);font-size:22px;line-height:1;color:var(--dc);display:block;}
.tally b{display:block;font-weight:300;font-size:22px;line-height:1.2;margin-top:6px;font-variant-numeric:tabular-nums;}
.tally small{font-size:11.5px;color:var(--ash);}
.tally div.zero .k{opacity:.35;} .tally div.zero b{color:var(--ash);}
.tally-h{font-family:var(--serif);font-weight:500;font-size:14px;color:var(--gold);margin-top:22px;}
.tally-h span{font-family:var(--sans);font-weight:300;font-size:12.5px;color:var(--ash);margin-left:8px;}
.mnums div{padding:12px 0;border-bottom:1px solid var(--line);}
.mnums b{display:block;font-size:28px;font-weight:300;line-height:1.1;font-variant-numeric:tabular-nums;}
.mnums small{font-size:12.5px;color:var(--ash);}
.ygrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));margin-top:28px;padding:1px 0 0 1px;}
.ycard{background:var(--night);border:1px solid var(--line);margin:-1px 0 0 -1px;padding:18px 18px 16px;text-align:left;display:flex;flex-direction:column;gap:4px;min-height:150px;transition:background .3s,transform .4s var(--ease);position:relative;}
.ycard:hover{background:var(--night-2);z-index:1;transform:translateY(-3px);}
.ycard .n{font-size:12.5px;color:var(--ash);}
.ycard h4{font-family:var(--serif);font-weight:500;font-size:16px;line-height:1.5;}
.ycard .s{margin-top:auto;font-size:12.5px;color:var(--ash);}
.ycard.done .s{color:var(--gold);}
.ycard.next{background:var(--gold-soft);}
.ycard.final{background:var(--night-3);}
.ycard.final h4{color:var(--gold);}
@media(max-width:860px){.mdetail{grid-template-columns:1fr;gap:20px;}}

/* ── 参 body ── */
.pipe{display:grid;grid-template-columns:repeat(4,1fr);margin-top:40px;border:1px solid var(--line);}
.step{padding:20px;border-right:1px solid var(--line);transition:background .3s;}
.step:hover{background:var(--night-2);}
.step:last-child{border-right:0;}
.step time{font-size:12.5px;color:var(--ash);}
.step h3{font-family:var(--serif);font-weight:500;font-size:16px;margin-top:4px;}
.step p{font-size:13px;color:var(--bone-2);margin-top:6px;line-height:1.7;}
.step.now{background:var(--gold-soft);}
.step.now h3{color:var(--gold);}
@media(max-width:780px){.pipe{grid-template-columns:1fr 1fr;}.step:nth-child(2){border-right:0;}.step:nth-child(-n+2){border-bottom:1px solid var(--line);}}
.body-row{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:40px;margin-top:32px;}
.spark{border:1px solid var(--line);padding:22px;}
.spark svg{width:100%;height:auto;display:block;}
.spark .ln{stroke-dasharray:1200;stroke-dashoffset:1200;animation:draw 1.6s var(--ease) forwards;}
@keyframes draw{to{stroke-dashoffset:0;}}
.spark-top{display:flex;justify-content:space-between;font-size:13px;color:var(--bone-2);margin-bottom:10px;gap:10px;flex-wrap:wrap;}
.tabs{display:flex;gap:4px;}
.tabs button{font-size:12.5px;padding:2px 10px;border:1px solid var(--line);color:var(--bone-2);transition:all .25s;}
.tabs button:hover{border-color:var(--bone-2);}
.tabs button[aria-pressed="true"]{background:var(--bone);color:var(--night);border-color:var(--bone);}
.metrics div{padding:14px 0;border-bottom:1px solid var(--line);}
.metrics b{font-size:30px;font-weight:300;display:block;line-height:1.1;}
.metrics small{font-size:12.5px;color:var(--ash);}
.demo{font-size:12px;color:var(--ash);margin-top:12px;}
@media(max-width:900px){.body-row{grid-template-columns:1fr;}}

/* ── 肆 works ── */
.strip{display:flex;gap:20px;overflow-x:auto;margin-top:36px;padding:10px 2px 14px;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:var(--ash) transparent;}
.work{flex:0 0 min(380px,82vw);scroll-snap-align:start;background:var(--night-2);border:1px solid var(--line);padding:26px;display:flex;flex-direction:column;min-height:250px;position:relative;overflow:hidden;transition:transform .5s var(--ease),border-color .4s,box-shadow .5s var(--ease);}
.work::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--dc);transform:scaleX(0);transform-origin:left;transition:transform .6s var(--ease);}
.work::after{content:attr(data-k);position:absolute;right:-6px;bottom:-26px;font-family:var(--jp);font-weight:300;font-size:150px;line-height:1;color:var(--dc);opacity:0;transform:translateY(16px);transition:opacity .6s var(--ease),transform .6s var(--ease);pointer-events:none;}
.work:hover{transform:translateY(-6px);border-color:rgba(239,229,214,.2);box-shadow:0 18px 40px -20px rgba(0,0,0,.6);}
.work:hover::before{transform:scaleX(1);}
.work:hover::after{opacity:.1;transform:none;}
.work .meta{display:flex;justify-content:space-between;font-size:12.5px;color:var(--ash);}
.work .meta span:first-child{color:var(--dc);}
.work h3{font-family:var(--serif);font-weight:500;font-size:20px;margin-top:18px;line-height:1.45;}
.work p{font-size:13.5px;color:var(--bone-2);margin-top:8px;}
.work .nums{display:flex;gap:24px;margin-top:auto;padding-top:20px;}
.work .nums b{display:block;font-size:24px;font-weight:300;}
.work .nums small{font-size:11.5px;color:var(--ash);}

/* ── 伍 journal ── */
.filters{display:flex;flex-wrap:wrap;gap:6px;margin-top:28px;}
.chip{font-size:13px;padding:4px 14px;border:1px solid var(--line);color:var(--bone-2);transition:all .25s;}
.chip:hover{border-color:var(--bone-2);color:var(--bone);}
.chip[aria-pressed="true"]{border-color:var(--gold);color:var(--gold);}
.jlist{margin-top:10px;}
.jrow{display:grid;grid-template-columns:96px 36px minmax(0,1fr) 24px;gap:18px;padding:18px 0;border-bottom:1px solid var(--line);align-items:baseline;transition:opacity .4s,padding .4s var(--ease);}
.jrow[hidden]{display:none;}
.jrow time{font-size:13px;color:var(--ash);}
.jrow .k{font-family:var(--jp);font-size:19px;color:var(--dc);width:32px;height:32px;display:grid;place-items:center;border-radius:50%;transition:background .35s,color .35s;}
.jrow h3{font-family:var(--serif);font-weight:500;font-size:17px;transition:color .3s,transform .45s var(--ease);}
.jrow p{font-size:13.5px;color:var(--bone-2);}
.jrow .arrow{color:var(--gold);opacity:0;transform:translateX(-8px);transition:opacity .35s,transform .45s var(--ease);}
.jrow:hover .k{background:var(--dc);color:var(--night);}
.jrow:hover h3{color:var(--gold);transform:translateX(4px);}
.jrow:hover .arrow{opacity:1;transform:none;}
.jempty{padding:20px 0;color:var(--ash);}
@media(max-width:640px){.jrow{grid-template-columns:1fr;gap:2px;}.jrow .arrow{display:none;}}

/* ── 陸 about ── */
.about{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:56px;margin-top:36px;}
.about .q{font-family:var(--serif);font-size:22px;line-height:1.7;}
.about p{color:var(--bone-2);margin-top:14px;max-width:32em;}
.motto-card{margin-top:28px;padding-top:20px;border-top:1px solid var(--line);font-family:var(--serif);font-size:18px;color:var(--bone);}
.motto-card small{display:block;font-family:var(--sans);font-size:13px;color:var(--ash);margin-top:4px;}
.support{background:#EFE5D6;color:#1C0F14;padding:28px;align-self:start;transition:transform .5s var(--ease),box-shadow .5s var(--ease);}
.support:hover{transform:translateY(-4px);box-shadow:0 20px 40px -20px rgba(0,0,0,.6);}
.support h3{font-family:var(--serif);font-weight:500;font-size:18px;}
.support p{font-size:13.5px;color:#5B4B4E;margin-top:8px;}
.support .r{display:flex;align-items:baseline;gap:10px;margin-top:18px;flex-wrap:wrap;}
.support .r b{font-size:30px;font-weight:400;}
.btn-ink{position:relative;overflow:hidden;margin-left:auto;background:#1C0F14;color:#EFE5D6;padding:10px 20px;font-size:13.5px;transition:background .3s;}
.btn-ink::after{content:'';position:absolute;top:0;left:-60%;width:40%;height:100%;background:linear-gradient(100deg,transparent,rgba(212,162,76,.35),transparent);transform:skewX(-20deg);transition:left .7s var(--ease);}
.btn-ink:hover{background:#3D0F1A;}
.btn-ink:hover::after{left:120%;}
@media(max-width:900px){.about{grid-template-columns:1fr;}}
</style>

<section class="hero" aria-labelledby="motto">
  <canvas id="art" aria-hidden="true"></canvas>
  <div class="hero-in">
    <div class="hero-grid">
      <div>
        <h1 class="motto rv" id="motto" style="--i:0"><span>{copy.motto_line1}</span><span class="l2">{copy.motto_line2}</span></h1>
        <p class="hero-lede rv" style="--i:2">{copy.hero_lede}</p>
        <div class="cd rv" style="--i:3"><small>{copy.countdown_label}</small><span class="cd-days num" id="cdD">—</span><small>天</small><span class="cd-clock num" id="cdC">00:00:<b>00</b></span></div>
        <a class="next-rel rv" style="--i:4" href="#chapters" id="nextRel">&nbsp;</a>
      </div>
    </div>
  </div>
</section>

<section class="sec band-light" id="five" aria-labelledby="five-h">
  <div class="sec-grid">
    <div class="side" aria-hidden="true"><span class="sn">壱</span><span class="sl"></span><span class="se">Directions</span></div>
    <div>
      <div class="sec-head"><p class="sub rv">{copy.five_sub}</p><h2 id="five-h" class="rv" style="--i:1">{copy.five_title}</h2></div>
      <div class="dirs">
        <div class="penta rv" style="--i:2">
          <svg id="penta" viewBox="-190 -190 380 380" role="img" aria-label="五個方向的累積雷達圖">
            {rings.map((r) => <polygon points={r} fill="none" style="stroke:var(--line)" />)}
            {pillars.map((_, i) => { const [x, y] = pt(i, 1); return <line x1="0" y1="0" x2={x.toFixed(1)} y2={y.toFixed(1)} style="stroke:var(--line)" />; })}
            <g class="grow"><polygon class="shape" points={shape} />
              {pillars.map((p, i) => { const [x, y] = pt(i, val(p.slug)); return <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="4.5" style={`fill:var(--c-${p.slug})`} />; })}</g>
            {pillars.map((p, i) => { const [x, y] = pt(i, 1.2); return <text class="axis" data-i={i} x={x.toFixed(1)} y={(y + 7).toFixed(1)} text-anchor="middle">{p.kanji}</text>; })}
          </svg>
        </div>
        <div>
          <div class="idx" role="tablist" aria-label="五個方向" id="idx">
            {pillars.map((p, i) => (
              <button role="tab" id={`tab-${p.slug}`} aria-controls={`panel-${p.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} style={`--dc:var(--c-${p.slug})`} class="rv" data-i={i}>
                <span class="k" style={`view-transition-name:k-${p.slug}`}>{p.kanji}</span><span class="n">{p.type}<small>{p.title}・{counts[p.slug]} 篇</small></span>
                <span class="bar" aria-hidden="true"><i style={`width:${Math.min(100, (counts[p.slug] / MAX) * 100)}%`}></i></span><span class="dan">{dan(counts[p.slug])}</span>
              </button>
            ))}
          </div>
          {pillars.map((p, i) => {
            const es = all.filter((a) => a.dir === p.slug).slice(0, 3);
            return (
              <div class="detail" role="tabpanel" id={`panel-${p.slug}`} aria-labelledby={`tab-${p.slug}`} hidden={i !== 0} style={`--dc:var(--c-${p.slug})`}>
                <div class="big" aria-hidden="true">{p.kanji}</div>
                <h3>{p.title}</h3><p class="jp" lang="ja">{p.titleJp}</p><p class="d">{p.desc}</p>
                <div class="es">{es.map((a) => <a href={`/pillars/${p.slug}/${a.e.slug}`}><time>{dot(a.e.data.date)}</time><span>{a.e.data.title}</span></a>)}<a href={`/pillars/${p.slug}`}><time></time><span>看「{p.type}」全部文章</span></a></div>
              </div>
            );
          })}
          <p class="dir-note">段位：10 篇初段、30 篇二段、60 篇三段、100 篇四段。</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sec band-wine" id="chapters" aria-labelledby="ch-h">
  <div class="sec-grid">
    <div class="side" aria-hidden="true"><span class="sn">弐</span><span class="sl"></span><span class="se">Chapters</span></div>
    <div>
      <div class="sec-head"><p class="sub rv">{copy.chapters_sub}</p><h2 id="ch-h" class="rv" style="--i:1">{copy.chapters_title}</h2></div>
      <div class="mv-toggle rv" style="--i:2" role="group" aria-label="切換檢視"><button aria-pressed="true" data-v="one">單話</button><button aria-pressed="false" data-v="toc">第一卷目次</button></div>
      <div id="vOne"><div class="track-wrap rv" style="--i:3"><ol class="track" id="track" aria-label="連載時間軸"></ol></div><div class="mdetail" id="mdetail" aria-live="polite"></div></div>
      <div id="vToc" hidden><div class="ygrid" id="ygrid"></div></div>
    </div>
  </div>
</section>

<section class="sec band-light" id="body" aria-labelledby="body-h">
  <div class="sec-grid">
    <div class="side" aria-hidden="true"><span class="sn">参</span><span class="sl"></span><span class="se">Body</span></div>
    <div>
      <div class="sec-head"><p class="sub rv">{copy.body_sub}</p><h2 id="body-h" class="rv" style="--i:1">{copy.body_title}</h2></div>
      <div class="pipe" role="list">
        <div class="step rv" style="--i:2" role="listitem"><time>06:00</time><h3>收進資料</h3><p>Apple Health 把 Strava 運動和 OMRON 體組成一起送來。</p></div>
        <div class="step rv" style="--i:3" role="listitem"><time>06:02</time><h3>寫成草稿</h3><p>整理成本週訓練、體脂趨勢、一段觀察。</p></div>
        <div class="step now rv" style="--i:4" role="listitem"><time>每天</time><h3>等巴確認</h3><p>在後台看過、改過，才決定公開哪些數字。</p></div>
        <div class="step rv" style="--i:5" role="listitem"><time>確認後</time><h3>公開發布</h3><p>文章進「強化」，帳上這一天被填上。</p></div>
      </div>
      <div class="body-row">
        <div class="spark rv" style="--i:3">
          <div class="spark-top"><span id="sparkLabel"></span><div class="tabs" role="group" aria-label="切換指標"><button aria-pressed="true" data-m="mins">訓練</button><button aria-pressed="false" data-m="fat">體脂</button><button aria-pressed="false" data-m="weight">體重</button></div></div>
          <svg id="spark" viewBox="0 0 600 180" role="img" aria-label="近 12 週身體指標趨勢"></svg>
        </div>
        <div class="metrics rv" style="--i:4">
          <div><b class="num">{body.stats.week_minutes}</b><small>本週訓練分鐘</small></div>
          <div><b class="num">{body.stats.fat_change}</b><small>體脂 12 週變化（百分點）</small></div>
          <div><b class="num">{body.stats.streak}</b><small>連續紀錄天數</small></div>
          {body.sample && <p class="demo">{body.note}</p>}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sec" id="works" aria-labelledby="works-h">
  <div class="sec-grid">
    <div class="side" aria-hidden="true"><span class="sn">肆</span><span class="sl"></span><span class="se">Works</span></div>
    <div>
      <div class="sec-head"><p class="sub rv">{copy.works_sub}</p><h2 id="works-h" class="rv" style="--i:1">{copy.works_title}</h2></div>
      <div class="strip" tabindex="0" aria-label="成果列表，可左右捲動">
        {worksData.works.map((w, i) => { const p = pillars.find((x) => x.slug === w.dir)!; return (
          <article class="work rv" style={`--i:${i + 2};--dc:var(--c-${w.dir})`} data-k={p.kanji}><div class="meta"><span>{p.type}</span><span>{w.date}</span></div><h3>{w.title}</h3><p>{w.desc}</p><div class="nums"><div><b class="num">{w.spent}</b><small>花費小時</small></div><div><b class="num">{w.saved}</b><small>每月省下</small></div></div></article>
        ); })}
      </div>
    </div>
  </div>
</section>

<section class="sec band-light" id="journal" aria-labelledby="j-h">
  <div class="sec-grid">
    <div class="side" aria-hidden="true"><span class="sn">伍</span><span class="sl"></span><span class="se">Journal</span></div>
    <div>
      <div class="sec-head"><p class="sub rv">{copy.journal_sub}</p><h2 id="j-h" class="rv" style="--i:1">{copy.journal_title}</h2></div>
      <div class="filters rv" style="--i:2" id="filters" role="group" aria-label="依方向篩選">
        <button class="chip" data-f="all" aria-pressed="true">全部</button>
        {pillars.map((p) => <button class="chip" data-f={p.slug} aria-pressed="false">{p.type}</button>)}
      </div>
      <div class="jlist" id="jlist">
        {journal.map((a, i) => { const p = pillars.find((x) => x.slug === a.dir)!; return (
          <a class="jrow rv" style={`--i:${Math.min(i, 6) + 3};--dc:var(--c-${a.dir})`} data-dir={a.dir} href={`/pillars/${a.dir}/${a.e.slug}`}>
            <time>{dot(a.e.data.date)}</time><span class="k" title={p.type}>{p.kanji}</span>
            <div><h3>{a.e.data.title}</h3>{a.e.data.excerpt && <p>{a.e.data.excerpt}</p>}</div><span class="arrow" aria-hidden="true">→</span>
          </a>
        ); })}
        <p class="jempty" id="jempty" hidden>這個方向還沒有文章。</p>
      </div>
    </div>
  </div>
</section>

<section class="sec band-wine" id="about" aria-labelledby="a-h">
  <div class="sec-grid">
    <div class="side" aria-hidden="true"><span class="sn">陸</span><span class="sl"></span><span class="se">About</span></div>
    <div>
      <div class="sec-head"><p class="sub rv">{copy.about_meta}</p><h2 id="a-h" class="rv" style="--i:1">{copy.about_name}</h2></div>
      <div class="about">
        <div>
          <p class="q rv" style="--i:2">{copy.about_lede}</p>
          <p class="rv" style="--i:3">{copy.about_p1}</p>
          <p class="rv" style="--i:4">{copy.about_p2}</p>
          <p class="motto-card rv" style="--i:5">{copy.motto_line1}{copy.motto_line2}<small lang="ja">したことは残す。済んだことは手放す。</small></p>
        </div>
        <aside class="support rv" style="--i:4" id="support">
          <h3>{copy.subscribe_title}</h3><p>{copy.subscribe_desc}</p>
          <div class="r"><b>{copy.subscribe_price}</b><span>／月</span><a class="btn-ink" href={copy.subscribe_url} target="_blank" rel="noopener">前往 Stripe 訂閱</a></div>
        </aside>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="page-data" set:html={json}></script>

<script is:inline>
(function(){
var D=JSON.parse(document.getElementById('page-data').textContent);
var RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
var DAY=864e5,pad=function(n){return String(n).padStart(2,'0');};
var START=new Date(D.start).getTime(),TARGET=new Date(D.target).getTime();
var jst=function(t){return new Date(t+9*3600e3).toISOString().slice(0,10);};
var dirOf=function(id){for(var i=0;i<D.dirs.length;i++)if(D.dirs[i].id===id)return D.dirs[i];return D.dirs[0];};
var col=function(id){return 'var(--c-'+id+')';};
var hero=document.querySelector('.hero');
requestAnimationFrame(function(){requestAnimationFrame(function(){hero.classList.add('in');hero.querySelectorAll('.rv').forEach(function(r){r.classList.add('in');});});});

/* countdown — the seconds digit rolls in each tick */
(function(){var d=document.getElementById('cdD'),c=document.getElementById('cdC');
  function t(){var r=Math.max(0,TARGET-Date.now());d.textContent=Math.floor(r/DAY);
    c.innerHTML=pad(Math.floor(r%DAY/36e5))+':'+pad(Math.floor(r%36e5/6e4))+':<b class="'+(RM?'':'tick')+'">'+pad(Math.floor(r%6e4/1e3))+'</b>';}
  t();setInterval(t,1000);})();

/* age rings: one ring a year, current ring drawn to the fraction of the year */
(function(){var cv=document.getElementById('art');if(!cv)return;var ctx=cv.getContext('2d'),W,H,dpr,run=true,last=performance.now(),t=0,raf;
  var b=D.birth.split('-').map(Number),bd=function(y){return new Date(y+'-'+pad(b[1])+'-'+pad(b[2])+'T00:00:00+09:00').getTime();};
  var now=Date.now(),y=new Date(now+9*3600e3).getUTCFullYear();if(bd(y)>now)y--;
  var full=y-b[0],frac=(now-bd(y))/(bd(y+1)-bd(y)),total=Math.max(40,full+1);
  var rnd=function(a,c){return a+Math.random()*(c-a);},seed=[rnd(0,6.28),rnd(0,6.28),rnd(0,6.28)],acc=0,rr=[0];
  for(var i=1;i<=total;i++){acc+=rnd(.75,1.3);rr.push(acc);}
  function rs(){dpr=Math.min(devicePixelRatio||1,2);var r=cv.parentElement.getBoundingClientRect();W=cv.width=r.width*dpr;H=cv.height=r.height*dpr;}
  rs();addEventListener('resize',rs);
  var wide=function(){return W>900*dpr;},cx=function(){return W*(wide()?.66:.55);},cy=function(){return H*(wide()?.52:.74);},mn=function(){return Math.min(W,H)*(wide()?1:1.2);};
  function shape(i,a){var f=rr[i]/acc;return mn()*(.02+f*.34)*(1+.045*Math.sin(a*3+seed[0])+.028*Math.sin(a*5+seed[1]+f*2.2)+.014*Math.sin(a*11+seed[2]+f*4));}
  function ring(i,p,rot){var N=180;ctx.beginPath();for(var j=0;j<=N*p;j++){var a=-Math.PI/2+j/N*Math.PI*2+rot,r=shape(i,a),x=cx()+Math.cos(a)*r,yy=cy()+Math.sin(a)*r;j?ctx.lineTo(x,yy):ctx.moveTo(x,yy);}ctx.stroke();}
  function frame(dt){t+=dt;ctx.clearRect(0,0,W,H);var rot=t*.006,g=Math.min(1,t/5);
    for(var i=1;i<=full;i++){var f=i/full;ctx.strokeStyle='rgba(212,162,76,'+(.06+.26*f*f).toFixed(3)+')';ctx.lineWidth=(.7+.4*f)*dpr;ring(i,Math.min(1,g*1.4),rot);}
    ctx.strokeStyle='rgba(236,196,118,.9)';ctx.lineWidth=1.7*dpr;ctx.shadowColor='rgba(212,162,76,.6)';ctx.shadowBlur=(6+3*Math.sin(t*1.3))*dpr;ring(full+1,frac*g,rot);ctx.shadowBlur=0;
    ctx.setLineDash([2*dpr,7*dpr]);ctx.strokeStyle='rgba(239,229,214,.22)';ctx.lineWidth=dpr;for(var k=full+2;k<=total;k++)ring(k,1,rot);ctx.setLineDash([]);
    if(g>.98)tip(-Math.PI/2+frac*Math.PI*2+rot);}
  function tip(a){var r=shape(full+1,a),x=cx()+Math.cos(a)*r,yy=cy()+Math.sin(a)*r;
    for(var k=0;k<3;k++){var ph=((t*.55)+k/3)%1;ctx.beginPath();ctx.arc(x,yy,(4+ph*28)*dpr,0,Math.PI*2);ctx.strokeStyle='rgba(236,196,118,'+((1-ph)*.55).toFixed(3)+')';ctx.lineWidth=dpr;ctx.stroke();}
    ctx.beginPath();ctx.arc(x,yy,3.6*dpr,0,Math.PI*2);ctx.fillStyle='rgb(236,196,118)';ctx.shadowColor='rgba(212,162,76,.9)';ctx.shadowBlur=8*dpr;ctx.fill();ctx.shadowBlur=0;
    if(!wide())return;
    var ox=Math.cos(a),oy=Math.sin(a),x1=x+ox*12*dpr,y1=yy+oy*12*dpr,x2=x+ox*38*dpr,y2=yy+oy*38*dpr;
    ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.strokeStyle='rgba(239,229,214,.5)';ctx.lineWidth=dpr;ctx.stroke();
    var age=(full+(Date.now()-bd(y))/(bd(y+1)-bd(y))).toFixed(5);
    ctx.font=(12*dpr)+'px "Noto Sans TC",system-ui,sans-serif';ctx.fillStyle='rgba(239,229,214,.88)';ctx.textAlign=ox>=0?'left':'right';ctx.textBaseline='middle';
    ctx.fillText('今　'+age+' 歲',x2+(ox>=0?6:-6)*dpr,y2);}
  function loop(ts){if(!run)return;var dt=Math.min(.05,(ts-last)/1e3);last=ts;frame(dt);raf=requestAnimationFrame(loop);}
  if(RM){t=6;frame(0);return;}
  raf=requestAnimationFrame(loop);
  new IntersectionObserver(function(es){es.forEach(function(e){run=e.isIntersecting;if(run){last=performance.now();cancelAnimationFrame(raf);raf=requestAnimationFrame(loop);}});},{threshold:.05}).observe(cv.parentElement);})();

/* five directions: index + pentagon share one selection, arrow keys loop */
(function(){var I=document.getElementById('idx'),tabs=[].slice.call(I.querySelectorAll('[role=tab]')),S=document.getElementById('penta');
  function sel(i,focus){i=(i+tabs.length)%tabs.length;tabs.forEach(function(t,j){t.setAttribute('aria-selected',j===i);t.tabIndex=j===i?0:-1;document.getElementById(t.getAttribute('aria-controls')).hidden=j!==i;});
    if(focus)tabs[i].focus();S.querySelectorAll('.axis').forEach(function(a,j){a.classList.toggle('on',j===i);});}
  tabs.forEach(function(t,i){t.addEventListener('click',function(){sel(i);});});
  I.addEventListener('keydown',function(e){var i=tabs.indexOf(document.activeElement);if(e.key==='ArrowDown'||e.key==='ArrowRight'){e.preventDefault();sel(i+1,true);}if(e.key==='ArrowUp'||e.key==='ArrowLeft'){e.preventDefault();sel(i-1,true);}});
  S.addEventListener('click',function(e){var a=e.target.closest('.axis');if(a)sel(+a.dataset.i);});
  sel(0);})();

/* 連載: 第 0 話 … 第 11 話 → 第一卷 */
(function(){var C=D.chapters,now=Date.now(),T=function(d){return new Date(d+'T00:00:00+09:00').getTime();};
  var list=C.chapters.map(function(c){return Object.assign({},c);});list.push(Object.assign({final:true,no:12},C.volume));
  var nextIdx=list.findIndex(function(r){return T(r.date)>=now;});if(nextIdx<0)nextIdx=list.length;
  list.forEach(function(r,i){r.days=Math.floor((T(r.date)-now)/DAY);r.state=i<nextIdx?(r.on_break?'break':'done'):i===nextIdx?'next':'future';
    var a=(C.arcs||[]).filter(function(a){return !r.final&&r.no>=a.from&&r.no<=a.to;})[0];r.arc=a?a.name:'';});
  var md=function(r){return (+r.date.slice(5,7))+'.'+r.date.slice(8);},label=function(r){return r.final?'第一卷':'第 '+r.no+' 話';};
  var esc=function(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;');};
  var nr=list[Math.min(nextIdx,list.length-1)];
  document.getElementById('nextRel').innerHTML=(nr.no===0?'新連載・':'連載中・')+label(nr)+'・'+(+nr.date.slice(5,7))+' 月 '+(+nr.date.slice(8))+' 日刊出 <b>'+(nr.days<=0?'今天':nr.days+' 天後')+'</b>';
  var Tr=document.getElementById('track'),Md=document.getElementById('mdetail');
  Tr.innerHTML=list.map(function(r,i){return '<li><button class="node '+r.state+(r.final?' final':'')+'" data-i="'+i+'" aria-label="'+label(r)+'，'+md(r)+'"><span class="dot">'+(r.final?'巻':'')+'</span><span class="r">'+label(r)+'</span><span class="d">'+md(r)+'</span></button></li>';}).join('')
    +'<span class="fill" style="width:calc((100% - 64px) * '+Math.max(0,nextIdx-.5)/(list.length-1)+')"></span>';
  function items(arr,withDir){return '<ul>'+arr.map(function(x){var d=withDir&&x.dir?dirOf(x.dir):null;return '<li'+(d?' style="--dc:'+col(d.id)+'"':'')+'><span class="k">'+(d?d.k:'・')+'</span><span>'+esc(x.text||x)+'</span></li>';}).join('')+'</ul>';}
  function show(i){var r=list[i];Tr.querySelectorAll('.node').forEach(function(n){n.setAttribute('aria-current',+n.dataset.i===i);});
    var st={done:'<b>已刊出</b>',break:'<b>休載</b>',next:'<b>製作中</b>還有 '+r.days+' 天',future:'還有 '+r.days+' 天'}[r.state]+(r.arc?'・'+r.arc:'');
    var b='';
    if(r.state==='done'||r.state==='break'){b+=r.summary?'<p>'+esc(r.summary)+'</p>':'';b+=(r.keep&&r.keep.length)?'<h4>這一話留下的</h4>'+items(r.keep):'';b+=(r.letgo&&r.letgo.length)?'<h4>這一話放下的</h4>'+items(r.letgo):'';if(!b)b='<p>'+(r.state==='break'?'這個月休載。':'這一話的內容整理中。')+'</p>';}
    else if(r.final)b='<p>'+esc(r.summary)+'</p>';
    else if(r.plan&&r.plan.length)b='<p>這一話預計刊出的內容：</p>'+items(r.plan,true);
    else b='<p>這一話還在畫分鏡，刊出當天公開。</p>';
    var from=i>0?list[i-1].date:D.start.slice(0,10),inRange=function(e){return (i>0?e.date>from:e.date>=from)&&e.date<=r.date;};
    var es=D.entries.filter(inRange),total=es.length,showT=!r.final&&(r.state!=='future');
    var tally=showT?'<p class="tally-h">'+(r.state==='next'?'這一話目前累積':'這一話累積')+'<span>'+from.slice(5).replace('-','.')+' – '+md(r)+'</span></p><div class="tally">'+D.dirs.map(function(d){var n=es.filter(function(e){return e.dir===d.id;}).length;return '<div class="'+(n?'':'zero')+'" style="--dc:'+col(d.id)+'"><span class="k">'+d.k+'</span><b>'+n+'</b><small>'+d.n+'</small></div>';}).join('')+'</div>':'';
    Md.innerHTML='<div><p class="tag">'+st+'・'+r.date.replace(/-/g,'.')+'</p><h3>'+label(r)+'　'+esc(r.title)+'</h3>'+b+tally+'</div><div class="mnums"><div><b>'+(showT?total:'—')+'</b><small>'+(r.state==='next'?'這一話目前的文章':'這一話的文章')+'</small></div><div><b>—</b><small>這一話的訓練分鐘</small></div><div><b>—</b><small>這一話完成的成果</small></div></div>';}
  Tr.addEventListener('click',function(e){var n=e.target.closest('.node');if(n)show(+n.dataset.i);});
  show(Math.min(nextIdx,list.length-1));
  requestAnimationFrame(function(){var w=Tr.parentElement,n=Tr.querySelector('.node.next');if(n)w.scrollLeft=Math.max(0,n.offsetLeft-80);});
  var Y=document.getElementById('ygrid');
  Y.innerHTML=list.map(function(r,i){var s={done:'已刊出',break:'休載',next:'製作中・'+r.days+' 天後',future:r.days+' 天後'}[r.state];return '<button class="ycard '+r.state+(r.final?' final':'')+'" data-i="'+i+'"><span class="n">'+label(r)+'・'+md(r)+(r.arc?'・'+r.arc:'')+'</span><h4>'+esc(r.title)+'</h4><span class="s">'+s+'</span></button>';}).join('');
  var MV=document.querySelector('.mv-toggle'),V1=document.getElementById('vOne'),V2=document.getElementById('vToc');
  function view(v){MV.querySelectorAll('button').forEach(function(b){b.setAttribute('aria-pressed',b.dataset.v===v);});V1.hidden=v!=='one';V2.hidden=v!=='toc';}
  MV.addEventListener('click',function(e){var b=e.target.closest('button');if(b)view(b.dataset.v);});
  Y.addEventListener('click',function(e){var c=e.target.closest('.ycard');if(c){view('one');show(+c.dataset.i);}});})();

/* body spark: the line draws itself when shown */
(function(){var data={mins:['近 12 週・每週訓練分鐘',D.body.weeks.mins],fat:['近 12 週・體脂（%）',D.body.weeks.fat],weight:['近 12 週・體重（kg）',D.body.weeks.weight]};
  var S=document.getElementById('spark'),L=document.getElementById('sparkLabel');
  function draw(k){var v=data[k][1],mn=Math.min.apply(0,v),mx=Math.max.apply(0,v),W=600,H=180,p=16,st=(W-p*2)/(v.length-1);
    var y=function(x){return H-p-(x-mn)/((mx-mn)||1)*(H-p*2);},pts=v.map(function(x,i){return (p+i*st)+','+y(x);}).join(' ');
    S.innerHTML='<polygon points="'+p+','+(H-p)+' '+pts+' '+(W-p)+','+(H-p)+'" style="fill:var(--gold-soft)"/><polyline class="ln" points="'+pts+'" fill="none" style="stroke:var(--gold)" stroke-width="2"/><circle cx="'+(W-p)+'" cy="'+y(v[v.length-1])+'" r="4.5" style="fill:var(--gold)"/><text x="'+(W-p)+'" y="'+(y(v[v.length-1])-12)+'" text-anchor="end" style="fill:var(--bone)" font-size="13">'+v[v.length-1]+'</text>';L.textContent=data[k][0];}
  document.querySelector('.tabs').addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;document.querySelectorAll('.tabs button').forEach(function(x){x.setAttribute('aria-pressed',x===b);});draw(b.dataset.m);});
  var sec=document.getElementById('body'),drawn=false;new IntersectionObserver(function(es,o){if(es[0].isIntersecting&&!drawn){drawn=true;draw('mins');o.disconnect();}},{threshold:.2}).observe(sec);})();

/* journal filter */
(function(){var F=document.getElementById('filters'),rows=[].slice.call(document.querySelectorAll('.jrow')),E=document.getElementById('jempty');
  F.addEventListener('click',function(e){var b=e.target.closest('.chip');if(!b)return;var f=b.dataset.f,n=0;
    F.querySelectorAll('.chip').forEach(function(c){c.setAttribute('aria-pressed',c===b);});
    rows.forEach(function(r){var on=f==='all'||r.dataset.dir===f;r.hidden=!on;if(on)n++;});E.hidden=n>0;});})();
})();
</script>
</BaseLayout>
