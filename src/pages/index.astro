---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pillars } from '../data/pillars';
import copy from '../data/site-copy.json';
import chapters from '../data/chapters.json';
import worksData from '../data/works.json';
import { safeImg } from '../data/work-utils';
import dreams from '../data/dreams.json';
import services from '../data/services.json';
import { buildRing } from '../data/ring';
import { allEntries, SHOW_DRAFTS } from '../data/journal';
import { workColor, colorVars } from '../data/work-colors';
const endRing = buildRing(copy.birth_date);
// 結尾區塊的文字：都可以在 Studio「首頁文案 → 結尾」修改；沒填就用這裡的預設
const C0: Record<string, string> = {
  end_cd_before: '第 {n} 圈，還有', end_cd_after: '長完這一圈',
  subscribe_unit: '', pay1_name: '', pay1_sub: '', pay1_amt: '', pay1_url: '', pay2_name: '', pay2_sub: '', pay2_amt: '', pay2_url: '', pay3_name: '', pay3_sub: '', pay3_amt: '', pay3_url: '', subscribe_btn: 'Stripe 支持澆個水', subscribe_note: '單次支持・金額由你決定',
  tw_bank_on: 'on', tw_bank_msg: '轉好了之後，我會用您留下的聯絡方式與您聯繫。', tw_bank_sub: '留下稱呼，就能看到轉帳帳號',
  tw_show: 'on', tw_text: '在台灣？也可以轉帳**單筆支持**。',
  tw_link: '請我喝杯咖啡・私訊 @{ig}',
  give_show: 'on', give_rate: '8', give_org: 'Civic Force', give_url: '', give_tw_org: '', give_tw_url: '', give_next: '',
  give_text: '',
  give_use: 'AI 線上工具訂閱 38\n網站經營 20\n日本景點考察 20\n請我喝咖啡＋健康餐 14', give_month: '', give_received: '', give_donated: '', give_total: '', tw_note: '轉帳資訊只由 @{ig} 回覆，其他帳號請忽略。',
};
const C: Record<string, string> = Object.fromEntries(Object.keys(C0).map((k) => [k, (copy as any)[k] != null ? String((copy as any)[k]) : C0[k]]));
const endBefore = (C.end_cd_before.includes('{n}') ? C.end_cd_before.split('{n}') : [C.end_cd_before + ' ', '']).slice(0, 2);
// 連載區的五角儀表板：首頁先拿掉（段位改顯示在「日常紀錄」頁的分類按鈕上），改回 true 就會重新出現
const SHOW_PENTA = false;
// 實績數字（三格）暫時隱藏：資料與 Studio 都保留，改回 true 就會重新出現
const SHOW_PROOF = false;

const all = await allEntries();
const ymd = (d: Date) => d.toISOString().slice(0, 10);
const dot = (d: Date) => ymd(d).replaceAll('-', '.');
const counts = Object.fromEntries(pillars.map((p) => [p.slug, all.filter((a) => a.dir === p.slug).length]));
const prog = (c: number) => { const T = [0, 10, 30, 60, 100]; if (c >= 100) return 100; const k = T.findIndex((t) => c < t); return Math.round(((c - T[k - 1]) / (T[k] - T[k - 1])) * 100); };
const dan = (c: number) => (c >= 100 ? '四段' : c >= 60 ? '三段' : c >= 30 ? '二段' : c >= 10 ? '初段' : '見習');
const MAX = 30;

// pentagon geometry (viewBox centered on 0,0)
const R = 150;
const pt = (i: number, v: number) => { const a = -Math.PI / 2 + (i * 2 * Math.PI) / 5; return [Math.cos(a) * R * v, Math.sin(a) * R * v]; };
// the shape shows balance between directions, so it is scaled to the largest one
const top = Math.max(1, ...Object.values(counts) as number[]);
const val = (s: string) => 0.15 + (counts[s] / top) * 0.85;
const shape = pillars.map((p, i) => pt(i, val(p.slug)).map((n) => n.toFixed(1)).join(',')).join(' ');
const rings = [0.25, 0.5, 0.75, 1].map((l) => pillars.map((_, i) => pt(i, l).map((n) => n.toFixed(1)).join(',')).join(' '));

// 首頁只放最新 6 篇；篩選某個方向時顯示該方向最新 4 篇，其餘到 /journal/ 看
const HOME_N = 6, PER_DIR = 4;
const topSet = new Set(all.slice(0, HOME_N));
const dirSet = new Set(pillars.flatMap((p) => all.filter((a) => a.dir === p.slug).slice(0, PER_DIR)));
const journal = all.filter((a) => topSet.has(a) || dirSet.has(a)).map((a) => ({ ...a, top: topSet.has(a) }));
const escH = (x: string) => String(x ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as any)[c]);
// 直排時，兩位以內的數字或英文字母橫躺排成一格（縦中横）
const tcy = (x: string) => escH(x).replace(/(?<![0-9A-Za-z])([0-9A-Za-z]{1,2})(?![0-9A-Za-z])/g, '<span class="tcy">$1</span>');
const fortieth = (() => { const b = String((copy as any).birth_date || '1987-10-02').split('-'); return `${+b[0] + 40}.${b[1]}.${b[2]}`; })();
const kanjiYear = String(new Date().getFullYear()).split('').map((c) => '〇一二三四五六七八九'[+c]).join('');
const igHandle = String((copy as any).instagram_handle || '').replace(/^@/, '').trim();
const igUrl = /^[A-Za-z0-9._]{1,30}$/.test(igHandle) ? `https://ig.me/m/${igHandle}` : '';
const fillIg = (x: string) => String(x || '').replaceAll('{ig}', igHandle);
const givePct = Math.min(100, Math.max(0, Number(C.give_rate) || 0));
const SHADES = ['#1C0F14', '#3B2229', '#5C3D44', '#806268', '#A6898E', '#C2AAAE'];
const flow = C.give_use.split(/\n|・/).map((l) => l.trim()).filter(Boolean).map((l) => { const m = l.match(/^(.*?)[\s:：]*([\d.]+)\s*%?$/); return m ? { name: m[1].trim(), pct: Number(m[2]) } : { name: l, pct: 0 }; });
const useSum = flow.reduce((t, x) => t + x.pct, 0);
if (!useSum && flow.length) flow.forEach((x) => (x.pct = Math.round((100 - givePct) / flow.length)));
const flowAll = [...flow.map((x, i) => ({ ...x, c: SHADES[Math.min(i, SHADES.length - 1)], dark: i < 3 })), { name: "善的循環：台日災害救援單位捐贈", pct: givePct, c: '#8A2B3D', dark: true, give: true }];
const giveHtml = escH(C.give_text.replaceAll('{rate}', C.give_rate).replaceAll('{org}', C.give_org)).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
/* 台灣轉帳：帳號不在網站裡；訪客留下稱呼＋聯絡方式後，才由 Supabase（tw-bank）回傳 */
const bankOn = C.tw_bank_on !== 'off';
const twHtml = escH(C.tw_text).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
const aboutPhoto = /^\/(about|works)\/[\w./-]+\.(webp|png|jpe?g)$/i.test(String((copy as any).about_photo || '')) ? (copy as any).about_photo : '';
const pageData = {
  dirs: pillars.map((p) => ({ id: p.slug, k: p.kanji, n: p.type })),
  entries: all.map((a) => ({ date: ymd(a.e.data.date), dir: a.dir, t: a.e.data.title, url: `/pillars/${a.dir}/${a.e.slug}` })),
  chapters,
  totals: counts,
  start: copy.countdown_start, target: copy.countdown_target, birth: copy.birth_date, ringLabel: copy.ring_label,
};
const safeHref = (u: string) => (/^(\/(?!\/)|https:\/\/)/.test(u || '') ? u : '');
const payTiers = [1, 2, 3].map((n) => ({ name: C[`pay${n}_name`], sub: C[`pay${n}_sub`], amt: C[`pay${n}_amt`], url: safeHref(C[`pay${n}_url`]) })).filter((t) => t.name && t.url);
const stays = (services.stays as any[]).filter((st) => /^https:\/\/(www\.)?airbnb\.[a-z.]+\//i.test(st.url || '') && st.name).map((st) => ({ ...st, img: /^https:\/\//.test(st.img || '') ? st.img : '' }));
// 服務卡燈箱：每張卡對應哪幾張服務內容（樣品）、每張卡的色調（與 .hats .hat:nth-child 一致）
const HAT_SVC: Record<string, string[]> = { '築': ['property', 'owner'], '旅': ['omakase'] };
const svcById: Record<string, any> = Object.fromEntries((services.services as any[]).map((x) => [x.id, x]));
// 祈願所：「我可以幫忙」連到需求填表，並帶入是哪個願望、需要什麼
// 祈願所：四種燈籠（Goal／Habit／Fun／Idea），不用百分比，亮度由「階段」決定
const WISH_KINDS: Record<string, string> = { goal: 'Goal', fun: 'Fun', idea: 'Idea' };
const WISH_ST: Record<string, Record<string, [string, number]>> = {
  goal: { idea: ['規劃中', 0], doing: ['進行中', 0.7], done: ['已完成', 1] },
  idea: { idea: ['規劃中', 0], test: ['進行中', 0.55], build: ['進行中', 0.8], done: ['已完成', 1] },
  fun: { idea: ['規劃中', 0], doing: ['進行中', 0.7], done: ['已完成', 1] },
};
const wishView = (d: any) => {
  const legacyHabit = d.kind === 'habit'; // 舊的 Habit 併入 Fun
  const kind = legacyHabit ? 'fun' : (WISH_KINDS[d.kind] ? d.kind : 'goal');
  const t = WISH_ST[kind][legacyHabit && (!d.state || d.state === 'idea') ? 'doing' : d.state] || WISH_ST[kind].idea;
  const n = Number(d.count); const has = kind === 'fun' && d.count !== '' && d.count != null && Number.isFinite(n) && n > 0;
  return { kind, label: WISH_KINDS[kind], st: t[0] + (has ? `・累積 ${n} ${String(d.unit || '次').slice(0, 4)}` : ''), g: t[1], lit: t[1] > 0, stamp: d.state === 'done' ? (kind === 'fun' ? '趣' : '叶') : '' };
};
const wishHelpHref = (d: any) => `/chat/?from=wish&about=${encodeURIComponent(String(d.title || ''))}&help=${encodeURIComponent(String(d.help || ''))}`;
const wishDate = (u: any) => { const m = /^\d{4}-(\d{2})-(\d{2})$/.exec(String(u || '')); return m ? `${+m[1]}/${+m[2]}` : ''; };
const HAT_COL = [['196,86,107', '236,160,176'], ['212,162,76', '243,217,160'], ['214,196,172', '245,234,218']];
const json = JSON.stringify(pageData).replace(/</g, '\\u003c');
---
<BaseLayout>
<style is:global>
/* ── hero ── */
.hero{position:relative;min-height:100vh;min-height:100svh;overflow:hidden;display:flex;align-items:center;background:radial-gradient(120% 80% at 70% 40%,#2A1520 0%,#1C0F14 60%);color:#EFE5D6;}
#art{position:absolute;inset:0;width:100%;height:100%;}
.hero-in{position:relative;z-index:2;width:100%;max-width:1240px;margin:0 auto;padding:110px 40px 26vh;}
.hero-grid{max-width:780px;margin:0 auto;text-align:center;position:relative;}
.hero-grid::before{content:'';position:absolute;left:50%;top:50%;width:130%;height:150%;transform:translate(-50%,-50%);background:radial-gradient(closest-side,rgba(28,15,20,.62),rgba(28,15,20,0));z-index:-1;pointer-events:none;}
.hero .hero-lede{margin-left:auto;margin-right:auto;}
.hero .cd{justify-content:center;}
.hero .rv{--d:0}
h1.motto{font-family:var(--serif);font-weight:500;font-size:clamp(38px,5.6vw,72px);line-height:1.3;}
h1.motto span{display:block;}
h1.motto .l2{color:#3A1F29;transition:color 2.2s var(--ease) .9s;}
.hero.in h1.motto .l2{color:#B9A89E;}
.hero-lede{margin-top:20px;max-width:30em;color:#B9A89E;}
.cd{margin-top:30px;display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;}
.cd-pre,.cd-unit{font-family:var(--serif);font-size:20px;color:#B9A89E;}
.cd-days{font-family:var(--serif);font-size:56px;line-height:1;color:#EFE5D6;}
.cd-sub{margin-top:10px;font-size:13.5px;letter-spacing:.08em;color:#86707A;}
.next-rel{display:inline-flex;gap:10px;align-items:baseline;margin-top:14px;font-size:13.5px;color:#B9A89E;border-bottom:1px solid rgba(239,229,214,.12);padding-bottom:3px;transition:color .3s,border-color .3s,gap .4s var(--ease);}
.next-rel b{font-weight:400;color:#D4A24C;}
.next-rel:hover{color:#EFE5D6;border-color:#D4A24C;gap:14px;}
.board{background:rgba(38,20,27,.72);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border:1px solid rgba(239,229,214,.12);padding:24px 24px 20px;}
.board-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px;}
.board-head h2{font-family:var(--serif);font-weight:500;font-size:17px;}
.board-head small,.board-foot{font-size:12.5px;color:#86707A;}
.brow{display:grid;grid-template-columns:26px minmax(0,1fr) auto;gap:12px;align-items:center;padding:11px 0;border-bottom:1px solid rgba(239,229,214,.1);transition:padding .35s var(--ease);}
.brow:last-of-type{border-bottom:0;}
.brow:hover{padding-left:6px;}
.brow .k{font-family:var(--jp);font-size:17px;color:var(--dc);text-align:center;}
.brow p{font-size:14px;line-height:1.5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.brow p small{display:block;font-size:12px;color:#86707A;}
.brow.todo p{color:#86707A;}
.brow .st{font-size:12px;color:#86707A;}
.brow.done .st{color:var(--dc);}
.board-foot{display:flex;justify-content:space-between;align-items:center;margin-top:14px;color:#B9A89E;}
.pips{display:flex;gap:4px;}
.pips i{width:18px;height:3px;background:rgba(239,229,214,.12);transition:background .6s var(--ease);}
.pips i.on{background:#D4A24C;}
.ledger-block{margin-top:48px;}
.ledger-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;font-size:13px;color:#B9A89E;margin-bottom:12px;}
.ledger-top b{font-family:var(--serif);font-weight:500;color:#EFE5D6;font-size:16px;}
.ledger-wrap{overflow-x:auto;padding:4px 2px 6px;scrollbar-width:none;}
.ledger-wrap::-webkit-scrollbar{display:none;}
.months{--cs:12px;display:grid;grid-auto-flow:column;grid-auto-columns:var(--cs);column-gap:3px;font-size:11.5px;color:#86707A;margin-bottom:6px;width:max-content;}
.months span{white-space:nowrap;}
.ledger{--cs:12px;display:grid;grid-auto-flow:column;grid-template-rows:repeat(7,var(--cs));grid-auto-columns:var(--cs);gap:3px;width:max-content;}
.cell{width:var(--cs);height:var(--cs);border:1px solid rgba(239,229,214,.1);transition:transform .25s var(--ease),box-shadow .25s;opacity:0;animation:cellIn .5s var(--ease) forwards;animation-delay:calc(var(--c) * 4ms + .6s);}
@keyframes cellIn{to{opacity:1;}}
.cell.future{border-color:rgba(239,229,214,.05);}
.cell.done{border:0;}
.cell.done:hover,.cell.today:hover{transform:scale(1.7);box-shadow:0 0 0 3px rgba(28,15,20,.8);position:relative;z-index:2;}
.cell.today{border:1.5px solid #D4A24C;animation:cellIn .5s var(--ease) forwards,breathe 2.6s ease-in-out 1.2s infinite;animation-delay:calc(var(--c) * 4ms + .6s),1.2s;}
@keyframes breathe{50%{box-shadow:0 0 0 4px rgba(212,162,76,.2);}}
.legend{display:flex;flex-wrap:wrap;gap:18px;margin-top:14px;font-size:12.5px;color:#B9A89E;}
.legend i{display:inline-block;width:9px;height:9px;margin-right:7px;}
.tip{position:fixed;z-index:80;pointer-events:none;background:#EFE5D6;color:#1C0F14;font-size:12.5px;padding:7px 11px;line-height:1.55;max-width:260px;opacity:0;transform:translateY(4px);transition:opacity .15s,transform .2s var(--ease);}
.tip.on{opacity:1;transform:none;}
@media(max-width:900px){.hero{align-items:flex-start;}.hero-in{padding:104px 20px 46vh;}}

/* ── 壱 連載：五角形能力值 ── */
.story{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,560px);gap:44px;margin-top:26px;border-top:1px solid var(--line);padding-top:26px;align-items:start;}
.stat{padding:0;margin-top:8px;}
/* 五角陣：雷達圖＋五個頂點直接標字、篇數、段位、小年輪（不再用列表） */
.pent{position:relative;width:min(100%,440px);aspect-ratio:1;margin:6px auto 0;}
.pent>svg{position:absolute;inset:16%;width:68%;height:68%;overflow:visible;}
.pent .grow{transform:scale(.001);transition:transform 1.4s var(--ease) .3s;}
.in .pent .grow{transform:none;}
.pv{position:absolute;transform:translate(-50%,-50%);display:grid;grid-template-columns:auto auto;grid-template-rows:auto auto;column-gap:6px;align-items:center;justify-items:start;padding:6px 8px;transition:transform .45s var(--ease);}
.pv:hover{transform:translate(-50%,-50%) scale(1.08);}
.pv .dring{grid-row:1/3;width:30px;height:30px;overflow:visible;}
.pv .pk{font-family:var(--jp);font-size:20px;line-height:1;color:var(--dc);}
.pv .pn{display:flex;align-items:baseline;gap:5px;line-height:1.2;white-space:nowrap;}
.pv .pn b{font-weight:300;font-size:15px;color:var(--bone);}
.pv .pn i{font-style:normal;font-size:11px;color:var(--ash);font-family:var(--serif);}
@media(max-width:520px){.pv{padding:2px 4px;column-gap:4px;}.pv .dring{width:22px;height:22px;}.pv .pk{font-size:17px;}.pv .pn b{font-size:13px;}.pv .pn i{font-size:10px;}}
.stat .tabs{display:flex;gap:4px;}
.stat .tabs button{font-size:12.5px;padding:3px 11px;border:1px solid var(--line);color:var(--bone-2);transition:all .25s;}
.stat .tabs button:hover{border-color:var(--bone-2);}
.stat .tabs button[aria-pressed="true"]{background:var(--bone);color:var(--night);border-color:var(--bone);}
.stat-top{display:flex;justify-content:center;align-items:center;gap:14px;font-size:13px;color:var(--bone-2);}
.pgrid{display:grid;grid-template-columns:minmax(0,210px) minmax(0,1fr);gap:22px;align-items:center;margin-top:8px;}
.penta{margin:0;max-width:210px;width:100%;}
.penta svg{width:100%;height:auto;overflow:visible;display:block;}
.penta .grow{transform:scale(.001);transition:transform 1.4s var(--ease) .3s;}
.in .penta .grow{transform:none;}
.shape{fill:var(--gold-soft);stroke:var(--gold);stroke-width:1.5;transition:all .8s var(--ease);}
.pdot{transition:cx .8s var(--ease),cy .8s var(--ease);}
.axis{font-family:var(--jp);font-size:26px;fill:var(--bone-2);transition:fill .3s;}
.penta a:hover .axis{fill:var(--gold);}

.plegend{list-style:none;margin:0;}
.plegend a{display:grid;grid-template-columns:26px minmax(0,1fr) auto;gap:10px;align-items:center;padding:9px 2px;border-bottom:1px solid var(--line);transition:background .3s,padding .35s var(--ease);}
.plegend li:last-child a{border-bottom:0;}
.plegend a:hover{background:var(--night-3);padding-left:8px;}
.plegend .k{font-family:var(--jp);font-size:19px;color:var(--dc);text-align:center;}
.plegend .n{font-size:14px;min-width:0;}
.plegend .n small{display:block;font-size:11.5px;color:var(--ash);margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.plegend .pbar{display:block;height:3px;background:var(--line);margin-top:6px;position:relative;overflow:hidden;}
.plegend .pbar i{position:absolute;left:0;top:0;bottom:0;background:var(--dc);transition:width 1s var(--ease);}
.plegend .nd{display:flex;flex-direction:column;align-items:flex-end;line-height:1.2;min-width:34px;}
.plegend b{font-weight:300;font-size:18px;}
.plegend .dan{font-family:var(--serif);font-size:11.5px;color:var(--bone-2);text-align:right;margin-top:2px;}
.dir-note{font-size:11.5px;color:var(--ash);margin-top:10px;}
@media(max-width:960px){.story{grid-template-columns:1fr;gap:28px;}}

/* ── 未來祈願：提灯（亮度＝進度） ── */
.cho-wrap{margin-top:30px;position:relative;}
.cho-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;padding:22px 26px 0;}
.cho-head .t{font-family:var(--serif);font-size:22px;color:#EBD3A8;}
.cho-head .y{font-size:12.5px;color:var(--ash);letter-spacing:.12em;}
.cho-head .s{flex-basis:100%;font-size:13px;color:var(--bone-2);}
.cho-scroll{position:relative;}
/* 祈願所：燈籠沿著一串串垂下的繩子排列，自動換行，不用橫向捲動 */
.cho-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(176px,1fr));gap:40px 0;position:relative;}
.cho::before{content:'';position:absolute;top:0;left:0;right:0;height:26px;border-bottom:1.2px solid rgba(239,229,214,.28);border-radius:0 0 50% 50%/0 0 100% 100%;pointer-events:none;}
.cho{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;padding:26px 14px 0;color:inherit;}
.cho h4,.cho .more{align-self:stretch;}.cho .st{align-self:center;}
.cho .lan{align-self:center;}
.cho .pin,.cho .pin-none{display:grid;place-items:center;width:24px;height:24px;margin-bottom:0;}
.cho .pin{border-radius:50%;border:1px solid rgba(212,162,76,.6);color:var(--gold);font-size:12px;background:rgba(28,15,20,.85);transition:background .3s,color .3s,transform .3s var(--ease);}
.cho.go{cursor:pointer;}
.cho.go:hover .pin{background:var(--gold);color:#1C0F14;transform:scale(1.12);}
.cho.go:hover .bd{filter:saturate(1) brightness(1.15);}
.cho.go:hover h4{color:#EBD3A8;}
.cho.go:focus-visible{outline:1px solid var(--gold);outline-offset:6px;}
.cho .needs{margin-top:6px;font-size:12.5px;color:var(--bone-2);}
.cho .lan{display:flex;flex-direction:column;align-items:center;transform-origin:50% 0;animation:sway 5.5s ease-in-out infinite;animation-delay:calc(var(--n) * -1.1s);}
.cho .str{width:1px;height:18px;background:rgba(239,229,214,.4);}
.cho .lan{position:relative;}
.cho .pin,.cho .pin-none{position:absolute;top:0;left:calc(50% + 8px);}
.cho .cp{width:44px;height:9px;background:#1a0f0a;border-radius:2px;}
.cho .bd{position:relative;width:80px;height:116px;border-radius:44%/30%;display:grid;place-items:center;font-family:var(--serif);font-size:28px;color:#5a1a14;
  background:repeating-linear-gradient(0deg,rgba(0,0,0,.13) 0 1px,transparent 1px 11px),radial-gradient(60% 60% at 50% 50%,#ffe0a0,#e8893a 70%,#b0472a);
  filter:saturate(calc(.35 + var(--g) * .65)) brightness(calc(.55 + var(--g) * .55));
  box-shadow:0 0 calc(var(--g) * 70px) calc(var(--g) * 16px) rgba(255,170,80,calc(var(--g) * .55));transition:box-shadow .6s,filter .6s;}
.cho.dim .bd{background:repeating-linear-gradient(0deg,rgba(0,0,0,.14) 0 1px,transparent 1px 11px),radial-gradient(60% 60% at 50% 50%,#ddd0c2,#a8968a 78%);color:#3a2a2a;filter:none;box-shadow:none;}
.cho .cp2{width:38px;height:7px;background:#1a0f0a;border-radius:2px;}
.cho .tas{width:2px;height:16px;background:#b0472a;}
.cho .stamp{position:absolute;right:-12px;bottom:6px;width:30px;height:30px;border:1.6px solid #C0392B;color:#C0392B;border-radius:50%;display:grid;place-items:center;font-size:15px;background:rgba(255,240,220,.9);transform:rotate(-12deg);}
.cho .bd{display:flex!important;flex-direction:column;align-items:center;justify-content:center;gap:4px;}
.cho .gan{font-family:var(--serif);font-size:24px;line-height:1;}
.cho .pct{display:flex;align-items:baseline;font-family:var(--latin);line-height:1;}
.cho .pct b{font-weight:600;font-size:22px;}
.cho .pct small{font-size:11px;margin-left:1px;}
/* 祈願所：平常只顯示標題與狀態；滑過（手機點一下）才展開說明 */
.cho .more{display:grid;grid-template-rows:0fr;opacity:0;transition:grid-template-rows .5s var(--ease),opacity .4s;}
.cho .more>*{overflow:hidden;min-height:0;}
.cho .more{grid-template-columns:1fr;}
.cho:hover .more,.cho:focus-within .more,.cho:focus .more,.cho.open .more{grid-template-rows:1fr;opacity:1;}
.cho .more p:first-child{margin-top:8px;}
.cho h4{margin-top:16px;font-family:var(--serif);font-weight:500;font-size:15px;line-height:1.55;color:var(--bone);}
.cho .why{margin-top:6px;font-size:12.5px;line-height:1.75;color:var(--bone-2);}
.cho .memo{margin-top:6px;font-size:12.5px;color:#E2A08F;}
.cho .st{margin-top:10px;font-size:11.5px;letter-spacing:.1em;color:var(--gold);}
.cho.dim .st{color:var(--ash);}
.cho-hint{display:none!important;}
/* 祈願所：燈籠互動（有興趣／想法與建議） */
.cho-act{position:absolute;left:0;right:0;top:84px;display:flex;justify-content:space-between;padding:0 8px;pointer-events:none;z-index:3;}
.ca{pointer-events:auto;width:30px;height:30px;padding:0;border-radius:50%;border:1px solid rgba(212,162,76,.6);background:rgba(28,15,20,.9);color:var(--gold);display:grid;place-items:center;cursor:pointer;opacity:0;transform:scale(.6);transition:opacity .3s,transform .4s var(--ease),background .3s,color .3s;}
.ca svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;}
.cho:hover .ca,.cho:focus-within .ca,.cho.open .ca{opacity:1;transform:none;}
.ca:hover,.ca:focus-visible{background:var(--gold);color:#1C0F14;outline:none;}
.ca.like.on{background:var(--gold);color:#1C0F14;}.ca.like.on svg{fill:currentColor;}
@media(hover:none){.ca{opacity:1;transform:none;}}
.cho.hearted .bd{box-shadow:0 0 70px 20px rgba(255,170,80,.6),0 0 0 3px rgba(212,162,76,.55)!important;}
.wp{position:absolute;z-index:60;width:min(300px,calc(100vw - 24px));background:#241218;border:1px solid rgba(212,162,76,.5);padding:16px 16px 14px;color:var(--bone);box-shadow:0 18px 50px -12px rgba(0,0,0,.8);font-size:13.5px;line-height:1.7;animation:wpIn .35s var(--ease) both;}
.wp::before{content:'';position:absolute;top:-6px;left:var(--ax,50%);width:10px;height:10px;background:#241218;border-left:1px solid rgba(212,162,76,.5);border-top:1px solid rgba(212,162,76,.5);transform:translateX(-50%) rotate(45deg);}
.wp.up::before{top:auto;bottom:-6px;transform:translateX(-50%) rotate(225deg);}
.wp.bub{border-radius:16px;}
@keyframes wpIn{from{opacity:0;transform:translateY(6px) scale(.97);}}
.wp-h{font-family:var(--serif);font-size:15px;color:#EBD3A8;line-height:1.5;}
.wp-s{margin-top:4px;color:var(--bone-2);font-size:12.5px;}
.wp-l{margin-top:10px;font-size:11.5px;letter-spacing:.12em;color:var(--gold);}
.wp-opts{display:flex;gap:6px;margin-top:4px;flex-wrap:wrap;}
.wp-opts label,.wp-chips label{cursor:pointer;}
.wp-opts input,.wp-chips input{position:absolute;opacity:0;pointer-events:none;}
.wp-opts b,.wp-chips b{display:inline-block;font-weight:400;font-size:12.5px;padding:3px 11px;border:1px solid rgba(239,229,214,.28);border-radius:99px;color:var(--bone-2);transition:all .25s;}
.wp-opts input:checked+b,.wp-chips input:checked+b{border-color:var(--gold);color:#1C0F14;background:var(--gold);}
.wp-opts input:focus-visible+b,.wp-chips input:focus-visible+b{outline:1px solid var(--gold);outline-offset:2px;}
.wp-chips{display:flex;gap:6px;margin-top:8px;}
.wp-in,.wp-ta,.wp-sel{display:block;width:100%;margin-top:6px;padding:7px 10px;background:#1a0d12;border:1px solid rgba(239,229,214,.25);color:var(--bone);font:inherit;font-size:13.5px;border-radius:2px;box-sizing:border-box;}
.wp-ta{min-height:76px;resize:vertical;}
.wp-in[hidden],.wp [hidden]{display:none;}
.wp-in:focus,.wp-ta:focus,.wp-sel:focus{outline:none;border-color:var(--gold);}
.wp-go{margin-top:12px;width:100%;padding:8px 12px;border:1px solid var(--gold);background:transparent;color:var(--gold);font:inherit;font-size:13.5px;letter-spacing:.1em;cursor:pointer;transition:background .3s,color .3s;}
.wp-go:hover,.wp-go:focus-visible{background:var(--gold);color:#1C0F14;outline:none;}
.wp-ok{font-family:var(--serif);font-size:15px;color:#EBD3A8;}
.wp-demo{margin-top:8px;font-size:11.5px;color:#E2A08F;}
.wp-more{margin-top:8px;background:none;border:0;padding:0;color:var(--gold);font:inherit;font-size:12.5px;text-decoration:underline;text-underline-offset:3px;cursor:pointer;}
.wp-x{position:absolute;top:4px;right:6px;width:28px;height:28px;border:0;background:none;color:var(--bone-2);font-size:18px;cursor:pointer;}
dialog.wp-dlg{border:1px solid rgba(212,162,76,.5);background:#241218;color:var(--bone);padding:26px 24px 22px;width:min(420px,calc(100vw - 24px));margin:auto;}
dialog.wp-dlg::backdrop{background:rgba(10,4,6,.72);backdrop-filter:blur(3px);}
.wp-tabs{display:flex;gap:6px;margin:12px 0 4px;border-bottom:1px solid rgba(239,229,214,.15);}
.wp-tabs button{background:none;border:0;border-bottom:2px solid transparent;color:var(--bone-2);font:inherit;font-size:13.5px;padding:6px 12px;cursor:pointer;display:flex;gap:6px;align-items:center;}
.wp-tabs button[aria-selected=true]{color:var(--gold);border-bottom-color:var(--gold);}
.wp-tabs svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;}
.wp-toast{position:absolute;left:50%;top:6px;transform:translateX(-50%);width:max-content;max-width:190px;text-align:center;line-height:1.5;z-index:4;background:#241218;border:1px solid rgba(212,162,76,.5);color:#EBD3A8;font-size:12px;padding:5px 12px;border-radius:14px;animation:wpIn .4s var(--ease) both;}
.spark{position:absolute;left:50%;top:150px;width:6px;height:6px;border-radius:50%;background:#f0b9a0;box-shadow:0 0 6px 1px rgba(232,160,140,.7);pointer-events:none;z-index:4;animation:sparkUp 1.1s ease-out forwards;}
@keyframes sparkUp{to{transform:translate(var(--dx),-110px) scale(.2);opacity:0;}}
@media(prefers-reduced-motion:reduce){.wp,.wp-toast,.spark{animation:none!important;}}
/* 人數顯示：點亮人數在燈籠裡面上方、想法與建議數量在燈籠裡面下方；周圍的光點＝點亮的人 */
.cnt-note{margin-top:14px;font-size:12px;color:#E2A08F;letter-spacing:.06em;}
.cnt-in{position:absolute;left:0;right:0;display:flex;align-items:center;justify-content:center;gap:4px;font-family:'Cinzel','Cormorant Garamond',var(--serif);font-size:15px;font-weight:600;letter-spacing:.04em;color:#7a3340;text-shadow:0 1px 0 rgba(255,226,170,.55);opacity:.95;pointer-events:none;line-height:1;}
.cnt-up{top:22px;}.cnt-dn{bottom:22px;}
@media(max-width:640px){.cnt-up{top:19px;}.cnt-dn{bottom:19px;}}
.cnt-in i{font-style:normal;font-size:12px;}
.cnt-in svg{width:15px;height:15px;filter:drop-shadow(0 1px 0 rgba(255,226,170,.55));fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;}
.spark.alt{background:#fff3c4;box-shadow:0 0 8px 2px rgba(255,236,150,.85);}
.ash{position:absolute;left:50%;top:70px;width:5px;height:5px;border-radius:50%;background:#b9857c;pointer-events:none;z-index:4;animation:ashDn 1.3s ease-in forwards;}
@keyframes ashDn{to{transform:translate(var(--dx),130px) scale(.3);opacity:0;}}
.cho .bd.snuff{animation:snuff .7s ease-out;}
@keyframes snuff{0%{transform:scale(1);opacity:1;}15%{transform:scale(1.04);opacity:1;}30%{opacity:.45;}45%{opacity:.9;}65%{transform:scale(.96);opacity:.55;}100%{transform:scale(1);opacity:1;}}
@media(prefers-reduced-motion:reduce){.ash,.cho .bd.snuff{animation:none!important;}}
.ffs{position:absolute;left:50%;top:111px;width:0;height:0;pointer-events:none;z-index:1;}
.ffs b{position:absolute;width:4px;height:4px;margin:-2px;border-radius:50%;background:#ffd98a;box-shadow:0 0 8px 2px rgba(255,200,110,.7);animation:ffTw 3s ease-in-out infinite;}
@keyframes ffTw{0%,100%{opacity:.15;transform:translateY(0) scale(.7);}50%{opacity:1;transform:translateY(-6px) scale(1);}}
@media(prefers-reduced-motion:reduce){.ffs b{animation:none;opacity:.7;}}
.cho h4{text-wrap:balance;}
.cho .kd{align-self:stretch;text-align:center;padding:6px 0 5px;font-family:var(--latin);font-size:15px;font-weight:600;letter-spacing:.14em;line-height:1;color:#f6dcae;text-shadow:0 1px 1px rgba(60,15,25,.5);background:linear-gradient(180deg,#7d3a44,#5c2430 55%,#7d3a44);border-top:1px solid rgba(240,190,160,.55);border-bottom:1px solid rgba(240,190,160,.55);box-shadow:0 1px 3px rgba(60,15,25,.35);}
.cho.dim .kd{background:linear-gradient(180deg,#8a6a66,#6e514f 55%,#8a6a66);color:#efe0d0;}
.cho-empty{margin-top:28px;color:var(--bone-2);font-size:14.5px;letter-spacing:.06em;}

/* 祈願所：需要幫忙的標記、下一步、更新日、幫忙入口 */
.cho .need-tag{margin-top:6px;font-size:11px;letter-spacing:.12em;color:#E2A08F;border:1px solid rgba(226,160,143,.5);padding:1px 8px;border-radius:99px;}
.cho .next{margin-top:8px;font-size:12.5px;line-height:1.7;color:var(--bone);}
.cho .next b{display:block;font-weight:500;font-size:11px;letter-spacing:.16em;color:var(--gold);}
.cho .upd{margin-top:8px;font-size:11px;letter-spacing:.1em;color:var(--ash);}
.cho .hlp{display:inline-block;margin-top:8px;padding:5px 12px;border:1px solid rgba(212,162,76,.6);color:var(--gold);font-size:12.5px;letter-spacing:.06em;text-decoration:none;transition:background .3s,color .3s;}
.cho .hlp:hover,.cho .hlp:focus-visible{background:var(--gold);color:#1C0F14;}

@keyframes sway{0%,100%{transform:rotate(-1.6deg);}50%{transform:rotate(1.6deg);}}
#kiganjo.in .cho{animation:choIn .7s var(--ease) both;animation-delay:calc(var(--n) * 90ms);}
@keyframes choIn{from{opacity:0;transform:translateY(-12px);}}
@media(prefers-reduced-motion:reduce){.cho .lan,#kiganjo.in .cho{animation:none;}}
@media(max-width:640px){.cho-row{grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 0;}.cho{padding:26px 8px 0;}.cho .bd{width:70px;height:100px;}}

/* ── 弐 連載 ── */
.mv-toggle{display:inline-flex;margin-top:28px;border:1px solid var(--line);}
/* ── 連載：三種版型 ── */
.chd{margin-top:24px;}
.ca-kick{font-size:12.5px;letter-spacing:.14em;color:var(--gold);}
.chd h3{font-family:var(--serif);font-weight:500;font-size:26px;line-height:1.45;margin-top:6px;color:var(--bone);}
.chd h3 em{display:block;font-style:normal;font-size:14px;letter-spacing:.12em;color:var(--bone-2);margin-bottom:2px;}
.chd h4{font-size:12px;letter-spacing:.16em;color:var(--ash);margin-top:18px;font-weight:400;}
.chd article p{color:var(--bone-2);margin-top:10px;}
.chd .mute{color:var(--ash)!important;}
.chd .ch-link{display:inline-block;margin-top:20px;}
.ilist{list-style:none;margin-top:6px;}
.ilist li{display:grid;grid-template-columns:24px minmax(0,1fr);gap:6px;padding:7px 0;border-bottom:1px dashed var(--line);font-size:14px;color:var(--bone);}
.ilist .k{font-family:var(--jp);color:var(--dc,var(--gold));}
.ca-prog{height:2px;background:rgba(239,229,214,.12);margin-top:18px;position:relative;}
.ca-prog i{position:absolute;inset:0 auto 0 0;background:var(--gold);}
.ca-prog i::after{content:'';position:absolute;right:-4px;top:-3px;width:8px;height:8px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 4px rgba(212,162,76,.18);}
.ca-pn{font-size:12.5px!important;color:var(--ash)!important;margin-top:9px!important;}
.ca-pn b{color:var(--bone);font-weight:400;}
.ca-nums{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:22px;border-top:1px solid var(--line);}
.ca-nums div{padding:12px 0 0;}
.ca-nums div+div{padding-left:16px;border-left:1px solid var(--line);}
.ca-nums b{display:block;font-weight:300;font-size:30px;line-height:1.1;color:var(--bone);}
.ca-nums small{font-size:12px;color:var(--ash);}
.dline{display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:16px;font-size:13.5px;color:var(--bone-2);}
.dline a{display:inline-flex;align-items:baseline;gap:5px;}
.dline b{font-family:var(--jp);font-weight:400;color:var(--dc);}
.dline a:hover{color:var(--bone);}
.rline{display:flex;align-items:center;gap:12px;margin-top:26px;padding-top:16px;border-top:1px solid var(--line);font-size:13px;color:var(--bone-2);}
.rline span{display:grid;place-items:center;width:28px;height:28px;border:1px solid var(--gold);color:var(--gold);font-family:var(--jp);font-size:14px;flex:none;}
/* B 年輪帳 */
.cb-ring{position:relative;}
.cb-ring svg{width:100%;height:auto;display:block;overflow:visible;}
.rg{fill:none;stroke:rgba(239,229,214,.24);stroke-width:1;cursor:pointer;transition:stroke .3s,stroke-width .3s;}
.rg.future{stroke-dasharray:2 5;}
.rg.done{stroke:rgba(212,162,76,.7);stroke-width:1.6;}
.rg.next{stroke:#F3D9A0;stroke-width:2.6;stroke-linecap:round;filter:drop-shadow(0 0 6px rgba(212,162,76,.6));}
.rg.fin{stroke:rgba(212,162,76,.35);stroke-dasharray:1 4;}
.rg.on{stroke-width:3;}
.rg:hover{stroke:var(--bone);}
.rg-hit{fill:none;stroke:none;}
.cb-c{position:absolute;left:50%;top:0;width:100%;aspect-ratio:1;transform:translateX(-50%);display:grid;place-content:center;justify-items:center;pointer-events:none;}
.cb-c b{font-family:var(--jp);font-weight:400;font-size:30px;color:var(--gold);line-height:1;}
.cb-c small{font-size:11px;color:var(--ash);margin-top:4px;letter-spacing:.2em;}
/* C 縦書き帳 */
.cc-cols{list-style:none;display:flex;flex-direction:row;border-top:1.5px solid var(--bone);border-bottom:1.5px solid var(--bone);overflow-x:auto;scrollbar-width:none;}
.cc-cols::-webkit-scrollbar{display:none;}
.cc-cols li{flex:1 0 64px;}
.cc-cols li+li{border-left:1px solid var(--line);}
.cc-cols button{position:relative;width:100%;height:330px;padding:16px 0 12px;display:flex;flex-direction:row-reverse;justify-content:center;align-items:flex-start;gap:6px;color:var(--bone-2);transition:background .35s,color .3s;}
.cc-cols button>span{writing-mode:vertical-rl;}
/* 直書：優先用內建、含直排字距的系統字型（網路字型在部分手機直排時字會疊在一起） */
.cc-cols .vn,.cc-cols .vt{font-family:"Hiragino Mincho ProN","Hiragino Mincho Pro","Songti TC","Noto Serif CJK TC","Source Han Serif TC","Yu Mincho","YuMincho","MS Mincho",var(--serif)!important;}
.cc-cols .vd{font-family:"Hiragino Sans","PingFang TC","Noto Sans CJK TC","Source Han Sans TC","Yu Gothic","Microsoft JhengHei",var(--sans,sans-serif)!important;}
.cc-cols .vn{inline-size:4.6em;line-height:1.2;font-family:var(--serif);font-size:15px;color:var(--bone);letter-spacing:.12em;}
.cc-cols button>span{flex:none;}
.cc-cols .vt{display:block;inline-size:176px;block-size:calc(2 * 1.6em);max-block-size:calc(2 * 1.6em);font-family:var(--serif);font-size:13px;line-height:1.6;letter-spacing:.06em;overflow:hidden;word-break:break-all;}
.cc-cols .vd{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);white-space:nowrap;inline-size:5.6em;line-height:1.2;text-align:center;}
.cc-cols .vd{font-size:11.5px;color:var(--ash);letter-spacing:.08em;}
.cc-cols .future{opacity:.5;}
.cc-cols button:hover{background:rgba(239,229,214,.04);opacity:1;}
.cc-cols button.on{background:linear-gradient(rgba(212,162,76,.14),rgba(212,162,76,.05));}
.cc-cols button.on .vn{color:var(--gold);}
.cc-cols .hk{writing-mode:horizontal-tb;bottom:86px;}
.hk{position:absolute;bottom:56px;left:50%;transform:translateX(-50%) rotate(-8deg);writing-mode:horizontal-tb;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font-family:var(--jp);font-size:13px;border:1.5px solid currentColor;}
.hk.done{color:#C8584A;background:rgba(200,88,74,.08);}
.hk.next{color:var(--gold);}
.hk.fin{color:var(--gold);border-radius:3px;}
.cc-now{display:grid;grid-template-columns:240px minmax(0,1.3fr) minmax(0,1fr);gap:44px;margin-top:30px;align-items:start;}
.cc-now .cb-ring{width:100%;}
.cc-side .ca-nums{margin-top:6px;}
@media(max-width:1100px){.cc-now{grid-template-columns:200px minmax(0,1fr);}.cc-side{grid-column:1/-1;}}
@media(max-width:700px){.cc-now{grid-template-columns:1fr;gap:28px;}.cc-now .cb-ring{max-width:230px;margin:0 auto;}}
@media(max-width:520px){.chd h3{font-size:21px;}.ca-nums b{font-size:24px;}.cc-cols li{flex-basis:58px;}.cc-cols button{height:320px;}}
.mv-toggle button{font-size:13px;padding:5px 16px;color:var(--bone-2);transition:background .3s,color .3s;}
.mv-toggle button:hover{color:var(--bone);}
.mv-toggle button[aria-pressed="true"]{background:var(--bone);color:var(--night);}
.track-wrap{overflow-x:auto;margin-top:28px;padding:8px 2px 4px;scrollbar-width:none;}
.track-wrap::-webkit-scrollbar{display:none;}
.track{list-style:none;display:grid;grid-template-columns:repeat(13,minmax(48px,1fr));min-width:640px;position:relative;}
.track::before{content:'';position:absolute;left:32px;right:32px;top:15px;height:1px;background:var(--line);}
.track .fill{position:absolute;left:32px;top:15px;height:1px;background:var(--gold);transform-origin:left;transform:scaleX(0);transition:transform 1.6s var(--ease) .4s;}
.in .track .fill{transform:scaleX(1);}
.track li{position:relative;display:flex;justify-content:center;}
.node{display:flex;flex-direction:column;align-items:center;gap:8px;padding:0 2px 6px;}
.dot{width:14px;height:14px;border-radius:50%;border:1px solid var(--ash);background:var(--night);margin:8px 0;transition:transform .35s var(--ease),box-shadow .35s;}
.node:hover .dot{transform:scale(1.3);box-shadow:0 0 0 5px var(--gold-soft);}
.node.done .dot{background:var(--gold);border-color:var(--gold);}
.node.break .dot{background:repeating-linear-gradient(45deg,var(--ash) 0 2px,transparent 2px 4px);}
.node.next .dot{border:1.5px solid var(--gold);animation:breathe 2.6s ease-in-out infinite;}
.node.final .dot{width:30px;height:30px;margin:0;display:grid;place-items:center;font-size:14px;color:var(--gold);border-color:var(--gold);font-family:var(--jp);}
.node .d{font-size:11.5px;color:var(--gold);font-variant-numeric:tabular-nums;visibility:hidden;transform:translateY(-4px);transition:transform .35s var(--ease);}
.node[aria-current="true"] .d,.node:hover .d{visibility:visible;transform:none;}
.node .r{font-family:var(--latin);font-size:15px!important;letter-spacing:.04em;}
.node.final .r{font-family:var(--serif);font-size:12.5px!important;}
.node .r{font-size:12.5px;color:var(--bone-2);white-space:nowrap;transition:color .3s;}
.node:hover .r,.node[aria-current="true"] .r{color:var(--gold);}
.node[aria-current="true"] .dot{transform:scale(1.25);}
.mdetail{min-width:0;}
.mdetail>*{animation:detIn .6s var(--ease) both;}
.mnums{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:22px;}
.mnums div{border-top:1px solid var(--line);padding-top:10px;}
.mdetail .tag{font-size:12.5px;color:var(--ash);}
.mdetail .tag b{font-weight:400;color:var(--gold);margin-right:8px;}
.mdetail h3{font-family:var(--serif);font-weight:500;font-size:24px;margin-top:4px;line-height:1.45;}
.mdetail p{color:var(--bone-2);margin-top:10px;max-width:32em;}
.mdetail h4{font-family:var(--serif);font-weight:500;font-size:14px;color:var(--gold);margin-top:18px;}
.mdetail ul{list-style:none;margin-top:6px;}
.mdetail li{display:grid;grid-template-columns:30px minmax(0,1fr);gap:10px;padding:10px 0;border-top:1px solid var(--line);font-size:14.5px;}
.mdetail li .k{font-family:var(--jp);color:var(--dc,var(--ash));}
.ch-link{display:inline-block;margin-top:22px;font-size:13.5px;color:var(--bone-2);border-bottom:1px solid var(--line);padding-bottom:3px;transition:color .3s,border-color .3s,padding .4s var(--ease);}
.ch-link:hover{color:var(--bone);border-color:var(--gold);padding-left:6px;}
/* 每月月報 */
.mrep{display:grid;grid-template-columns:auto minmax(0,1fr);gap:14px;align-items:center;margin-top:22px;padding:14px 16px;border:1px solid rgba(212,162,76,.3);background:linear-gradient(100deg,rgba(212,162,76,.08),transparent 70%);max-width:34em;}
.mrep .mi{display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--gold);color:var(--gold);font-family:var(--jp);font-size:16px;}
.mrep b{display:block;font-weight:500;font-size:14.5px;color:var(--bone);}
.mrep small{display:block;font-size:12.5px;color:var(--bone-2);line-height:1.6;margin-top:2px;}
.mrep a{font-size:13px;color:var(--gold);white-space:nowrap;border-bottom:1px solid rgba(212,162,76,.4);padding-bottom:2px;}
.mrep a:hover{border-color:var(--gold);}
@media(max-width:520px){.mrep{grid-template-columns:auto minmax(0,1fr);}.mrep a{grid-column:2;justify-self:start;}}
.mnums b{display:block;font-size:28px;font-weight:300;line-height:1.1;font-variant-numeric:tabular-nums;}
.mnums small{font-size:12.5px;color:var(--ash);}
.ygrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));margin-top:28px;padding:1px 0 0 1px;}
.ycard{background:var(--night);border:1px solid var(--line);margin:-1px 0 0 -1px;padding:18px 18px 16px;text-align:left;display:flex;flex-direction:column;gap:4px;min-height:150px;transition:background .3s,transform .4s var(--ease);position:relative;}
.ycard:hover{background:var(--night-2);z-index:1;transform:translateY(-3px);}
.ycard .n{font-size:12.5px;color:var(--ash);}
.ycard h4{font-family:var(--serif);font-weight:500;font-size:16px;line-height:1.5;}
.ycard .s{margin-top:auto;font-size:12.5px;color:var(--ash);}
.ycard.done .s{color:var(--gold);}
.ycard.next{background:var(--gold-soft);}
.ycard.final{background:var(--night-3);}
.ycard.final h4{color:var(--gold);}

/* ── 肆 works ── */
.strip{display:flex;gap:20px;overflow-x:auto;margin-top:36px;padding:10px 2px 14px;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:var(--ash) transparent;}
.work{flex:0 0 min(380px,82vw);gap:0;scroll-snap-align:start;background:var(--night-2);border:1px solid var(--line);padding:26px;display:flex;flex-direction:column;min-height:250px;position:relative;overflow:hidden;transition:transform .5s var(--ease),border-color .4s,box-shadow .5s var(--ease);}
.work::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--dc);transform:scaleX(0);transform-origin:left;transition:transform .6s var(--ease);}
.work::after{content:attr(data-k);position:absolute;right:-8px;bottom:-34px;font-family:var(--latin);font-weight:300;font-size:200px;line-height:1;color:var(--dc);opacity:0;transform:translateY(16px);transition:opacity .6s var(--ease),transform .6s var(--ease);pointer-events:none;}
.work:hover{transform:translateY(-6px);border-color:rgba(239,229,214,.2);box-shadow:0 18px 40px -20px rgba(0,0,0,.6);}
.work:hover::before{transform:scaleX(1);}
.work:hover::after,.deck .work.on::after{opacity:.13;transform:none;}
.work .meta{display:flex;justify-content:space-between;font-size:12px;letter-spacing:.06em;color:var(--ash);}
.work .meta span:first-child{color:var(--gold);}
.work h3{font-family:var(--serif);font-weight:500;font-size:21px;margin-top:14px;line-height:1.45;color:#EBD3A8;}
.work p{font-size:13.5px;color:var(--bone-2);margin-top:8px;}
.work .wq{margin:16px 0 0;padding-left:14px;border-left:2px solid var(--ash);font-family:var(--serif);font-size:15px;line-height:1.8;}
.work .wq small{display:block;font-family:var(--latin);font-size:12px;letter-spacing:.24em;margin-bottom:2px;}
.work .wq.bf{color:var(--bone-2);border-left-color:rgba(134,112,122,.55);}
.work .wq.bf small{color:var(--ash);}
.work .wq.af{color:var(--bone);border-left-color:var(--gold);margin-bottom:8px;}
.work .wthumb{display:block;margin:-26px -26px 20px;aspect-ratio:16/9;overflow:hidden;border-bottom:1px solid var(--line);background:var(--night-3);}
.work .wthumb img{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease);}
.work:hover .wthumb img{transform:scale(1.03);}
.work .wmore{margin-top:auto;align-self:stretch;position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:46px;padding:0 18px;border:1px solid rgba(212,162,76,.55);background:rgba(20,8,12,.55);color:#F3D9A0;font-size:14px;letter-spacing:.04em;overflow:hidden;isolation:isolate;transition:color .4s var(--ease),border-color .4s;}
.work .wmore::before{content:'';position:absolute;inset:0;z-index:-1;background:#D4A24C;transform:scaleX(0);transform-origin:left;transition:transform .5s var(--ease);}
.work .wmore i{font-style:normal;font-family:var(--latin);font-size:18px;line-height:1;transition:transform .45s var(--ease);}
.work:hover .wmore,.work:focus-visible .wmore{color:#2A0A12;border-color:#D4A24C;}
.work:hover .wmore::before,.work:focus-visible .wmore::before{transform:scaleX(1);}
.work:hover .wmore i{transform:translateX(6px);}
.work .wq.af+.wmore,.work .wq.bf+.wmore,.work p+.wmore{margin-top:auto;}
.work .wq.af{margin-bottom:18px;}
.work .wq.af small{color:var(--gold);}
.work .wfoot{margin-top:auto;padding-top:16px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;font-size:13px;color:var(--ash);position:relative;z-index:1;}
.work .wfoot{margin-top:auto;}.work .wq.af+.wfoot,.work .wq.bf+.wfoot{margin-top:auto;}
.work .wfoot .wsvc{color:var(--gold);padding:0;margin:0;}
.work .wsvc:hover{text-decoration:underline;text-underline-offset:4px;}
.work .nums{display:flex;gap:24px;margin-top:auto;padding-top:20px;}
.work .nums b{display:block;font-size:24px;font-weight:300;}
.work .nums small{font-size:11.5px;color:var(--ash);}

/* ── 伍 journal ── */
.filters{display:flex;flex-wrap:wrap;gap:6px;margin-top:28px;}
.chip{font-size:13px;padding:4px 14px;border:1px solid var(--line);color:var(--bone-2);transition:all .25s;}
.chip:hover{border-color:var(--bone-2);color:var(--bone);}
.chip[aria-pressed="true"]{border-color:var(--gold);color:var(--gold);}
.jlist{margin-top:10px;}
.jrow{display:grid;grid-template-columns:96px 36px minmax(0,1fr) 24px;gap:18px;padding:18px 0;border-bottom:1px solid var(--line);align-items:baseline;transition:opacity .4s,padding .4s var(--ease);}
.jrow[hidden]{display:none;}
.jrow .dft{display:inline-block;font-size:11px;letter-spacing:.08em;padding:0 7px;margin-right:8px;border:1px dashed var(--gold);color:var(--gold);vertical-align:2px;}
.jmore{display:inline-flex;align-items:center;gap:10px;margin-top:28px;min-height:44px;padding:0 20px;border:1px solid var(--line);font-size:14px;color:var(--bone);transition:border-color .3s,color .3s;}
.jmore i{font-style:normal;color:var(--gold);transition:transform .45s var(--ease);}
.jmore:hover{border-color:var(--gold);color:var(--gold);}
.jmore:hover i{transform:translateX(4px);}
.jmore[hidden]{display:none;}
.jrow time{font-size:13px;color:var(--ash);}
.jrow .k{font-family:var(--jp);font-size:19px;line-height:1;color:var(--dc);width:32px;height:32px;display:grid;place-items:center;border-radius:50%;align-self:start;margin-top:0;transition:background .35s,color .35s;}
.jrow h3{font-family:var(--serif);font-weight:500;font-size:17px;transition:color .3s,transform .45s var(--ease);}
.jrow p{font-size:13.5px;color:var(--bone-2);}
.jrow .arrow{color:var(--gold);opacity:0;transform:translateX(-8px);transition:opacity .35s,transform .45s var(--ease);}
.jrow:hover .k{background:var(--dc);color:var(--night);}
.jrow:hover h3{color:var(--gold);transform:translateX(4px);}
.jrow:hover .arrow{opacity:1;transform:none;}
.jempty{padding:20px 0;color:var(--ash);}
@media(max-width:640px){.jrow{grid-template-columns:minmax(0,1fr) auto;gap:6px 12px;align-items:center;}.jrow time{grid-column:1;grid-row:1;}.jrow .k{grid-column:2;grid-row:1;width:34px;height:34px;font-size:17px;align-self:center;}.jrow>div{grid-column:1/-1;grid-row:2;}.jrow .arrow{display:none;}}
@media(max-width:640px){
  .jrow .k{background:color-mix(in srgb,var(--dc) 13%,transparent);border:1px solid color-mix(in srgb,var(--dc) 45%,transparent);box-shadow:0 0 0 0 color-mix(in srgb,var(--dc) 35%,transparent);}
  .jrow .k:not(.pop){transform:scale(.4) rotate(-25deg);opacity:0;}
  .jrow .k{transition:transform .7s cubic-bezier(.34,1.56,.64,1) .25s,opacity .4s ease .25s,background .25s,color .25s;}
  .jrow .k.pop{animation:kping 1.4s ease-out .55s 1;}
  .jrow:active .k{background:var(--dc);color:var(--night);transform:scale(.92);}
}
/* 圓章裡的字置中：正方形、不被擠壓；Safari 用表意字框裁切，讓漢字剛好落在圓心 */
@media(max-width:640px){.jrow .k,.jr .k{box-sizing:border-box;flex:none;aspect-ratio:1;line-height:1;text-align:center;padding:0;}}
@supports (text-box:trim-both ideographic){@media(max-width:640px){.jrow .k,.jr .k{text-box:trim-both ideographic;}}}
@keyframes kping{0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--dc) 40%,transparent);}100%{box-shadow:0 0 0 10px color-mix(in srgb,var(--dc) 0%,transparent);}}
@media(hover:none){.jrow:hover h3{color:inherit;transform:none;}}
@media(prefers-reduced-motion:reduce){.jrow .k:not(.pop){transform:none;opacity:1;}}

/* ── 陸 about ── */
.about{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:56px;margin-top:36px;}
.about .q{font-family:var(--serif);font-size:22px;line-height:1.7;}
.about p{color:var(--bone-2);margin-top:14px;max-width:32em;}
.motto-card{margin-top:28px;padding-top:20px;border-top:1px solid var(--line);font-family:var(--serif);font-size:18px;color:var(--bone);}
.motto-card small{display:block;font-family:var(--sans);font-size:13px;color:var(--ash);margin-top:4px;}
.support{background:#EFE5D6;color:#1C0F14;padding:28px;align-self:start;transition:transform .5s var(--ease),box-shadow .5s var(--ease);}
.support h3{font-family:var(--serif);font-weight:500;font-size:18px;}
.support p{font-size:13.5px;color:#5B4B4E;margin-top:8px;}
.support .r{display:flex;align-items:baseline;gap:10px;margin-top:18px;flex-wrap:wrap;}
.support .r b{font-size:30px;font-weight:400;}
.support .sdesc{white-space:pre-line;}
.support .sup-k{margin:0 0 6px;font-family:var(--latin);font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:#A07A3A;}
.end-card .support h3{font-size:21px;line-height:1.5;letter-spacing:.02em;text-wrap:balance;}
.give-cta{position:relative;display:grid;grid-template-columns:44px minmax(0,1fr) auto;align-items:center;gap:14px;margin-top:22px;padding:14px 18px 14px 14px;background:linear-gradient(135deg,#4A1524 0%,#2A0F18 55%,#1C0F14 100%);color:#F3E9DA;border:1px solid rgba(212,162,76,.45);box-shadow:0 14px 28px -16px rgba(61,15,26,.8),inset 0 1px 0 rgba(255,255,255,.08);overflow:hidden;isolation:isolate;transition:transform .45s var(--ease),box-shadow .45s var(--ease),border-color .3s;}
.give-cta::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(100deg,transparent 30%,rgba(212,162,76,.22) 50%,transparent 70%) no-repeat;background-size:250% 100%;background-position:120% 0;transition:background-position .9s var(--ease);}
.give-cta:hover{transform:translateY(-2px);border-color:#D4A24C;box-shadow:0 20px 34px -16px rgba(61,15,26,.9),inset 0 1px 0 rgba(255,255,255,.1);}
.give-cta:hover::after{background-position:-20% 0;}
.give-cta:focus-visible{outline:2px solid #D4A24C;outline-offset:3px;}
.gc-ic{position:relative;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 40% 35%,#F6EFE4,#E6D6BE);box-shadow:inset 0 -2px 4px rgba(90,50,30,.25);}
.gc-ic svg{width:16px;height:22px;fill:#5B93C4;filter:drop-shadow(0 2px 2px rgba(30,60,90,.3));transition:transform .5s var(--ease);}
.gc-ic i{position:absolute;left:50%;bottom:9px;width:18px;height:5px;margin-left:-9px;border-radius:50%;border:1.5px solid rgba(91,147,196,.7);opacity:0;}
.give-cta:hover .gc-ic svg{animation:gcdrop 1.1s var(--ease) infinite;}
.give-cta:hover .gc-ic i{animation:gcrip 1.1s ease-out infinite;}
@keyframes gcdrop{0%{transform:translateY(-8px);opacity:0;}30%{opacity:1;}55%{transform:translateY(2px) scale(1);}65%{transform:translateY(3px) scale(1.15,.8);}100%{transform:translateY(0);opacity:1;}}
@keyframes gcrip{0%,55%{opacity:0;transform:scale(.4);}65%{opacity:1;}100%{opacity:0;transform:scale(1.5);}}
.gc-t{display:flex;flex-direction:column;gap:2px;min-width:0;}
.gc-t b{font-family:var(--serif);font-weight:500;font-size:17px;letter-spacing:.06em;}
.gc-t small{font-size:12px;letter-spacing:.06em;color:rgba(243,233,218,.62);}
.gc-ar{font-size:18px;color:#D4A24C;transition:transform .45s var(--ease);}
.give-cta:hover .gc-ar{transform:translate(3px,-3px);}
@media(prefers-reduced-motion:reduce){.give-cta:hover .gc-ic svg,.give-cta:hover .gc-ic i{animation:none;}}
/* 善的循環：3D 年輪木樁 + 一行說明 */
.support .give{display:grid;gap:12px;margin-top:22px;padding:16px;background:linear-gradient(135deg,rgba(138,43,61,.07),rgba(138,43,61,.02));border-top:1px solid rgba(28,15,20,.12);color:#1C0F14;}
.flow-key li.kg{position:relative;cursor:help;}
.gv-pop{position:absolute;left:-6px;bottom:calc(100% + 10px);z-index:30;width:min(300px,86vw);display:grid;gap:9px;padding:14px;background:#2A1219;border:1px solid rgba(212,162,76,.55);box-shadow:0 22px 40px -14px rgba(20,6,10,.75);color:#F1E4D2;opacity:0;visibility:hidden;transform:translateY(6px);transition:opacity .25s,transform .25s,visibility .25s;pointer-events:none;text-align:left;}
.gv-pop::after{content:"";position:absolute;left:26px;bottom:-6px;width:10px;height:10px;background:#2A1219;border-right:1px solid rgba(212,162,76,.55);border-bottom:1px solid rgba(212,162,76,.55);transform:rotate(45deg);}
.flow-key li.kg:hover .gv-pop,.flow-key li.kg:focus-within .gv-pop,.flow-key li.kg.open .gv-pop{opacity:1;visibility:visible;transform:none;pointer-events:auto;}
.gv-pop .gv-k{font-size:11px;letter-spacing:.24em;color:#D4A24C;}
.gv-pop .gv-l{font-size:13.5px;line-height:1.65;color:#F1E4D2;}
.gv-pop .gv-l strong{font-family:var(--latin);font-weight:600;font-size:17px;color:#F0B9A0;}
.gv-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.gv-pop a{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;padding:12px 8px 10px;text-align:center;border:1px solid rgba(240,185,160,.35);background:rgba(255,255,255,.05);color:#F1E4D2;text-decoration:none;transition:border-color .3s,background .3s;}
.gv-pop a:hover,.gv-pop a:focus-visible{border-color:#D4A24C;background:rgba(255,255,255,.12);outline:none;}
.gv-flag{width:28px;height:19px;flex:none;box-shadow:0 0 0 1px rgba(255,255,255,.25);}
.gv-pop a em{font-style:normal;display:grid;gap:2px;font-size:12.5px;line-height:1.35;min-width:0;justify-items:center;}
.gv-pop a em strong{font-weight:400;font-size:10.5px;letter-spacing:.18em;color:#BFA894;}
.gv-pop a small{display:none;}
.gv-pop .gv-n{font-size:12.5px;line-height:1.7;color:#D9C8B6;}
.gv-pop .gv-n strong{font-weight:600;color:#F0B9A0;}
@media(prefers-reduced-motion:reduce){.gv-pop{transition:none;}}
.support .gline{margin:0;font-size:13.5px;line-height:1.75;color:#3A2A2D;}
.support .gline b{font-family:var(--latin);font-weight:600;font-size:17px;color:#8A2B3D;}
.support .gnum{display:flex;flex-wrap:wrap;gap:4px 18px;margin-top:8px;font-size:12px;}
.support .gnum dt{color:#7A6A6C;}
.support .gnum dd{font-family:var(--latin);font-size:17px;color:#1C0F14;}
.support .glink{display:inline-block;margin-top:6px;font-size:12.5px;color:#5B4B4E;border-bottom:1px solid #8A2B3D;padding-bottom:1px;transition:color .3s;}
.support .glink:hover{color:#8A2B3D;}
.flow{margin-top:2px;}
.flow-k{margin:0 0 8px!important;font-size:11px!important;letter-spacing:.24em;color:#A07A3A!important;}
.end-card .support .give{margin-top:0;margin-bottom:24px;padding:14px 16px;border-top:0;border-left:2px solid rgba(138,43,61,.35);background:rgba(138,43,61,.04);}
.end-card .flow-key{margin-top:0;gap:5px;font-size:12.5px;}
.end-card .flow-key li span{text-wrap:balance;}
@media(max-width:400px){.end-card .support{padding:26px 18px 22px;}.ec-ring{padding:20px 12px 24px;}.ec-ring canvas{height:200px;}
  .end-card .give-cta{grid-template-columns:36px minmax(0,1fr) auto;gap:10px;padding:12px 12px 12px 10px;}.end-card .gc-ic{width:36px;height:36px;}.end-card .gc-ic svg{width:13px;height:18px;}.end-card .gc-ic .cup{width:20px;height:20px;}
  .end-card .gc-t b{font-size:15.5px;letter-spacing:.02em;white-space:nowrap;}.end-card .gc-ar{font-size:16px;}.end-card .support h3{font-size:19px;}}
@media(max-width:340px){.sec.closing{padding-left:12px;padding-right:12px;}.end-card .gc-t b{font-size:14.5px;letter-spacing:0;}.end-card .gc-t small{font-size:11px;}}
