/* 通用：開啟狀態（hover / 點擊 / 鍵盤） */
.pay-morph .pm-face,.pay-morph .pm-tiers .pay-t{transition:opacity .38s var(--pm-e),transform .5s var(--pm-e),filter .38s var(--pm-e),clip-path .55s var(--pm-e);}
.pay-morph.open .pm-tiers,.pay-morph:has(:focus-visible) .pm-tiers{pointer-events:auto;}
.pay-morph.open .pm-face,.pay-morph:has(:focus-visible) .pm-face{pointer-events:none;}
.pay-morph.open .pm-tiers .pay-t,.pay-morph:has(:focus-visible) .pm-tiers .pay-t{opacity:1;transform:none;filter:none;clip-path:inset(0);}
.pay-morph.open .pm-tiers .t2,.pay-morph:has(:focus-visible) .pm-tiers .t2{transition-delay:.06s;}
.pay-morph.open .pm-tiers .t3,.pay-morph:has(:focus-visible) .pm-tiers .t3{transition-delay:.12s;}
@media(hover:hover){.pay-morph:hover .pm-tiers{pointer-events:auto;}.pay-morph:hover .pm-face{pointer-events:none;}
.pay-morph:hover .pm-tiers .pay-t{opacity:1;transform:none;filter:none;clip-path:inset(0);}
.pay-morph:hover .pm-tiers .t2{transition-delay:.06s;}.pay-morph:hover .pm-tiers .t3{transition-delay:.12s;}}
/* 翻牌（原卡片往上翻走，三張由下翻上來） */
