                {pillars.map((p, i) => { const [x, y] = pt(i, 1.2); return <a href={`/pillars/${p.slug}`}><text class="axis" x={x.toFixed(1)} y={(y + 7).toFixed(1)} text-anchor="middle">{p.kanji}</text></a>; })}
              </svg>
            </div>
            <ul class="plegend" id="pLegend">
              {pillars.map((p) => <li style={`--dc:var(--c-${p.slug})`}><a href={`/pillars/${p.slug}`}><span class="k">{p.kanji}</span><span class="n">{p.type}<small>{p.title}</small></span><svg class="dring" data-ring={p.slug} viewBox="-16 -16 32 32" aria-hidden="true"></svg><span class="nd"><b class="num" data-d={p.slug}>{counts[p.slug]}</b><span class="dan" data-dan={p.slug}>{dan(counts[p.slug])}</span></span></a></li>)}
            </ul></div>
            <p class="dir-note" id="pNote">小年輪：每升一段長一圈，外圈的弧＝離下一段還差多少。段位：10 篇初段、30 篇二段、60 篇三段、100 篇四段。</p>
          </aside>
        </div>
      </div>
      <div id="vDream" hidden>
        <div class="cho-wrap">
          <div class="cho-head"><span class="t">祈願所</span><span class="y">40 歲生日（{fortieth}）前要完成的事</span><span class="s">{dreams.intro}</span></div>
          <div class="cho-scroll"><div class="cho-row">
          {dreams.items.filter((d: any) => d.public).map((d: any, i: number) => { const st = ({ idea: '許願', doing: '進行中', done: '已實現' } as any)[d.state] || '許願'; const raw = Number(d.progress); const hasPg = d.progress !== '' && d.progress != null && Number.isFinite(raw); const pg = d.state === 'done' ? 100 : d.state === 'idea' ? 0 : Math.max(5, Math.min(100, hasPg ? Math.round(raw) : 30)); const g = d.state === 'idea' ? 0 : (0.4 + pg / 100 * 0.6).toFixed(2);
            const href = safeHref(d.link); const cls = `cho ${d.state}${href ? ' go' : ''}`; const sty = `--n:${i};--g:${g}`;
            const inner = (<><div class="lan" aria-hidden="true">{href ? <span class="pin" title="可以點開">↗</span> : <span class="pin-none"></span>}<span class="str"></span><span class="cp"></span><span class="bd">願{d.state === 'done' && <span class="stamp">叶</span>}</span><span class="cp2"></span><span class="tas"></span></div>
