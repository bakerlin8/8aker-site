---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { pillars } from '../data/pillars';
import copy from '../data/site-copy.json';
import proof from '../data/proof-cards.json';

const collectionEntries = await Promise.all(
  pillars.map(async (p) => {
    const entries = await getCollection(p.slug, ({ data }) => !data.draft);
    return { slug: p.slug, entries };
  })
);

const allArticles = collectionEntries.flatMap(({ slug, entries }) =>
  entries.map((e) => ({ pillarSlug: slug, ...e }))
);
allArticles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = allArticles.slice(0, 5);
const totalCount = allArticles.length;
const pillarCount = pillars.length;

const pillarLabel = (slug: string) => pillars.find((p) => p.slug === slug)?.title ?? '';
const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title="8AKER — 七転び八起">
<div class="masthead">8AKER · VOL. 01 / 2026 · <b>七転び八起</b> — the diary before the eighth rise</div>

