              <p class="st">{st}{d.state === 'doing' && hasPg && `・${pg}%`}</p></>);
            return href ? <a class={cls} style={sty} href={href} aria-label={`${d.title}（點開看相關內容）`}>{inner}</a> : <article class={cls} style={sty}>{inner}</article>; })}
          </div></div>
          <p class="cho-hint">← 左右滑動看全部 →</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sec band-light" id="journal" aria-labelledby="j-h">
