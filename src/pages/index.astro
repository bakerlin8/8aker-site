      </div>}
      {aboutPhoto && <div class="me has-photo"><img class="me-photo rv" style="--i:2" src={aboutPhoto} alt="林子翔（巴）" loading="lazy" decoding="async" /></div>}
      <div class="svc-head rv" style="--i:3"><small>SERVICES</small><h3>有聯絡直接聊，初見面先填表</h3></div>
      <ol class="hats" id="hats">
        {services.hats.map((h: any, i: number) => (
