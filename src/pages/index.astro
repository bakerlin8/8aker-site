.flow-bar{position:relative;}
.flow-bar .fb{position:relative;overflow:visible;border-radius:0 2px 2px 0;box-shadow:inset 0 1px 0 rgba(255,255,255,.18);}
.flow-bar .fb::before{content:"";position:absolute;inset:0;background:linear-gradient(105deg,transparent 35%,rgba(255,235,200,.6) 50%,transparent 65%) no-repeat;background-size:300% 100%;background-position:100% 0;animation:fbshine 3.6s ease-in-out 1.4s infinite;}
@keyframes fbshine{0%,45%{background-position:100% 0;}80%,100%{background-position:0 0;}}
.flow-bar b{font-family:var(--latin);font-weight:500;font-size:12.5px;}
.support.in .flow-bar span{animation:fgrow 1s var(--ease) var(--d,0s) both;}
@keyframes fgrow{from{transform:scaleX(0);}to{transform:none;}}
.flow-key{list-style:none;margin:8px 0 0;padding:0;display:grid;gap:3px;font-size:12px;line-height:1.6;color:#5B4B4E;}
.flow-key li{display:flex;align-items:baseline;gap:6px;}
.flow-key i{flex:none;width:9px;height:9px;align-self:center;}
.flow-key .kg{color:#8A2B3D;}.flow-key .kg b{color:#8A2B3D;}
.flow-key .kg span,.flow-key .kg b{background:linear-gradient(100deg,#8A2B3D 0 40%,#E7B36A 50%,#8A2B3D 60% 100%);background-size:250% 100%;background-position:100% 0;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:kgshine 4.2s ease-in-out 1s infinite;}
.flow-key .kg i{position:relative;animation:kgbeat 4.2s ease-in-out 1s infinite;}
.flow-key .kg i::after{content:"";position:absolute;inset:-1px;border:1px solid #8A2B3D;opacity:0;animation:kgring 4.2s ease-out 1s infinite;}
@keyframes kgshine{0%,40%{background-position:100% 0;}75%,100%{background-position:0 0;}}
@keyframes kgbeat{0%,38%,58%,100%{transform:none;}44%{transform:scale(1.25);}50%{transform:scale(1);}53%{transform:scale(1.15);}}
@keyframes kgring{0%,40%{opacity:0;transform:scale(1);}45%{opacity:.8;}80%,100%{opacity:0;transform:scale(2.6);}}
.flow-key b{font-family:var(--latin);font-weight:600;color:#1C0F14;min-width:2.4em;}
@media(prefers-reduced-motion:reduce){.flow-key .kg span,.flow-key .kg b,.flow-key .kg i,.flow-key .kg i::after{animation:none;}.support.in .flow-bar span,.flow-bar .fb::before{animation:none;}}
