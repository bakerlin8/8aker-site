/* ── 服務卡 ── */
.hat{position:relative;overflow:hidden;isolation:isolate;}
.hat>*{position:relative;z-index:1;}
.hat .hk,.hat h3,.hat p,.hitems li{transition:color .45s var(--ease),border-color .45s var(--ease),transform .55s var(--ease),text-shadow .45s;}
/* 服務卡：光の縁＋三張卡各一色（酒・金・生成り：玫瑰紅／金／米白） */
@property --ang{syntax:'<angle>';initial-value:0deg;inherits:false;}
.hats .hat:nth-child(3n+1){--hc:196,86,107;--hl:236,160,176;}
.hats .hat:nth-child(3n+2){--hc:212,162,76;--hl:243,217,160;}
.hats .hat:nth-child(3n+3){--hc:214,196,172;--hl:245,234,218;}
.hats .hat{--hc:212,162,76;--hl:243,217,160;border-color:rgba(var(--hc),.26);background:radial-gradient(240px circle at var(--mx,50%) var(--my,50%),rgba(var(--hc),.20),transparent 70%),linear-gradient(160deg,rgba(var(--hc),.2),rgba(var(--hc),.05) 70%),var(--night-2);transition:transform .55s var(--ease),border-color .4s;}
.hats .hat .hk{color:rgb(var(--hc));}
.hats .hitems li{border-color:rgba(var(--hc),.42);}
.hats .hat::before{content:'';position:absolute;inset:0;padding:1.5px;z-index:0;background:conic-gradient(from var(--ang),transparent 0 60%,rgba(var(--hl),1) 78%,rgb(var(--hc)) 87%,transparent 97%);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:0;transition:opacity .4s;}
.hats .hat:hover{transform:translateY(-3px);border-color:rgba(var(--hc),.5);}
.hats .hat:hover::before{opacity:1;animation:hatSpin 2.4s linear infinite;}
.hats .hat:hover .hk{text-shadow:0 0 18px rgba(var(--hl),.8);color:rgb(var(--hl));}
.hats .hat:hover .hitems li{border-color:rgba(var(--hl),.6);}
/* 字標浮水印：大字淡淡地從卡底浮上來 */
.hats .hat::after{content:attr(data-k);position:absolute;right:-6px;bottom:-26px;font-family:var(--jp);font-size:120px;line-height:1;color:rgba(var(--hc),.16);z-index:0;transform:translateY(24px) scale(.9);opacity:0;transition:transform .7s var(--ease),opacity .5s;pointer-events:none;}
.hats .hat:hover::after{transform:none;opacity:1;}
/* 服務卡燈箱 */
.hat-hit{position:absolute;inset:0;z-index:2;background:none;border:0;padding:0;cursor:pointer;-webkit-tap-highlight-color:transparent;}
.hat-hit:focus-visible{outline:2px solid rgba(var(--hl),.85);outline-offset:3px;}
.hmore{display:inline-block;margin-top:14px;font-size:12px;letter-spacing:.18em;color:rgb(var(--hc));opacity:.85;transition:transform .4s var(--ease),opacity .3s,color .3s;}
.hats .hat:hover .hmore{transform:translateX(4px);opacity:1;color:rgb(var(--hl));}
html:has(.svc-dlg[open]){overflow:hidden;scrollbar-gutter:stable;}
.svc-dlg{border:1px solid rgba(var(--hc),.5);padding:0;margin:auto;width:min(580px,calc(100vw - 32px));max-height:calc(100dvh - 40px);overflow:hidden;color:#EFE5D6;background:radial-gradient(420px circle at 85% 0%,rgba(var(--hc),.22),transparent 70%),linear-gradient(160deg,rgba(var(--hc),.2),rgba(var(--hc),.05) 70%),#26141B;box-shadow:0 40px 80px -24px rgba(0,0,0,.75);}
.svc-dlg::backdrop{background:rgba(20,8,12,.66);backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);}
.svc-dlg[open]::backdrop{animation:svcbd .45s ease both;}
.svc-dlg.closing::backdrop{animation:svcbd .38s ease reverse both;}
@keyframes svcbd{from{opacity:0;}to{opacity:1;}}
.svc-dlg::after{content:attr(data-k);position:absolute;right:-8px;bottom:-40px;font-family:var(--jp);font-size:190px;line-height:1;color:rgba(var(--hc),.14);pointer-events:none;z-index:0;}
.svc-in{position:relative;z-index:1;max-height:calc(100dvh - 42px);overflow:auto;overscroll-behavior:contain;padding:34px 30px 28px;}
