<script type="application/json" id="page-data" set:html={json}></script>

<script is:inline>
(function(){
var D=JSON.parse(document.getElementById('page-data').textContent);
var RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
var DAY=864e5,pad=function(n){return String(n).padStart(2,'0');};
var START=new Date(D.start).getTime(),TARGET=new Date(D.target).getTime();
var jst=function(t){return new Date(t+9*3600e3).toISOString().slice(0,10);};
var dirOf=function(id){for(var i=0;i<D.dirs.length;i++)if(D.dirs[i].id===id)return D.dirs[i];return D.dirs[0];};
var col=function(id){return 'var(--c-'+id+')';};
var hero=document.querySelector('.hero');
requestAnimationFrame(function(){requestAnimationFrame(function(){hero.classList.add('in');hero.querySelectorAll('.rv').forEach(function(r){r.classList.add('in');});});});

/* 年輪倒數：第 N 圈（滿 N 歲）還有幾天長完 = 距離下一個生日的天數；一天只變一次 */
(function(){var d=document.getElementById('cdD'),p=document.getElementById('cdP');if(!d||!D.birth)return;
  var b=D.birth.split('-').map(Number),bd=function(y){return new Date(y+'-'+pad(b[1])+'-'+pad(b[2])+'T00:00:00+09:00').getTime();};
  function t(){var now=Date.now(),y=new Date(now+9*3600e3).getUTCFullYear();if(bd(y)>now)y--;var n=y-b[0],left=Math.ceil((bd(y+1)-now)/DAY);
    if(p)p.textContent=(D.ringLabel||'第 {n} 圈，還有').replace('{n}',n);d.textContent=left;}
  t();setInterval(t,60000);})();

/* age rings: one ring a year, current ring drawn to the fraction of the year */
(function(){var cv=document.getElementById('art');if(!cv)return;var ctx=cv.getContext('2d'),W=0,H=0,dpr=1,run=true,last=0,t=0,raf=0,started=false;
  var b=D.birth.split('-').map(Number),bd=function(y){return new Date(y+'-'+pad(b[1])+'-'+pad(b[2])+'T00:00:00+09:00').getTime();};
  var now=Date.now(),y=new Date(now+9*3600e3).getUTCFullYear();if(bd(y)>now)y--;
  var full=y-b[0],frac=(now-bd(y))/(bd(y+1)-bd(y)),total=Math.max(40,full+1);
  var rnd=function(a,c){return a+Math.random()*(c-a);},seed=[rnd(0,6.28),rnd(0,6.28)],acc=0,rr=[0];
  for(var i=1;i<=total;i++){acc+=rnd(.75,1.3);rr.push(acc);}
  /* 年輪「向光而長」：30 歲前在台灣，圍著同一個中心長；搬到日本後，年輪往東北（日本的方向）偏心生長。 */
  var MOVE=D.move||30,N=180,LEAN=-0.62,RX=[],RY=[];
  for(i=1;i<=total;i++){var f=rr[i]/acc,r=.03+f*.97,k=Math.max(0,i-MOVE)/10,ox=-.08+.088*k,oy=.05-.064*k,xs=new Float32Array(N),ys=new Float32Array(N);
    for(var j=0;j<N;j++){var t=-Math.PI/2+j/N*6.2832,w=1+.03*Math.sin(t*3+seed[0])+.018*Math.sin(t*5+seed[1]+f*2)+.009*Math.sin(t*11+f*4),bias=i>MOVE?1+.18*k*Math.cos(t-LEAN):1,rad=r*w*bias;
      xs[j]=ox+Math.cos(t)*rad;ys[j]=oy+Math.sin(t)*rad;}
    RX[i]=xs;RY[i]=ys;}
  /* 3D 木頭切片：年輪刻在一片斜放、有厚度的木頭上，非常慢地轉；滑鼠移動時微微傾斜 */
  var CX=0,CY=0,S=1,YAW=0,TILT=1.0,mx=0,my=0,smx=0,smy=0,TH=.13;
  addEventListener('pointermove',function(e){if(e.pointerType!=='mouse')return;mx=e.clientX/innerWidth-.5;my=e.clientY/innerHeight-.5;},{passive:true});
  function geom(){var wide=W>900*dpr;if(wide){S=Math.min(W*.34,H*.56);CX=W*.5;CY=H*.6;}else{S=Math.min(W*.42,H*.26);CX=W*.5;CY=H*.76;}}
  var cY=1,sY=0,cT=1,sT=0;
  function P(px,py,pz){var X=px*cY-py*sY,Y=px*sY+py*cY,sy=Y*cT-pz*sT,d=Y*sT+pz*cT,q=3/(3+d*.7);return [CX+X*S*q,CY+sy*S*q];}
  function path(c,i,p,z){var xs=RX[i],ys=RY[i],n=Math.max(1,Math.floor(N*p)),a=P(xs[0],ys[0],z||0);c.beginPath();c.moveTo(a[0],a[1]);for(var j=1;j<=n;j++){var k=j%N;a=P(xs[k],ys[k],z||0);c.lineTo(a[0],a[1]);}}
  function bake(){}
  function size(force){var nd=Math.min(devicePixelRatio||1,innerWidth<900?1.5:2),r=cv.parentElement.getBoundingClientRect(),nw=Math.round(r.width*nd),nh=Math.round(r.height*nd);
    if(!force&&nw===W&&Math.abs(nh-H)<160*nd)return false;dpr=nd;W=cv.width=nw;H=cv.height=nh;geom();return true;}
  function frame(dt){t+=dt;var g=Math.min(1,t/3.5),e=1-Math.pow(1-g,3);ctx.clearRect(0,0,W,H);
    smx+=(mx-smx)*.05;smy+=(my-smy)*.05;YAW=-.35+t*.035+smx*.5;TILT=1.0+smy*.25;cY=Math.cos(YAW);sY=Math.sin(YAW);cT=Math.cos(TILT);sT=Math.sin(TILT);
    var oS=S;S=oS*(.55+.45*e);ctx.globalAlpha=e;ctx.lineJoin='round';
    var o=full+1,xs=RX[o],ys=RY[o],j,a;
    /* 側面（樹皮） */
    ctx.beginPath();for(j=0;j<=N;j++){a=P(xs[j%N],ys[j%N],-TH);j?ctx.lineTo(a[0],a[1]):ctx.moveTo(a[0],a[1]);}for(j=N;j>=0;j--){a=P(xs[j%N],ys[j%N],0);ctx.lineTo(a[0],a[1]);}
    var gr=ctx.createLinearGradient(0,CY-S*.3,0,CY+S*.7);gr.addColorStop(0,'#3a2016');gr.addColorStop(1,'#1d0f0b');ctx.fillStyle=gr;ctx.fill();
    for(j=0;j<N;j+=6){var a1=P(xs[j],ys[j],0),a2=P(xs[j],ys[j],-TH);ctx.beginPath();ctx.moveTo(a1[0],a1[1]);ctx.lineTo(a2[0],a2[1]);ctx.strokeStyle='rgba(0,0,0,.22)';ctx.lineWidth=dpr;ctx.stroke();}
    /* 切面 */
    path(ctx,o,1,0);ctx.closePath();var fg=ctx.createRadialGradient(CX,CY,0,CX,CY,S*1.1);fg.addColorStop(0,'rgba(58,26,30,.95)');fg.addColorStop(1,'rgba(40,18,22,.95)');ctx.fillStyle=fg;ctx.fill();
    /* 台灣的年＝玫瑰色，搬家那年加亮，日本的年＝金色 */
    for(var i=1;i<=full;i++){var f,col,lw;
      if(i<MOVE){f=i/MOVE;col='rgba(196,140,150,'+(.07+.24*f*f).toFixed(3)+')';lw=(.7+.3*f)*dpr;}
      else if(i===MOVE){col='rgba(214,160,170,.6)';lw=1.3*dpr;}
      else{f=(i-MOVE)/Math.max(1,full-MOVE);col='rgba(212,162,76,'+(.2+.35*f).toFixed(3)+')';lw=(.9+.3*f)*dpr;}
      ctx.strokeStyle=col;ctx.lineWidth=lw;path(ctx,i,1,0);ctx.closePath();ctx.stroke();}
    var p=frac*e,br=.5+.5*Math.sin(t*1.3);
    path(ctx,o,1,0);ctx.closePath();ctx.strokeStyle='rgba(236,196,118,.35)';ctx.lineWidth=dpr;ctx.stroke();
    path(ctx,o,p,0);ctx.strokeStyle='rgba(212,162,76,'+(.10+.08*br).toFixed(3)+')';ctx.lineWidth=7*dpr;ctx.stroke();
    ctx.strokeStyle='rgba(236,196,118,.92)';ctx.lineWidth=1.7*dpr;ctx.stroke();
    S=oS;ctx.globalAlpha=1;if(g>.98)tip(Math.floor(N*frac)%N);}
  function tip(k){var a=P(RX[full+1][k],RY[full+1][k],0),x=a[0],yy=a[1];
    for(var q=0;q<3;q++){var ph=((t*.55)+q/3)%1;ctx.beginPath();ctx.arc(x,yy,(4+ph*28)*dpr,0,6.2832);ctx.strokeStyle='rgba(236,196,118,'+((1-ph)*.55).toFixed(3)+')';ctx.lineWidth=dpr;ctx.stroke();}
    ctx.beginPath();ctx.arc(x,yy,9*dpr,0,6.2832);ctx.fillStyle='rgba(212,162,76,.18)';ctx.fill();
    ctx.beginPath();ctx.arc(x,yy,3.6*dpr,0,6.2832);ctx.fillStyle='rgb(236,196,118)';ctx.fill();}
  /* 切片轉得很慢，每兩幀畫一次就夠順，省一半運算 */
  var acc2=0,odd=false;function loop(ts){if(!run)return;var dt=last?Math.min(.05,(ts-last)/1e3):0;last=ts;acc2+=dt;odd=!odd;if(odd){frame(acc2);acc2=0;}raf=requestAnimationFrame(loop);}
  var rt=0;addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(function(){if(size(false)&&(RM||!run))frame(0);},150);});
  function start(){if(started)return;started=true;size(true);
    if(RM){t=9;frame(0);return;}
    raf=requestAnimationFrame(loop);
    new IntersectionObserver(function(es){es.forEach(function(e){run=e.isIntersecting;cancelAnimationFrame(raf);if(run){last=0;raf=requestAnimationFrame(loop);}});},{threshold:.05}).observe(cv.parentElement);}
  /* 等字型與第一屏排好再開始長，避開開場最忙的那一秒 */
  if(document.fonts&&document.fonts.ready){Promise.race([document.fonts.ready,new Promise(function(r){setTimeout(r,700);})]).then(function(){requestAnimationFrame(start);});}else requestAnimationFrame(start);})();


/* 有點樣子：唱盤（目前那件在中間，其他沿著弧線轉到兩側；唱片從封套滑出、轉動） */
(function(){var D=document.getElementById('deck');if(!D)return;var C=[].slice.call(D.querySelectorAll('.work')),T=[].slice.call(document.querySelectorAll('#wTicks [data-go]')),NOW=document.getElementById('wNow'),VL=null,n=C.length,cur=0;
  function pad(x){return (x<10?'0':'')+x;}
  function lay(){var mob=innerWidth<640;C.forEach(function(el,k){var d=k-cur,a=Math.abs(d),x=d*(mob?62:58),z=-a*(mob?220:180),ry=-d*(mob?32:26);
      el.style.transform='translateX('+x+'%) translateZ('+z+'px) rotateY('+ry+'deg)';el.style.opacity=a>3?0:(1-a*.28).toFixed(2);el.style.filter=a?'brightness(.6) saturate(.8)':'none';el.style.zIndex=100-a;el.style.pointerEvents=a>3?'none':'auto';
      el.classList.toggle('on',d===0);el.setAttribute('aria-hidden',d===0?'false':'true');el.tabIndex=d===0?0:-1;});
    T.forEach(function(b,k){b.setAttribute('aria-current',k===cur?'true':'false');});var t=T[cur];if(t&&t.scrollIntoView)t.parentElement.parentElement.scrollLeft=t.offsetLeft-60;
    NOW.textContent=pad(cur+1);if(VL)VL.textContent=pad(cur+1);}
  function go(i){i=Math.max(0,Math.min(n-1,i));if(i===cur)return;cur=i;lay();}
  document.getElementById('wPrev').addEventListener('click',function(){go(cur-1);});document.getElementById('wNext').addEventListener('click',function(){go(cur+1);});
  T.forEach(function(b){b.addEventListener('click',function(){go(+b.dataset.go);});});
  C.forEach(function(el,k){el.addEventListener('click',function(e){if(k!==cur){e.preventDefault();go(k);}});});
  D.addEventListener('keydown',function(e){if(e.key==='ArrowRight'){go(cur+1);e.preventDefault();}if(e.key==='ArrowLeft'){go(cur-1);e.preventDefault();}});
  // 左右滑動（手機）／拖曳（滑鼠）
  var sx=null,sy=0,moved=false;D.addEventListener('pointerdown',function(e){sx=e.clientX;sy=e.clientY;moved=false;});
  D.addEventListener('pointermove',function(e){if(sx===null)return;if(Math.abs(e.clientX-sx)>10&&Math.abs(e.clientX-sx)>Math.abs(e.clientY-sy))moved=true;});
  D.addEventListener('pointerup',function(e){if(sx===null)return;var dx=e.clientX-sx;sx=null;if(moved&&Math.abs(dx)>40)go(cur+(dx<0?1:-1));});
  D.addEventListener('click',function(e){if(moved){e.preventDefault();e.stopPropagation();moved=false;}},true);
  // 觸控板左右滑
  var acc=0,lock=0;D.addEventListener('wheel',function(e){if(Math.abs(e.deltaX)<=Math.abs(e.deltaY))return;e.preventDefault();var now=Date.now();if(now<lock)return;acc+=e.deltaX;if(Math.abs(acc)>40){go(cur+(acc>0?1:-1));acc=0;lock=now+450;}},{passive:false});
  lay();addEventListener('resize',lay);})();

/* 連載: 第 0 話 … 第 11 話 → 第一卷 */
(function(){var C=D.chapters,now=Date.now(),T=function(d){return new Date(d+'T00:00:00+09:00').getTime();};
  var list=C.chapters.map(function(c){return Object.assign({},c);});list.push(Object.assign({final:true,no:12},C.volume));
  var nextIdx=list.findIndex(function(r){return T(r.date)>=now;});if(nextIdx<0)nextIdx=list.length;
  list.forEach(function(r,i){r.days=Math.floor((T(r.date)-now)/DAY);r.state=i<nextIdx?(r.on_break?'break':'done'):i===nextIdx?'next':'future';
    var a=(C.arcs||[]).filter(function(a){return !r.final&&r.no>=a.from&&r.no<=a.to;})[0];r.arc=a?a.name:'';});
  var md=function(r){return (+r.date.slice(5,7))+'.'+r.date.slice(8);},label=function(r){return r.final?'第一卷':'第 '+r.no+' 話';};
  var esc=function(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;');};
  var nr=list[Math.min(nextIdx,list.length-1)];
  var nrEl=document.getElementById('nextRel');if(nrEl)nrEl.innerHTML=(nr.no===0?'新連載・':'連載中・')+label(nr)+'・'+(+nr.date.slice(5,7))+' 月 '+(+nr.date.slice(8))+' 日刊出 <b>'+(nr.days<=0?'今天':nr.days+' 天後')+'</b>';
  var Tr=document.getElementById('track'),Md=document.getElementById('mdetail');
  Tr.innerHTML=list.map(function(r,i){return '<li><button class="node '+r.state+(r.final?' final':'')+'" data-i="'+i+'" aria-label="'+label(r)+'，'+md(r)+'"><span class="dot">'+(r.final?'巻':'')+'</span><span class="r">'+label(r)+'</span><span class="d">'+md(r)+'</span></button></li>';}).join('')
    +'<span class="fill" style="width:calc((100% - 64px) * '+Math.max(0,nextIdx-.5)/(list.length-1)+')"></span>';

  function items(arr,withDir){return '<ul>'+arr.map(function(x){var d=withDir&&x.dir?dirOf(x.dir):null;return '<li'+(d?' style="--dc:'+col(d.id)+'"':'')+'><span class="k">'+(d?d.k:'・')+'</span><span>'+esc(x.text||x)+'</span></li>';}).join('')+'</ul>';}
  function show(i){var r=list[i];Tr.querySelectorAll('.node').forEach(function(n){n.setAttribute('aria-current',+n.dataset.i===i);});
    var st={done:'<b>已刊出</b>',break:'<b>休載</b>',next:'<b>製作中</b>還有 '+r.days+' 天',future:'還有 '+r.days+' 天'}[r.state]+(r.arc?'・'+r.arc:'');
    var b='';
    if(r.state==='done'||r.state==='break'){b+=r.summary?'<p>'+esc(r.summary)+'</p>':'';b+=(r.keep&&r.keep.length)?'<h4>這一話留下的</h4>'+items(r.keep):'';b+=(r.letgo&&r.letgo.length)?'<h4>這一話放下的</h4>'+items(r.letgo):'';if(!b)b='<p>'+(r.state==='break'?'這個月休載。':'這一話的內容整理中。')+'</p>';}
    else if(r.final)b='<p>'+esc(r.summary)+'</p>';
    else if(r.plan&&r.plan.length)b='<p>這一話預計刊出的內容：</p>'+items(r.plan,true);
    else b='<p>這一話還在準備中，刊出當天公開。</p>';
    var from=i>0?list[i-1].date:D.start.slice(0,10),inRange=function(e){return (i>0?e.date>from:e.date>=from)&&e.date<=r.date;};
    var es=D.entries.filter(inRange),total=es.length,showT=!r.final&&(r.state!=='future');
    var cc={};D.dirs.forEach(function(d){cc[d.id]=es.filter(function(e){return e.dir===d.id;}).length;});
    var topD=D.dirs.slice().sort(function(a,b){return cc[b.id]-cc[a.id];})[0],hasTop=showT&&cc[topD.id]>0;
    Md.innerHTML='<p class="tag">'+st+'・'+r.date.replace(/-/g,'.')+'</p><h3>'+label(r)+'　'+esc(r.title)+'</h3>'+b+'<div class="mnums"><div><b class="num">'+(showT?total:'—')+'</b><small>'+(r.state==='next'?'這一話目前的文章':'這一話的文章')+'</small></div><div><b>'+(hasTop?'<span style="color:'+col(topD.id)+'">'+topD.k+'</span> '+topD.n:'—')+'</b><small>這一話寫最多的方向</small></div></div><a class="ch-link" href="/chapters/'+(r.final?'':r.no+'/')+'">'+(r.final?'看第一卷目次':'看完整的'+label(r))+' →</a>';
    CUR={counts:cc,label:showT?label(r)+'（'+from.slice(5).replace('-','.')+'–'+md(r)+'）':label(r)+'・尚未開始'};if(PM==='ch')penta('ch');}
  /* 五角形：全卷累計 ↔ 這一話 */
  var PM='all',CUR=null,PS=document.getElementById('pShape'),PD=[].slice.call(document.querySelectorAll('#penta .pdot')),PL=document.getElementById('pLabel'),PMB=document.getElementById('pMode');
  var dan=function(c){return c>=100?'四段':c>=60?'三段':c>=30?'二段':c>=10?'初段':'見習';};

  /* 段位小年輪：每升一段長一圈（見習 0 圈 → 四段 4 圈），最外面那條弧＝離下一段還差多少；「這一話」模式改顯示比例 */
  function ring(el,n,ratio){if(!el)return;var T=[0,10,30,60,100],tiers=0;while(tiers<4&&n>=T[tiers+1])tiers++;var R=[4,7.5,11,14.5],h='<circle r="1.6" fill="currentColor"/>';
    for(var gk=0;gk<4;gk++)h+='<circle r="'+R[gk]+'" stroke="currentColor" stroke-width=".8" opacity=".14"/>';
    if(ratio===null){for(var k=0;k<tiers;k++)h+='<circle r="'+R[k]+'" stroke="currentColor" stroke-width="1.4" opacity="'+(.6+k*.12)+'"/>';
      if(tiers<4){var r=R[tiers],c=2*Math.PI*r,f=(n-T[tiers])/(T[tiers+1]-T[tiers]);h+='<circle r="'+r+'" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-dasharray="'+Math.max(1.5,c*f).toFixed(2)+' '+c.toFixed(2)+'" transform="rotate(-90)"/>';}}
    else{var c2=2*Math.PI*14.5;h+='<circle r="14.5" stroke="currentColor" stroke-width="1" opacity=".18"/><circle r="14.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-dasharray="'+(c2*ratio).toFixed(2)+' '+c2.toFixed(2)+'" transform="rotate(-90)"/>';}
    el.innerHTML=h;el.style.color='var(--dc)';}
  function penta(m){PM=m;var c=m==='all'?D.totals:(CUR?CUR.counts:D.totals),top=Math.max(1,Math.max.apply(null,D.dirs.map(function(d){return c[d.id]||0;})));
    var pts=D.dirs.map(function(d,i){var v=.15+((c[d.id]||0)/top)*.85,a=-Math.PI/2+i*2*Math.PI/5;return [Math.cos(a)*150*v,Math.sin(a)*150*v];});
    PS.setAttribute('points',pts.map(function(p){return p[0].toFixed(1)+','+p[1].toFixed(1);}).join(' '));
    PD.forEach(function(el,i){el.setAttribute('cx',pts[i][0].toFixed(1));el.setAttribute('cy',pts[i][1].toFixed(1));});
    var prog=function(n){var T=[0,10,30,60,100];if(n>=100)return 100;for(var k=1;k<T.length;k++)if(n<T[k])return Math.round((n-T[k-1])/(T[k]-T[k-1])*100);return 100;};
    D.dirs.forEach(function(d){var n=c[d.id]||0;document.querySelector('[data-d="'+d.id+'"]').textContent=n;document.querySelector('[data-dan="'+d.id+'"]').textContent=m==='all'?dan(n):(n?'+'+n:'—');ring(document.querySelector('[data-ring="'+d.id+'"]'),n,m==='all'?null:n/top);});
    var PN=document.getElementById('pNote');if(PN)PN.textContent=m==='all'?'小年輪：每升一段長一圈，外圈的弧＝離下一段還差多少。段位：10 篇初段、30 篇二段、60 篇三段、100 篇四段。':'小年輪的弧＝這一話各方向的比例。';
    PL.textContent=m==='all'?'全卷累計':(CUR?CUR.label:'這一話');
    PMB.querySelectorAll('button').forEach(function(b){b.setAttribute('aria-pressed',b.dataset.m===m);});}
  PMB.addEventListener('click',function(e){var b=e.target.closest('button');if(b)penta(b.dataset.m);});
  D.dirs.forEach(function(d){ring(document.querySelector('[data-ring="'+d.id+'"]'),D.totals[d.id]||0,null);});
  Tr.addEventListener('click',function(e){var n=e.target.closest('.node');if(n)show(+n.dataset.i);});
  show(Math.min(nextIdx,list.length-1));
  requestAnimationFrame(function(){var w=Tr.parentElement,n=Tr.querySelector('.node.next');if(n&&w.scrollWidth>w.clientWidth){var li=n.closest('li');w.scrollLeft=Math.max(0,li.offsetLeft-w.clientWidth/2+li.offsetWidth/2);}});
  var MV=document.querySelector('.mv-toggle'),V1=document.getElementById('vOne'),V3=document.getElementById('vDream');
  function view(v){MV.querySelectorAll('button').forEach(function(b){b.setAttribute('aria-pressed',b.dataset.v===v);});V1.hidden=v!=='one';V3.hidden=v!=='dream';}
  if(location.hash==='#dreams'||location.hash==='#kiganjo')view('dream');
  MV.addEventListener('click',function(e){var b=e.target.closest('button');if(b)view(b.dataset.v);});
})();


/* 需求表：選服務 → 預先帶入；送出到私人收件匣 */
(function(){var F=document.getElementById('inquiry');if(!F)return;var M=document.getElementById('inqMsg'),SEL=F.querySelector('select[name=service]');
  document.addEventListener('click',function(e){var a=e.target.closest('[data-svc]');if(!a)return;var v=a.dataset.svc;if(v==='ai')v='ai';if([].some.call(SEL.options,function(o){return o.value===v;}))SEL.value=v;});
  F.addEventListener('submit',function(e){e.preventDefault();var fd=new FormData(F),b={};fd.forEach(function(v,k){b[k]=String(v);});b.lang=navigator.language||'';
    if(!b.name.trim()||!b.contact.trim()||b.message.trim().length<5){M.className='fmsg err';M.textContent='請填寫稱呼、聯絡方式和需求內容。';window.sfx&&sfx('error');return;}
    var btn=F.querySelector('button[type=submit]');btn.disabled=true;M.className='fmsg';M.textContent='送出中…';
    fetch('https://gsaqrjovipnfiedvjaeb.supabase.co/functions/v1/inquiry',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)})
      .then(function(r){return r.json().then(function(d){return {ok:r.ok,d:d};});})
      .then(function(x){if(!x.ok)throw new Error(x.d&&x.d.error||'送出失敗');F.reset();M.className='fmsg ok';M.textContent='已收到，我們會在 2 個工作天內回覆你。';window.sfx&&sfx('success');})
      .catch(function(err){M.className='fmsg err';M.textContent=(err&&err.message)||'送出失敗，請稍後再試。';window.sfx&&sfx('error');})
      .then(function(){btn.disabled=false;});});})();

/* journal filter */
(function(){var F=document.getElementById('filters'),rows=[].slice.call(document.querySelectorAll('.jrow')),E=document.getElementById('jempty');
  F.addEventListener('click',function(e){var b=e.target.closest('.chip');if(!b)return;var f=b.dataset.f,n=0;
    F.querySelectorAll('.chip').forEach(function(c){c.setAttribute('aria-pressed',c===b);});
    rows.forEach(function(r){var on=f==='all'||r.dataset.dir===f;r.hidden=!on;if(on)n++;});E.hidden=n>0;});})();
})();
