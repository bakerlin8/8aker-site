    for(var j=0;j<N;j++){var t=-Math.PI/2+j/N*6.2832,w=1+.03*Math.sin(t*3+seed[0])+.018*Math.sin(t*5+seed[1]+f*2)+.009*Math.sin(t*11+f*4),bias=i>MOVE?1+.18*k*Math.cos(t-LEAN):1,rad=r*w*bias;
      xs[j]=ox+Math.cos(t)*rad;ys[j]=oy+Math.sin(t)*rad;}
    RX[i]=xs;RY[i]=ys;}
  /* 3D 木頭切片：年輪刻在一片斜放、有厚度的木頭上，非常慢地轉；滑鼠移動時微微傾斜 */
  var CX=0,CY=0,S=1,YAW=0,TILT=1.0,mx=0,my=0,smx=0,smy=0,TH=.13;
  addEventListener('pointermove',function(e){if(e.pointerType!=='mouse')return;mx=e.clientX/innerWidth-.5;my=e.clientY/innerHeight-.5;},{passive:true});
  function geom(){var wide=W>900*dpr,phone=W<=720*dpr;if(wide){S=Math.min(W*.34,H*.56);CX=W*.5;CY=H*.6;}else if(phone){S=Math.min(W*.46,H*.4);CX=W*.5;var hg=document.querySelector('.hero-grid'),hr=hg?hg.getBoundingClientRect():null,cr=cv.getBoundingClientRect(),mid=hr?((hr.top+hr.bottom)/2-cr.top)*dpr:H*.5;CY=mid+S*.12;}else{S=Math.min(W*.42,H*.26);CX=W*.5;CY=H*.76;}}
  var cY=1,sY=0,cT=1,sT=0;
  function P(px,py,pz){var X=px*cY-py*sY,Y=px*sY+py*cY,sy=Y*cT-pz*sT,d=Y*sT+pz*cT,q=3/(3+d*.7);return [CX+X*S*q,CY+sy*S*q];}
  /* 畫一圈年輪：投影直接算在迴圈裡，不另外產生陣列（每幀上萬個點，省下記憶體回收造成的頓點） */
  function path(c,i,p,z){var xs=RX[i],ys=RY[i],n=Math.max(1,Math.floor(N*p)),zs=(z||0)*sT,zc=(z||0)*cT;c.beginPath();
    for(var j=0;j<=n;j++){var k=j%N,px=xs[k],py=ys[k],X=px*cY-py*sY,Y=px*sY+py*cY,q=S*3/(3+(Y*sT+zc)*.7),x=CX+X*q,y=CY+(Y*cT-zs)*q;j?c.lineTo(x,y):c.moveTo(x,y);}}
  /* 木頭切片本體（樹皮側面＋切面＋已長完的年輪）幾乎不動，先畫在一張暫存畫布上；只有傾斜角度真的變了才重畫 */
  var bc=document.createElement('canvas'),bx=bc.getContext('2d'),bkey='',lkey='',stab=0;
  function slab(c){var o=full+1,xs=RX[o],ys=RY[o],j,a;c.lineJoin='round';
    c.beginPath();for(j=0;j<=N;j++){a=P(xs[j%N],ys[j%N],-TH);j?c.lineTo(a[0],a[1]):c.moveTo(a[0],a[1]);}for(j=N;j>=0;j--){a=P(xs[j%N],ys[j%N],0);c.lineTo(a[0],a[1]);}
    var gr=c.createLinearGradient(0,CY-S*.3,0,CY+S*.7);gr.addColorStop(0,'#3a2016');gr.addColorStop(1,'#1d0f0b');c.fillStyle=gr;c.fill();
    c.beginPath();for(j=0;j<N;j+=6){var a1=P(xs[j],ys[j],0),a2=P(xs[j],ys[j],-TH);c.moveTo(a1[0],a1[1]);c.lineTo(a2[0],a2[1]);}c.strokeStyle='rgba(0,0,0,.22)';c.lineWidth=dpr;c.stroke();
    path(c,o,1,0);c.closePath();var fg=c.createRadialGradient(CX,CY,0,CX,CY,S*1.1);fg.addColorStop(0,'rgba(58,26,30,.95)');fg.addColorStop(1,'rgba(40,18,22,.95)');c.fillStyle=fg;c.fill();
