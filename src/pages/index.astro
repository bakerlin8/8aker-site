/* 連載: 第 0 話 … 第 11 話 → 第一卷 */
(function(){var C=D.chapters,now=Date.now(),T=function(d){return new Date(d+'T00:00:00+09:00').getTime();};
  var list=C.chapters.map(function(c){return Object.assign({},c);});list.push(Object.assign({final:true,no:12},C.volume));
  var nextIdx=list.findIndex(function(r){return T(r.date)>=now;});if(nextIdx<0)nextIdx=list.length;
  list.forEach(function(r,i){r.days=Math.floor((T(r.date)-now)/DAY);r.state=i<nextIdx?(r.on_break?'break':'done'):i===nextIdx?'next':'future';
    var a=(C.arcs||[]).filter(function(a){return !r.final&&r.no>=a.from&&r.no<=a.to;})[0];r.arc=a?a.name:'';});
  var md=function(r){return (+r.date.slice(5,7))+'.'+r.date.slice(8);},label=function(r){return r.final?'第一卷':'第 '+r.no+' 話';};
  var esc=function(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;');};
  var nr=list[Math.min(nextIdx,list.length-1)];
  document.getElementById('nextRel').innerHTML=(nr.no===0?'新連載・':'連載中・')+label(nr)+'・'+(+nr.date.slice(5,7))+' 月 '+(+nr.date.slice(8))+' 日刊出 <b>'+(nr.days<=0?'今天':nr.days+' 天後')+'</b>';
  var Tr=document.getElementById('track'),Md=document.getElementById('mdetail');
  Tr.innerHTML=list.map(function(r,i){return '<li><button class="node '+r.state+(r.final?' final':'')+'" data-i="'+i+'" aria-label="'+label(r)+'，'+md(r)+'"><span class="dot">'+(r.final?'巻':'')+'</span><span class="r">'+label(r)+'</span><span class="d">'+md(r)+'</span></button></li>';}).join('')
    +'<span class="fill" style="width:calc((100% - 64px) * '+Math.max(0,nextIdx-.5)/(list.length-1)+')"></span>';
  function items(arr,withDir){return '<ul>'+arr.map(function(x){var d=withDir&&x.dir?dirOf(x.dir):null;return '<li'+(d?' style="--dc:'+col(d.id)+'"':'')+'><span class="k">'+(d?d.k:'・')+'</span><span>'+esc(x.text||x)+'</span></li>';}).join('')+'</ul>';}
  function show(i){var r=list[i];Tr.querySelectorAll('.node').forEach(function(n){n.setAttribute('aria-current',+n.dataset.i===i);});
    var st={done:'<b>已刊出</b>',break:'<b>休載</b>',next:'<b>製作中</b>還有 '+r.days+' 天',future:'還有 '+r.days+' 天'}[r.state]+(r.arc?'・'+r.arc:'');
    var b='';
    if(r.state==='done'||r.state==='break'){b+=r.summary?'<p>'+esc(r.summary)+'</p>':'';b+=(r.keep&&r.keep.length)?'<h4>這一話留下的</h4>'+items(r.keep):'';b+=(r.letgo&&r.letgo.length)?'<h4>這一話放下的</h4>'+items(r.letgo):'';if(!b)b='<p>'+(r.state==='break'?'這個月休載。':'這一話的內容整理中。')+'</p>';}
    else if(r.final)b='<p>'+esc(r.summary)+'</p>';
    else if(r.plan&&r.plan.length)b='<p>這一話預計刊出的內容：</p>'+items(r.plan,true);
    else b='<p>這一話還在畫分鏡，刊出當天公開。</p>';
    var from=i>0?list[i-1].date:D.start.slice(0,10),inRange=function(e){return (i>0?e.date>from:e.date>=from)&&e.date<=r.date;};
    var es=D.entries.filter(inRange),total=es.length,showT=!r.final&&(r.state!=='future');
    var cc={};D.dirs.forEach(function(d){cc[d.id]=es.filter(function(e){return e.dir===d.id;}).length;});
    var topD=D.dirs.slice().sort(function(a,b){return cc[b.id]-cc[a.id];})[0],hasTop=showT&&cc[topD.id]>0;
    Md.innerHTML='<p class="tag">'+st+'・'+r.date.replace(/-/g,'.')+'</p><h3>'+label(r)+'　'+esc(r.title)+'</h3>'+b+'<div class="mnums"><div><b class="num">'+(showT?total:'—')+'</b><small>'+(r.state==='next'?'這一話目前的文章':'這一話的文章')+'</small></div><div><b>'+(hasTop?'<span style="color:'+col(topD.id)+'">'+topD.k+'</span> '+topD.n:'—')+'</b><small>這一話寫最多的方向</small></div></div><a class="ch-link" href="/chapters/'+(r.final?'':r.no+'/')+'">'+(r.final?'看第一卷目次':'看完整的'+label(r))+' →</a>';
    CUR={counts:cc,label:showT?label(r)+'（'+from.slice(5).replace('-','.')+'–'+md(r)+'）':label(r)+'・尚未開始'};if(PM==='ch')penta('ch');}
  /* 五角形：全卷累計 ↔ 這一話 */
  var PM='all',CUR=null,PS=document.getElementById('pShape'),PD=[].slice.call(document.querySelectorAll('#penta .pdot')),PL=document.getElementById('pLabel'),PMB=document.getElementById('pMode');
  var dan=function(c){return c>=100?'四段':c>=60?'三段':c>=30?'二段':c>=10?'初段':'見習';};
  function penta(m){PM=m;var c=m==='all'?D.totals:(CUR?CUR.counts:D.totals),top=Math.max(1,Math.max.apply(null,D.dirs.map(function(d){return c[d.id]||0;})));
    var pts=D.dirs.map(function(d,i){var v=.15+((c[d.id]||0)/top)*.85,a=-Math.PI/2+i*2*Math.PI/5;return [Math.cos(a)*150*v,Math.sin(a)*150*v];});
    PS.setAttribute('points',pts.map(function(p){return p[0].toFixed(1)+','+p[1].toFixed(1);}).join(' '));
    PD.forEach(function(el,i){el.setAttribute('cx',pts[i][0].toFixed(1));el.setAttribute('cy',pts[i][1].toFixed(1));});
    var prog=function(n){var T=[0,10,30,60,100];if(n>=100)return 100;for(var k=1;k<T.length;k++)if(n<T[k])return Math.round((n-T[k-1])/(T[k]-T[k-1])*100);return 100;};
    D.dirs.forEach(function(d){var n=c[d.id]||0;document.querySelector('[data-d="'+d.id+'"]').textContent=n;document.querySelector('[data-dan="'+d.id+'"]').textContent=m==='all'?dan(n):(n?'+'+n:'—');document.querySelector('[data-bar="'+d.id+'"]').style.width=(m==='all'?prog(n):Math.round(n/top*100))+'%';});
    var PN=document.getElementById('pNote');if(PN)PN.textContent=m==='all'?'進度條＝離下一個段位還差多少。段位：10 篇初段、30 篇二段、60 篇三段、100 篇四段。':'進度條＝這一話各方向的比例。';
    PL.textContent=m==='all'?'全卷累計':(CUR?CUR.label:'這一話');
    PMB.querySelectorAll('button').forEach(function(b){b.setAttribute('aria-pressed',b.dataset.m===m);});}
  PMB.addEventListener('click',function(e){var b=e.target.closest('button');if(b)penta(b.dataset.m);});
  Tr.addEventListener('click',function(e){var n=e.target.closest('.node');if(n)show(+n.dataset.i);});
  show(Math.min(nextIdx,list.length-1));
  requestAnimationFrame(function(){var w=Tr.parentElement,n=Tr.querySelector('.node.next');if(n&&w.scrollWidth>w.clientWidth){var li=n.closest('li');w.scrollLeft=Math.max(0,li.offsetLeft-w.clientWidth/2+li.offsetWidth/2);}});
  var MV=document.querySelector('.mv-toggle'),V1=document.getElementById('vOne'),V3=document.getElementById('vDream');
  function view(v){MV.querySelectorAll('button').forEach(function(b){b.setAttribute('aria-pressed',b.dataset.v===v);});V1.hidden=v!=='one';V3.hidden=v!=='dream';}
  if(location.hash==='#dreams'||location.hash==='#kiganjo')view('dream');
  MV.addEventListener('click',function(e){var b=e.target.closest('button');if(b)view(b.dataset.v);});
})();


/* 需求表：選服務 → 預先帶入；送出到私人收件匣 */
(function(){var F=document.getElementById('inquiry');if(!F)return;var M=document.getElementById('inqMsg'),SEL=F.querySelector('select[name=service]');
  document.addEventListener('click',function(e){var a=e.target.closest('[data-svc]');if(!a)return;var v=a.dataset.svc;if(v==='ai')v='ai';if([].some.call(SEL.options,function(o){return o.value===v;}))SEL.value=v;});
  F.addEventListener('submit',function(e){e.preventDefault();var fd=new FormData(F),b={};fd.forEach(function(v,k){b[k]=String(v);});b.lang=navigator.language||'';
    if(!b.name.trim()||!b.contact.trim()||b.message.trim().length<5){M.className='fmsg err';M.textContent='請填寫稱呼、聯絡方式和需求內容。';window.sfx&&sfx('error');return;}
    var btn=F.querySelector('button[type=submit]');btn.disabled=true;M.className='fmsg';M.textContent='送出中…';
    fetch('https://gsaqrjovipnfiedvjaeb.supabase.co/functions/v1/inquiry',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)})
      .then(function(r){return r.json().then(function(d){return {ok:r.ok,d:d};});})
      .then(function(x){if(!x.ok)throw new Error(x.d&&x.d.error||'送出失敗');F.reset();M.className='fmsg ok';M.textContent='已收到，我們會在 2 個工作天內回覆你。';window.sfx&&sfx('success');})
      .catch(function(err){M.className='fmsg err';M.textContent=(err&&err.message)||'送出失敗，請稍後再試。';window.sfx&&sfx('error');})
      .then(function(){btn.disabled=false;});});})();

/* journal filter */
(function(){var F=document.getElementById('filters'),rows=[].slice.call(document.querySelectorAll('.jrow')),E=document.getElementById('jempty');
  F.addEventListener('click',function(e){var b=e.target.closest('.chip');if(!b)return;var f=b.dataset.f,n=0;
    F.querySelectorAll('.chip').forEach(function(c){c.setAttribute('aria-pressed',c===b);});
    rows.forEach(function(r){var on=f==='all'||r.dataset.dir===f;r.hidden=!on;if(on)n++;});E.hidden=n>0;});})();
})();
</script>
</BaseLayout>
