@media(hover:hover){.pay-morph:hover .pm-face{opacity:0;transform:rotateX(-80deg);}}
@media(prefers-reduced-motion:reduce){.pay-morph .pm-face,.pay-morph .pm-tiers .pay-t{transition:opacity .01s!important;transform:none!important;}}
