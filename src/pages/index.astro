          <div class="cho-scroll"><div class="cho-row">
          {dreams.items.filter((d: any) => d.public).map((d: any, i: number) => { const V = wishView(d);
            const href = safeHref(d.link); const cls = `cho k-${V.kind} ${V.lit ? 'lit' : 'dim'}${href ? ' go' : ''}`; const sty = `--n:${i};--g:${V.g}`;
