@media(max-width:900px){.hats{grid-template-columns:1fr;}.me.has-photo{grid-template-columns:120px minmax(0,1fr);gap:18px;}.me-photo{width:120px;}}
@media(max-width:640px){.me.has-photo{grid-template-columns:1fr;}.me-photo{width:150px;}.s-foot{flex-direction:column;align-items:stretch;}.s-acts{justify-content:space-between;}.ig-btn{width:100%;justify-content:center;}.about.end{grid-template-columns:1fr;gap:28px;}}

/* ── 弐 有點樣子：唱盤 ── */
.deck{position:relative;margin-top:24px;height:560px;perspective:1400px;overflow:hidden;outline:none;touch-action:pan-y;user-select:none;}
.deck-stage{position:absolute;inset:0;transform-style:preserve-3d;}
.deck .work{position:absolute;left:50%;top:70px;width:min(380px,78vw);margin-left:calc(min(380px,78vw) / -2);min-height:420px;transition:transform .8s var(--ease),opacity .6s var(--ease),filter .6s var(--ease),box-shadow .6s;will-change:transform;}
.deck .work:not(.on){cursor:pointer;}
.deck .work:not(.on) .wmore{opacity:0;}
.deck .work.on{box-shadow:0 30px 60px -30px rgba(0,0,0,.8);}
.deck .work.on::before{transform:scaleX(1);}
.vinyl{position:absolute;left:50%;top:10px;width:540px;height:540px;margin-left:-270px;border-radius:50%;
  background:radial-gradient(circle,#D4A24C 0 9%,#1a0d12 9.5% 10.5%,transparent 11%),repeating-radial-gradient(circle,#140a0e 0 2px,#22121a 2.5px 3.5px),#140a0e;
  box-shadow:0 20px 50px -20px #000,inset 0 0 0 1px rgba(239,229,214,.06);transition:transform .9s var(--ease),opacity .6s;animation:spin 9s linear infinite;}
.vinyl::after{content:"";position:absolute;inset:0;border-radius:50%;background:conic-gradient(from 30deg,transparent 0 20%,rgba(255,255,255,.06) 25%,transparent 32% 70%,rgba(255,255,255,.05) 75%,transparent 82%);}
.vinyl .vlabel{display:none;}
.deck.switching .vinyl{transform:scale(.92);opacity:.7;}
@keyframes spin{to{rotate:360deg;}}
.wnav{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:6px;}
.wn-btn{width:42px;height:42px;border-radius:50%;border:1px solid var(--line);color:var(--bone-2);font-size:16px;transition:border-color .3s,color .3s;}
.wn-btn:hover{border-color:var(--gold);color:var(--gold);}
.wn-ticks{list-style:none;display:flex;gap:6px;align-items:center;max-width:60vw;overflow-x:auto;scrollbar-width:none;padding:4px 2px;}
.wn-ticks button{display:block;padding:6px 4px;}
.wn-ticks span{display:block;width:26px;height:2px;background:var(--line);font-size:0;transition:background .4s,width .4s var(--ease);}
.wn-ticks button[aria-current="true"] span{background:var(--gold);width:44px;}
.wn-ticks button:hover span{background:var(--bone-2);}
.wn-count{font-family:var(--latin);font-size:15px;color:var(--ash);letter-spacing:.08em;min-width:62px;text-align:center;}
.wn-count b{color:var(--gold);font-weight:500;}
@media(max-width:640px){.deck{height:540px;margin-left:-20px;margin-right:-20px;}.deck .work{top:60px;min-height:420px;}.vinyl{width:380px;height:380px;margin-left:-190px;top:80px;}.wnav{gap:10px;}}
@media(prefers-reduced-motion:reduce){.vinyl{animation:none;}}

/* ── 年輪：五個方向的段位小年輪 ── */
.plegend a{grid-template-columns:26px minmax(0,1fr) 36px auto !important;}
.dring{width:36px;height:36px;display:block;overflow:visible;}
.dring circle{fill:none;}

.swipe-hint{display:none;font-size:12px;color:var(--ash);margin-top:8px;letter-spacing:.04em;}
</style>

