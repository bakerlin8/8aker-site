    if(u>G1&&u<G1+1.1){var ph=(u-G1)/1.1;ctx.beginPath();ctx.arc(a[0],a[1],ph*100*dpr,0,6.2832);ctx.strokeStyle='rgba(243,217,160,'+(.6*(1-ph)).toFixed(3)+')';ctx.lineWidth=2*dpr;ctx.stroke();}
    /* 集結之後，在「今」旁邊浮出現在的歲數（到小數點兩位） */
    if(u>G1+1.2){var ta=Math.min(1,(u-G1-1.2)/1.2),ag=(full+(Date.now()-bd(y))/(bd(y+1)-bd(y))).toFixed(3),fx=a[0]+30*dpr,fy=a[1]-14*dpr-6*dpr*(1-ta);
      ctx.textAlign='left';ctx.textBaseline='alphabetic';ctx.font='500 '+(26*dpr)+'px "Cormorant Garamond",Georgia,serif';var w=ctx.measureText(ag).width,tw=w+22*dpr;
      if(fx+tw>W-14*dpr)fx=a[0]-30*dpr-tw;if(fx<14*dpr)fx=14*dpr;
      ctx.fillStyle='rgba(243,217,160,'+ta.toFixed(3)+')';ctx.fillText(ag,fx,fy);
      ctx.font=(12*dpr)+'px "Noto Serif TC","Noto Serif JP",serif';ctx.fillStyle='rgba(185,168,158,'+ta.toFixed(3)+')';ctx.fillText('歲',fx+w+5*dpr,fy);}}
