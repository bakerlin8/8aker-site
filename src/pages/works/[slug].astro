---
import BaseLayout from '../../layouts/BaseLayout.astro';
import worksData from '../../data/works.json';
import { safeImg, safeLink, videoEmbed, entriesForWork } from '../../data/work-utils';
import { workColor, colorVars } from '../../data/work-colors';

export async function getStaticPaths() {
  const list = (worksData.works as any[]).filter((w) => /^[a-z0-9-]+$/.test(w.slug || ''));
  return list.map((w) => ({ params: { slug: w.slug }, props: { w, no: (worksData.works as any[]).indexOf(w) + 1 } }));
}
const { w, no } = Astro.props as any;
const imgs: string[] = (w.images || []).map((x: any) => (typeof x === 'string' ? x : x?.src)).map(safeImg).filter(Boolean);
const caps: string[] = (w.images || []).map((x: any) => (typeof x === 'string' ? '' : x?.caption || ''));
const vid = videoEmbed(w.video || '');
const link = safeLink(w.link || '');
const domain = link ? (() => { try { return new URL(link).host.replace(/^www\./, ''); } catch { return ''; } })() : '';
const siteName = (w.link_label || '').trim() || domain;
const C = workColor(w, no - 1);
const log = await entriesForWork(w.slug);
const dot = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
const NO = String(no).padStart(2, '0');
const SITE = (Astro.site ?? new URL('https://8aker0.com')).href.replace(/\/$/, '');
const url = `${SITE}/works/${w.slug}/`;
const desc = w.result || w.desc || '';
// 版面：直式影片（IG／Shorts）→ 左文右手機框；橫式影片 → 標題下方一整幅；沒有影片 → 只有文字
// 雜誌版：作品資料有 groups（分組的畫面）時，開頭改成跨頁版面
const groups: any[] = (Array.isArray(w.groups) ? w.groups : []).map((g: any) => ({ ...g, shots: (g.shots || []).map((x: any) => ({ ...x, src: safeImg(x.src), mobile: safeImg(x.mobile || '') })).filter((x: any) => x.src) })).filter((g: any) => g.shots.length);
const shots: any[] = groups.flatMap((g: any) => g.shots.map((x: any) => ({ ...x, g: g.key })));
const mag = shots.length > 0;
const gIdx = (x: any) => shots.indexOf(x);
const lum = (hex: string) => { const n = parseInt(hex.slice(1), 16); const f = (v: number) => { v /= 255; return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; }; return 0.2126 * f((n >> 16) & 255) + 0.7152 * f((n >> 8) & 255) + 0.0722 * f(n & 255); };
const how = w.how || null;
const colsOk = groups.length > 1 && groups.every((g: any) => Number(g.cols) > 0);
const engage = mag && !!link && w.engage !== 'off';
const ask = (w.ask || '').trim() || '玩得還開心嗎？';
const design = w.design || null;
const layout = vid ? (vid.vertical ? 'v' : 'h') : 'none';
const schema = [
  { '@type': 'CreativeWork', '@id': `${url}#work`, name: w.title, description: desc, creator: { '@id': `${SITE}/#person` }, url, inLanguage: 'zh-Hant-TW', ...(imgs[0] ? { image: imgs[0].startsWith('/') ? SITE + imgs[0] : imgs[0] } : {}) },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: '有點樣子', item: `${SITE}/#works` },
    { '@type': 'ListItem', position: 3, name: w.title, item: url } ] },
];
---
<BaseLayout title={`${w.title} — 有點樣子 — 8AKER零`} description={desc} schema={schema} type="article" noindex={!!w.draft}>
<style is:global>
.wpage{--frame:340px;}
.wh{position:relative;overflow:hidden;background:radial-gradient(80% 70% at 85% 0%,var(--wb) 0%,transparent 70%),radial-gradient(110% 90% at 85% 10%,#2A1520 0%,#1C0F14 65%);color:#EFE5D6;padding:150px 40px 64px;}
.wh-in{max-width:1040px;margin:0 auto;position:relative;}
.wh .no{position:absolute;right:-20px;top:-80px;font-family:var(--latin);font-size:240px;line-height:1;color:var(--dc);opacity:.12;pointer-events:none;}
.wh[data-layout="v"] .wh-in{display:grid;grid-template-columns:minmax(0,1fr) var(--frame);gap:64px;align-items:center;}
.wh[data-layout="v"] .wh-txt{position:relative;}
.wh[data-layout="v"] .no{right:-10px;top:-70px;}
.wh .crumb{font-size:13px;color:#86707A;display:flex;gap:10px;flex-wrap:wrap;}
.wh .crumb a{border-bottom:1px solid rgba(239,229,214,.15);transition:color .3s,border-color .3s;}
.wh .crumb a:hover{color:#EFE5D6;border-color:#D4A24C;}
.wh .meta{margin-top:22px;font-size:12.5px;letter-spacing:.06em;color:#86707A;display:flex;gap:14px;}
.wh .meta b{color:var(--dc);font-weight:400;}
.wh h1{font-family:var(--serif);font-weight:500;font-size:clamp(28px,4.2vw,42px);line-height:1.4;margin-top:10px;color:#EBD3A8;text-wrap:balance;}
.wh .ba{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:28px;}
.wh[data-layout="v"] .ba{grid-template-columns:1fr;gap:18px;}
.wh .wq{margin:0;padding-left:16px;border-left:2px solid rgba(134,112,122,.55);font-family:var(--serif);font-size:17px;line-height:1.85;color:#B9A89E;}
.wh .wq small{display:block;font-family:var(--latin);font-size:12.5px;letter-spacing:.24em;color:#86707A;margin-bottom:4px;}
.wh .wq.af{border-left-color:#D4A24C;color:#EFE5D6;}
.wh .wq.af small{color:#D4A24C;}
.wh .intro{margin-top:22px;font-family:var(--serif);font-size:16px;line-height:2;color:#D9CCBD;white-space:pre-line;}
/* 行動：前往網站（主要）＋看製作紀錄（次要） */
.acts{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-top:32px;}
.go-site{display:inline-flex;align-items:center;gap:14px;min-height:52px;padding:0 22px 0 20px;background:#D4A24C;color:#1C0F14;position:relative;overflow:hidden;isolation:isolate;transition:background .35s;}
.go-site::before{content:'';position:absolute;inset:0;z-index:-1;background:#F0C878;transform:scaleX(0);transform-origin:left;transition:transform .5s var(--ease);}
.go-site:hover::before{transform:scaleX(1);}
.go-site span{display:flex;flex-direction:column;line-height:1.25;}
.go-site b{font-weight:500;font-size:15px;}
.go-site small{font-family:var(--latin);font-size:12.5px;letter-spacing:.04em;opacity:.7;}
.go-site i{font-style:normal;font-size:18px;transition:transform .45s var(--ease);}
.go-site:hover i{transform:translate(3px,-3px);}
.go-log{display:inline-flex;align-items:center;gap:8px;min-height:52px;padding:0 18px;border:1px solid rgba(239,229,214,.2);color:#D9CCBD;font-size:14px;transition:border-color .3s,color .3s;}
.go-log:hover{border-color:var(--dc);color:#EFE5D6;}
/* 直式影片：手機外框 */
.phone{position:relative;width:var(--frame);max-width:100%;margin:0 auto;padding:10px;border-radius:34px;background:linear-gradient(160deg,var(--wb),var(--wb2));border:1px solid rgba(255,255,255,.12);box-shadow:0 40px 80px -30px rgba(0,0,0,.85),0 0 0 6px rgba(0,0,0,.25),0 0 90px -10px color-mix(in srgb,var(--dc) 35%,transparent);}
.phone .scr{position:relative;border-radius:25px;overflow:hidden;background:#000;aspect-ratio:9/16;}
.phone .scr.ig{aspect-ratio:auto;min-height:560px;background:#0E0709;}
.phone iframe,.phone video{display:block;width:100%;height:100%;border:0;}
.phone .scr:not(.ig) iframe,.phone .scr video{position:absolute;inset:0;object-fit:cover;}
.phone .scr.ig iframe{height:640px;}
.vcap{display:flex;justify-content:center;gap:10px;margin-top:16px;font-size:12px;letter-spacing:.14em;color:#86707A;}
.vcap b{font-family:var(--latin);color:var(--dc);font-weight:400;letter-spacing:.3em;}
/* 橫式影片：標題下方一整幅 */
.cinema{max-width:1040px;margin:-24px auto 0;padding:0 40px;position:relative;z-index:2;}
.cinema .frame{position:relative;aspect-ratio:16/9;background:#000;border:1px solid rgba(255,255,255,.1);box-shadow:0 40px 80px -40px rgba(0,0,0,.9);}
.cinema iframe,.cinema video{position:absolute;inset:0;width:100%;height:100%;border:0;}
.wb{padding:64px 40px 96px;background:var(--night);color:var(--bone);}
.wb-in{max-width:880px;margin:0 auto;}
.wb h2{font-family:var(--serif);font-weight:500;font-size:21px;margin:0 0 18px;display:flex;align-items:baseline;gap:12px;}
.wb h2 small{font-family:var(--latin);font-size:12.5px;letter-spacing:.22em;color:var(--gold);}
.wb section+section{margin-top:56px;}
.gal{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:10px;overscroll-behavior-x:contain;}
.gal figure{flex:0 0 min(620px,86%);margin:0;scroll-snap-align:start;}
.gal button{display:block;width:100%;padding:0;border:1px solid var(--line);background:var(--night-2);cursor:zoom-in;}
.gal img{display:block;width:100%;height:auto;aspect-ratio:16/10;object-fit:cover;}
.gal figcaption{font-size:13px;color:var(--bone-2);margin-top:8px;}
.gal.one figure{flex-basis:100%;}
.log{list-style:none;margin:0;padding:0;border-left:1px solid var(--line);}
.log li{position:relative;padding:0 0 22px 24px;}
.log li::before{content:'';position:absolute;left:-4px;top:9px;width:7px;height:7px;border-radius:50%;background:var(--gold);}
.log time{font-size:12.5px;color:var(--ash);letter-spacing:.04em;}
.log a{display:block;font-family:var(--serif);font-size:17px;line-height:1.55;margin-top:2px;transition:color .3s;}
.log a:hover{color:var(--gold);}
.log p{font-size:13.5px;color:var(--bone-2);margin-top:4px;line-height:1.75;}
.empty{font-size:14px;color:var(--bone-2);line-height:1.9;}
.back{display:inline-block;margin-top:64px;font-size:14px;color:var(--gold);border-bottom:1px solid currentColor;}
dialog.lb{border:0;padding:0;background:transparent;max-width:96vw;max-height:94vh;}
dialog.lb::backdrop{background:rgba(10,5,7,.88);}
dialog.lb img{display:block;max-width:96vw;max-height:88vh;width:auto;height:auto;}
dialog.lb p{color:#EFE5D6;font-size:13px;text-align:center;margin-top:8px;}
dialog.lb .x{position:fixed;top:14px;right:16px;width:44px;height:44px;border:0;background:rgba(239,229,214,.12);color:#EFE5D6;font-size:20px;cursor:pointer;}

/* 雜誌版開頭（作品資料有 groups 時使用） */
.mg{position:relative;overflow:hidden;background:radial-gradient(70% 60% at 100% 0%,#2A1520 0%,transparent 70%),#1C0F14;color:#EFE5D6;padding:112px 40px 64px;}
.mg-in{max-width:1120px;margin:0 auto;}
.mg-run{display:flex;justify-content:space-between;gap:16px;border-bottom:1px solid rgba(212,162,76,.38);padding-bottom:10px;font-family:'Cormorant Garamond',var(--serif);font-style:italic;font-size:15px;letter-spacing:.08em;color:#D4A24C;}
.mg-run span:last-child{color:#B9A89E;}
.mg-spread{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);column-gap:clamp(24px,4vw,56px);margin-top:44px;align-items:start;}
.mg-kick{font-size:12px;letter-spacing:.34em;color:#D4A24C;display:flex;align-items:center;gap:14px;}
.mg-kick::after{content:'';height:1px;width:48px;background:rgba(212,162,76,.38);}
.mg-h1{margin-top:18px;font-weight:500;}
.mg-h1 .en{display:block;font-family:'Cormorant Garamond','Noto Serif TC',serif;font-style:italic;font-weight:500;font-size:clamp(54px,8.4vw,104px);line-height:.92;letter-spacing:-.01em;color:#EBD3A8;}
.mg-h1 .zh{display:block;margin-top:16px;font-family:var(--serif);font-weight:400;font-size:clamp(20px,2.4vw,28px);letter-spacing:.14em;color:#EFE5D6;}
.mg-tags{margin-top:22px;display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;font-size:12.5px;letter-spacing:.12em;color:#86707A;}
.mg-tag{display:inline-flex;align-items:center;gap:7px;font-size:12px;letter-spacing:.18em;color:#EBD3A8;background:#4B1623;border:1px solid #D4A24C;padding:1px 12px;border-radius:2px;}
.mg-tag::before{content:'';width:6px;height:6px;border-radius:50%;background:#D4A24C;}
.mg-deck{margin-top:28px;font-family:var(--serif);font-size:clamp(17px,1.7vw,20px);line-height:2;color:#EFE5D6;max-width:min(23em,100%);}
.mg .acts{margin-top:30px;}
.mg-plate{position:relative;min-width:0;}
.mg-fig{position:relative;margin-right:-40px;}
.mg-fig::before{content:'';position:absolute;inset:14px -14px -14px 14px;border:1px solid rgba(212,162,76,.38);pointer-events:none;}
.mg-desk{position:relative;background:#26141B;border:1px solid rgba(255,255,255,.12);box-shadow:0 50px 90px -40px #000;}
.mg-bar{height:28px;background:#2c1a22;display:flex;align-items:center;gap:6px;padding:0 12px;}
.mg-bar i{width:8px;height:8px;border-radius:50%;background:#5a4048;flex:none;}
.mg-bar span{margin-left:12px;font-size:11px;color:#B9A89E;letter-spacing:.04em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;}
.mg-shot{position:relative;display:block;width:100%;aspect-ratio:1280/900;border:0;padding:0;background:#1C0F14;cursor:zoom-in;}
.mg-shot img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top;opacity:0;transition:opacity .5s;}
.mg-shot img.on{opacity:1;}
.mg-ph{position:absolute;left:-36px;bottom:-4px;width:clamp(120px,15vw,172px);padding:6px;border-radius:26px;background:#14090d;border:1px solid rgba(239,229,214,.2);box-shadow:0 36px 60px -20px #000;transition:opacity .4s,transform .4s;}
.mg-ph.off{opacity:0;transform:translateY(12px);pointer-events:none;}
.mg-scr{position:relative;border-radius:20px;overflow:hidden;aspect-ratio:9/17;background:#000;}
.mg-scr img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top;opacity:0;transition:opacity .5s;}
.mg-scr img.on{opacity:1;}
.mg-cap{margin-top:34px;display:grid;grid-template-columns:auto 1fr;gap:4px 16px;align-items:baseline;padding-left:clamp(110px,14vw,150px);}
.mg-cap .no{font-family:'Cormorant Garamond',var(--serif);font-style:italic;font-size:15px;letter-spacing:.1em;color:#D4A24C;}
.mg-cap .tt{font-family:var(--serif);font-size:18px;color:#EBD3A8;}
.mg-cap p{grid-column:2;font-size:14px;color:#B9A89E;line-height:1.8;max-width:34em;}
.mg-cap ul{grid-column:2;list-style:none;margin:6px 0 0;padding:0;max-width:34em;}
.mg-cap li{position:relative;padding:7px 0 7px 18px;border-top:1px solid rgba(239,229,214,.1);font-size:13.5px;line-height:1.7;color:#D9CCBD;}
.mg-cap li::before{content:'';position:absolute;left:0;top:1.2em;width:8px;height:1px;background:#D4A24C;}
.mg-toc{margin-top:46px;border-top:1px solid rgba(212,162,76,.38);padding-top:14px;}
.mg-toc-h{display:flex;align-items:center;gap:14px;font-size:12px;letter-spacing:.34em;color:#D4A24C;}
.mg-toc-h .sp{flex:1;}
.mg-play{border:1px solid rgba(239,229,214,.14);background:transparent;padding:2px 12px;font-size:12px;letter-spacing:.1em;color:#B9A89E;cursor:pointer;}
.mg-play:hover,.mg-play[aria-pressed="true"]{color:#D4A24C;border-color:#D4A24C;}
.mg-groups.cw{grid-template-columns:var(--gc);}
.mg-groups{display:grid;grid-template-columns:4fr 2fr;gap:0 clamp(16px,3vw,40px);margin-top:14px;}
.mg-grp h3{font-family:'Cormorant Garamond',var(--serif);font-style:italic;font-weight:500;font-size:15px;letter-spacing:.06em;color:#86707A;margin-bottom:6px;}
.mg-grp h3 b{font-family:var(--sans);font-style:normal;font-weight:400;font-size:12.5px;letter-spacing:.2em;color:#B9A89E;margin-right:10px;}
.mg-items{display:grid;gap:0 14px;}
.mg-grp.gF .mg-items{grid-template-columns:repeat(4,1fr);}
.mg-grp.gO .mg-items{grid-template-columns:repeat(2,1fr);}
.mg-grp .mg-items.ic{grid-template-columns:repeat(var(--ic),1fr);}
.mg-items button{position:relative;text-align:left;border:0;border-top:1px solid rgba(239,229,214,.14);background:none;padding:10px 0 4px;display:grid;color:#B9A89E;cursor:pointer;font:inherit;}
.mg-items .n{font-family:'Cormorant Garamond',var(--serif);font-style:italic;font-size:22px;line-height:1;color:#86707A;transition:color .3s;}
.mg-items .t{font-family:var(--serif);font-size:14.5px;margin-top:4px;}
.mg-items button:hover{color:#EFE5D6;}
.mg-items button[aria-pressed="true"]{color:#EBD3A8;}
.mg-items button[aria-pressed="true"] .n{color:#D4A24C;}
.mg-items button::before{content:'';position:absolute;left:0;top:-1px;height:2px;width:0;background:#D4A24C;}
.mg-items button[aria-pressed="true"]::before{width:100%;}
.mg-toc.auto .mg-items button[aria-pressed="true"]::before{width:0;animation:mgfill var(--dur,4500ms) linear forwards;}
@keyframes mgfill{to{width:100%;}}
/* 雜誌版內文區塊 */
.mg-sec h3.mg-sub{font-family:var(--serif);font-weight:500;font-size:16px;color:var(--gold);margin:30px 0 12px;}
.mg-steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:0 24px;counter-reset:s;}
.mg-steps li{counter-increment:s;border-top:1px solid rgba(212,162,76,.38);padding-top:12px;display:grid;gap:4px;align-content:start;}
.mg-steps li::before{content:counter(s);font-family:'Cormorant Garamond',var(--serif);font-style:italic;font-size:26px;line-height:1;color:var(--gold);}
.mg-steps b{font-family:var(--serif);font-weight:500;font-size:16px;}
.mg-steps span{font-size:14px;line-height:1.8;color:var(--bone-2);}
.mg-note{margin-top:24px;padding:12px 16px;border-left:2px solid var(--gold);background:rgba(212,162,76,.07);font-size:14px;line-height:1.85;color:#D9CCBD;}
.mg-extra{margin-top:16px;font-size:14.5px;line-height:1.95;color:#D9CCBD;max-width:40em;}
.mg-lead{font-family:var(--serif);font-size:17px;line-height:2;color:#EFE5D6;max-width:36em;}
.mg-pal{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:16px 28px;}
.mg-pal li{display:grid;grid-template-columns:96px 1fr;gap:14px;align-items:start;min-width:0;}
.mg-pal .sw{display:flex;align-items:flex-end;aspect-ratio:1;padding:8px;font-family:'JetBrains Mono',monospace;font-size:11.5px;border:1px solid rgba(239,229,214,.18);}
.mg-pal b,.mg-fonts b{font-family:var(--serif);font-weight:500;font-size:15px;}
.mg-pal p,.mg-fonts p{font-size:13.5px;line-height:1.8;color:var(--bone-2);margin-top:2px;}
.mg-fonts{list-style:none;margin:0;padding:0;display:grid;gap:0;}
.mg-fonts li{display:grid;grid-template-columns:minmax(0,220px) 1fr;gap:6px 28px;align-items:center;padding:16px 0;border-top:1px solid rgba(239,229,214,.12);}
.mg-fonts li:last-child{border-bottom:1px solid rgba(239,229,214,.12);}
.mg-fonts .spec{font-size:26px;line-height:1.3;color:#EBD3A8;overflow-wrap:anywhere;}
.mg-fonts .spec.fraunces{font-family:'Fraunces','Cormorant Garamond',serif;font-style:italic;font-size:30px;}
.mg-fonts .spec.sans{font-family:'Noto Sans TC',sans-serif;font-size:19px;}
.mg-fonts .spec.mono{font-family:'JetBrains Mono',monospace;font-size:24px;}
@media(max-width:860px){.mg-spread{grid-template-columns:1fr;margin-top:30px;row-gap:44px;}.mg-fig{margin-right:0;}.mg-fig::before{inset:10px -8px -10px 10px;}.mg-ph{left:auto;right:-6px;bottom:-24px;width:104px;}.mg-cap{padding-left:0;}.mg-groups,.mg-groups.cw{grid-template-columns:1fr;row-gap:20px;}.mg-grp.gF .mg-items,.mg-grp .mg-items.ic{grid-template-columns:repeat(2,1fr);}}
@media(max-width:720px){.mg{padding:92px 20px 48px;}.mg-steps{grid-template-columns:1fr;gap:16px;}.mg-pal{grid-template-columns:1fr;}.mg-pal li{grid-template-columns:72px 1fr;}.mg-fonts li{grid-template-columns:1fr;}}
@media(hover:hover) and (pointer:fine){
.mg-cap p,.mg-cap ul{opacity:0;transform:translateY(6px);transition:opacity .35s,transform .35s;}
.mg-cap .tt::after{content:'　＋';font-size:13px;color:#86707A;transition:opacity .3s;}
.mg-in:has(.mg-plate:hover,.mg-plate:focus-within,.mg-toc:hover,.mg-toc:focus-within) .mg-cap :is(p,ul){opacity:1;transform:none;}
.mg-in:has(.mg-plate:hover,.mg-plate:focus-within,.mg-toc:hover,.mg-toc:focus-within) .mg-cap .tt::after{opacity:0;}
}
@media(prefers-reduced-motion:reduce){.mg *{transition:none!important;animation:none!important;}.mg-toc.auto .mg-items button[aria-pressed="true"]::before{width:100%;}}

/* 雜誌版：背景、成效、未來、CTA */
.mg-prob{list-style:none;margin:26px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:0 24px;counter-reset:p;}
.mg-prob li{counter-increment:p;border-top:1px solid rgba(212,162,76,.38);padding-top:12px;display:grid;gap:6px;align-content:start;}
.mg-prob li::before{content:counter(p);font-family:'Cormorant Garamond',var(--serif);font-style:italic;font-size:26px;line-height:1;color:var(--gold);}
.mg-prob b{font-family:var(--serif);font-weight:500;font-size:16px;line-height:1.5;}
.mg-prob span{font-size:14px;line-height:1.85;color:var(--bone-2);}
.mg-rows{list-style:none;margin:24px 0 0;padding:0;}
.mg-rows li{display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr;gap:6px 20px;align-items:baseline;padding:14px 0;border-top:1px solid rgba(239,229,214,.12);font-size:14px;color:var(--bone-2);}
.mg-rows li:last-child{border-bottom:1px solid rgba(239,229,214,.12);}
.mg-rows .ba{display:contents;}
.mg-rows b{font-family:var(--serif);font-weight:500;font-size:15px;color:var(--bone);}
.mg-rows small{display:none;font-size:11.5px;letter-spacing:.18em;color:var(--ash);margin-right:8px;}
.mg-rows em{font-style:normal;color:var(--gold-hi,#EBD3A8);}
.mg-total{margin-top:26px;display:grid;gap:4px;}
.mg-total b{font-family:var(--serif);font-weight:500;font-size:clamp(22px,3vw,30px);color:#EBD3A8;line-height:1.4;}
.mg-total span{font-size:14.5px;color:#D9CCBD;}
.mg-joke{margin-top:22px;padding-left:16px;border-left:2px solid rgba(212,162,76,.5);font-family:var(--serif);font-style:italic;font-size:16px;line-height:1.95;color:#EBD3A8;max-width:34em;}
.mg-fut{display:grid;grid-template-columns:1fr 1fr;gap:0 40px;margin-top:6px;}
.mg-fut ul{list-style:none;margin:0;padding:0;}
.mg-fut li{position:relative;padding:10px 0 10px 18px;border-top:1px solid rgba(239,229,214,.1);display:grid;gap:2px;}
.mg-fut li::before{content:'';position:absolute;left:0;top:1.35em;width:8px;height:1px;background:var(--gold);}
.mg-fut b{font-family:var(--serif);font-weight:500;font-size:15px;}
.mg-fut span{font-size:13.5px;line-height:1.8;color:var(--bone-2);}
.mg-cta{margin-top:72px;padding:48px 0 8px;border-top:1px solid rgba(212,162,76,.38);text-align:left;}
.mg-cta h2{font-family:var(--serif);font-weight:500;font-size:clamp(24px,3.4vw,34px);line-height:1.45;color:#EBD3A8;display:block;margin:0;}
.mg-cta p{margin-top:14px;font-family:var(--serif);font-size:16px;line-height:2;color:#D9CCBD;max-width:30em;}
.mg-live{display:flex;gap:10px;align-items:flex-start;margin:0 0 18px;padding:12px 14px;border:1px solid rgba(212,162,76,.45);background:rgba(75,22,35,.45);font-family:var(--serif);font-size:15px;line-height:1.85;color:#EBD3A8;}
.mg-live i{flex:none;width:8px;height:8px;margin-top:.8em;border-radius:50%;background:#D4A24C;animation:mgpulse 2.4s ease-out infinite;}
@media(prefers-reduced-motion:reduce){.mg-live i{animation:none;}}
/* 愛心「我有興趣」與回來提示 */
.mg-heart{appearance:none;display:inline-flex;align-items:center;gap:9px;min-height:52px;padding:0 18px;background:transparent;border:1px solid rgba(212,162,76,.55);color:#EFE5D6;font:inherit;font-size:14px;letter-spacing:.06em;cursor:pointer;transition:border-color .3s,background .3s,color .3s;}
.mg-heart:hover{border-color:#D4A24C;background:rgba(212,162,76,.08);}
.mg-heart svg{width:20px;height:20px;fill:none;stroke:#D4A24C;stroke-width:1.5;stroke-linejoin:round;transition:fill .3s;}
.mg-heart[aria-pressed="true"]{border-color:#D4A24C;color:#EBD3A8;background:rgba(75,22,35,.55);}
.mg-heart[aria-pressed="true"] svg{fill:#D4A24C;animation:mgpop .5s var(--ease,ease-out);}
.mg-heart .n{font-weight:500;font-family:var(--latin);font-size:13px;color:#D4A24C;}
@keyframes mgpop{0%{transform:scale(.7);}55%{transform:scale(1.28);}100%{transform:scale(1);}}
.mg-chip{position:fixed;right:20px;bottom:20px;z-index:60;width:min(340px,calc(100vw - 32px));padding:16px 16px 14px;background:#26141B;border:1px solid rgba(212,162,76,.5);color:#EFE5D6;box-shadow:0 14px 40px rgba(0,0,0,.45);animation:mgchip .5s var(--ease,ease-out);}
.mg-chip p{margin:0 22px 12px 0;font-family:var(--serif);font-size:15px;line-height:1.7;color:#EBD3A8;}
.mg-chip .row{display:flex;flex-wrap:wrap;gap:8px;}
.mg-chip button,.mg-chip a{appearance:none;display:inline-flex;align-items:center;min-height:40px;padding:0 14px;background:transparent;border:1px solid rgba(212,162,76,.5);color:#EFE5D6;font:inherit;font-size:13.5px;text-decoration:none;cursor:pointer;}
.mg-chip button:hover,.mg-chip a:hover{background:rgba(212,162,76,.12);}
.mg-chip a.want{background:#D4A24C;color:#1C0F14;border-color:#D4A24C;}
.mg-chip a.want:hover{background:#F0C878;}
.mg-chip .x{position:absolute;top:6px;right:6px;min-height:32px;width:32px;padding:0;justify-content:center;border:0;color:#B9A89E;font-size:16px;}
@keyframes mgchip{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:none;}}
@media(max-width:600px){.mg-chip{right:16px;left:16px;width:auto;bottom:calc(env(safe-area-inset-bottom,0px) + 16px);}}
@media(prefers-reduced-motion:reduce){.mg-chip{animation:none;}.mg-heart[aria-pressed="true"] svg{animation:none;}}
/* 試玩按鈕：光暈脈動、掃光、箭頭彈跳 */
.mg-go{position:relative;}
.mg-go::after{content:'';position:absolute;inset:0;pointer-events:none;animation:mgpulse 2.4s ease-out infinite;}
@keyframes mgpulse{0%{box-shadow:0 0 0 0 rgba(212,162,76,.55);}70%,100%{box-shadow:0 0 0 16px rgba(212,162,76,0);}}
.mg-go span{position:relative;z-index:1;}
.mg-go b{background:linear-gradient(100deg,#1C0F14 0 40%,#6b3b12 50%,#1C0F14 60% 100%);background-size:250% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:mgshine 3.2s ease-in-out infinite;}
@keyframes mgshine{0%,35%{background-position:100% 0;}75%,100%{background-position:0 0;}}
.mg-go i{animation:mgnudge 1.6s ease-in-out infinite;}
@keyframes mgnudge{0%,100%{transform:translate(0,0);}50%{transform:translate(4px,-4px);}}
.mg-cta .mg-go i{animation-name:mgnudgeR;}
@keyframes mgnudgeR{0%,100%{transform:translateX(0);}50%{transform:translateX(5px);}}
@media(max-width:860px){.mg-prob{grid-template-columns:1fr;gap:18px;}.mg-fut{grid-template-columns:1fr;gap:20px;}.mg-rows li{grid-template-columns:1fr;gap:2px;}.mg-rows small{display:inline;}.mg-rows b{margin-bottom:4px;}}
@media(prefers-reduced-motion:reduce){.mg-go::after,.mg-go b,.mg-go i{animation:none!important;}.mg-go b{background:none;color:#1C0F14;-webkit-text-fill-color:#1C0F14;}}
@media(max-width:900px){.wh[data-layout="v"] .wh-in{grid-template-columns:1fr;gap:40px;}.wpage{--frame:300px;}}
@media(max-width:720px){.wh{padding:96px 20px 48px;}.wh .ba{grid-template-columns:1fr;gap:18px;}.wb{padding:44px 20px 80px;}.wh .wq{font-size:16px;}.cinema{padding:0;margin-top:0;}.cinema .frame{border-left:0;border-right:0;}.acts>a{flex:1 1 100%;justify-content:space-between;}}

/* ───── 手機版整理（≤720px）：資訊分層、少一點線條、目次改成橫滑 ───── */
.mg-fold summary{list-style:none;cursor:default;}
.mg-fold summary::-webkit-details-marker{display:none;}
@media(max-width:720px){
  /* 開頭：標題區更緊湊，主要按鈕突出，次要連結變成文字 */
  .mg{padding:84px 20px 36px;}
  .mg-spread{margin-top:22px;row-gap:30px;}
  .mg-h1 .en{font-size:clamp(46px,15vw,64px);}
  .mg-h1 .zh{margin-top:10px;font-size:19px;letter-spacing:.1em;}
  .mg-tags{margin-top:14px;}
  .mg-deck{margin-top:18px;font-size:16px;line-height:1.9;}
  .mg .acts{margin-top:20px;gap:6px;}
  .mg .acts>.go-site{flex:1 1 100%;}
  .go-log{border:0;min-height:40px;padding:0;justify-content:center;color:#B9A89E;font-size:13.5px;border-bottom:0;}
  .mg .acts>.go-log{flex:1 1 100%;}
  .mg-cta .acts>.go-log{border:1px solid rgba(239,229,214,.2);min-height:48px;padding:0 16px;}
  /* 這是手機工具：有手機截圖的畫面，直接放大顯示手機版；沒有才顯示電腦版 */
  .mg-fig:has(.mg-ph:not(.off)) .mg-desk,.mg-fig:has(.mg-ph:not(.off))::before{display:none;}
  .mg-fig:has(.mg-ph:not(.off)) .mg-ph{position:relative;left:auto;right:auto;bottom:auto;width:min(64%,250px);margin:0 auto;cursor:zoom-in;}
  .mg-cap{margin-top:20px;}
  .mg-cap ul{display:none;}
  .mg-cap .tt{font-size:17px;}
  .mg-cap p{font-size:13.5px;}
  /* 目次：一排可橫滑的小標籤，不再佔掉半個畫面 */
  .mg-toc{margin-top:26px;padding-top:12px;}
  .mg-toc-h{letter-spacing:.2em;}
  .mg-groups,.mg-groups.cw{display:flex;gap:6px 22px;margin:12px -20px 0;padding:0 20px 8px;overflow-x:auto;scroll-snap-type:x proximity;scroll-padding-left:20px;scrollbar-width:none;-webkit-overflow-scrolling:touch;}
  .mg-groups::-webkit-scrollbar{display:none;}
  .mg-grp{flex:none;scroll-snap-align:start;}
  .mg-grp h3{margin-bottom:8px;font-size:12.5px;white-space:nowrap;}
  .mg-grp h3 b{margin-right:6px;font-size:12px;letter-spacing:.14em;}
  .mg-grp .mg-items,.mg-grp.gF .mg-items,.mg-grp.gO .mg-items,.mg-grp .mg-items.ic{display:flex;gap:8px;}
  .mg-items button{flex:none;display:flex;align-items:baseline;gap:7px;padding:7px 14px;border:1px solid rgba(239,229,214,.2);border-radius:999px;white-space:nowrap;min-height:40px;align-items:center;}
  .mg-items button::before{display:none;}
  .mg-items .n{font-size:15px;}
  .mg-items .t{margin-top:0;font-size:14px;}
  .mg-items button[aria-pressed="true"]{border-color:#D4A24C;background:rgba(75,22,35,.6);}
  /* 內文：區塊間距小一點、編號跟標題同一排 */
  .wb{padding:36px 20px 72px;}
  .wb section+section{margin-top:40px;}
  .wb h2{font-size:20px;margin-bottom:14px;}
  .mg-lead{font-size:16px;line-height:1.9;}
  .mg-prob,.mg-steps{margin-top:18px;gap:0;}
  .mg-prob li,.mg-steps li{grid-template-columns:26px 1fr;column-gap:6px;row-gap:2px;padding:12px 0;}
  .mg-prob li::before,.mg-steps li::before{grid-row:1 / span 2;font-size:22px;line-height:1.3;}
  .mg-prob li:first-child,.mg-steps li:first-child{border-top-color:rgba(212,162,76,.38);}
  .mg-prob li,.mg-steps li{border-top-color:rgba(239,229,214,.1);}
  .mg-prob b,.mg-steps b{font-size:15.5px;}
  .mg-prob span,.mg-steps span{font-size:13.5px;line-height:1.75;}
  .mg-extra{font-size:14px;line-height:1.85;}
  .mg-note{margin-top:16px;font-size:13.5px;}
  /* 成效：每項「項目＋省下」一行、「以前→現在」一行 */
  .mg-rows{margin-top:16px;}
  .mg-rows li{grid-template-columns:1fr auto;gap:2px 12px;padding:12px 0;align-items:baseline;}
  .mg-rows b{grid-column:1;margin:0;font-size:15px;}
  .mg-rows em{grid-column:2;grid-row:1;font-size:13.5px;white-space:nowrap;}
  .mg-rows em small{display:none;}
  .mg-rows .ba{display:block;grid-column:1 / -1;grid-row:2;font-size:13px;line-height:1.7;color:var(--ash);}
  .mg-rows .ba>span{display:inline;}
  .mg-rows .bf::after{content:' → ';color:var(--gold);}
  .mg-rows .ba small{display:inline;margin-right:5px;font-size:11px;letter-spacing:.1em;}
  .mg-rows .af{color:var(--bone-2);}
  .mg-total{margin-top:18px;}
  .mg-joke{font-size:15px;}
  /* 未來規劃：手機預設收合，點標題展開 */
  .mg-fold summary{cursor:pointer;display:flex;align-items:center;justify-content:space-between;}
  .mg-fold summary h2{margin:0;}
  .mg-fold summary::after{content:'＋';font-size:18px;color:var(--gold);}
  .mg-fold details[open] summary::after{content:'－';}
  .mg-fold details[open] summary h2{margin-bottom:14px;}
  .mg-fut{gap:8px;}
  .mg-sub{margin:18px 0 6px;}
  .mg-cta{margin-top:48px;padding-top:32px;}
  .mg-cta p{font-size:15px;line-height:1.9;}
  .log li{padding-bottom:18px;}
  .back{margin-top:40px;}
}

/* ───── 手機版 B 方案：分頁籤（≤720px）。網頁版維持雜誌式長頁。作品資料不用另外填，手機版自動套用 ───── */
.mm{display:none;}
.mm-cta{display:none;}
@media(max-width:720px){
  .mm{display:block;}
  .mg{overflow:clip;padding-bottom:20px;}
  .mm-tabs{position:sticky;top:var(--navh,60px);z-index:30;display:flex;gap:2px;overflow-x:auto;padding:0 12px;background:var(--night);border-bottom:1px solid var(--line);scrollbar-width:none;}
  .mm-tabs::-webkit-scrollbar{display:none;}
  .mm-tabs button{flex:none;appearance:none;background:none;border:0;border-bottom:2px solid transparent;color:var(--ash);font:inherit;font-size:14.5px;min-height:48px;padding:0 13px;cursor:pointer;}
  .mm-tabs button[aria-selected="true"]{color:#EBD3A8;border-bottom-color:var(--gold);}
  .mm-tabs button:focus-visible{outline:2px solid var(--gold);outline-offset:-4px;}
  .mm-p{padding:24px 20px 0;background:var(--night);color:var(--bone);}
  .mm-p[hidden]{display:none;}
  .mm-p.scr{padding-top:20px;}
  .mm-p .mg-plate{margin:0;}
  .mm-p .mg-toc{margin-top:22px;}
  .mm-p>section>h2:not(summary h2){display:none;}
  .mm-p>section#log>h2{display:none;}
  .mm-p .mg-fold{margin-top:30px;}
  .mm-p .mg-cta{margin-top:36px;}
  .mm-pad{height:96px;background:var(--night);}
  .mm-cta{position:fixed;left:0;right:0;bottom:0;z-index:40;display:block;padding:10px max(16px,env(safe-area-inset-right,0px)) calc(env(safe-area-inset-bottom,0px) + 12px) max(16px,env(safe-area-inset-left,0px));background:linear-gradient(to top,var(--night) 72%,transparent);transform:translateY(110%);transition:transform .35s var(--ease,ease);pointer-events:none;}
  .mm-cta.on{transform:none;pointer-events:auto;}
  .mm-cta a{display:flex;width:100%;}
  .mm-cta .go-site::after,.mm-cta .mg-go::after{display:none;}
  .mg-chip{bottom:calc(env(safe-area-inset-bottom,0px) + 84px);}
}
@media(prefers-reduced-motion:reduce){.mm-cta{transition:none;}}
</style>
<div class="wpage" style={colorVars(C)}>
{!mag && <header class="wh" data-layout={layout}>
  <div class="wh-in">
    <div class="wh-txt">
      <span class="no" aria-hidden="true">{NO}</span>
      <nav class="crumb" aria-label="麵包屑"><a href="/">首頁</a><span>/</span><a href="/#works">有點樣子</a></nav>
      <div class="meta"><b>No.{NO}</b><span>{w.date}</span></div>
      <h1>{w.title}</h1>
      {(w.why || w.result) && <div class="ba">
        {w.why && <blockquote class="wq"><small>BEFORE</small>{w.why}</blockquote>}
        {w.result && <blockquote class="wq af"><small>AFTER</small>{w.result}</blockquote>}
      </div>}
      {w.intro && <p class="intro">{w.intro}</p>}
      <div class="acts">
        {link && <a class="go-site" href={link} target="_blank" rel="noopener"><span><b>前往網站使用</b><small>{siteName}</small></span><i aria-hidden="true">↗</i></a>}
        <a class="go-log" href="#log">看作品日誌 <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    {layout === 'v' && vid && <div class="wh-vid">
      <div class="phone">
        <div class={`scr${vid.kind === 'instagram' ? ' ig' : ''}`}>
          {vid.kind === 'file'
            ? <video src={vid.src} controls preload="metadata" playsinline></video>
            : <iframe src={vid.src} title={`${w.title} 介紹影片`} loading="lazy" scrolling="no" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen data-ig={vid.kind === 'instagram' ? '1' : undefined}></iframe>}
        </div>
      </div>
      <p class="vcap"><b>FILM</b>{vid.kind === 'instagram' ? '介紹影片・Instagram' : '介紹影片'}</p>
    </div>}
  </div>
</header>}
{mag && <header class="mg">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500&family=Fraunces:ital,wght@1,500&family=JetBrains+Mono:wght@500&display=swap&text=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.$,%20" />
  <div class="mg-in">
    <div class="mg-run"><span>8AKER零 ・ 有點樣子</span><span>No.{NO}</span></div>
    <div class="mg-spread">
      <div class="mg-txt">
        <div class="mg-kick">{w.kicker || '作品'}</div>
        <h1 class="mg-h1">{w.title_en ? <><span class="en">{w.title_en}</span><span class="zh">{w.title_zh}</span></> : w.title}</h1>
        <div class="mg-tags">{w.tag && <span class="mg-tag">{w.tag}</span>}<span>{w.date}</span></div>
        {w.deck && <p class="mg-deck">{w.deck}</p>}
        <div class="acts">
          {link && <a class="go-site mg-go" href={link} target="_blank" rel="noopener" data-play={engage ? '' : undefined}><span><b>{w.cta_label || '前往網站使用'}</b>{!w.cta_label && <small>{siteName}</small>}</span><i aria-hidden="true">↗</i></a>}
          <a class="go-log" href="#log">看作品日誌 <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="mg-plate">
        <div class="mg-fig">
          <div class="mg-desk">
