            <button type="button" class="mg-shot" id="mgShot" data-lb={shots[0].src} data-cap={shots[0].title} aria-label="放大目前畫面">
              {shots.map((x: any, i: number) => <img class={i === 0 ? 'on' : ''} src={x.src} alt={`${x.title}畫面`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />)}
            </button>
          </div>
          <div class="mg-ph" id="mgPh" aria-hidden="true"><div class="mg-scr">{shots.filter((x: any) => x.mobile).map((x: any) => <img src={x.mobile} alt="" loading="lazy" decoding="async" data-for={String(gIdx(x))} class={gIdx(x) === 0 ? 'on' : ''} />)}</div></div>
        </div>
        <div class="mg-cap" id="mgCap" aria-live="polite">
          <span class="no">Fig. 1</span><span class="tt">{shots[0].title}</span>
          <p>{shots[0].note}</p>
          <ul>{(shots[0].points || []).map((t: string) => <li>{t}</li>)}</ul>
        </div>
      </div>
    </div>
    <nav class="mg-toc" id="mgToc" aria-label="畫面目次">
      <div class="mg-toc-h"><span>目次 ・ 試玩路線</span><span class="sp"></span><button type="button" class="mg-play" id="mgPlay" aria-pressed="false">自動導覽</button></div>
      <div class={`mg-groups${colsOk ? ' cw' : ''}`} style={colsOk ? `--gc:${groups.map((g: any) => g.cols + 'fr').join(' ')}` : undefined}>{groups.map((g: any) => <div class={`mg-grp g${g.key}`}><h3><b>{g.label}</b>{g.en}</h3><div class={`mg-items${g.cols ? ' ic' : ''}`} style={g.cols ? `--ic:${g.cols}` : undefined}>{g.shots.map((x: any) => { const i = gIdx(shots.find((y: any) => y.src === x.src)); return <button type="button" data-i={i} aria-pressed={i === 0 ? 'true' : 'false'}><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="t">{x.title}</span></button>; })}</div></div>)}</div>
    </nav>
  </div>
</header>}
{mag && <div class="mm" id="mm" hidden></div>}
{mag && <div class="mm-cta" id="mmCta" aria-hidden="true"></div>}
{layout === 'h' && vid && <div class="cinema" aria-label="介紹影片"><div class="frame">{vid.kind === 'file'
  ? <video src={vid.src} controls preload="metadata" playsinline data-auto></video>
  : <iframe src={vid.src} title={`${w.title} 介紹影片`} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>}</div></div>}
<main class="wb">
  <div class="wb-in">
    {mag && w.bg && <section aria-label="背景原因" class="mg-sec" data-mm="bg" data-mm-t="背景"><h2>背景原因<small>BACKGROUND</small></h2>
      <p class="mg-lead">{w.bg.lead}</p>
      <ol class="mg-prob">{(w.bg.problems || []).map((x: any) => <li><b>{x.t}</b><span>{x.d}</span></li>)}</ol>
      {w.bg.close && <p class="mg-extra">{w.bg.close}</p>}</section>}
    {mag && how && <section aria-label="怎麼試玩" class="mg-sec" data-mm="how" data-mm-t="怎麼試玩"><h2>怎麼試玩<small>TRY IT</small></h2>
      <ol class="mg-steps">{(how.steps || []).map((x: any) => <li><b>{x.t}</b><span>{x.d}</span></li>)}</ol>
      {how.notice && <p class="mg-note">{how.notice}</p>}
      {how.extra && <p class="mg-extra">{how.extra}</p>}</section>}
    {mag && w.impact && <section aria-label="成效" class="mg-sec" data-mm="impact" data-mm-t="成效"><h2>成效<small>RESULT</small></h2>
      {w.impact.live && <p class="mg-live"><i aria-hidden="true"></i>{w.impact.live}</p>}
      <p class="mg-lead">{w.impact.lead}</p>
      <ul class="mg-rows">{(w.impact.rows || []).map((r: any) => <li><b>{r.item}</b><span class="ba"><span class="bf"><small>以前</small>{r.before}</span><span class="af"><small>現在</small>{r.after}</span></span><em><small>省下</small>{r.saved}</em></li>)}</ul>
      {w.impact.total && <p class="mg-total"><b>{w.impact.total}</b><span>{w.impact.cost}</span></p>}
      {w.impact.extra && <p class="mg-extra">{w.impact.extra}</p>}
      {w.impact.joke && <p class="mg-joke">{w.impact.joke}</p>}</section>}
    {mag && w.future && <section aria-label="未來規劃" class="mg-sec mg-fold" data-mm="future"><details open id="mgFut"><summary><h2>未來規劃<small>NEXT</small></h2></summary>
      <p class="mg-lead">{w.future.lead}</p>
      <div class="mg-fut"><div><h3 class="mg-sub">可以再新增的功能</h3><ul>{(w.future.add || []).map((x: any) => <li><b>{x.t}</b><span>{x.d}</span></li>)}</ul></div>
      <div><h3 class="mg-sub">想再優化的地方</h3><ul>{(w.future.improve || []).map((x: any) => <li><b>{x.t}</b><span>{x.d}</span></li>)}</ul></div></div></details></section>}
    {mag && w.cta && <section aria-label="下一步" class="mg-cta" data-mm="cta"><h2>{w.cta.title}</h2><p>{w.cta.body}</p>
      <div class="acts">{/^\/[a-z0-9\/-]*$/.test(w.cta.href || '') && <a class="go-site mg-go" href={w.cta.href} data-want={engage ? '' : undefined}><span><b>{w.cta.primary}</b></span><i aria-hidden="true">→</i></a>}
      {link && <a class="go-log" href={link} target="_blank" rel="noopener" data-play={engage ? '' : undefined}>{w.cta.secondary} <span aria-hidden="true">↗</span></a>}</div></section>}
    {!mag && imgs.length > 0 && <section aria-label="畫面"><h2>畫面<small>SCREENS</small></h2>
      <div class={`gal${imgs.length === 1 ? ' one' : ''}`}>{imgs.map((src, i) => (
        <figure><button type="button" data-lb={src} data-cap={caps[i] || ''} aria-label={`放大第 ${i + 1} 張畫面`}><img src={src} alt={caps[i] || `${w.title} 畫面 ${i + 1}`} loading={i ? 'lazy' : 'eager'} decoding="async" /></button>{caps[i] && <figcaption>{caps[i]}</figcaption>}</figure>))}</div></section>}
    <section aria-label="作品日誌" id="log" data-mm="log" data-mm-t="日誌"><h2>作品日誌<small>LOG</small></h2>
      {log.length > 0
        ? <ol class="log">{log.map((e) => <li><time datetime={e.date.toISOString().slice(0, 10)}>{dot(e.date)}</time><a href={e.url}>{e.title}</a>{e.excerpt && <p>{e.excerpt}</p>}</li>)}</ol>
        : <p class="empty">做這個作品時寫下的日常紀錄，會自動整理在這裡。</p>}
    </section>
    <a class="back" href="/#works">← 回到有點樣子</a>
  </div>
</main>
{mag && <script is:inline type="application/json" id="mgData" set:html={JSON.stringify(shots.map((x: any) => ({ src: x.src, title: x.title, url: x.url || '', note: x.note || '', points: x.points || [] }))).replace(/</g, '\u003c')}></script>}
<dialog class="lb" id="lb" aria-label="放大畫面"><button class="x" type="button" aria-label="關閉">×</button><img alt="" /><p></p></dialog>
</div>
{engage && <div id="mgEng" data-slug={w.slug} data-ask={ask} data-show={w.show_likes ? '1' : ''} hidden></div>}
<script>
(function(){var d=document.getElementById('lb') as HTMLDialogElement|null;if(!d||!d.showModal)return;var im=d.querySelector('img') as HTMLImageElement,cp=d.querySelector('p') as HTMLElement;
  document.addEventListener('click',function(e){var b=(e.target as HTMLElement).closest('[data-lb]') as HTMLElement|null;if(!b)return;im.src=b.dataset.lb||'';im.alt=b.dataset.cap||'';cp.textContent=b.dataset.cap||'';d.showModal();});
  d.addEventListener('click',function(e){if(e.target===d||(e.target as HTMLElement).closest('.x'))d.close();});})();


/* 手機版：把畫面、怎麼試玩、成效、背景、日誌排成分頁籤；回到寬螢幕時自動還原。內容沒有複製，只是搬位置 */
(function(){var mm=document.getElementById('mm') as HTMLElement|null,bar=document.getElementById('mmCta') as HTMLElement|null;if(!mm||!bar)return;
  var hdr=document.querySelector('header.mg') as HTMLElement,mq=matchMedia('(max-width:720px)');
  var moved:{n:HTMLElement,p:Node,s:Node|null}[]=[],io:IntersectionObserver|null=null,navh=0;
  function mv(n:HTMLElement|null,to:HTMLElement){if(!n)return;moved.push({n:n,p:n.parentNode as Node,s:n.nextSibling});to.appendChild(n);}
  function q(s:string){return document.querySelector(s) as HTMLElement|null;}
  function build(){
    var top=document.getElementById('top');navh=top?Math.round(top.getBoundingClientRect().height):60;document.documentElement.style.setProperty('--navh',navh+'px');
    var defs:{k:string,t:string,els:(HTMLElement|null)[]}[]=[
      {k:'scr',t:'畫面',els:[q('.mg-plate'),q('.mg-toc')]},
      {k:'how',t:'怎麼試玩',els:[q('[data-mm=how]')]},
      {k:'impact',t:'成效',els:[q('[data-mm=impact]'),q('[data-mm=future]')]},
      {k:'bg',t:'背景',els:[q('[data-mm=bg]')]},
      {k:'log',t:'日誌',els:[q('[data-mm=log]'),q('[data-mm=cta]')]}
    ].filter(function(d){return d.els.some(Boolean);});
    var tabs=document.createElement('div');tabs.className='mm-tabs';tabs.setAttribute('role','tablist');
    var panels:HTMLElement[]=[];
    defs.forEach(function(d,i){
      var b=document.createElement('button');b.type='button';b.setAttribute('role','tab');b.textContent=d.t;b.setAttribute('aria-selected',String(i===0));b.dataset.k=d.k;tabs.appendChild(b);
      var p=document.createElement('div');p.className='mm-p'+(d.k==='scr'?' scr':'');p.hidden=i!==0;p.setAttribute('role','tabpanel');p.dataset.k=d.k;d.els.forEach(function(e){mv(e,p);});mm!.appendChild(p);panels.push(p);
    });
    mm!.insertBefore(tabs,mm!.firstChild);
    var pad=document.createElement('div');pad.className='mm-pad';mm!.appendChild(pad);
    function pick(k:string,scroll:boolean){
      tabs.querySelectorAll('button').forEach(function(b){b.setAttribute('aria-selected',String((b as HTMLElement).dataset.k===k));});
      panels.forEach(function(p){p.hidden=p.dataset.k!==k;});
      if(scroll){var y=tabs.getBoundingClientRect().top+scrollY-navh+1;if(scrollY>y)window.scrollTo({top:y});}
    }
    tabs.addEventListener('click',function(e){var b=(e.target as HTMLElement).closest('button') as HTMLElement|null;if(b)pick(b.dataset.k||'scr',true);});
    // 「看作品日誌」連結：切到日誌分頁
    document.querySelectorAll('a[href="#log"]').forEach(function(a){(a as any)._mm=function(e:Event){if(!mq.matches)return;e.preventDefault();pick('log',false);var y=tabs.getBoundingClientRect().top+scrollY-navh+1;window.scrollTo({top:y,behavior:'smooth'});};a.addEventListener('click',(a as any)._mm);});
    if(location.hash==='#log')pick('log',false);
    // 底部固定的行動按鈕：主要按鈕捲出畫面之後才出現
    var src=hdr.querySelector('.acts > .go-site') as HTMLElement|null||q('[data-mm=cta] .go-site');
    if(src){var c=src.cloneNode(true) as HTMLElement;c.classList.remove('mg-go');c.removeAttribute('id');bar!.appendChild(c);
      if('IntersectionObserver' in window){var ac=hdr.querySelector('.acts') as HTMLElement||src;io=new IntersectionObserver(function(es){bar!.classList.toggle('on',!es[0].isIntersecting);},{rootMargin:'-'+navh+'px 0px 0px 0px'});io.observe(ac);}}
    mm!.hidden=false;
  }
  function destroy(){
    if(io){io.disconnect();io=null;}
    while(moved.length){var m=moved.pop()!;m.p.insertBefore(m.n,m.s);}
    mm!.innerHTML='';mm!.hidden=true;bar!.innerHTML='';bar!.classList.remove('on');
    document.querySelectorAll('a[href="#log"]').forEach(function(a){if((a as any)._mm){a.removeEventListener('click',(a as any)._mm);(a as any)._mm=null;}});
  }
  function sync(){if(mq.matches){if(!moved.length)build();}else if(moved.length)destroy();}
  sync();(mq.addEventListener?mq.addEventListener('change',sync):mq.addListener(sync));
})();

/* 雜誌版：目次切換畫面、手機同步、自動導覽（預設關閉） */
(function(){var shot=document.getElementById('mgShot') as HTMLElement|null;if(!shot)return;
  var imgs=Array.prototype.slice.call(shot.querySelectorAll('img')) as HTMLElement[];
  var ph=document.getElementById('mgPh') as HTMLElement,phImgs=Array.prototype.slice.call(ph.querySelectorAll('img')) as HTMLElement[];
  var btns=Array.prototype.slice.call(document.querySelectorAll('.mg-items button')) as HTMLElement[];
  var toc=document.getElementById('mgToc') as HTMLElement,play=document.getElementById('mgPlay') as HTMLElement,cap=document.getElementById('mgCap') as HTMLElement,url=document.getElementById('mgUrl') as HTMLElement;
  var data:any[]=JSON.parse((document.getElementById('mgData') as HTMLElement).textContent||'[]');
  var cur=0,auto=false,timer:any=0,DUR=4500,small=matchMedia('(max-width:720px)').matches;
  function esc(t:string){return t.replace(/[&<>]/g,function(c){return c==='&'?'&amp;':c==='<'?'&lt;':'&gt;';});}
  function show(i:number){cur=i;var s=data[i];
    imgs.forEach(function(im,k){im.classList.toggle('on',k===i);});
    var hasPh=false;phImgs.forEach(function(im){var on=im.getAttribute('data-for')===String(i);im.classList.toggle('on',on);if(on)hasPh=true;});
    ph.classList.toggle('off',!hasPh);
    var on=phImgs.filter(function(im){return im.classList.contains('on');})[0] as HTMLImageElement|undefined;if(on){ph.setAttribute('data-lb',on.getAttribute('src')||'');ph.setAttribute('data-cap',s.title);}else{ph.removeAttribute('data-lb');}
    btns.forEach(function(b){b.setAttribute('aria-pressed',String(b.getAttribute('data-i')===String(i)));});
    if(url)url.textContent=s.url||'';
    shot!.setAttribute('data-lb',s.src);shot!.setAttribute('data-cap',s.title);
    cap.innerHTML='<span class="no">Fig. '+(i+1)+'</span><span class="tt">'+esc(s.title)+'</span><p>'+esc(s.note||'')+'</p><ul>'+(s.points||[]).map(function(t:string){return '<li>'+esc(t)+'</li>';}).join('')+'</ul>';
    toc.classList.toggle('auto',auto);
    if(small){var cb=btns[i],bx=cb&&cb.closest('.mg-groups') as HTMLElement|null;if(cb&&bx)bx.scrollTo({left:cb.offsetLeft+(cb.offsetParent===bx?0:(cb.offsetParent as HTMLElement).offsetLeft)-bx.clientWidth/2+cb.offsetWidth/2,behavior:'smooth'});}
    clearTimeout(timer);if(auto)timer=setTimeout(function(){show((cur+1)%data.length);},DUR);}
  btns.forEach(function(b){b.addEventListener('click',function(){auto=false;play.setAttribute('aria-pressed','false');play.textContent='自動導覽';show(+(b.getAttribute('data-i')||0));});});
  play.addEventListener('click',function(){auto=!auto;play.setAttribute('aria-pressed',String(auto));play.textContent=auto?'暫停':'自動導覽';show(cur);});
  var sx=0,sy=0;(document.querySelector('.mg-fig') as HTMLElement).addEventListener('touchstart',function(e:any){sx=e.touches[0].clientX;sy=e.touches[0].clientY;},{passive:true});
  (document.querySelector('.mg-fig') as HTMLElement).addEventListener('touchend',function(e:any){var dx=e.changedTouches[0].clientX-sx,dy=e.changedTouches[0].clientY-sy;if(Math.abs(dx)>45&&Math.abs(dx)>Math.abs(dy)*1.5){auto=false;play.setAttribute('aria-pressed','false');play.textContent='自動導覽';show((cur+(dx<0?1:data.length-1))%data.length);}},{passive:true});
  var calm=matchMedia('(prefers-reduced-motion: reduce)').matches;if(calm)DUR=7000;
  if(!calm&&!small){auto=true;play.setAttribute('aria-pressed','true');play.textContent='暫停';show(cur);}
  if('IntersectionObserver' in window){new IntersectionObserver(function(es){if(!es[0].isIntersecting)clearTimeout(timer);else if(auto)show(cur);},{threshold:.2}).observe(toc);}
})();

/* 手機：未來規劃預設收合 */
(function(){var d=document.getElementById('mgFut') as HTMLDetailsElement|null;if(d&&matchMedia('(max-width:720px)').matches)d.open=false;})();

/* Instagram 嵌入：依 Instagram 回傳的實際高度調整，不會被裁切或留白 */
(function(){var f=document.querySelector('iframe[data-ig]') as HTMLIFrameElement|null;if(!f)return;
  addEventListener('message',function(e){if(e.origin!=='https://www.instagram.com'||e.source!==f.contentWindow)return;
    try{var m=typeof e.data==='string'?JSON.parse(e.data):e.data;if(m&&m.type==='MEASURE'&&m.details&&m.details.height)f.style.height=Math.round(m.details.height)+'px';}catch(_){}});})();
/* 自己上傳的 .mp4：如果是直式影片，把橫幅改成置中的直式比例 */
(function(){var v=document.querySelector('.cinema video') as HTMLVideoElement|null;if(!v)return;
  v.addEventListener('loadedmetadata',function(){if(v.videoHeight>v.videoWidth){var fr=v.parentElement as HTMLElement;fr.style.aspectRatio='9/16';fr.style.maxWidth='360px';fr.style.margin='0 auto';}});})();
/* 互動：試玩次數（靜默）、♡ 我有興趣、玩完回來的小提示。只記數字，不存個人資料；任何失敗都不影響頁面使用 */
(function () {
  var box = document.getElementById('mgEng'); if (!box) return;
  var API = 'https://gsaqrjovipnfiedvjaeb.supabase.co/functions/v1/work-actions';
  var slug = box.getAttribute('data-slug') || '', ask = box.getAttribute('data-ask') || '';
  var ls = { g: function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } }, s: function (k, v) { try { localStorage.setItem(k, v); } catch (e) {} } };
  function post(a) { try { fetch(API, { method: 'POST', keepalive: true, body: JSON.stringify({ slug: slug, action: a, website: '' }) }).catch(function () {}); } catch (e) {} }
  var heart = document.querySelector('[data-heart]'), liked = ls.g('liked:' + slug) === '1', likes = 0;
  function paint() {
    if (!heart) return;
    heart.setAttribute('aria-pressed', liked ? 'true' : 'false');
    var n = heart.querySelector('.n'); if (n) { n.textContent = likes; n.hidden = !(box.getAttribute('data-show') === '1' && likes >= 5); }
  }
  function setLiked(on) {
    if (on === liked) return;
    liked = on; likes = Math.max(0, likes + (on ? 1 : -1)); ls.s('liked:' + slug, on ? '1' : '0'); paint(); post(on ? 'like' : 'unlike');
  }
  paint();
  try {
    fetch(API + '?slug=' + encodeURIComponent(slug)).then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
      if (!d) return; likes = +d.likes || 0; if (typeof d.liked === 'boolean') { liked = d.liked; ls.s('liked:' + slug, liked ? '1' : '0'); } paint();
    }).catch(function () {});
  } catch (e) {}
  if (heart) heart.addEventListener('click', function () { setLiked(!liked); });
  document.querySelectorAll('[data-play]').forEach(function (a) { a.addEventListener('click', function () { post('play'); ls.s('played:' + slug, String(Date.now())); }); });
  document.querySelectorAll('[data-want]').forEach(function (a) { a.addEventListener('click', function () { post('want'); }); });

  var chip = null;
  function closeChip() { if (chip) { chip.remove(); chip = null; } }
  function showChip() {
    if (chip) return;
    ls.s('asked:' + slug, String(Date.now()));
    chip = document.createElement('aside'); chip.className = 'mg-chip'; chip.setAttribute('role', 'dialog'); chip.setAttribute('aria-label', ask);
    var p = document.createElement('p'); p.textContent = ask; chip.appendChild(p);
    var row = document.createElement('div'); row.className = 'row'; chip.appendChild(row);
    if (!liked) { var b = document.createElement('button'); b.type = 'button'; b.textContent = '♡ 喜歡'; b.addEventListener('click', function () { setLiked(true); closeChip(); }); row.appendChild(b); }
    var w = document.createElement('a'); w.className = 'want'; w.href = '/chat/'; w.textContent = '想要自己的版本'; w.addEventListener('click', function () { post('want'); }); row.appendChild(w);
    var x = document.createElement('button'); x.type = 'button'; x.className = 'x'; x.setAttribute('aria-label', '關閉'); x.textContent = '✕'; x.addEventListener('click', closeChip); chip.appendChild(x);
    document.body.appendChild(chip);
  }
  function maybeAsk() {
    var t = +ls.g('played:' + slug) || 0; if (!t) return;
    var away = Date.now() - t; if (away < 120000 || away > 6 * 3600e3) return;
    var last = +ls.g('asked:' + slug) || 0; if (last && Date.now() - last < 14 * 86400e3) return;
    showChip();
  }
  document.addEventListener('visibilitychange', function () { if (!document.hidden) maybeAsk(); });
  window.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeChip(); });
})();
</script>
</BaseLayout>
