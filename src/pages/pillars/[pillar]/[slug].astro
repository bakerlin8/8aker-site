---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { pillars, pillarBySlug } from '../../../data/pillars';
import worksData from '../../../data/works.json';
import { pillarEntries } from '../../../data/journal';

export async function getStaticPaths() {
  const paths: any[] = [];
  for (const p of pillars) {
    const entries = await pillarEntries(p.slug, 'asc');
    entries.forEach((entry: any, i: number) => paths.push({ params: { pillar: p.slug, slug: entry.slug }, props: { entry, prev: entries[i - 1] ?? null, next: entries[i + 1] ?? null } }));
  }
  return paths;
}
const { pillar } = Astro.params;
const { entry, prev, next } = Astro.props as any;
const meta = pillarBySlug(pillar!)!;
const { Content } = await render(entry);
const alsoMeta = entry.data.also && entry.data.also !== meta.slug ? pillarBySlug(entry.data.also) : null;
const ofWork = entry.data.work ? (worksData.works as any[]).find((x) => x.slug === entry.data.work && /^[a-z0-9-]+$/.test(x.slug)) : null;
const dot = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
const SITE = (Astro.site ?? new URL('https://8aker0.com')).href.replace(/\/$/, '');
const url = `${SITE}/pillars/${meta.slug}/${entry.slug}/`;
// AEO：正文有「## 常見問題」區塊，下面每個「### 問題」＋ 回答 → 自動輸出 FAQPage 結構化資料，讓搜尋與 AI 問答能直接引用
const faqItems: { q: string; a: string }[] = [];
{
  const sec = /^##\s*(?:常見問題|FAQ|Q&A)[^\n]*\n([\s\S]*?)(?=^##\s[^#]|$(?![\s\S]))/mi.exec(entry.body ?? '');
  if (sec) for (const part of sec[1].split(/^###\s+/m).slice(1)) {
    const [q, ...rest] = part.split('\n'); const a = rest.join(' ').replace(/[*_`>#-]/g, '').replace(/\s+/g, ' ').trim();
    if (q.trim() && a && !/^[（(]/.test(a)) faqItems.push({ q: q.trim().replace(/[*_`]/g, ''), a });
  }
}
const schema = [
  ...(faqItems.length ? [{ '@type': 'FAQPage', '@id': `${url}#faq`, mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
  { '@type': 'BlogPosting', '@id': `${url}#article`, headline: entry.data.title, description: entry.data.excerpt ?? meta.desc,
    datePublished: entry.data.date.toISOString(), dateModified: entry.data.date.toISOString(), inLanguage: 'zh-Hant-TW',
    author: { '@id': `${SITE}/#person` }, publisher: { '@id': `${SITE}/#person` }, mainEntityOfPage: url,
    articleSection: `${meta.type}・${meta.title}`, keywords: (entry.data.tags ?? []).join(', ') },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: '日常紀錄', item: `${SITE}/journal/` },
    { '@type': 'ListItem', position: 3, name: `${meta.type}・${meta.title}`, item: `${SITE}/pillars/${meta.slug}/` },
    { '@type': 'ListItem', position: 4, name: entry.data.title, item: url } ] },
];
---
<BaseLayout title={`${entry.data.title} — 8AKER零`} description={entry.data.excerpt ?? meta.desc} schema={schema} type="article">
<style is:global>
.ah{position:relative;overflow:hidden;background:radial-gradient(110% 90% at 85% 10%,#2A1520 0%,#1C0F14 65%);color:#EFE5D6;padding:150px 40px 64px;}
.ah-in{max-width:760px;margin:0 auto;position:relative;}
.ah .k{position:absolute;right:-40px;top:-60px;font-family:var(--jp);font-weight:300;font-size:220px;line-height:1;color:var(--dc);opacity:.12;pointer-events:none;}
.ah .crumb{font-size:13px;color:#86707A;display:flex;gap:10px;flex-wrap:wrap;}
.ah .crumb a{border-bottom:1px solid rgba(239,229,214,.15);transition:color .3s,border-color .3s;}
.ah .crumb a:hover{color:#EFE5D6;border-color:#D4A24C;}
.ah h1{font-family:var(--serif);font-weight:500;font-size:clamp(28px,4.2vw,44px);line-height:1.45;margin-top:14px;}
.ah .meta{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-top:18px;font-size:13px;color:#B9A89E;}
.rp{position:fixed;top:0;left:0;height:2px;width:100%;background:var(--gold);transform-origin:0 50%;transform:scaleX(0);z-index:60;pointer-events:none;}
.ah .alsob{padding:1px 9px;border:1px solid var(--dc);color:var(--dc);font-size:12px;transition:background .3s;}
.ah .alsob:hover{background:rgba(239,229,214,.06);}
.ah .meta span{padding:1px 9px;border:1px solid rgba(239,229,214,.15);font-size:12px;}
.read{padding:64px 40px 96px;background:var(--night);color:var(--bone);}
.read-in{max-width:720px;margin:0 auto;}
.prose{font-family:var(--serif);font-size:17px;line-height:2.05;color:var(--bone);}
.prose>*{animation:detIn2 .8s var(--ease) both;}
.prose>*:nth-child(2){animation-delay:.05s}.prose>*:nth-child(3){animation-delay:.1s}.prose>*:nth-child(4){animation-delay:.15s}
@keyframes detIn2{from{opacity:0;filter:blur(4px);transform:translateY(6px);}}
.prose p{margin:0 0 1.3em;}
.prose h2{font-weight:500;font-size:23px;margin:2.2em 0 .8em;padding-top:.6em;border-top:1px solid var(--line);}
.prose h3{font-weight:500;font-size:19px;margin:1.8em 0 .6em;}
.prose strong{font-weight:500;background:linear-gradient(transparent 62%,var(--gold-soft) 62%);}
.prose a{color:var(--gold);border-bottom:1px solid currentColor;}
.prose ul,.prose ol{margin:0 0 1.3em 1.4em;}
.prose li{margin-bottom:.4em;}
.prose blockquote{margin:1.6em 0;padding-left:20px;border-left:2px solid var(--gold);color:var(--bone-2);}
.prose .embed{margin:2em 0;}
.prose .embed-frame{border:1px solid var(--line);background:var(--night-2);overflow:hidden;}
.prose .embed-16x9{aspect-ratio:16/9;}
.prose .embed iframe{display:block;width:100%;height:100%;border:0;}
.prose .embed figcaption{display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;margin-top:10px;font-family:var(--sans,inherit);font-size:13px;line-height:1.7;color:var(--ash);}
.prose .embed figcaption span{letter-spacing:.1em;font-size:12px;color:var(--gold);}
.prose .embed figcaption a{color:var(--bone-2);border-bottom:1px solid var(--line);}
.prose .embed figcaption a:hover{color:var(--gold);border-color:var(--gold);}
.prose img{max-width:100%;height:auto;display:block;margin:1.6em 0;}
.prose code{font-size:.88em;background:var(--night-2);padding:.1em .4em;}
.prose pre{overflow-x:auto;background:var(--night-2);padding:16px;margin:0 0 1.3em;font-size:14px;line-height:1.7;}
.ofwork{display:grid;grid-template-columns:1fr auto;align-items:center;gap:4px 16px;margin-top:48px;padding:18px 22px;border:1px solid var(--line);border-left:2px solid var(--gold);background:var(--night-2);transition:border-color .3s;}
.ofwork small{grid-column:1/-1;font-size:12px;letter-spacing:.12em;color:var(--ash);}
.ofwork span{font-family:var(--serif);font-size:17px;}
.ofwork i{font-style:normal;font-size:13px;color:var(--gold);}
.ofwork:hover{border-color:rgba(212,162,76,.5);}
.pn{display:grid;grid-template-columns:1fr 1fr;gap:1px;margin-top:64px;border:1px solid var(--line);}
.pn a,.pn span{padding:20px;min-height:96px;display:flex;flex-direction:column;gap:6px;transition:background .3s;}
.pn a:hover{background:var(--night-2);}
.pn small{font-size:12.5px;color:var(--ash);}
.pn b{font-family:var(--serif);font-weight:500;font-size:15px;line-height:1.5;transition:color .3s;}
.pn a:hover b{color:var(--gold);}
.pn .nx{text-align:right;border-left:1px solid var(--line);}
.backs{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px;}
.backs a{display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border:1px solid var(--line);font-size:13.5px;color:var(--bone-2);transition:color .3s,border-color .3s;}
.backs a:hover{color:var(--bone);border-color:var(--gold);}
.backs a:last-child{margin-left:auto;}
.ah .meta .dft{border:1px dashed #D4A24C;color:#D4A24C;}
@media(max-width:700px){.backs a{flex:1 1 auto;justify-content:center;}.backs a:last-child{margin-left:0;}}
@media(max-width:700px){.ah{padding:96px 20px 40px;}.ah .k{font-size:150px;right:-20px;}.read{padding:44px 20px 72px;}.prose{font-size:16px;}}
@media(prefers-reduced-motion:reduce){.prose>*{animation:none;}}
</style>
<div class="rp" id="rp" aria-hidden="true"></div>
<header class="ah" style={`--dc:var(--c-${meta.slug})`}>
  <div class="ah-in">
    <div class="k" aria-hidden="true" style={`view-transition-name:k-${meta.slug}`}>{meta.kanji}</div>
    <p class="crumb rv"><a href="/">首頁</a>／<a href="/journal/">日常紀錄</a>／<a href={`/pillars/${meta.slug}/`}>{meta.type}・{meta.title}</a></p>
    <h1 class="rv" style="--i:1">{entry.data.title}</h1>
    <div class="meta rv" style="--i:2">{entry.data.draft && <span class="dft">草稿・只在預覽顯示</span>}<time>{dot(entry.data.date)}</time>{alsoMeta && <a class="alsob" href={`/pillars/${alsoMeta.slug}/`} style={`--dc:var(--c-${alsoMeta.slug})`}>也屬於・{alsoMeta.type}</a>}{entry.data.tags?.map((t: string) => <span>{t}</span>)}</div>
  </div>
</header>
<article class="read band-light">
  <div class="read-in">
    <div class="prose"><Content /></div>
    {ofWork && <a class="ofwork" href={`/works/${ofWork.slug}/`}><small>這篇屬於作品</small><span>{ofWork.title}</span><i>看作品 →</i></a>}
    <nav class="pn" aria-label="同方向的上一篇與下一篇">
      {prev ? <a href={`/pillars/${meta.slug}/${prev.slug}`}><small>← 上一篇</small><b>{prev.data.title}</b></a> : <span><small>← 上一篇</small><b style="color:var(--ash)">這是第一篇</b></span>}
      {next ? <a class="nx" href={`/pillars/${meta.slug}/${next.slug}`}><small>下一篇 →</small><b>{next.data.title}</b></a> : <span class="nx"><small>下一篇 →</small><b style="color:var(--ash)">還沒寫</b></span>}
    </nav>
    <nav class="backs" aria-label="回到列表">
      <a href={`/pillars/${meta.slug}/`}>「{meta.type}」全部文章</a>
      <a href="/journal/">日常紀錄・全部</a>
      <a href="/">回首頁</a>
    </nav>
  </div>
</article>
<script>
  // 閱讀進度條：頂端一條細金線
  const bar = document.getElementById('rp');
  const art = document.querySelector('.read');
  if (bar && art) {
    let raf = 0;
    const upd = () => { raf = 0; const r = art.getBoundingClientRect(), h = r.height - innerHeight * 0.6; const p = Math.min(1, Math.max(0, (-r.top + innerHeight * 0.2) / Math.max(h, 1))); bar.style.transform = `scaleX(${p.toFixed(3)})`; };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(upd); }, { passive: true });
    addEventListener('resize', upd); upd();
  }
</script>
</BaseLayout>
