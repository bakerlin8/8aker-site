---
import BaseLayout from '../../layouts/BaseLayout.astro';
import copy from '../../data/site-copy.json';
const igHandle = String((copy as any).instagram_handle || '').replace(/^@/, '').trim();
const ig = /^[A-Za-z0-9._]{1,30}$/.test(igHandle) ? igHandle : '';
import services from '../../data/services.json';
import inq from '../../data/inquiry.json';
const hideItems: string[] = (inq as any).hide_items || [];
const hats = ((services as any).hats || []).map((h: any) => ({ k: h.k, title: h.title, desc: h.desc, items: (h.items || []).filter((x: string) => !hideItems.includes(x)) }));
const OTHER = { k: 'other', title: '祈願所：我可以幫忙', desc: '', items: [] };
const noteForm = String((services as any).form_note || '');
---
<BaseLayout title="需求填表 — 8AKER零" description="想聊日本不動產、隨行地陪或 AI 工具？選一個服務、回答幾個問題，送出就好。">
<style is:global>
.chat{min-height:100vh;padding:140px 40px 96px;background:radial-gradient(110% 80% at 80% 0%,#3D0F1A 0%,#1C0F14 60%);color:#EFE5D6;}
.chat-in{max-width:720px;margin:0 auto;}
.chat .crumb{font-size:13px;color:#86707A;}.chat .crumb a{border-bottom:1px solid rgba(239,229,214,.15);}
.chat h1{font-family:var(--serif);font-weight:500;font-size:clamp(30px,4.6vw,44px);margin-top:12px;color:#EBD3A8;}
.chat .lede{color:#B9A89E;margin-top:12px;line-height:1.9;max-width:34em;}
.cf .scope[hidden],.cf label[hidden],.cf .q[hidden],.cf .qwarn[hidden]{display:none;}
.cf .q{margin-top:16px;}
.cf .q>.ql{display:block;font-size:13px;color:#5B4B4E;margin-bottom:6px;}
.cf .q .chips{margin-top:0;}
.cf .q input.li{margin-bottom:6px;}
.cf .q .qh{font-size:12.5px;color:#7a6a6d;line-height:1.7;margin-top:8px;}
.cf .q .qwarn{font-size:13.5px;color:#A1324A;margin-top:8px;line-height:1.7;}
.cf .scope{margin-top:14px;display:inline-block;font-size:13px;letter-spacing:.06em;color:#7a5a1a;background:#F6E9D3;border:1px solid rgba(158,111,34,.4);padding:5px 12px;}
.steps{display:flex;gap:18px;margin-top:22px;font-size:12.5px;color:#86707A;letter-spacing:.06em;}
.steps b{font-weight:400;color:#D4A24C;}
.cf{margin-top:28px;background:#EFE5D6;color:#1C0F14;padding:28px;}
.cf fieldset{border:0;padding:0;margin:0;}
.cf legend,.cf label>span{display:block;font-size:13px;color:#5B4B4E;margin-bottom:6px;}
.cf label{display:block;margin-top:16px;}
.cf input,.cf select,.cf textarea{display:block;width:100%;font:inherit;font-size:16px;color:#1C0F14;background:#FBF6F3;border:1px solid rgba(42,24,30,.18);padding:10px 12px;border-radius:0;}
.cf input:focus,.cf select:focus,.cf textarea:focus{outline:none;border-color:#9E6F22;box-shadow:0 0 0 3px rgba(158,111,34,.15);}
.topics{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:8px;}
.topics label{margin:0;display:flex;gap:10px;align-items:center;padding:11px 12px;border:1px solid rgba(42,24,30,.18);background:#FBF6F3;cursor:pointer;font-size:14.5px;color:#1C0F14;transition:border-color .2s,background .2s;}
.topics input{width:auto;margin:0;accent-color:#9E6F22;}
.topics label:has(input:checked){border-color:#9E6F22;background:#F6E9D3;}
.frow2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 14px;}
.cf .hint{font-size:12.5px;color:#7a6a6d;margin-top:14px;line-height:1.7;}
.cf .err{color:#A1324A;font-size:13.5px;margin-top:10px;min-height:1em;}
.cbtn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:10px 20px;font-size:15px;border:0;cursor:pointer;transition:transform .25s var(--ease),background .25s;}
.cbtn.gold{background:#D4A24C;color:#1C0F14;}.cbtn.gold:hover{background:#E2B35E;transform:translateY(-1px);}
.cbtn.ink{background:#1C0F14;color:#EFE5D6;}.cbtn.ink:hover{transform:translateY(-1px);}
.cbtn.line{background:transparent;color:#1C0F14;box-shadow:inset 0 0 0 1px rgba(42,24,30,.3);}
.cbtn.ghost{background:transparent;color:#EFE5D6;box-shadow:inset 0 0 0 1px rgba(239,229,214,.3);}
.cacts{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px;}
.preview{margin-top:28px;}
.preview canvas{display:block;width:100%;max-width:420px;height:auto;border:1px solid rgba(239,229,214,.15);box-shadow:0 30px 60px -30px #000;}
.pv-grid{display:grid;grid-template-columns:minmax(0,420px) minmax(0,1fr);gap:28px;align-items:start;}
.pv-side h2{font-family:var(--serif);font-weight:500;font-size:20px;}
.pv-side ol{margin:12px 0 0 1.2em;color:#B9A89E;font-size:14px;line-height:1.9;}
.pv-side .cacts{flex-direction:column;align-items:stretch;}
.pv-side .ok{font-size:13.5px;color:#D4A24C;min-height:1.4em;margin-top:10px;}
.pv-side pre{white-space:pre-wrap;font-family:inherit;font-size:13px;color:#B9A89E;background:rgba(239,229,214,.05);border:1px solid rgba(239,229,214,.1);padding:12px;margin-top:16px;line-height:1.8;}
.privacy-note{font-size:12.5px;color:#86707A;margin-top:18px;line-height:1.8;}
@media(max-width:720px){.chat{padding:100px 20px 72px;}.cf{padding:20px 16px;margin-left:-4px;margin-right:-4px;}.frow2{grid-template-columns:1fr;}.pv-grid{grid-template-columns:1fr;}.svc-pick{grid-template-columns:1fr;}.cacts .cbtn{width:100%;}}
.svc-pick{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;}
.svc-pick label{margin:0;display:block;cursor:pointer;}
.svc-pick input{position:absolute;opacity:0;pointer-events:none;width:auto;}
.svc-pick .sp{display:block;padding:14px 14px 13px;border:1px solid rgba(42,24,30,.18);background:transparent;transition:border-color .2s;height:100%;}
.svc-pick .sp b{display:block;font-weight:500;font-size:16px;color:#1C0F14;}
.svc-pick .sp small{display:block;margin-top:4px;font-size:12.5px;line-height:1.6;color:#7a6a6d;}
.svc-pick label{background:#FBF6F3;transition:background .2s;}
.svc-pick label:has(input:checked){background:#F6E9D3;}
.svc-pick label:has(input:checked) .sp{border-color:#9E6F22;}
.svc-pick label{position:relative;overflow:hidden;}
.svc-pick .sp{position:relative;z-index:1;}
.svc-pick label::after{content:attr(data-k);position:absolute;right:-4px;bottom:-22px;font-family:var(--jp);font-size:96px;line-height:1;color:rgba(var(--hc),.17);z-index:0;transform:translateY(18px) scale(.92);opacity:0;transition:transform .5s var(--ease),opacity .4s;pointer-events:none;}
.svc-pick label[data-long]::after{font-size:62px;bottom:-8px;}
.svc-pick label:nth-child(3n+1){--hc:176,70,92;}
.svc-pick label:nth-child(3n+2){--hc:158,111,34;}
.svc-pick label:nth-child(3n+3){--hc:110,92,78;}
.svc-pick label:hover::after,.svc-pick label:has(input:checked)::after{transform:none;opacity:1;}
@media(hover:none){.svc-pick label::after{transform:none;opacity:.7;}.svc-pick label:has(input:checked)::after{opacity:1;}}
.svc-pick input:focus-visible+.sp{box-shadow:0 0 0 3px rgba(158,111,34,.25);}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px;}
.chips label{margin:0;display:flex;gap:8px;align-items:center;padding:8px 12px;border:1px solid rgba(42,24,30,.18);background:#FBF6F3;font-size:14px;cursor:pointer;}
.chips input{width:auto;margin:0;accent-color:#9E6F22;}
.chips label:has(input:checked){border-color:#9E6F22;background:#F6E9D3;}
.cf .req{color:#A1324A;margin-left:2px;}
.cf .crow{display:flex;gap:8px;margin:0;}.crow select{width:auto;flex:0 0 112px;}.crow input{flex:1;min-width:0;}
.hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0;}
.done{margin-top:28px;background:#EFE5D6;color:#1C0F14;padding:28px;}
.done h2{font-family:var(--serif);font-weight:500;font-size:22px;}
.done p{margin-top:10px;line-height:1.9;color:#5B4B4E;font-size:15px;}
.done .ok{color:#7a5a1a;font-size:13.5px;min-height:1.4em;margin-top:10px;}
</style>
<main class="chat">
  <div class="chat-in">
    <nav class="crumb" aria-label="麵包屑"><a href="/">首頁</a> / 需求填表</nav>
    <h1>需求填表</h1>
    <p class="lede">選一個服務，回答幾個問題就好。{noteForm}</p>

    <form class="cf" id="cf" novalidate>
      <fieldset id="svcSet"><legend>想聊什麼？</legend>
        <div class="svc-pick">{hats.map((h: any) => <label data-k={h.k} data-long={h.k.length > 1 ? '1' : undefined}><input type="radio" name="svc" value={h.k} /><span class="sp"><b>{h.title}</b>{h.desc && <small>{h.desc}</small>}</span></label>)}</div>
      </fieldset>
      <p class="scope" id="scope" hidden></p>
      <div id="sub" hidden><label><span>哪些項目？（可多選，選填）</span></label><div class="chips" id="chips"></div></div>
      <div id="qs"></div>
      <div id="common" hidden>
        <div class="frow2">
          <label><span>怎麼稱呼你<i class="req">*</i></span><input name="name" maxlength="40" autocomplete="name"></label>
          <label><span>聯絡方式<i class="req">*</i></span><span class="crow"><select name="ctype"><option>Instagram</option><option>LINE</option><option>Email</option></select><input name="contact" maxlength="120" placeholder="帳號或 ID"></span></label>
        </div>
        <label><span>你從哪裡知道我？（選填）</span><select name="source"><option value="">—</option><option>朋友介紹</option><option>Instagram</option><option>Facebook</option><option>8AKER零 的文章</option><option>祈願所</option><option>搜尋</option><option>其他</option></select></label>
        <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
        <p class="err" id="cfErr" role="alert"></p>
        <div class="cacts"><button class="cbtn ink" type="submit" id="send">送出</button></div>
        <p class="hint">送出即表示同意依<a href="/privacy/" target="_blank" rel="noopener">隱私權政策</a>處理你填寫的資料，只用來回覆你。</p>
      </div>
    </form>

    <section class="done" id="done" hidden aria-live="polite">
      <h2>已收到，謝謝你</h2>
      <p>我會在 2 個工作天內回覆。想更快的話，也可以直接傳一則 Instagram 私訊，內容我已經幫你整理好了。</p>
      <div class="cacts">{ig && <button class="cbtn gold" type="button" id="goIg">複製內容並開啟 IG 私訊 →</button>}<button class="cbtn line" type="button" id="again">再填一份</button></div>
      <p class="ok" id="ok" role="status"></p>
    </section>
  </div>
</main>
<script is:inline define:vars={{ IG: ig, HATS: hats, OTHER, Q: (inq as any).questions, CODES: (inq as any).service_codes, SCOPES: (inq as any).scope_by_service || {} }}>
(function(){
  var F=document.getElementById('cf'),SUB=document.getElementById('sub'),CH=document.getElementById('chips'),QS=document.getElementById('qs'),CM=document.getElementById('common'),E=document.getElementById('cfErr'),DONE=document.getElementById('done'),OK=document.getElementById('ok'),BTN=document.getElementById('send');
  var ALL=HATS.concat([OTHER]),cur=null,lastText='',uid=0;
  function el(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e;}
  function qs(){return cur?(Q[cur.k]||Q.other||[]):[];}
  function qOf(key){return qs().filter(function(q){return q.key===key;})[0];}
  function val(q){var n='q_'+q.key;
    if(q.type==='checks')return [].map.call(F.querySelectorAll('input[name='+n+']:checked'),function(x){return x.value;});
    if(q.type==='list')return [].map.call(F.querySelectorAll('input[name^='+n+'_]'),function(x){return x.value.trim();}).filter(Boolean);
    var x=F.elements[n];return x?String(x.value||'').trim():'';}
  function pick(k){cur=ALL.filter(function(h){return h.k===k;})[0]||null;if(!cur)return;
    CH.innerHTML='';SUB.hidden=!cur.items.length;cur.items.forEach(function(t){var l=el('label'),i=el('input');i.type='checkbox';i.name='item';i.value=t;l.appendChild(i);l.appendChild(document.createTextNode(t));CH.appendChild(l);});
    QS.innerHTML='';qs().forEach(function(q){var w=el('div','q'),id='qf'+(++uid),lab=el('label','ql');lab.textContent=q.label;lab.htmlFor=id;if(q.required)lab.appendChild(el('i','req','*'));w.appendChild(lab);var f;
      if(q.type==='checks'){var cw=el('div','chips');(q.options||[]).forEach(function(o){var l=el('label'),i=el('input');i.type='checkbox';i.name='q_'+q.key;i.value=o;l.appendChild(i);l.appendChild(document.createTextNode(o));cw.appendChild(l);});w.removeChild(lab);var sp=el('span','ql',q.label);if(q.required)sp.appendChild(el('i','req','*'));w.appendChild(sp);w.appendChild(cw);}
      else if(q.type==='list'){w.removeChild(lab);var sp2=el('span','ql',q.label);w.appendChild(sp2);for(var n=1;n<=(q.count||5);n++){var li=el('input');li.type='text';li.name='q_'+q.key+'_'+n;li.maxLength=80;li.placeholder=(q.placeholder||'')+(n>1?'':'');li.className='li';w.appendChild(li);}}
      else{if(q.type==='textarea'){f=el('textarea');f.rows=3;}else if(q.type==='select'){f=el('select');var o0=el('option',null,'請選擇');o0.value='';f.appendChild(o0);(q.options||[]).forEach(function(o){var op=el('option',null,o);op.value=o;f.appendChild(op);});}else if(q.type==='number'){f=el('input');f.type='number';f.min='1';f.max='99';f.inputMode='numeric';}else{f=el('input');f.type='text';}
        f.id=id;f.name='q_'+q.key;if(q.type!=='number')f.maxLength=600;if(q.placeholder)f.placeholder=q.placeholder;w.appendChild(f);}
      if(q.hint)w.appendChild(el('p','qh',q.hint));
      if(q.warnIf){var wp=el('p','qwarn',q.warnIf.text);wp.hidden=true;wp.dataset.wk=q.key;w.appendChild(wp);}
      if(q.showIf){w.dataset.sk=q.showIf.key;w.hidden=true;}
      w.dataset.qk=q.key;QS.appendChild(w);});
    var sc=document.getElementById('scope');sc.textContent=SCOPES[k]||'';sc.hidden=!SCOPES[k];CM.hidden=false;E.textContent='';}
  function sync(){qs().forEach(function(q){
    if(q.showIf){var w=QS.querySelector('[data-qk="'+q.key+'"]'),cv=val(qOf(q.showIf.key)||{key:q.showIf.key}),ok=q.showIf.includes!=null?(Array.isArray(cv)&&cv.indexOf(q.showIf.includes)>-1):cv===q.showIf.equals;w.hidden=!ok;}
    if(q.warnIf){var wp=QS.querySelector('[data-wk="'+q.key+'"]'),nv=parseInt(val(q),10);wp.hidden=!(nv>=q.warnIf.gte);}});}
  F.addEventListener('change',function(e){if(e.target.name==='svc')pick(e.target.value);else sync();});
  F.addEventListener('input',function(e){if(e.target.type==='number')sync();});
  // 從祈願所「我可以幫忙」進來：直接帶入是哪個願望、需要什麼
  try{var P=new URLSearchParams(location.search);if(P.get('from')==='wish'){var ab=(P.get('about')||'').slice(0,80),hp=(P.get('help')||'').slice(0,120);
    var fs=document.getElementById('svcSet');if(fs)fs.hidden=true;pick('other');
    var a=F.querySelector('[name=q_about]');if(a)a.value='我看到祈願所的「'+ab+'」'+(hp?'，你需要：'+hp:'')+'。我可以幫忙的是：';
    var sr=F.elements.source;if(sr){for(var i=0;i<sr.options.length;i++){if(sr.options[i].text==='祈願所'){sr.selectedIndex=i;break;}}}}}catch(e){}
  function v(n){var x=F.elements[n];return x?String(x.value||'').trim():'';}
  F.addEventListener('submit',function(e){e.preventDefault();E.textContent='';
    if(!cur){E.textContent='先選一個想聊的服務。';return;}
    var lines=['【想聊】'+cur.title],dates='',people='',miss=false;
    var items=[].map.call(F.querySelectorAll('input[name=item]:checked'),function(x){return x.value;});if(items.length)lines.push('【項目】'+items.join('、'));
    qs().forEach(function(q){var w=QS.querySelector('[data-qk="'+q.key+'"]');if(w&&w.hidden)return;var x=val(q),has=Array.isArray(x)?x.length:!!x;if(q.required&&!has)miss=true;
      if(has){var t=Array.isArray(x)?x.join('、'):x;lines.push('【'+(q.short||q.label.replace(/[？?]$/,''))+'】'+t);if(q.col==='dates')dates=t;if(q.col==='people')people=t;}});
    if(miss||!v('name')||!v('contact')){E.textContent='請填寫有 * 的欄位。';window.sfx&&sfx('error');return;}
    var body={service:CODES[cur.k]||'other',name:v('name'),contact:v('ctype')+'：'+v('contact'),dates:dates,people:people,message:lines.join('\n'),source:v('source'),website:v('website'),lang:navigator.language||''};
    lastText='你好，我是 '+body.name+'，從 8aker0.com 來的。\n\n'+lines.join('\n');
    BTN.disabled=true;BTN.textContent='送出中…';
    fetch('https://gsaqrjovipnfiedvjaeb.supabase.co/functions/v1/inquiry',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      .then(function(r){return r.json().then(function(d){return {ok:r.ok,d:d};});})
      .then(function(x){if(!x.ok)throw new Error(x.d&&x.d.error||'送出失敗');F.hidden=true;DONE.hidden=false;OK.textContent='';window.sfx&&sfx('success');DONE.scrollIntoView({behavior:'smooth',block:'start'});})
      .catch(function(err){E.textContent=(err&&err.message)||'送出失敗，請稍後再試，或直接私訊我。';window.sfx&&sfx('error');})
      .then(function(){BTN.disabled=false;BTN.textContent='送出';});});
  function copy(s){if(navigator.clipboard&&window.isSecureContext)return navigator.clipboard.writeText(s);return new Promise(function(res,rej){var t=document.createElement('textarea');t.value=s;t.style.position='fixed';t.style.opacity='0';document.body.appendChild(t);t.select();try{document.execCommand('copy');res();}catch(e){rej(e);}t.remove();});}
  var g=document.getElementById('goIg');if(g)g.addEventListener('click',function(){var p=copy(lastText);var w=window.open('https://ig.me/m/'+IG,'_blank','noopener');
    p.then(function(){OK.textContent='已複製！在 Instagram 私訊裡長按輸入框「貼上」就好。';}).catch(function(){OK.textContent='沒辦法自動複製，請回到表單手動複製內容。';});if(!w)location.href='https://ig.me/m/'+IG;});
  document.getElementById('again').addEventListener('click',function(){F.reset();QS.innerHTML='';CM.hidden=true;SUB.hidden=true;cur=null;DONE.hidden=true;F.hidden=false;F.scrollIntoView({behavior:'smooth',block:'start'});});
})();
</script>
</BaseLayout>
