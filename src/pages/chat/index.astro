---
import BaseLayout from '../../layouts/BaseLayout.astro';
import copy from '../../data/site-copy.json';
const igHandle = String((copy as any).instagram_handle || '').replace(/^@/, '').trim();
const ig = /^[A-Za-z0-9._]{1,30}$/.test(igHandle) ? igHandle : '';
import services from '../../data/services.json';
import inq from '../../data/inquiry.json';
const hideItems: string[] = (inq as any).hide_items || [];
const hats = ((services as any).hats || []).map((h: any) => ({ k: h.k, title: h.title, desc: h.desc, items: (h.items || []).filter((x: string) => !hideItems.includes(x)) }));
const OTHER = { k: 'other', title: '祈願所：我可以幫忙', desc: '', items: [] };
const noteForm = String((services as any).form_note || '');
---
<BaseLayout title="需求填表 — 8AKER零" description="想聊日本不動產、隨行地陪或 AI 工具？選一個服務、回答幾個問題，送出就好。">
<style is:global>
.chat{min-height:100vh;padding:132px 40px 104px;background:radial-gradient(120% 70% at 85% 0%,#4B1623 0%,#2A0F18 38%,#1C0F14 70%);color:#EFE5D6;}
.chat-in{max-width:780px;margin:0 auto;}
.chat .crumb{font-size:13px;color:#86707A;}.chat .crumb a{border-bottom:1px solid rgba(239,229,214,.15);}
.chat .eyebrow{margin-top:34px;font-size:12px;letter-spacing:.32em;color:#D4A24C;}
.chat h1{font-family:var(--serif);font-weight:500;font-size:clamp(34px,5vw,52px);line-height:1.15;margin-top:12px;color:#EBD3A8;}
.chat .lede{color:#B9A89E;margin-top:16px;line-height:1.9;max-width:32em;font-size:15.5px;}
/* 步驟列 */
.steps{list-style:none;display:flex;gap:0;margin-top:34px;padding:0;counter-reset:st;}
.steps li{flex:1;position:relative;padding-top:20px;font-size:13px;letter-spacing:.08em;color:#6f5a62;transition:color .35s;}
.steps li::before{content:'';position:absolute;left:0;right:6px;top:0;height:2px;background:rgba(239,229,214,.14);transition:background .45s;}
.steps li b{font-weight:400;margin-right:8px;font-family:var(--serif);color:inherit;}
.steps[data-step="1"] li:nth-child(1),.steps[data-step="2"] li:nth-child(-n+2),.steps[data-step="3"] li{color:#EBD3A8;}
.steps[data-step="1"] li:nth-child(1)::before,.steps[data-step="2"] li:nth-child(-n+2)::before,.steps[data-step="3"] li::before{background:#D4A24C;}
/* 表單卡 */
.cf{position:relative;margin-top:26px;background:#EFE5D6;color:#1C0F14;padding:44px 44px 40px;box-shadow:0 40px 80px -40px rgba(0,0,0,.7);}
.cf::before{content:'';position:absolute;inset:10px;border:1px solid rgba(158,111,34,.28);pointer-events:none;}
.cf>*{position:relative;}
.fs+.fs{margin-top:40px;padding-top:34px;border-top:1px solid rgba(42,24,30,.12);animation:fsIn .5s var(--ease) both;}
@keyframes fsIn{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:none;}}
.fs[hidden]{display:none;}
.fh{display:flex;align-items:baseline;gap:14px;font-family:var(--serif);font-weight:500;font-size:22px;color:#1C0F14;margin-bottom:20px;}
.fh i{font-style:normal;font-size:13px;letter-spacing:.18em;color:#9E6F22;}
/* 服務卡 */
.svc-pick{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;}
.svc-pick label{position:relative;overflow:hidden;display:block;margin:0;cursor:pointer;background:#FBF6F3;border:1px solid rgba(42,24,30,.16);transition:transform .35s var(--ease),border-color .3s,background .35s,box-shadow .35s;}
.svc-pick label:hover{transform:translateY(-3px);border-color:rgba(var(--hc),.7);box-shadow:0 14px 28px -18px rgba(28,15,20,.55);}
.svc-pick input{position:absolute;opacity:0;pointer-events:none;width:auto;}
.svc-pick .sp{position:relative;z-index:1;display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto auto;column-gap:14px;padding:22px 18px 20px;align-items:center;}
.svc-pick .hk{grid-row:1/3;font-family:var(--jp);font-size:34px;line-height:1;color:rgb(var(--hc));min-width:1.1em;text-align:center;transition:color .3s;}
.svc-pick .hk.long{font-size:22px;letter-spacing:.02em;}
.svc-pick .sp b{display:block;font-weight:500;font-size:16.5px;line-height:1.35;color:#1C0F14;transition:color .3s;}
.svc-pick .sp small{display:block;margin-top:6px;font-size:12.5px;line-height:1.65;color:#7a6a6d;transition:color .3s;grid-column:2;}
.svc-pick label::after{content:attr(data-k);position:absolute;right:-4px;bottom:-24px;font-family:var(--jp);font-size:92px;line-height:1;color:rgba(var(--hc),.14);z-index:0;transform:translateY(16px) scale(.92);opacity:0;transition:transform .5s var(--ease),opacity .4s;pointer-events:none;}
.svc-pick label[data-long]::after{font-size:60px;bottom:-8px;}
.svc-pick label:hover::after{transform:none;opacity:1;}
.svc-pick label:nth-child(3n+1){--hc:176,70,92;}
.svc-pick label:nth-child(3n+2){--hc:158,111,34;}
.svc-pick label:nth-child(3n+3){--hc:110,92,78;}
.svc-pick label:has(input:checked){background:#3D0F1A;border-color:#D4A24C;box-shadow:0 18px 34px -20px rgba(61,15,26,.9);}
.svc-pick label:has(input:checked) .hk{color:#D4A24C;}
.svc-pick label:has(input:checked) b{color:#F6E9D3;}
.svc-pick label:has(input:checked) small{color:#B9A89E;}
.svc-pick label:has(input:checked)::after{opacity:1;transform:none;color:rgba(212,162,76,.16);}
.svc-pick input:focus-visible+.sp{outline:2px solid #D4A24C;outline-offset:-4px;}
.cf .scope{display:inline-block;margin:-6px 0 18px;font-size:13px;letter-spacing:.06em;color:#7a5a1a;background:#F6E9D3;border-left:3px solid #D4A24C;padding:7px 14px;}
.cf .scope[hidden],.cf label[hidden],.cf .q[hidden],.cf .qwarn[hidden],.cf #sub[hidden]{display:none;}
/* 題目 */
.qgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 20px;}
.cf .q.wide,.qgrid .q.wide{grid-column:1/-1;}
.cf .q>.ql,.cf .lbl{display:block;font-size:13.5px;letter-spacing:.03em;color:#4a3a3e;margin-bottom:8px;font-weight:500;}
.cf .req{color:#A1324A;margin-left:3px;font-style:normal;}
.cf input,.cf select,.cf textarea{display:block;width:100%;font:inherit;font-size:16px;color:#1C0F14;background:#FBF6F3;border:1px solid rgba(42,24,30,.2);padding:12px 14px;min-height:48px;border-radius:0;transition:border-color .2s,box-shadow .2s,background .2s;-webkit-appearance:none;appearance:none;}
.cf select{background-image:linear-gradient(45deg,transparent 50%,#9E6F22 50%),linear-gradient(135deg,#9E6F22 50%,transparent 50%);background-position:calc(100% - 20px) 21px,calc(100% - 14px) 21px;background-size:6px 6px,6px 6px;background-repeat:no-repeat;padding-right:38px;}
.cf input:hover,.cf select:hover,.cf textarea:hover{border-color:rgba(158,111,34,.55);}
.cf input:focus,.cf select:focus,.cf textarea:focus{outline:none;border-color:#9E6F22;background:#fff;box-shadow:0 0 0 3px rgba(158,111,34,.16);}
.cf ::placeholder{color:#a8999b;}
.cf textarea{resize:vertical;line-height:1.7;}
.cf .q input.li{margin-bottom:8px;}
.cf .q .qh{font-size:12.5px;color:#7a6a6d;line-height:1.75;margin-top:9px;padding-left:12px;border-left:2px solid rgba(158,111,34,.35);}
.cf .q .qwarn{font-size:13.5px;color:#A1324A;margin-top:9px;line-height:1.7;}
/* 可複選 */
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:2px;}
.chips label{margin:0;display:flex;gap:9px;align-items:center;padding:10px 15px;min-height:44px;border:1px solid rgba(42,24,30,.2);background:#FBF6F3;font-size:14.5px;color:#1C0F14;cursor:pointer;transition:border-color .2s,background .2s;}
.chips label:hover{border-color:rgba(158,111,34,.6);}
.chips input{width:auto;min-height:0;margin:0;padding:0;accent-color:#9E6F22;flex:none;-webkit-appearance:auto;appearance:auto;}
.chips label:has(input:checked){border-color:#9E6F22;background:#F6E9D3;}
/* 聯絡 */
.cgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 20px;}
.cgrid .full{grid-column:1/-1;}
.cf .crow{display:flex;gap:8px;margin:0;}
.cf .crow select{flex:0 0 140px;width:140px;}
.cf .crow input{flex:1;min-width:0;}
.hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0;}
.cf .err{color:#A1324A;font-size:14px;margin-top:18px;min-height:1.2em;}
.cacts{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px;}
.cbtn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:12px 26px;font-size:15.5px;letter-spacing:.08em;border:0;cursor:pointer;transition:transform .3s var(--ease),background .3s,box-shadow .3s;}
.cbtn.send{width:100%;background:#3D0F1A;color:#EBD3A8;box-shadow:inset 0 0 0 1px rgba(212,162,76,.55);}
.cbtn.send::after{content:'→';transition:transform .3s var(--ease);}
.cbtn.send:hover{background:#4B1623;transform:translateY(-1px);box-shadow:inset 0 0 0 1px #D4A24C,0 16px 30px -18px rgba(61,15,26,.9);}
.cbtn.send:hover::after{transform:translateX(5px);}
.cbtn.send:disabled{opacity:.6;cursor:default;transform:none;}
.cbtn.gold{background:#D4A24C;color:#1C0F14;}.cbtn.gold:hover{background:#E2B35E;transform:translateY(-1px);}
.cbtn.line{background:transparent;color:#1C0F14;box-shadow:inset 0 0 0 1px rgba(42,24,30,.3);}.cbtn.line:hover{background:rgba(42,24,30,.05);}
.cf .hint{font-size:12.5px;color:#7a6a6d;margin-top:16px;line-height:1.8;text-align:center;}
.cf .hint a{border-bottom:1px solid rgba(122,106,109,.5);}
/* 送出完成 */
.done{position:relative;margin-top:26px;background:#EFE5D6;color:#1C0F14;padding:48px 44px;text-align:center;box-shadow:0 40px 80px -40px rgba(0,0,0,.7);}
.done::before{content:'';position:absolute;inset:10px;border:1px solid rgba(158,111,34,.28);pointer-events:none;}
.done .mark{display:block;font-family:var(--jp);font-size:46px;color:#9E6F22;line-height:1;}
.done h2{font-family:var(--serif);font-weight:500;font-size:26px;margin-top:14px;}
.done p{margin:12px auto 0;max-width:28em;line-height:1.9;color:#5B4B4E;font-size:15px;}
.done .cacts{justify-content:center;}
.done .ok{color:#7a5a1a;font-size:13.5px;min-height:1.4em;margin-top:12px;}
@media(max-width:720px){
  .chat{padding:96px 16px 72px;}
  .chat .eyebrow{margin-top:26px;}
  .steps{margin-top:26px;}.steps li{font-size:12px;letter-spacing:.04em;}.steps li b{margin-right:4px;}
  .cf{padding:30px 20px 28px;margin-left:-2px;margin-right:-2px;}
  .cf::before{inset:6px;}
  .fs+.fs{margin-top:32px;padding-top:28px;}
  .fh{font-size:20px;margin-bottom:16px;}
  .svc-pick{grid-template-columns:1fr;gap:10px;}
  .svc-pick .sp{padding:16px 16px;grid-template-columns:56px 1fr;column-gap:12px;}
  .svc-pick .hk{font-size:32px;}.svc-pick .hk.long{font-size:21px;}
  .svc-pick label:hover{transform:none;}
  .svc-pick label::after{opacity:.5;transform:none;font-size:70px;bottom:-14px;}
  .svc-pick label[data-long]::after{font-size:46px;bottom:-4px;}
  .qgrid,.cgrid{grid-template-columns:1fr;gap:20px;}
  .cf .crow select{flex-basis:128px;width:128px;}
  .done{padding:38px 22px;}
  .cbtn{width:100%;}
}
@media(hover:none){.svc-pick label::after{opacity:.5;transform:none;}.svc-pick label:has(input:checked)::after{opacity:1;}}
@media(prefers-reduced-motion:reduce){.fs+.fs{animation:none;}.cbtn,.svc-pick label{transition:none;}}
</style>
<main class="chat">
  <div class="chat-in">
    <nav class="crumb" aria-label="麵包屑"><a href="/">首頁</a> / 需求填表</nav>
    <p class="eyebrow">CONTACT</p>
    <h1>需求填表</h1>
    <p class="lede">選一個服務，回答幾個問題就好。{noteForm}</p>
    <ol class="steps" id="steps" data-step="1"><li><b>01</b>選服務</li><li><b>02</b>填需求</li><li><b>03</b>留聯絡</li></ol>

    <form class="cf" id="cf" novalidate>
      <section class="fs" id="svcSet"><h2 class="fh"><i>01</i>想聊什麼</h2>
        <div class="svc-pick">{hats.map((h: any) => <label data-k={h.k} data-long={h.k.length > 1 ? '1' : undefined}><input type="radio" name="svc" value={h.k} /><span class="sp"><span class="hk" class:list={{ long: h.k.length > 1 }}>{h.k}</span><b>{h.title}</b>{h.desc && <small>{h.desc}</small>}</span></label>)}</div>
      </section>
      <section class="fs" id="s2" hidden><h2 class="fh"><i>02</i>你的需求</h2>
        <p class="scope" id="scope" hidden></p>
        <div id="sub" hidden style="margin-bottom:22px"><span class="lbl">哪些項目？（可多選，選填）</span><div class="chips" id="chips"></div></div>
        <div id="qs" class="qgrid"></div>
      </section>
      <section class="fs" id="common" hidden><h2 class="fh"><i>03</i>怎麼聯絡你</h2>
        <div class="cgrid">
          <label><span class="lbl">怎麼稱呼你<i class="req">*</i></span><input name="name" maxlength="40" autocomplete="name"></label>
          <label><span class="lbl">聯絡方式<i class="req">*</i></span><span class="crow"><select name="ctype"><option>Instagram</option><option>LINE</option><option>Email</option></select><input name="contact" maxlength="120" placeholder="帳號或 ID"></span></label>
          <label class="full"><span class="lbl">你從哪裡知道我？（選填）</span><select name="source"><option value="">—</option><option>朋友介紹</option><option>Instagram</option><option>Facebook</option><option>8AKER零 的文章</option><option>祈願所</option><option>搜尋</option><option>其他</option></select></label>
        </div>
        <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
        <p class="err" id="cfErr" role="alert"></p>
        <div class="cacts"><button class="cbtn send" type="submit" id="send">送出</button></div>
        <p class="hint">送出即表示同意依<a href="/privacy/" target="_blank" rel="noopener">隱私權政策</a>處理你填寫的資料，只用來回覆你。</p>
      </section>
    </form>

    <section class="done" id="done" hidden aria-live="polite">
      <span class="mark">謝</span>
      <h2>已收到，謝謝你</h2>
      <p>我會在 2 個工作天內回覆。想更快的話，也可以直接傳一則 Instagram 私訊，內容我已經幫你整理好了。</p>
      <div class="cacts">{ig && <button class="cbtn gold" type="button" id="goIg">複製內容並開啟 IG 私訊 →</button>}<button class="cbtn line" type="button" id="again">再填一份</button></div>
      <p class="ok" id="ok" role="status"></p>
    </section>
  </div>
</main>
<script is:inline define:vars={{ IG: ig, HATS: hats, OTHER, Q: (inq as any).questions, CODES: (inq as any).service_codes, SCOPES: (inq as any).scope_by_service || {} }}>
(function(){
  var S2=document.getElementById('s2'),STEPS=document.getElementById('steps'),F=document.getElementById('cf'),SUB=document.getElementById('sub'),CH=document.getElementById('chips'),QS=document.getElementById('qs'),CM=document.getElementById('common'),E=document.getElementById('cfErr'),DONE=document.getElementById('done'),OK=document.getElementById('ok'),BTN=document.getElementById('send');
  var ALL=HATS.concat([OTHER]),cur=null,lastText='',uid=0;
  function el(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e;}
  function qs(){return cur?(Q[cur.k]||Q.other||[]):[];}
  function qOf(key){return qs().filter(function(q){return q.key===key;})[0];}
  function val(q){var n='q_'+q.key;
    if(q.type==='checks')return [].map.call(F.querySelectorAll('input[name='+n+']:checked'),function(x){return x.value;});
    if(q.type==='list')return [].map.call(F.querySelectorAll('input[name^='+n+'_]'),function(x){return x.value.trim();}).filter(Boolean);
    var x=F.elements[n];return x?String(x.value||'').trim():'';}
  function pick(k){cur=ALL.filter(function(h){return h.k===k;})[0]||null;if(!cur)return;
    CH.innerHTML='';SUB.hidden=!cur.items.length;cur.items.forEach(function(t){var l=el('label'),i=el('input');i.type='checkbox';i.name='item';i.value=t;l.appendChild(i);l.appendChild(document.createTextNode(t));CH.appendChild(l);});
    QS.innerHTML='';qs().forEach(function(q){var w=el('div','q'+((q.type==='textarea'||q.type==='checks'||q.type==='list'||q.hint||q.warnIf)?' wide':'')),id='qf'+(++uid),lab=el('label','ql');lab.textContent=q.label;lab.htmlFor=id;if(q.required)lab.appendChild(el('i','req','*'));w.appendChild(lab);var f;
      if(q.type==='checks'){var cw=el('div','chips');(q.options||[]).forEach(function(o){var l=el('label'),i=el('input');i.type='checkbox';i.name='q_'+q.key;i.value=o;l.appendChild(i);l.appendChild(document.createTextNode(o));cw.appendChild(l);});w.removeChild(lab);var sp=el('span','ql',q.label);if(q.required)sp.appendChild(el('i','req','*'));w.appendChild(sp);w.appendChild(cw);}
      else if(q.type==='list'){w.removeChild(lab);var sp2=el('span','ql',q.label);w.appendChild(sp2);for(var n=1;n<=(q.count||5);n++){var li=el('input');li.type='text';li.name='q_'+q.key+'_'+n;li.maxLength=80;li.placeholder=(q.placeholder||'')+(n>1?'':'');li.className='li';w.appendChild(li);}}
      else{if(q.type==='textarea'){f=el('textarea');f.rows=3;}else if(q.type==='select'){f=el('select');var o0=el('option',null,'請選擇');o0.value='';f.appendChild(o0);(q.options||[]).forEach(function(o){var op=el('option',null,o);op.value=o;f.appendChild(op);});}else if(q.type==='number'){f=el('input');f.type='number';f.min='1';f.max='99';f.inputMode='numeric';}else{f=el('input');f.type='text';}
        f.id=id;f.name='q_'+q.key;if(q.type!=='number')f.maxLength=600;if(q.placeholder)f.placeholder=q.placeholder;w.appendChild(f);}
      if(q.hint)w.appendChild(el('p','qh',q.hint));
      if(q.warnIf){var wp=el('p','qwarn',q.warnIf.text);wp.hidden=true;wp.dataset.wk=q.key;w.appendChild(wp);}
      if(q.showIf){w.dataset.sk=q.showIf.key;w.hidden=true;}
      w.dataset.qk=q.key;QS.appendChild(w);});
    var sc=document.getElementById('scope');sc.textContent=SCOPES[k]||'';sc.hidden=!SCOPES[k];S2.hidden=false;CM.hidden=false;STEPS.dataset.step='2';E.textContent='';}
  function sync(){qs().forEach(function(q){
    if(q.showIf){var w=QS.querySelector('[data-qk="'+q.key+'"]'),cv=val(qOf(q.showIf.key)||{key:q.showIf.key}),ok=q.showIf.includes!=null?(Array.isArray(cv)&&cv.indexOf(q.showIf.includes)>-1):cv===q.showIf.equals;w.hidden=!ok;}
    if(q.warnIf){var wp=QS.querySelector('[data-wk="'+q.key+'"]'),nv=parseInt(val(q),10);wp.hidden=!(nv>=q.warnIf.gte);}});}
  F.addEventListener('change',function(e){if(e.target.name==='svc')pick(e.target.value);else sync();});
  F.addEventListener('focusin',function(e){if(CM.contains(e.target))STEPS.dataset.step='3';});
  F.addEventListener('input',function(e){if(e.target.type==='number')sync();});
  // 從祈願所「我可以幫忙」進來：直接帶入是哪個願望、需要什麼
  try{var P=new URLSearchParams(location.search);if(P.get('from')==='wish'){var ab=(P.get('about')||'').slice(0,80),hp=(P.get('help')||'').slice(0,120);
    var fs=document.getElementById('svcSet');if(fs)fs.hidden=true;pick('other');
    var a=F.querySelector('[name=q_about]');if(a)a.value='我看到祈願所的「'+ab+'」'+(hp?'，你需要：'+hp:'')+'。我可以幫忙的是：';
    var sr=F.elements.source;if(sr){for(var i=0;i<sr.options.length;i++){if(sr.options[i].text==='祈願所'){sr.selectedIndex=i;break;}}}}}catch(e){}
  function v(n){var x=F.elements[n];return x?String(x.value||'').trim():'';}
  F.addEventListener('submit',function(e){e.preventDefault();E.textContent='';
    if(!cur){E.textContent='先選一個想聊的服務。';return;}
    var lines=['【想聊】'+cur.title],dates='',people='',miss=false;
    var items=[].map.call(F.querySelectorAll('input[name=item]:checked'),function(x){return x.value;});if(items.length)lines.push('【項目】'+items.join('、'));
    qs().forEach(function(q){var w=QS.querySelector('[data-qk="'+q.key+'"]');if(w&&w.hidden)return;var x=val(q),has=Array.isArray(x)?x.length:!!x;if(q.required&&!has)miss=true;
      if(has){var t=Array.isArray(x)?x.join('、'):x;lines.push('【'+(q.short||q.label.replace(/[？?]$/,''))+'】'+t);if(q.col==='dates')dates=t;if(q.col==='people')people=t;}});
    if(miss||!v('name')||!v('contact')){E.textContent='請填寫有 * 的欄位。';window.sfx&&sfx('error');return;}
    var body={service:CODES[cur.k]||'other',name:v('name'),contact:v('ctype')+'：'+v('contact'),dates:dates,people:people,message:lines.join('\n'),source:v('source'),website:v('website'),lang:navigator.language||''};
    lastText='你好，我是 '+body.name+'，從 8aker0.com 來的。\n\n'+lines.join('\n');
    BTN.disabled=true;BTN.textContent='送出中…';
    fetch('https://gsaqrjovipnfiedvjaeb.supabase.co/functions/v1/inquiry',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      .then(function(r){return r.json().then(function(d){return {ok:r.ok,d:d};});})
      .then(function(x){if(!x.ok)throw new Error(x.d&&x.d.error||'送出失敗');F.hidden=true;DONE.hidden=false;OK.textContent='';window.sfx&&sfx('success');DONE.scrollIntoView({behavior:'smooth',block:'start'});})
      .catch(function(err){E.textContent=(err&&err.message)||'送出失敗，請稍後再試，或直接私訊我。';window.sfx&&sfx('error');})
      .then(function(){BTN.disabled=false;BTN.textContent='送出';});});
  function copy(s){if(navigator.clipboard&&window.isSecureContext)return navigator.clipboard.writeText(s);return new Promise(function(res,rej){var t=document.createElement('textarea');t.value=s;t.style.position='fixed';t.style.opacity='0';document.body.appendChild(t);t.select();try{document.execCommand('copy');res();}catch(e){rej(e);}t.remove();});}
  var g=document.getElementById('goIg');if(g)g.addEventListener('click',function(){var p=copy(lastText);var w=window.open('https://ig.me/m/'+IG,'_blank','noopener');
    p.then(function(){OK.textContent='已複製！在 Instagram 私訊裡長按輸入框「貼上」就好。';}).catch(function(){OK.textContent='沒辦法自動複製，請回到表單手動複製內容。';});if(!w)location.href='https://ig.me/m/'+IG;});
  document.getElementById('again').addEventListener('click',function(){F.reset();QS.innerHTML='';S2.hidden=true;CM.hidden=true;SUB.hidden=true;cur=null;STEPS.dataset.step='1';DONE.hidden=true;F.hidden=false;F.scrollIntoView({behavior:'smooth',block:'start'});});
})();
