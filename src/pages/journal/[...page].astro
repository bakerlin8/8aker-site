---
// 日常紀錄・全部文章（跨五個方向，依日期由新到舊，每頁 12 篇）
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pillars } from '../../data/pillars';
import { allEntries, PER_PAGE } from '../../data/journal';

export async function getStaticPaths({ paginate }: any) {
  const all = await allEntries();
  return paginate(all, { pageSize: PER_PAGE });
}
const { page } = Astro.props as any;
const total: number = page.total;
const dot = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
const counts = Object.fromEntries(pillars.map((p) => [p.slug, 0]));
for (const a of await allEntries()) counts[a.dir]++;
// 段位：10 篇初段、30 篇二段、60 篇三段、100 篇四段
const latest: Record<string, string> = {};
for (const a of await allEntries()) if (!latest[a.dir]) latest[a.dir] = a.e.data.title;
// 預設展開文章最多的方向
const topDir = pillars.reduce((best, p) => (counts[p.slug] > counts[best.slug] ? p : best), pillars[0]).slug;
const pages = Array.from({ length: page.lastPage }, (_, i) => i + 1);
const href = (n: number) => (n === 1 ? '/journal/' : `/journal/${n}/`);
const SITE = (Astro.site ?? new URL('https://8aker0.com')).href.replace(/\/$/, '');
const schema = [
  { '@type': 'CollectionPage', name: '日常紀錄', url: `${SITE}${href(page.currentPage)}`, inLanguage: 'zh-Hant-TW', author: { '@id': `${SITE}/#person` } },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: '日常紀錄', item: `${SITE}/journal/` } ] },
];
---
<BaseLayout title={`日常紀錄${page.currentPage > 1 ? `（第 ${page.currentPage} 頁）` : ''} — 8AKER零`} description="強化・放出・操作・具現・變化，五個方向的日常紀錄，依日期排列。" schema={schema}>
<style is:global>
.jh{background:radial-gradient(110% 90% at 80% 20%,#2A1520 0%,#1C0F14 65%);color:#EFE5D6;padding:150px 40px 64px;}
.jh-in{max-width:1160px;margin:0 auto;}
.jh .crumb{font-size:13px;color:#86707A;}
.jh .crumb a{border-bottom:1px solid rgba(239,229,214,.15);transition:color .3s,border-color .3s;}
.jh .crumb a:hover{color:#EFE5D6;border-color:#D4A24C;}
.jh h1{font-family:var(--serif);font-weight:500;font-size:clamp(34px,5vw,56px);line-height:1.3;margin-top:10px;}
.jh .count{font-size:13px;color:#B9A89E;margin-top:14px;}
.jh .count b{font-family:var(--serif);font-weight:500;font-size:20px;color:#EFE5D6;margin:0 4px;}
.jcats{display:flex;gap:8px;flex-wrap:wrap;margin-top:28px;}
.jcats a{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;min-height:40px;border:1px solid rgba(239,229,214,.16);font-size:13.5px;color:#D9CCBD;transition:border-color .3s,color .3s;}
.jcats a b{font-family:var(--jp);font-weight:400;color:var(--dc,#D4A24C);}
.jcats a i{font-style:normal;font-size:12px;color:#86707A;}
.jcats a:hover{border-color:var(--dc,#D4A24C);color:#EFE5D6;}
.jcats a[aria-current="page"]{border-color:#D4A24C;color:#D4A24C;}
/* 五個方向：展開式。滑過（手機是點一下）的那張展開，露出最新一篇 */
.jdirs{display:flex;gap:10px;height:250px;margin-top:30px;}
.jdir{position:relative;flex:1;min-width:0;padding:20px;border:1px solid var(--line);background:color-mix(in srgb,var(--dc) 5%,transparent);overflow:hidden;transition:flex .6s var(--ease),border-color .4s,background .4s,min-height .55s var(--ease);}
.jdir.on{flex:3.2;border-color:var(--dc);background:color-mix(in srgb,var(--dc) 12%,transparent);}
.jdir .jk{position:absolute;right:12px;bottom:-14px;font-family:var(--jp);font-weight:400;font-size:140px;line-height:1;color:var(--dc);opacity:.45;transition:opacity .5s;pointer-events:none;}
.jdir.on .jk{opacity:.9;}
.jdir .jtx{position:relative;z-index:1;max-width:72%;}
.jdir .jn{display:block;font-family:var(--serif);font-size:20px;}
.jdir .jt{display:block;font-size:12.5px;color:var(--bone-2);margin-top:2px;}
.jdir em{position:absolute;top:16px;right:16px;z-index:1;font-style:normal;font-size:12px;color:var(--ash);}
.jdir .jx{display:block;margin-top:14px;max-height:0;opacity:0;overflow:hidden;transition:max-height .5s var(--ease),opacity .4s .12s;}
.jdir.on .jx{max-height:130px;opacity:1;}
.jdir .jx i{display:block;font-style:normal;font-size:12px;color:var(--dc);letter-spacing:.1em;}
.jdir .jx b{display:block;font-family:var(--serif);font-weight:500;font-size:15px;line-height:1.55;margin-top:2px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.jdir .jx u{display:inline-block;margin-top:8px;text-decoration:none;font-size:13px;color:var(--dc);}
.jdir:focus-visible{outline:2px solid var(--gold);outline-offset:2px;}
@media(max-width:700px){.jdirs{flex-direction:column;height:auto;gap:8px;}.jdir{flex:none;min-height:82px;padding:16px;}.jdir.on{flex:none;min-height:164px;}.jdir .jk{font-size:76px;bottom:-8px;}.jdir .jtx{max-width:74%;}}
@media(prefers-reduced-motion:reduce){.jdir,.jdir .jx,.jdir .jk{transition:none;}}
.jl-sec{padding:64px 40px 96px;background:var(--night);color:var(--bone);}
.jl-in{max-width:1160px;margin:0 auto;}
.jr{display:grid;grid-template-columns:96px 36px minmax(0,1fr) 24px;gap:18px;padding:20px 0;border-bottom:1px solid var(--line);align-items:baseline;transition:padding .45s var(--ease);}
.jr:first-child{border-top:1px solid var(--line);}
.jr time{font-size:13px;color:var(--ash);}
.jr .k{font-family:var(--jp);font-size:19px;line-height:1;color:var(--dc);width:32px;height:32px;display:grid;place-items:center;border-radius:50%;align-self:start;transition:background .35s,color .35s;}
.jr h2{font-family:var(--serif);font-weight:500;font-size:18px;line-height:1.55;transition:color .3s;text-wrap:pretty;}
.jr p{font-size:13.5px;color:var(--bone-2);margin-top:4px;}
.jr .kw{display:flex;flex-wrap:wrap;gap:2px 12px;align-items:baseline;font-size:12px;letter-spacing:.06em;color:var(--ash);margin:0 0 4px;}
.jr .kw b{font-weight:500;color:var(--dc);letter-spacing:.1em;}
.jr .arrow{color:var(--gold);opacity:0;transform:translateX(-8px);transition:opacity .35s,transform .45s var(--ease);}
.jr:hover{padding-left:8px;}
.jr:hover .k{background:var(--dc);color:var(--night);}
.jr:hover h2{color:var(--gold);}
.jr:hover .arrow{opacity:1;transform:none;}
@media(hover:none){.jr:hover{padding-left:0;}.jr:hover h2{color:inherit;}}
/* 圓章裡的字置中：正方形、不被擠壓；Safari 用表意字框裁切，讓漢字剛好落在圓心 */
@media(max-width:640px){.jrow .k,.jr .k{box-sizing:border-box;flex:none;aspect-ratio:1;line-height:1;text-align:center;padding:0;}}
@supports (text-box:trim-both ideographic){@media(max-width:640px){.jrow .k,.jr .k{text-box:trim-both ideographic;}}}
@keyframes kping{0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--dc) 40%,transparent);}100%{box-shadow:0 0 0 10px color-mix(in srgb,var(--dc) 0%,transparent);}}
@media(prefers-reduced-motion:reduce){.jr .k:not(.pop){transform:none;opacity:1;}}
.dft{display:inline-block;font-family:var(--sans,inherit);font-size:11px;letter-spacing:.08em;padding:0 7px;margin-right:8px;border:1px dashed var(--gold);color:var(--gold);vertical-align:2px;}
.pager{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:40px;font-size:14px;}
.pager .nums{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;}
.pager>a,.pager>span,.pager .nums>*{min-width:44px;min-height:44px;display:inline-grid;place-items:center;padding:0 12px;border:1px solid var(--line);color:var(--bone-2);transition:border-color .3s,color .3s;}
.pager>a:hover,.pager .nums>a:hover{border-color:var(--gold);color:var(--bone);}
.pager [aria-current="page"]{border-color:var(--gold);color:var(--gold);}
.pager .off{opacity:.35;}
.jl-foot{margin-top:48px;padding-top:24px;border-top:1px solid var(--line);font-size:13.5px;}
.jl-foot a{color:var(--bone-2);border-bottom:1px solid var(--line);padding-bottom:3px;transition:color .3s,border-color .3s;}
.jl-foot a:hover{color:var(--bone);border-color:var(--gold);}
@media(max-width:700px){.jh{padding:96px 20px 40px;}.jl-sec{padding:40px 20px 72px;}.jr{grid-template-columns:minmax(0,1fr) auto;gap:6px 12px;align-items:center;}.jr time{grid-column:1;grid-row:1;}.jr .k{grid-column:2;grid-row:1;width:34px;height:34px;font-size:17px;align-self:center;background:color-mix(in srgb,var(--dc) 13%,transparent);border:1px solid color-mix(in srgb,var(--dc) 45%,transparent);}.jr .k:not(.pop){transform:scale(.4) rotate(-25deg);opacity:0;}.jr .k{transition:transform .7s cubic-bezier(.34,1.56,.64,1) .25s,opacity .4s ease .25s,background .25s,color .25s;}.jr .k.pop{animation:kping 1.4s ease-out .55s 1;}.jr:active .k{background:var(--dc);color:var(--night);}.jr>div{grid-column:1/-1;grid-row:2;}.jr:hover{padding-left:0;}.jr .arrow{display:none;}.pager{font-size:13px;}}
</style>
<section class="jh">
  <div class="jh-in">
    <p class="crumb rv"><a href="/">首頁</a>　／　日常紀錄</p>
    <h1 class="rv" style="--i:1">日常紀錄</h1>
    <p class="count rv" style="--i:2">共<b>{total}</b>篇{page.lastPage > 1 && <>・第 {page.currentPage}／{page.lastPage} 頁</>}</p>
    <nav class="jdirs rv" style="--i:3" aria-label="依方向瀏覽">
      {pillars.map((p) => <a class={`jdir${p.slug === topDir ? ' on' : ''}`} style={`--dc:var(--c-${p.slug})`} href={`/pillars/${p.slug}/`}><b class="jk" aria-hidden="true">{p.kanji}</b><em>{counts[p.slug]} 篇</em><span class="jtx"><span class="jn">{p.type}</span><span class="jt">{p.title}</span></span><span class="jx">{latest[p.slug] && <><i>最新</i><b>{latest[p.slug]}</b></>}<u>進入 →</u></span></a>)}
    </nav>
  </div>
</section>
<section class="jl-sec band-light">
  <div class="jl-in">
    {page.data.map((a: any, i: number) => { const p = pillars.find((x) => x.slug === a.dir)!; return (
      <a class="jr rv" style={`--i:${Math.min(i, 8)};--dc:var(--c-${a.dir})`} href={`/pillars/${a.dir}/${a.e.slug}/`}>
        <time>{dot(a.e.data.date)}</time><span class="k" title={p.type}>{p.kanji}</span>
        <div><p class="kw"><b>{p.type}</b>{(a.e.data.tags ?? []).slice(0, 2).map((t: string) => <span>{t}</span>)}</p><h2>{a.e.data.draft && <span class="dft">草稿</span>}{a.e.data.title}</h2>{a.e.data.excerpt && <p>{a.e.data.excerpt}</p>}</div>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    ); })}
    {page.lastPage > 1 && (
      <nav class="pager" aria-label="分頁">
        {page.url.prev ? <a href={page.url.prev} rel="prev"><span class="lbl">← 較新</span></a> : <span class="off" aria-hidden="true">←</span>}
        <div class="nums">{pages.map((n) => n === page.currentPage ? <span aria-current="page">{n}</span> : <a href={href(n)}>{n}</a>)}</div>
        {page.url.next ? <a href={page.url.next} rel="next"><span class="lbl">較舊 →</span></a> : <span class="off" aria-hidden="true">→</span>}
      </nav>
    )}
    <p class="jl-foot"><a href="/">← 回首頁</a></p>
  </div>
</section>
<script>
  // 展開式：電腦滑過就展開；手機/平板第一下點擊只展開，第二下才進入該方向
  const box = document.querySelector('.jdirs');
  if (box) {
    const cards = Array.from(box.querySelectorAll<HTMLElement>('.jdir'));
    const set = (c: HTMLElement) => cards.forEach((x) => x.classList.toggle('on', x === c));
    const canHover = matchMedia('(hover:hover)').matches;
    cards.forEach((c) => {
      if (canHover) c.addEventListener('mouseenter', () => set(c));
      c.addEventListener('focus', () => { if (c.matches(':focus-visible')) set(c); });
      c.addEventListener('click', (e) => { if (!c.classList.contains('on')) { e.preventDefault(); set(c); } });
    });
  }
</script>
</BaseLayout>
