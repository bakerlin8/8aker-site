---
// 身體儀表：Strava 運動＋OMRON 體重體脂的即時彙總。放在「強化」分類頁。
// 三種版型共用同一份資料：預設 A；網址加 ?v=a / ?v=b / ?v=c 可預覽（出現切換鈕）。
import body from '../data/body.json';
const json = JSON.stringify(body).replace(/</g, '\\u003c');
---
<section class="bp" id="bodyPanel" aria-labelledby="bp-h">
  <div class="bp-head"><h2 id="bp-h">身體儀表</h2><p class="blive"><i aria-hidden="true"></i><span id="bdLive">讀取最新資料中…</span></p></div>
  <div class="bp-grid" id="bpGrid"><p class="bp-empty">讀取中…</p></div>
  <a class="strava" href="https://www.strava.com/athletes/103942910" target="_blank" rel="noopener">在 Strava 一起運動<span aria-hidden="true">↗</span></a>
</section>

<style is:global>
/* 夜色的配色＋帳本的細線版面：深酒紅底、金色重點、襯線大數字 */
.bp{--night:#1C0F14;--bone:#EFE5D6;--bone-2:#C2B2A6;--ash:#9a8590;--line:rgba(239,229,214,.14);--gold:#D4A24C;--bpc:#D4A24C;--c-strengthen:#E08A9B;
  margin-top:72px;padding:30px clamp(18px,3vw,34px) 34px;color:#EFE5D6;border:1px solid rgba(212,162,76,.28);
  background:radial-gradient(120% 90% at 90% 0%,#3A1F29 0%,#1C0F14 62%);}
.bp-head h2{font-family:var(--serif);font-weight:500;font-size:clamp(22px,2.6vw,28px);color:#EFE5D6;}
.blive{display:inline-flex;align-items:center;gap:8px;margin-top:6px;font-size:12.5px;color:var(--ash);}
.blive i{width:7px;height:7px;border-radius:50%;background:#5E9C6A;animation:livePulse 2.4s ease-out infinite;flex:none;}
.blive.stale i{background:var(--ash);animation:none;}
@keyframes livePulse{70%{box-shadow:0 0 0 7px rgba(94,156,106,0);}100%{box-shadow:0 0 0 0 rgba(94,156,106,0);}}
.bp-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:0 36px;margin-top:22px;border-top:1px solid var(--line);}
.bp-empty{grid-column:1/-1;padding:20px 0;color:var(--ash);font-size:13.5px;}
.w{min-width:0;padding:24px 0;border-bottom:1px solid var(--line);}
.w h3{font-family:var(--serif);font-weight:500;font-size:14px;letter-spacing:.12em;color:var(--bone-2);margin-bottom:14px;display:flex;align-items:baseline;justify-content:space-between;gap:10px;}
.w h3 small{font-family:var(--sans);font-size:12px;color:var(--ash);letter-spacing:0;font-weight:400;}
.num{font-family:var(--serif);font-weight:500;font-variant-numeric:tabular-nums;}
.est{display:inline-block;font-size:11px;letter-spacing:.08em;padding:1px 7px;border:1px dashed var(--gold);color:var(--gold);margin-left:6px;vertical-align:2px;}
.dim{color:var(--ash);}
.w-streak{grid-column:span 4;}.w-week{grid-column:span 8;}
.w-cal{grid-column:span 7;}.w-trend{grid-column:span 5;}
.w-rec{grid-column:span 7;border-bottom:0;}.w-body{grid-column:span 5;border-bottom:0;}
.w-streak .big{display:flex;align-items:baseline;gap:8px;}
.w-streak .big b{font-size:clamp(56px,7vw,80px);line-height:1;color:var(--gold);text-shadow:0 0 30px rgba(212,162,76,.35);}
.w-streak .big span{font-family:var(--serif);font-size:18px;}
.w-streak p{font-size:13px;color:var(--ash);margin-top:8px;}
.wk2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;}
.wk2 b{display:block;font-size:clamp(28px,3.4vw,38px);line-height:1.15;}
.wk2 .u{font-style:normal;font-family:var(--sans);font-size:14px;color:var(--bone-2);margin-left:3px;font-weight:400;}
.wk2 small{display:block;font-size:12px;color:var(--ash);margin-top:2px;}
.wkrow{margin-top:18px;}
.dots{display:flex;gap:8px;}
.dots i{width:26px;height:26px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;font-style:normal;font-size:11px;color:var(--ash);}
.dots i.on{background:var(--bpc);border-color:var(--bpc);color:#1C0F14;}
.dots i.now{outline:1px solid var(--bpc);outline-offset:2px;}
.cal-nav{display:flex;align-items:center;gap:6px;}
.cal-nav button{width:30px;height:30px;border:1px solid var(--line);color:var(--bone-2);font-size:14px;}
.cal-nav button:hover:not(:disabled){border-color:var(--bpc);color:var(--bpc);}
.cal-nav button:disabled{opacity:.3;}
.cal-nav b{font-family:var(--serif);font-weight:500;font-size:15px;min-width:96px;text-align:center;color:var(--bone);letter-spacing:0;}
.cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px;}
.cal .h{font-size:11.5px;color:var(--ash);text-align:center;padding-bottom:2px;}
.cal .d{aspect-ratio:1/.8;border:1px solid var(--line);padding:5px 6px;display:flex;flex-direction:column;justify-content:space-between;font-size:11px;color:var(--ash);text-align:left;background:transparent;transition:border-color .25s,transform .35s var(--ease);}
.cal .d.x{border-color:transparent;}
.cal .d.on{background:color-mix(in srgb,var(--bpc) calc(var(--l) * 1%),transparent);border-color:color-mix(in srgb,var(--bpc) 55%,transparent);cursor:pointer;}
.cal .d.on:hover,.cal .d.sel{border-color:var(--bpc);transform:translateY(-2px);}
.cal .d.today{box-shadow:inset 0 0 0 1px var(--bpc);}
.cal .d s{text-decoration:none;font-family:var(--serif);font-weight:500;font-size:14px;line-height:1;color:var(--bone);font-variant-numeric:tabular-nums;}
.cal .d span s{font-size:13px;}.cal .d span s small{font-size:10px;font-weight:400;color:var(--bone-2);margin-left:1px;}
.cal-det{min-height:22px;margin-top:12px;font-size:13px;color:var(--bone-2);}
.cal-det b{color:var(--bone);font-weight:500;}
.tr svg{width:100%;height:auto;display:block;overflow:visible;}
.tr .grow{transform-box:fill-box;transform-origin:50% 100%;transform:scaleY(0);animation:growUp .9s var(--ease) forwards;animation-delay:calc(var(--k) * 40ms);}
@keyframes growUp{to{transform:scaleY(1);}}
.rec3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;}
.rec{border-left:2px solid rgba(212,162,76,.5);padding:2px 0 2px 12px;}
.rec small{display:block;font-size:12px;color:var(--ash);letter-spacing:.06em;}
.rec b{display:block;font-size:clamp(24px,2.8vw,30px);line-height:1.2;margin-top:4px;}
.rec span{display:block;font-size:11.5px;color:var(--ash);margin-top:4px;}
.pred{margin-top:16px;font-size:13px;color:var(--bone-2);}
.pred b{font-size:18px;color:var(--bone);margin:0 4px;}
.bd2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.bd2 b{display:block;font-size:clamp(28px,3.2vw,36px);line-height:1.15;}
.bd2 b small{font-size:14px;font-family:var(--sans);color:var(--bone-2);margin-left:3px;font-weight:400;}
.bd2 span{display:block;font-size:12px;color:var(--ash);margin-top:2px;}
.strava{display:inline-flex;align-items:center;gap:8px;margin-top:24px;padding:9px 16px;border:1px solid #FF8A57;color:#FF8A57;font-size:13.5px;transition:background .3s,color .3s,gap .4s var(--ease);}
.strava:hover{background:#FC4C02;border-color:#FC4C02;color:#fff;gap:12px;}
@media(max-width:900px){.bp-grid{gap:0;}.bp .w{grid-column:1/-1 !important;border-bottom:1px solid var(--line) !important;}}
@media(max-width:560px){
  .bp{padding:22px 16px 26px;margin-top:56px;}
  .cal{gap:3px;}.cal .d{aspect-ratio:1/1;padding:4px;}.cal .d span small{display:none;}.cal .d s{font-size:13px;}
  .rec3{gap:8px;}.rec{padding-left:10px;}
  .cal-nav button{width:36px;height:36px;}.strava{min-height:44px;}
}
@media(prefers-reduced-motion:reduce){.tr .grow{animation:none;transform:none;}}
</style>

<script type="application/json" id="body-data" set:html={json}></script>
<script is:inline>
(function(){
var BD=JSON.parse(document.getElementById('body-data').textContent);
var API='https://gsaqrjovipnfiedvjaeb.supabase.co/functions/v1/health-public';
var root=document.getElementById('bodyPanel'),G=document.getElementById('bpGrid'),live=document.getElementById('bdLive');
var esc=function(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;');};
var ago=function(iso){if(!iso)return null;var m=Math.round((Date.now()-new Date(iso).getTime())/6e4);return m<60?Math.max(1,m)+' 分鐘前':m<1440?Math.round(m/60)+' 小時前':Math.round(m/1440)+' 天前';};
var hm=function(m){m=Math.round(m||0);return m>=60?Math.floor(m/60)+'h'+(m%60?String(m%60).padStart(2,'0')+'m':''):m+'m';};
var clock=function(s){s=Math.round(s);var h=Math.floor(s/3600),m=Math.floor(s%3600/60),x=s%60;return (h?h+':'+String(m).padStart(2,'0'):m)+':'+String(x).padStart(2,'0');};
var md=function(s){return s?s.slice(5).replace('-','/'):'';};
var TODAY=new Date(Date.now()+9*36e5).toISOString().slice(0,10);
var D=null,calMonth=null,CAL={};

function wStreak(){var n=D.streak_weeks||0;return '<div class="w w-streak"><h3>連續運動</h3><div class="big"><b class="num">'+n+'</b><span>週</span></div><p>每週至少動一次'+(D.longest_streak_weeks>n?'・最長 '+D.longest_streak_weeks+' 週':'')+'</p></div>';}
function dotRow(arr){var N='一二三四五六日',h='',tdx=(new Date(TODAY+'T00:00:00Z').getUTCDay()+6)%7;for(var i=0;i<7;i++)h+='<i class="'+(arr&&arr[i]!=null?'on ':'')+(i===tdx?'now':'')+'" title="'+(arr&&arr[i]!=null?arr[i]+' 分鐘':'休息')+'">'+N[i]+'</i>';return '<div class="dots">'+h+'</div>';}
function wWeek(){var a=D.this_week;if(!a)return '<div class="w w-week"><h3>本週</h3><p class="dim">累積中</p></div>';
  return '<div class="w w-week"><h3>本週<small>週一起算</small></h3><div class="wk2"><div><b class="num">'+hm(a.mins)+'</b><small>運動時間</small></div><div><b class="num">'+(a.km||0)+'<i class="u">km</i></b><small>距離</small></div></div><div class="wkrow">'+dotRow(a.dots)+'</div></div>';}
function buildCal(){CAL={};(D.calendar||[]).forEach(function(r){CAL[r[0]]={m:r[1],k:r[2],e:r[3],t:r[4]};});}
var monthOf=function(s){return s.slice(0,7);};
function calHtml(){var ym=calMonth,y=+ym.slice(0,4),m=+ym.slice(5,7),lead=(new Date(Date.UTC(y,m-1,1)).getUTCDay()+6)%7,days=new Date(Date.UTC(y,m,0)).getUTCDate(),h='',mx=60;
  '一二三四五六日'.split('').forEach(function(x){h+='<div class="h">'+x+'</div>';});
  for(var i=0;i<lead;i++)h+='<div class="d x"></div>';
  Object.keys(CAL).forEach(function(k){if(monthOf(k)===ym&&CAL[k].m>mx)mx=CAL[k].m;});
  for(var d=1;d<=days;d++){var key=ym+'-'+String(d).padStart(2,'0'),c=CAL[key],t=key===TODAY?' today':'';
    if(c)h+='<button class="d on'+t+'" data-d="'+key+'" style="--l:'+Math.round(18+Math.min(1,c.m/mx)*52)+'"><s>'+d+'</s><span><s>'+c.m+'<small>分</small></s></span></button>';
    else h+='<div class="d'+t+'"><s style="color:var(--ash);font-weight:400">'+d+'</s></div>';}
  return h;}
function wCal(){return '<div class="w w-cal"><h3><span>運動月曆</span><span class="cal-nav"><button id="cPrev" aria-label="上個月">‹</button><b id="cTitle"></b><button id="cNext" aria-label="下個月">›</button></span></h3><div class="cal" id="calGrid"></div><p class="cal-det" id="calDet"></p></div>';}
function paintCal(){var el=document.getElementById('calGrid');if(!el)return;document.getElementById('cTitle').textContent=calMonth.slice(0,4)+' 年 '+(+calMonth.slice(5,7))+' 月';el.innerHTML=calHtml();
  var keys=Object.keys(CAL).sort(),lo=keys[0]?monthOf(keys[0]):calMonth;document.getElementById('cPrev').disabled=calMonth<=lo;document.getElementById('cNext').disabled=calMonth>=monthOf(TODAY);
  var tot=0,n=0;keys.forEach(function(k){if(monthOf(k)===calMonth){tot+=CAL[k].m;n++;}});
  document.getElementById('calDet').innerHTML=n?'這個月動了 <b>'+n+'</b> 天・共 <b>'+hm(tot)+'</b>':'這個月沒有紀錄';}
root.addEventListener('click',function(e){
  var s=e.target.closest('#cPrev,#cNext');if(s){var d=new Date(Date.UTC(+calMonth.slice(0,4),+calMonth.slice(5,7)-1+(s.id==='cPrev'?-1:1),1));calMonth=d.toISOString().slice(0,7);paintCal();return;}
  var b=e.target.closest('.cal .d.on');if(b){[].forEach.call(root.querySelectorAll('.cal .d.sel'),function(x){x.classList.remove('sel');});b.classList.add('sel');var c=CAL[b.dataset.d];document.getElementById('calDet').innerHTML='<b>'+md(b.dataset.d)+'</b>　'+esc(c.t)+'・'+hm(c.m)+(c.k?'・'+c.k+' km':'');}
});
function wTrend(){return '<div class="w w-trend tr"><h3><span>近 12 週</span><small>每週運動分鐘</small></h3><svg id="trSvg" viewBox="0 0 600 200" role="img" aria-label="近 12 週每週運動時間"></svg></div>';}
function drawTrend(){var S=document.getElementById('trSvg');if(!S||!D)return;var v=(D.weeks&&D.weeks.mins)||[],labels=(D.weeks&&D.weeks.labels)||[];
  var W=Math.max(260,Math.min(640,Math.round(S.getBoundingClientRect().width)||500)),H=190,pl=4,pr=4,pt=20,pb=24,cw=(W-pl-pr)/Math.max(1,v.length),mx=Math.max.apply(0,v.concat([1])),y=function(x){return pt+(H-pt-pb)*(1-x/mx);},g='';
  for(var i=0;i<3;i++){var gy=pt+(H-pt-pb)*i/2;g+='<line x1="'+pl+'" x2="'+(W-pr)+'" y1="'+gy+'" y2="'+gy+'" style="stroke:var(--line)"/>';}
  var out=v.map(function(x,i){var bh=Math.max(x?2:0,(H-pt-pb)-(y(x||0)-pt)),last=i===v.length-1;return '<g class="grow" style="--k:'+i+'"><rect x="'+(pl+cw*i+cw*.2)+'" y="'+(H-pb-bh)+'" width="'+(cw*.6)+'" height="'+bh+'" style="fill:'+(last?'var(--gold)':'rgba(212,162,76,.3)')+';stroke:var(--gold);stroke-width:'+(last?0:1)+'"><title>'+esc(labels[i]||'')+'：'+(x||0)+' 分鐘</title></rect></g>';}).join('');
  out+='<text x="'+(pl+cw*(v.length-1)+cw/2)+'" y="'+(y(v[v.length-1]||0)-8)+'" text-anchor="middle" style="fill:var(--bone)" font-size="13">'+(v[v.length-1]||0)+'</text>';
  var xl=labels.map(function(t,i){return (i%4===0||i===labels.length-1)?'<text x="'+(pl+cw*i+cw/2)+'" y="'+(H-6)+'" text-anchor="middle" style="fill:var(--ash)" font-size="11">'+esc(t)+'</text>':'';}).join('');
  S.setAttribute('viewBox','0 0 '+W+' '+H);S.innerHTML=g+out+xl;}
function wRec(){var R=D.records||{};function card(k,n){var r=R[k];return '<div class="rec"><small>'+n+'</small><b class="num">'+(r?clock(r.sec):'—')+'</b><span>'+(r?r.day.replace(/-/g,'.'):'補齊紀錄中')+'</span></div>';}
  var p=D.predict10k;return '<div class="w w-rec"><h3>最佳表現</h3><div class="rec3">'+card('k1','1 公里')+card('k5','5 公里')+card('k10','10 公里')+'</div>'+(p?'<p class="pred">10K 預估<span class="est">估算</span><b class="num">'+clock(p.sec)+'</b>依近 90 天最快 5 公里換算，非實測</p>':'')+'</div>';}
function wBody(){var b=D.body_now;if(!b||(!b.weight&&!b.fat))return '<div class="w w-body"><h3>體重・體脂</h3><p class="dim" style="font-size:13px">累積中</p></div>';
  return '<div class="w w-body"><h3>體重・體脂'+(D.scale_last_day?'<small>'+md(D.scale_last_day)+'</small>':'')+'</h3><div class="bd2"><div><b class="num">'+(b.weight?b.weight.v:'—')+'<small>kg</small></b><span>體重</span></div><div><b class="num">'+(b.fat?b.fat.v:'—')+'<small>%</small></b><span>體脂</span></div></div></div>';}

function render(d,isLive){D=d;buildCal();
  var keys=Object.keys(CAL).sort();calMonth=monthOf(keys.length&&keys[keys.length-1]<TODAY&&monthOf(keys[keys.length-1])===monthOf(TODAY)?TODAY:TODAY);
  G.innerHTML=wStreak()+wWeek()+wCal()+wTrend()+wRec()+wBody();
  paintCal();drawTrend();
  if(isLive){var a=ago(d.updated_at),s=ago(d.strava_synced_at);live.textContent='自動同步中'+(s?'・Strava '+s+'同步':'');}
  else{live.parentElement.classList.add('stale');live.textContent='暫時讀不到即時資料，顯示的是上次發布時的數字';}}
var rz;addEventListener('resize',function(){clearTimeout(rz);rz=setTimeout(function(){if(D)drawTrend();},200);});
var fallback=function(){render({weeks:{mins:BD.weeks.mins,labels:[]},calendar:[],records:{},stats:{}},false);};
fetch(API,{mode:'cors'}).then(function(r){if(!r.ok)throw 0;return r.json();}).then(function(d){if(d.error)throw 0;render(d,true);}).catch(fallback);
})();
</script>
