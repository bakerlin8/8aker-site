---
// 身體儀表：Strava 運動＋OMRON 體重體脂＋每日步數（小米手錶→健康 App→捷徑）的即時彙總。放在「強化」分類頁。
// 三種版型共用同一份資料：預設 A；網址加 ?v=a / ?v=b / ?v=c 可預覽（出現切換鈕）。
import body from '../data/body.json';
const json = JSON.stringify(body).replace(/</g, '\\u003c');
---
<section class="bp" id="bodyPanel" aria-labelledby="bp-h">
  <div class="bp-head"><h2 id="bp-h">身體儀表</h2><p class="blive"><i aria-hidden="true"></i><span id="bdLive">讀取最新資料中…</span></p></div>
  <div class="bp-grid" id="bpGrid"><p class="bp-empty">讀取中…</p></div>
  <a class="strava" href="https://www.strava.com/athletes/103942910" target="_blank" rel="noopener">在 Strava 一起運動<span aria-hidden="true">↗</span></a>
</section>

<style is:global>
/* 夜色的配色＋帳本的細線版面：深酒紅底、金色重點、襯線大數字 */
.bp{--night:#1C0F14;--bone:#EFE5D6;--bone-2:#C2B2A6;--ash:#9a8590;--line:rgba(239,229,214,.14);--gold:#D4A24C;--bpc:#D4A24C;--c-strengthen:#E08A9B;
  margin-top:72px;padding:30px clamp(18px,3vw,34px) 34px;color:#EFE5D6;border:1px solid rgba(212,162,76,.28);
  background:radial-gradient(120% 90% at 90% 0%,#3A1F29 0%,#1C0F14 62%);}
.bp-head h2{font-family:var(--serif);font-weight:500;font-size:clamp(22px,2.6vw,28px);color:#EFE5D6;}
.blive{display:inline-flex;align-items:center;gap:8px;margin-top:6px;font-size:12.5px;color:var(--ash);}
.blive i{width:7px;height:7px;border-radius:50%;background:#5E9C6A;animation:livePulse 2.4s ease-out infinite;flex:none;}
.blive.stale i{background:var(--ash);animation:none;}
@keyframes livePulse{70%{box-shadow:0 0 0 7px rgba(94,156,106,0);}100%{box-shadow:0 0 0 0 rgba(94,156,106,0);}}
.bp-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:0 36px;margin-top:22px;border-top:1px solid var(--line);}
.bp-empty{grid-column:1/-1;padding:20px 0;color:var(--ash);font-size:13.5px;}
.w{min-width:0;padding:24px 0;border-bottom:1px solid var(--line);}
.w h3{font-family:var(--serif);font-weight:500;font-size:14px;letter-spacing:.12em;color:var(--bone-2);margin-bottom:14px;display:flex;align-items:baseline;justify-content:space-between;gap:10px;}
.w h3 small{font-family:var(--sans);font-size:12px;color:var(--ash);letter-spacing:0;font-weight:400;}
.num{font-family:var(--serif);font-weight:500;font-variant-numeric:tabular-nums;}
.est{display:inline-block;font-size:11px;letter-spacing:.08em;padding:1px 7px;border:1px dashed var(--gold);color:var(--gold);margin-left:6px;vertical-align:2px;}
.dim{color:var(--ash);}
.w-streak{grid-column:span 4;}.w-week{grid-column:span 8;}
.w-steps{grid-column:span 12;}
.w-cal{grid-column:span 7;}.w-trend{grid-column:span 5;}
.w-rec{grid-column:span 7;border-bottom:0;}.w-body{grid-column:span 5;border-bottom:0;}
.w-streak .big{display:flex;align-items:baseline;gap:8px;}
.w-streak .big b{font-size:clamp(56px,7vw,80px);line-height:1;color:var(--gold);text-shadow:0 0 30px rgba(212,162,76,.35);}
.w-streak .big span{font-family:var(--serif);font-size:18px;}
.w-streak p{font-size:13px;color:var(--ash);margin-top:8px;}
.wk2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;}
.wk2 b{display:block;font-size:clamp(28px,3.4vw,38px);line-height:1.15;}
.wk2 .u{font-style:normal;font-family:var(--sans);font-size:14px;color:var(--bone-2);margin-left:3px;font-weight:400;}
.wk2 small{display:block;font-size:12px;color:var(--ash);margin-top:2px;}
.wkrow{margin-top:18px;}
.dots{display:flex;gap:8px;}
.dots i{width:26px;height:26px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;font-style:normal;font-size:11px;color:var(--ash);}
.dots i.on{background:var(--bpc);border-color:var(--bpc);color:#1C0F14;}
.dots i.now{outline:1px solid var(--bpc);outline-offset:2px;}
.cal-nav{display:flex;align-items:center;gap:6px;}
.cal-nav button{width:30px;height:30px;border:1px solid var(--line);color:var(--bone-2);font-size:14px;}
.cal-nav button:hover:not(:disabled){border-color:var(--bpc);color:var(--bpc);}
.cal-nav button:disabled{opacity:.3;}
.cal-nav b{font-family:var(--serif);font-weight:500;font-size:15px;min-width:96px;text-align:center;color:var(--bone);letter-spacing:0;}
.cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px;}
.cal .h{font-size:11.5px;color:var(--ash);text-align:center;padding-bottom:2px;}
.cal .d{aspect-ratio:1/.8;border:1px solid var(--line);padding:5px 6px;display:flex;flex-direction:column;justify-content:space-between;font-size:11px;color:var(--ash);text-align:left;background:transparent;transition:border-color .25s,transform .35s var(--ease);}
.cal .d.x{border-color:transparent;}
.cal .d.on{background:color-mix(in srgb,var(--bpc) calc(var(--l) * 1%),transparent);border-color:color-mix(in srgb,var(--bpc) 55%,transparent);cursor:pointer;}
.cal .d.on:hover,.cal .d.sel{border-color:var(--bpc);transform:translateY(-2px);}
.cal .d.today{box-shadow:inset 0 0 0 1px var(--bpc);}
.cal .d s{text-decoration:none;font-family:var(--serif);font-weight:500;font-size:14px;line-height:1;color:var(--bone);font-variant-numeric:tabular-nums;}
.cal .d span s{font-size:13px;}.cal .d span s small{font-size:10px;font-weight:400;color:var(--bone-2);margin-left:1px;}
.cal-det{min-height:22px;margin-top:12px;font-size:13px;color:var(--bone-2);}
.cal-det b{color:var(--bone);font-weight:500;}
.tr svg{width:100%;height:auto;display:block;overflow:visible;}
.tr .grow{transform-box:fill-box;transform-origin:50% 100%;transform:scaleY(0);animation:growUp .9s var(--ease) forwards;animation-delay:calc(var(--k) * 40ms);}
@keyframes growUp{to{transform:scaleY(1);}}
.rec3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;}
.rec{border-left:2px solid rgba(212,162,76,.5);padding:2px 0 2px 12px;}
.rec small{display:block;font-size:12px;color:var(--ash);letter-spacing:.06em;}
.rec b{display:block;font-size:clamp(24px,2.8vw,30px);line-height:1.2;margin-top:4px;}
.rec span{display:block;font-size:11.5px;color:var(--ash);margin-top:4px;}
.pred{margin-top:16px;font-size:13px;color:var(--bone-2);}
.pred b{font-size:18px;color:var(--bone);margin:0 4px;}
.bd2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.bd2 b{display:block;font-size:clamp(28px,3.2vw,36px);line-height:1.15;}
.bd2 b small{font-size:14px;font-family:var(--sans);color:var(--bone-2);margin-left:3px;font-weight:400;}
.bd2 span{display:block;font-size:12px;color:var(--ash);margin-top:2px;}
.strava{display:inline-flex;align-items:center;gap:8px;margin-top:24px;padding:9px 16px;border:1px solid #FF8A57;color:#FF8A57;font-size:13.5px;transition:background .3s,color .3s,gap .4s var(--ease);}
.strava:hover{background:#FC4C02;border-color:#FC4C02;color:#fff;gap:12px;}

/* 每日步數 */
.st{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:18px 36px;align-items:end;}
.st .big>b{display:block;font-size:clamp(40px,5.2vw,60px);line-height:1;color:var(--gold);text-shadow:0 0 30px rgba(212,162,76,.3);}
.st .big small{display:block;font-size:12px;color:var(--ash);margin-top:6px;}
.st .cmp{margin-top:14px;font-size:13px;color:var(--bone-2);}
.st .cmp b{font-family:var(--serif);font-weight:500;font-size:17px;color:var(--bone);margin:0 3px;}
.st svg{width:100%;height:auto;display:block;overflow:visible;}
.st-det{min-height:20px;margin-top:8px;font-size:12.5px;color:var(--bone-2);}
.st-det b{color:var(--bone);font-weight:500;}
.st rect.hit{cursor:pointer;}
@media(max-width:700px){.st{grid-template-columns:1fr;}}

/* 互動 */
.cn{font-style:normal;}
.seg{display:flex;gap:4px;flex-wrap:wrap;}
.seg button{font-size:12.5px;padding:3px 11px;border:1px solid var(--line);color:var(--bone-2);transition:all .25s;}
.seg button:hover{border-color:var(--bone-2);}
.seg button[aria-pressed="true"]{background:var(--gold);color:#1C0F14;border-color:var(--gold);}
.w-cal h3{flex-wrap:wrap;}
.dots i{cursor:default;}.dots i.on{cursor:pointer;transition:transform .3s var(--ease);}.dots i.on:hover{transform:scale(1.18);}
.cal .d.on{animation:cellIn .55s var(--ease) both;animation-delay:calc(var(--n,0) * 35ms);}
@keyframes cellIn{from{opacity:0;transform:scale(.85);}to{opacity:1;transform:none;}}
.yr{overflow-x:auto;scrollbar-width:none;}.yr::-webkit-scrollbar{display:none;}
.yr svg{display:block;min-width:560px;width:100%;height:auto;}
.yr rect.on{cursor:pointer;transition:opacity .2s;}.yr rect.on:hover{stroke:var(--bone);stroke-width:1;}
.tr-top{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:12px;}
.tr-top h3{margin:0;}
.tr rect.hit{cursor:pointer;}
.tr .sel rect{stroke:var(--bone);stroke-width:1.5;}
.tr-det{min-height:20px;margin-top:10px;font-size:13px;color:var(--bone-2);}
.tr-det b{color:var(--bone);font-weight:500;}
.wdays{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px;margin-top:8px;}
.wdays div{border:1px solid var(--line);padding:5px 2px;text-align:center;font-size:11px;color:var(--ash);}
.wdays div.on{border-color:rgba(212,162,76,.6);background:rgba(212,162,76,.14);color:var(--bone);}
.wdays div b{display:block;font-family:var(--serif);font-weight:500;font-size:13px;color:inherit;}
.rec{text-align:left;background:none;cursor:pointer;transition:border-color .3s,transform .35s var(--ease);display:block;width:100%;}
.rec:hover,.rec[aria-expanded="true"]{border-left-color:var(--gold);transform:translateX(3px);}
.rec[aria-expanded="true"] small{color:var(--gold);}
.rec-det{margin-top:14px;font-size:13px;color:var(--bone-2);}
.rec-det ol{list-style:none;margin-top:6px;}
.rec-det li{display:grid;grid-template-columns:22px 1fr auto;gap:10px;padding:6px 0;border-top:1px solid var(--line);font-variant-numeric:tabular-nums;}
.rec-det li:first-child{border-top:0;}
.rec-det li b{font-family:var(--serif);font-weight:500;color:var(--bone);}
.bp-in{opacity:0;transform:translateY(14px);transition:opacity .8s var(--ease),transform .8s var(--ease);}
.bp.vis .bp-in{opacity:1;transform:none;}
@media(prefers-reduced-motion:reduce){.bp-in{opacity:1;transform:none;transition:none;}.cal .d.on{animation:none;}}
@media(max-width:900px){.bp-grid{gap:0;}.bp .w{grid-column:1/-1 !important;border-bottom:1px solid var(--line) !important;}}
@media(max-width:560px){
  .bp{padding:22px 16px 26px;margin-top:56px;}
  .cal{gap:3px;}.cal .d{aspect-ratio:1/1;padding:4px;}.cal .d span small{display:none;}.cal .d s{font-size:13px;}
  .rec3{gap:8px;}.rec{padding-left:10px;}
  .cal-nav button{width:36px;height:36px;}.strava{min-height:44px;}
}
@media(prefers-reduced-motion:reduce){.tr .grow{animation:none;transform:none;}}
</style>

<script type="application/json" id="body-data" set:html={json}></script>
<script is:inline>
(function(){
var BD=JSON.parse(document.getElementById('body-data').textContent);
var API='https://gsaqrjovipnfiedvjaeb.supabase.co/functions/v1/health-public';
var root=document.getElementById('bodyPanel'),G=document.getElementById('bpGrid'),live=document.getElementById('bdLive');
var RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
var esc=function(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;');};
var ago=function(iso){if(!iso)return null;var m=Math.round((Date.now()-new Date(iso).getTime())/6e4);return m<60?Math.max(1,m)+' 分鐘前':m<1440?Math.round(m/60)+' 小時前':Math.round(m/1440)+' 天前';};
var hm=function(m){m=Math.round(m||0);return m>=60?Math.floor(m/60)+'h'+(m%60?String(m%60).padStart(2,'0')+'m':''):m+'m';};
var clock=function(s){s=Math.round(s);var h=Math.floor(s/3600),m=Math.floor(s%3600/60),x=s%60;return (h?h+':'+String(m).padStart(2,'0'):m)+':'+String(x).padStart(2,'0');};
var md=function(s){return s?s.slice(5).replace('-','/'):'';};
var DAYMS=864e5,TODAY=new Date(Date.now()+9*36e5).toISOString().slice(0,10);
var addDays=function(ds,n){return new Date(new Date(ds+'T00:00:00Z').getTime()+n*DAYMS).toISOString().slice(0,10);};
var monthOf=function(s){return s.slice(0,7);};
var tdow=(new Date(TODAY+'T00:00:00Z').getUTCDay()+6)%7,THISMON=addDays(TODAY,-tdow);
var D=null,calMonth=null,CAL={},metric='mins',calView='month',selWeek=-1,recOpen=null,counted=false;

/* ── 數字滾動 ── */
function countUp(el){var to=parseFloat(el.dataset.to),fmt=el.dataset.f||'n',dec=+(el.dataset.dec||0);if(isNaN(to))return;
  var set=function(v){el.textContent=fmt==='hm'?hm(v):fmt==='c'?Math.round(v).toLocaleString():(dec?v.toFixed(dec):Math.round(v));};
  if(RM){set(to);return;}var t0=performance.now(),dur=1100;set(0);
  (function f(t){var k=Math.min(1,(t-t0)/dur),e=1-Math.pow(1-k,3);set(to*e);if(k<1)requestAnimationFrame(f);else set(to);})(t0);}
function runCounts(){counted=true;[].forEach.call(root.querySelectorAll('[data-to]'),countUp);}

/* ── 小零件 ── */
function wStreak(){var n=D.streak_weeks||0;return '<div class="w w-streak bp-in"><h3>連續運動</h3><div class="big"><b class="num" data-to="'+n+'">'+n+'</b><span>週</span></div><p>每週至少動一次'+(D.longest_streak_weeks>n?'・最長 '+D.longest_streak_weeks+' 週':'')+'</p></div>';}
function dotRow(arr){var N='一二三四五六日',h='',ws=D.week_start||THISMON;for(var i=0;i<7;i++){var on=arr&&arr[i]!=null;h+='<i class="'+(on?'on ':'')+(i===tdow?'now':'')+'" '+(on?'data-day="'+addDays(ws,i)+'" role="button" tabindex="0"':'')+' title="'+(on?arr[i]+' 分鐘・點一下看月曆':'休息')+'">'+N[i]+'</i>';}return '<div class="dots">'+h+'</div>';}
function wWeek(){var a=D.this_week;if(!a)return '<div class="w w-week bp-in"><h3>本週</h3><p class="dim">累積中</p></div>';
  return '<div class="w w-week bp-in"><h3>本週<small>週一起算・點圓點看當天</small></h3><div class="wk2"><div><b class="num" data-to="'+a.mins+'" data-f="hm">'+hm(a.mins)+'</b><small>運動時間</small></div><div><b class="num"><i class="cn" data-to="'+(a.km||0)+'" data-dec="1">'+(a.km||0)+'</i><i class="u">km</i></b><small>距離</small></div></div><div class="wkrow">'+dotRow(a.dots)+'</div></div>';}
var stSel=null,stM='steps',stP='d';
function mLbl(k){return k.slice(2,4)+'/'+(+k.slice(5,7));}
function lblOf(k){return stP==='m'?mLbl(k):md(k);}
function hasKm(){var S=D.steps;return !!(S&&S.km_days&&S.km_days.length);}
function stDays(){var S=D.steps;if(!S)return [];if(stP==='m'){return (S.months||[]).map(function(r){return [r[0],stM==='km'?r[2]:r[1]];});}var src=stM==='km'?S.km_days:S.days;if(!src)return [];var m={};src.forEach(function(r){m[r[0]]=r[1];});var out=[];for(var i=29;i>=0;i--){var k=addDays(TODAY,-i);out.push([k,m[k]==null?null:m[k]]);}return out;}
function fmtS(n){return stM==='km'?(Math.round(n*10)/10).toString():Math.round(n).toLocaleString();}
function wSteps(){var S=D.steps;if(!S)return '';var km=stM==='km';if(km&&!hasKm())stM='steps',km=false;
  var big=S[km?'km_today':'today'],lbl='今天',unit=km?'公里':'步';
  if(big==null){var ds=stDays().filter(function(r){return r[1]!=null;});var l=ds[ds.length-1];if(l){big=l[1];lbl=md(l[0]);}}
  var cmp=km?(S.km_week!=null?'本週累計 <b class="num">'+S.km_week+'</b> 公里'+(S.km_last_week!=null?'<br><span class="dim">上週 '+S.km_last_week+' 公里</span>':''):'')
    :(S.week_avg!=null?'本週平均 <b class="num">'+S.week_avg.toLocaleString()+'</b> 步／日'+(S.last_week_avg!=null?'<br><span class="dim">上週 '+S.last_week_avg.toLocaleString()+' 步／日</span>':''):'');
  var seg=hasKm()?'<div class="seg" id="stSeg" style="margin-bottom:8px"><button data-sm="steps" aria-pressed="'+!km+'">步數</button><button data-sm="km" aria-pressed="'+km+'">距離</button></div>':'';
  var hasM=!!(S.months&&S.months.length>1),pseg=hasM?'<div class="seg" id="stPSeg" style="margin-bottom:8px;margin-left:6px;display:inline-flex"><button data-sp="d" aria-pressed="'+(stP==='d')+'">近 30 天</button><button data-sp="m" aria-pressed="'+(stP==='m')+'">逐月（2023 起）</button></div>':'';
  if(seg)seg=seg.replace('style="margin-bottom:8px"','style="margin-bottom:8px;display:inline-flex"');
  return '<div class="w w-steps bp-in"><h3>每日步行<small>'+(stP==='m'?'每月平均・點長條看那個月':'近 30 天・點長條看當天')+'</small></h3><div class="st"><div class="big"><b class="num" data-to="'+(big||0)+'" data-f="'+(km?'n':'c')+'" data-dec="'+(km?1:0)+'">'+(big!=null?(km?big:big.toLocaleString()):'—')+'</b><small>'+lbl+'的'+(km?'步行距離':'步數')+(km?'（公里・含跑步）':'')+'</small><p class="cmp">'+cmp+'</p></div><div><div>'+seg+pseg+'</div><svg id="stSvg" viewBox="0 0 600 120" role="img" aria-label="'+(stP==='m'?'逐月每日平均':'近 30 天每日')+(km?'步行距離':'步數')+'"></svg><div class="st-det" id="stDet"></div></div></div></div>';}
function drawSteps(){var S=document.getElementById('stSvg');if(!S||!D||!D.steps)return;var km=stM==='km',ref=km?5:8000,ds=stDays(),W=600,H=120,pl=2,pr=2,pt=10,pb=20,cw=(W-pl-pr)/ds.length,mx=Math.max(ref,Math.max.apply(0,ds.map(function(r){return r[1]||0;}))),y=function(n){return pt+(H-pt-pb)*(1-n/mx);},o='',uni=km?' 公里':' 步';
  o+='<line x1="'+pl+'" x2="'+(W-pr)+'" y1="'+y(ref)+'" y2="'+y(ref)+'" style="stroke:var(--gold)" stroke-dasharray="3 4" opacity=".4"/><text x="'+(W-pr)+'" y="'+(y(ref)-4)+'" text-anchor="end" font-size="10" style="fill:var(--ash)">'+(km?'5 km':'8,000')+'</text>';
  ds.forEach(function(r,i){var n=r[1],x=pl+cw*i,last=stP==='m'?i===ds.length-1:r[0]===TODAY;if(n!=null){var bh=Math.max(2,(H-pb)-y(n));o+='<rect x="'+(x+cw*.18)+'" y="'+(H-pb-bh)+'" width="'+(cw*.64)+'" height="'+bh+'" style="fill:'+(last?'var(--gold)':'rgba(212,162,76,.35)')+';stroke:var(--gold);stroke-width:'+(r[0]===stSel?1.6:(last?0:.8))+'"><title>'+lblOf(r[0])+'：'+fmtS(n)+uni+'</title></rect>';}
    o+='<rect class="hit" data-sd="'+r[0]+'" x="'+x+'" y="0" width="'+cw+'" height="'+(H-pb)+'" fill="transparent"/>';
    if(stP==='m'?(r[0].slice(5,7)==='01'||r[0].slice(5,7)==='07'):i%7===0)o+='<text x="'+(x+cw/2)+'" y="'+(H-5)+'" text-anchor="middle" font-size="10.5" style="fill:var(--ash)">'+lblOf(r[0])+'</text>';});
  S.innerHTML=o;
  var sel=stSel&&ds.filter(function(r){return r[0]===stSel;})[0],det=document.getElementById('stDet');
  var ok=ds.filter(function(r){return r[1]!=null;}),avg=ok.length?ok.reduce(function(a,r){return a+r[1];},0)/ok.length:null;
  det.innerHTML=sel?'<b>'+lblOf(sel[0])+'</b>　'+(sel[1]!=null?fmtS(sel[1])+uni+(stP==='m'?'／日（月平均）':''):'沒有紀錄'):(avg!=null?'<span class="dim">'+(stP==='m'?'2023 年起的月平均再平均 ':'近 30 天平均 ')+fmtS(avg)+uni+'／日（有紀錄的日子）</span>':'');}
function repaintSteps(){var el=root.querySelector('.w-steps');if(!el)return;el.outerHTML=wSteps();var n=root.querySelector('.w-steps');if(n){n.classList.add('bp-in');[].forEach.call(n.querySelectorAll('[data-to]'),countUp);}drawSteps();}
function buildCal(){CAL={};(D.calendar||[]).forEach(function(r){CAL[r[0]]={m:r[1],k:r[2],e:r[3],t:r[4]};});}
function lvOf(m,mx){return Math.round(18+Math.min(1,m/mx)*52);}
function monthHtml(){var ym=calMonth,y=+ym.slice(0,4),m=+ym.slice(5,7),lead=(new Date(Date.UTC(y,m-1,1)).getUTCDay()+6)%7,days=new Date(Date.UTC(y,m,0)).getUTCDate(),h='<div class="cal">',mx=60,n=0;
  '一二三四五六日'.split('').forEach(function(x){h+='<div class="h">'+x+'</div>';});
  for(var i=0;i<lead;i++)h+='<div class="d x"></div>';
  Object.keys(CAL).forEach(function(k){if(monthOf(k)===ym&&CAL[k].m>mx)mx=CAL[k].m;});
  for(var d=1;d<=days;d++){var key=ym+'-'+String(d).padStart(2,'0'),c=CAL[key],t=key===TODAY?' today':'';
    if(c)h+='<button class="d on'+t+'" data-d="'+key+'" style="--l:'+lvOf(c.m,mx)+';--n:'+(n++)+'"><s>'+d+'</s><span><s>'+c.m+'<small>分</small></s></span></button>';
    else h+='<div class="d'+t+'"><s style="color:var(--ash);font-weight:400">'+d+'</s></div>';}
  return h+'</div>';}
function yearHtml(){var cell=11,gap=3,weeks=53,W=weeks*(cell+gap)+26,H=7*(cell+gap)+18,start=addDays(THISMON,-(weeks-1)*7),mx=60,s='',ml='',lastM='',lastW=-9;
  Object.keys(CAL).forEach(function(k){if(CAL[k].m>mx)mx=CAL[k].m;});
  for(var w=0;w<weeks;w++){for(var d=0;d<7;d++){var key=addDays(start,w*7+d);if(key>TODAY)continue;var c=CAL[key],x=24+w*(cell+gap),y=16+d*(cell+gap);
      s+='<rect class="'+(c?'on':'')+'" '+(c?'data-d="'+key+'"':'')+' x="'+x+'" y="'+y+'" width="'+cell+'" height="'+cell+'" rx="2.5" style="fill:'+(c?'var(--gold)':'rgba(239,229,214,.1)')+';opacity:'+(c?(.3+Math.min(1,c.m/mx)*.7).toFixed(2):1)+'"><title>'+key+(c?'：'+hm(c.m)+(c.k?'・'+c.k+' km':''):'：休息')+'</title></rect>';
      if(d===0&&monthOf(key)!==lastM){lastM=monthOf(key);if(w-lastW>=3){ml+='<text x="'+x+'" y="10" font-size="10" style="fill:var(--ash)">'+(+key.slice(5,7))+'月</text>';lastW=w;}}}}
  var dl='';[['一',0],['三',2],['五',4],['日',6]].forEach(function(a){dl+='<text x="0" y="'+(16+a[1]*(cell+gap)+9)+'" font-size="9.5" style="fill:var(--ash)">'+a[0]+'</text>';});
  return '<div class="yr"><svg viewBox="0 0 '+W+' '+H+'" role="img" aria-label="近一年運動熱力圖">'+ml+dl+s+'</svg></div>';}
function wCal(){return '<div class="w w-cal bp-in"><h3><span>運動月曆</span><span class="seg" id="calSeg"><button data-cv="month" aria-pressed="true">月</button><button data-cv="year" aria-pressed="false">整年</button></span></h3><div class="tr-top" id="calNavRow" style="margin-bottom:10px"><span class="cal-nav"><button id="cPrev" aria-label="上個月">‹</button><b id="cTitle"></b><button id="cNext" aria-label="下個月">›</button></span></div><div id="calBody"></div><p class="cal-det" id="calDet"></p></div>';}
function summary(){var keys=Object.keys(CAL).sort(),tot=0,n=0,lim=calView==='year'?addDays(TODAY,-364):calMonth+'-01',end=calView==='year'?TODAY:calMonth+'-31';
  keys.forEach(function(k){if(k>=lim&&k<=end){tot+=CAL[k].m;n++;}});
  document.getElementById('calDet').innerHTML=(calView==='year'?'近一年':'這個月')+'動了 <b>'+n+'</b> 天・共 <b>'+hm(tot)+'</b>　<span class="dim">點有顏色的日期看細節</span>';}
function paintCal(){var el=document.getElementById('calBody');if(!el)return;var yv=calView==='year';
  document.getElementById('calNavRow').style.display=yv?'none':'';
  [].forEach.call(document.querySelectorAll('#calSeg button'),function(b){b.setAttribute('aria-pressed',b.dataset.cv===calView);});
  if(!yv){document.getElementById('cTitle').textContent=calMonth.slice(0,4)+' 年 '+(+calMonth.slice(5,7))+' 月';
    var keys=Object.keys(CAL).sort(),lo=keys[0]?monthOf(keys[0]):calMonth;document.getElementById('cPrev').disabled=calMonth<=lo;document.getElementById('cNext').disabled=calMonth>=monthOf(TODAY);}
  el.innerHTML=yv?yearHtml():monthHtml();summary();}
function pickDay(key,scroll){var c=CAL[key];if(!c)return;if(calView==='month'&&monthOf(key)!==calMonth){calMonth=monthOf(key);paintCal();}
  [].forEach.call(root.querySelectorAll('.cal .d.sel'),function(x){x.classList.remove('sel');});var b=root.querySelector('.cal .d[data-d="'+key+'"]');if(b)b.classList.add('sel');
  document.getElementById('calDet').innerHTML='<b>'+md(key)+'</b>　'+esc(c.t)+'・'+hm(c.m)+(c.k?'・'+c.k+' km':'')+(c.e?'・爬升 '+c.e+' m':'');
  if(scroll){var w=root.querySelector('.w-cal');if(w)w.scrollIntoView({behavior:RM?'auto':'smooth',block:'center'});}}

/* ── 趨勢圖 ── */
var NM={mins:'時間',km:'距離',steps:'步數',walk:'步行距離',fat:'體脂',weight:'體重'},UN={mins:'分鐘',km:'km',steps:'步／日',walk:'km／週',fat:'%',weight:'kg'};
function series(){var W=D.weeks||{},s={mins:W.mins||[]};if(W.km&&W.km.some(function(x){return x}))s.km=W.km;if(W.steps&&W.steps.some(function(x){return x}))s.steps=W.steps;if(W.walk_km&&W.walk_km.some(function(x){return x}))s.walk=W.walk_km;if(W.fat&&W.fat.some(function(x){return x!=null}))s.fat=W.fat;if(W.weight&&W.weight.some(function(x){return x!=null}))s.weight=W.weight;return s;}
function wTrend(){return '<div class="w w-trend tr bp-in"><div class="tr-top"><h3><span>近 12 週</span></h3><div class="seg" id="trSeg"></div></div><svg id="trSvg" viewBox="0 0 600 200" role="img" aria-label="近 12 週趨勢"></svg><div class="tr-det" id="trDet"></div></div>';}
function weekStart(i){return addDays(THISMON,-7*(11-i));}
function drawTrend(){var S=document.getElementById('trSvg');if(!S||!D)return;var ser=series(),keys=Object.keys(ser);if(!ser[metric])metric='mins';
  document.getElementById('trSeg').innerHTML=keys.map(function(k){return '<button data-m="'+k+'" aria-pressed="'+(k===metric)+'">'+NM[k]+'</button>';}).join('');
  var v=ser[metric],labels=(D.weeks&&D.weeks.labels)||[],nums=v.filter(function(x){return x!=null;}),bar=metric==='mins'||metric==='km'||metric==='steps'||metric==='walk';
  var W=Math.max(260,Math.min(640,Math.round(S.getBoundingClientRect().width)||500)),H=190,pl=4,pr=4,pt=20,pb=24,cw=(W-pl-pr)/Math.max(1,v.length);
  if(!nums.length){S.innerHTML='<text x="'+W/2+'" y="90" text-anchor="middle" style="fill:var(--ash)" font-size="13">資料累積中</text>';return;}
  var mx=Math.max.apply(0,nums),mn=bar?0:Math.min.apply(0,nums),rg=(mx-mn)||1,y=function(x){return pt+(H-pt-pb)*(1-(x-mn)/rg);},g='',out='';
  for(var i=0;i<3;i++){var gy=pt+(H-pt-pb)*i/2;g+='<line x1="'+pl+'" x2="'+(W-pr)+'" y1="'+gy+'" y2="'+gy+'" style="stroke:var(--line)"/>';}
  if(bar){out=v.map(function(x,i){var bh=Math.max(x?2:0,(H-pt-pb)-(y(x||0)-pt)),last=i===v.length-1;return '<g class="grow'+(i===selWeek?' sel':'')+'" style="--k:'+i+'"><rect x="'+(pl+cw*i+cw*.2)+'" y="'+(H-pb-bh)+'" width="'+(cw*.6)+'" height="'+bh+'" style="fill:'+(last?'var(--gold)':'rgba(212,162,76,.3)')+';stroke:var(--gold);stroke-width:'+(last?0:1)+'"><title>'+esc(labels[i]||'')+'：'+(x||0).toLocaleString()+' '+UN[metric]+'</title></rect></g><rect class="hit" data-i="'+i+'" x="'+(pl+cw*i)+'" y="'+pt+'" width="'+cw+'" height="'+(H-pt-pb)+'" fill="transparent"/>';}).join('');
    out+='<text x="'+(pl+cw*(v.length-1)+cw/2)+'" y="'+(y(v[v.length-1]||0)-8)+'" text-anchor="middle" style="fill:var(--bone)" font-size="13">'+(v[v.length-1]||0).toLocaleString()+'</text>';}
  else{var pts=v.map(function(x,i){return x==null?null:(pl+cw*i+cw/2)+','+y(x);}).filter(Boolean).join(' ');out='<polyline points="'+pts+'" fill="none" style="stroke:var(--gold)" stroke-width="2"/>';
    v.forEach(function(x,i){if(x!=null)out+='<circle cx="'+(pl+cw*i+cw/2)+'" cy="'+y(x)+'" r="3" style="fill:var(--gold)"><title>'+esc(labels[i]||'')+'：'+x+' '+UN[metric]+'</title></circle>';});
    var last=v[v.length-1];if(last!=null){var cx=pl+cw*(v.length-1)+cw/2;out+='<text x="'+cx+'" y="'+(y(last)-12)+'" text-anchor="end" style="fill:var(--bone)" font-size="13">'+last+'</text>';}}
  var xl=labels.map(function(t,i){return (i%4===0||i===labels.length-1)?'<text x="'+(pl+cw*i+cw/2)+'" y="'+(H-6)+'" text-anchor="middle" style="fill:var(--ash)" font-size="11">'+esc(t)+'</text>':'';}).join('');
  S.setAttribute('viewBox','0 0 '+W+' '+H);S.innerHTML=g+out+xl;
  var det=document.getElementById('trDet');det.innerHTML=bar?(selWeek>=0?weekDetail(selWeek):'<span class="dim">單位：'+UN[metric]+(metric==='steps'?'・每週平均':metric==='walk'?'・每週合計':'・點長條看那一週每天')+'</span>'):'<span class="dim">單位：'+UN[metric]+'・每週平均</span>';}
function weekDetail(i){var st=weekStart(i),N='一二三四五六日',h='',tm=0,tk=0;for(var d=0;d<7;d++){var c=CAL[addDays(st,d)];if(c){tm+=c.m;tk+=c.k||0;}h+='<div class="'+(c?'on':'')+'">'+N[d]+'<b>'+(c?c.m:'·')+'</b></div>';}
  return '<b>'+md(st)+' – '+md(addDays(st,6))+'</b>　共 '+hm(tm)+(tk?'・'+Math.round(tk*10)/10+' km':'')+'<div class="wdays">'+h+'</div>';}

/* ── 最佳表現 ── */
var RN={k1:'1 公里',k5:'5 公里',k10:'10 公里'};
function wRec(){var R=D.records||{};function card(k){var r=R[k];return '<button class="rec" data-k="'+k+'" aria-expanded="false"><small>'+RN[k]+'</small><b class="num">'+(r?clock(r.sec):'—')+'</b><span>'+(r?r.day.replace(/-/g,'.'):'補齊紀錄中')+'</span></button>';}
  var p=D.predict10k;return '<div class="w w-rec bp-in"><h3>最佳表現<small>點一下看前幾名</small></h3><div class="rec3">'+card('k1')+card('k5')+card('k10')+'</div><div class="rec-det" id="recDet"></div>'+(p?'<p class="pred">10K 預估<span class="est">估算</span><b class="num">'+clock(p.sec)+'</b>依近 90 天最快 5 公里換算，非實測</p>':'')+'</div>';}
function openRec(k){var el=document.getElementById('recDet'),top=(D.records&&D.records.top&&D.records.top[k])||[];
  [].forEach.call(root.querySelectorAll('.rec'),function(b){b.setAttribute('aria-expanded',b.dataset.k===recOpen);});
  if(!recOpen){el.innerHTML='';return;}
  el.innerHTML=top.length?RN[k]+' 歷年前 '+top.length+' 名<ol>'+top.map(function(r,i){return '<li><span class="dim">'+(i+1)+'</span><b class="num">'+clock(r.sec)+'</b><span>'+r.day.replace(/-/g,'.')+'</span></li>';}).join('')+'</ol>':'<span class="dim">歷年排名補齊中</span>';}
function wBody(){var b=D.body_now;if(!b||(!b.weight&&!b.fat))return '<div class="w w-body bp-in"><h3>體重・體脂</h3><p class="dim" style="font-size:13px">累積中</p></div>';
  var n=function(o){return o?'<b class="num"><i class="cn" data-to="'+o.v+'" data-dec="1">'+o.v+'</i>':'<b class="num">—';};
  return '<div class="w w-body bp-in"><h3>體重・體脂'+(D.scale_last_day?'<small>'+md(D.scale_last_day)+'</small>':'')+'</h3><div class="bd2"><div>'+n(b.weight)+'<small>kg</small></b><span>體重</span></div><div>'+n(b.fat)+'<small>%</small></b><span>體脂</span></div></div></div>';}

/* ── 組合 ── */
function render(d,isLive){D=d;buildCal();calMonth=monthOf(TODAY);
  G.innerHTML=wStreak()+wWeek()+wSteps()+wCal()+wTrend()+wRec()+wBody();
  paintCal();drawTrend();drawSteps();
  if(isLive){var s=ago(d.strava_synced_at);live.textContent='Strava＋iPhone 健康 自動同步'+(s?'・Strava '+s+'同步':'');}
  else{live.parentElement.classList.add('stale');live.textContent='暫時讀不到即時資料，顯示的是上次發布時的數字';}
  if(seen){root.classList.add('vis');runCounts();}}
var seen=false;
new IntersectionObserver(function(es,o){if(es[0].isIntersecting){seen=true;root.classList.add('vis');o.disconnect();if(D&&!counted)runCounts();}},{threshold:.12}).observe(root);
/* ── 互動 ── */
root.addEventListener('click',function(e){var t=e.target;
  var s=t.closest('#cPrev,#cNext');if(s){var d=new Date(Date.UTC(+calMonth.slice(0,4),+calMonth.slice(5,7)-1+(s.id==='cPrev'?-1:1),1));calMonth=d.toISOString().slice(0,7);paintCal();return;}
  var cv=t.closest('#calSeg button');if(cv){calView=cv.dataset.cv;paintCal();return;}
  var cell=t.closest('.cal .d.on,.yr rect.on');if(cell){pickDay(cell.dataset.d,false);return;}
  var dot=t.closest('.dots i[data-day]');if(dot){if(calView!=='month'){calView='month';}calMonth=monthOf(dot.dataset.day);paintCal();pickDay(dot.dataset.day,true);return;}
  var tm=t.closest('#trSeg button');if(tm){metric=tm.dataset.m;selWeek=-1;drawTrend();return;}
  var sp=t.closest('#stPSeg button');if(sp){stP=sp.dataset.sp;stSel=null;repaintSteps();return;}
  var sm=t.closest('#stSeg button');if(sm){stM=sm.dataset.sm;stSel=null;repaintSteps();return;}
  var sh=t.closest('#stSvg rect.hit');if(sh){stSel=stSel===sh.dataset.sd?null:sh.dataset.sd;drawSteps();return;}
  var hit=t.closest('.tr rect.hit');if(hit){var i=+hit.dataset.i;selWeek=selWeek===i?-1:i;drawTrend();return;}
  var rc=t.closest('.rec');if(rc){recOpen=recOpen===rc.dataset.k?null:rc.dataset.k;openRec(rc.dataset.k);}
});
root.addEventListener('keydown',function(e){if((e.key==='Enter'||e.key===' ')&&e.target.matches('.dots i[data-day]')){e.preventDefault();e.target.click();}});
var rz;addEventListener('resize',function(){clearTimeout(rz);rz=setTimeout(function(){if(D)drawTrend();},200);});
var fallback=function(){render({weeks:{mins:BD.weeks.mins,labels:[]},calendar:[],records:{},stats:{}},false);};
fetch(API,{mode:'cors'}).then(function(r){if(!r.ok)throw 0;return r.json();}).then(function(d){if(d.error)throw 0;render(d,true);}).catch(fallback);
})();
</script>
