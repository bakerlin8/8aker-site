{
  "_說明": "需求填表的問題清單。key 要對應 services.json 裡每張服務卡的 k。服務卡的標題、說明、細項會自動從 services.json 來，這裡只放「選了之後要問什麼」。type: text / textarea / select；required 預設選填；col 可填 dates 或 people，會存到收件匣對應欄位。",
  "service_codes": {
    "AI": "ai",
    "築": "estate",
    "旅": "trip"
  },
  "questions": {
    "AI": [
      {
        "key": "pain",
        "label": "每天或每週最花時間的重複工作是什麼？",
        "type": "textarea",
        "required": true,
        "placeholder": "越具體越好，例如：每天要把訂單手動貼進表格"
      },
      {
        "key": "tools",
        "label": "目前用哪些工具？",
        "type": "text",
        "placeholder": "例如：LINE、Google 試算表、Notion"
      }
    ],
    "築": [
      {
        "key": "goal",
        "label": "你想做的是？",
        "type": "select",
        "required": true,
        "options": [
          "尋找新物件",
          "已有物件想改建",
          "新建一戶建"
        ]
      },
      {
        "key": "area",
        "label": "區域",
        "type": "select",
        "required": true,
        "options": [
          "大阪市內",
          "大阪周邊（大阪府其他地區、京都、神戶、奈良）"
        ]
      },
      {
        "key": "purpose",
        "label": "主要用途？",
        "type": "select",
        "required": true,
        "options": [
          "自住",
          "出租",
          "自住兼出租",
          "還沒決定"
        ]
      },
      {
        "key": "budget",
        "label": "預算範圍（物件或工程總額，日圓）",
        "type": "select",
        "required": true,
        "options": [
          "3,000 萬以下",
          "3,000 萬～6,000 萬",
          "6,000 萬～1 億",
          "1 億以上",
          "還沒概念，想先了解行情"
        ]
      },
      {
        "key": "funding",
        "label": "資金方式",
        "type": "select",
        "options": [
          "全部自備現金",
          "需要銀行貸款",
          "還在評估"
        ]
      },
      {
        "key": "timeline",
        "label": "希望什麼時候開始行動？",
        "type": "select",
        "options": [
          "三個月內",
          "半年內",
          "一年內",
          "不急，先蒐集資訊"
        ]
      },
      {
        "key": "candidate",
        "label": "是否已經有看到有興趣的物件？",
        "type": "select",
        "options": [
          "還沒有，想請你幫我找",
          "有，想請你幫我看"
        ]
      },
      {
        "key": "link",
        "label": "物件連結（SUUMO、at home、不動產公司網頁等）",
        "type": "text",
        "placeholder": "貼上網址就好。照片之後私訊再提供",
        "showIf": {
          "key": "candidate",
          "equals": "有，想請你幫我看"
        }
      }
    ],
    "旅": [
      {
        "key": "people",
        "label": "人數",
        "type": "number",
        "required": true,
        "col": "people",
        "placeholder": "例如：4",
        "hint": "精緻團以 8 人以下為主。",
        "warnIf": {
          "gte": 9,
          "text": "9 人以上建議請由旅行社與我們聯繫。"
        }
      },
      {
        "key": "dates",
        "label": "預計的日期",
        "type": "text",
        "required": true,
        "col": "dates",
        "short": "日期",
        "placeholder": "例如：2027 年 3 月下旬，或還在考慮的月份"
      },
      {
        "key": "booked",
        "label": "已經自己訂好的有哪些？",
        "short": "已自行預訂",
        "type": "checks",
        "options": [
          "機票",
          "包車",
          "住宿",
          "想住 TRS Osaka Stay（我們經營的民宿）",
          "都還沒訂"
        ],
        "hint": "機票、包車、住宿建議先自行預訂。包車我們可以免費介紹合法的綠牌業者，但不收任何差價或佣金。"
      },
      {
        "key": "hotel",
        "label": "住宿的區域或飯店名稱",
        "short": "住宿",
        "type": "text",
        "showIf": {
          "key": "booked",
          "includes": "住宿"
        }
      },
      {
        "key": "occasion",
        "label": "需要隨行翻譯陪同的場合",
        "short": "陪同場合",
        "type": "checks",
        "required": true,
        "options": [
          "餐廳",
          "購物",
          "看房",
          "商務洽談",
          "景點"
        ],
        "hint": "陪同期間可以順便幫忙餐廳訂位，不另外收費。"
      },
      {
        "key": "duration",
        "label": "大約陪同多久？",
        "short": "陪同時間",
        "type": "select",
        "required": true,
        "options": [
          "半天（約 4 小時）",
          "一整天（約 8 小時）",
          "多天",
          "還不確定"
        ]
      },
      {
        "key": "care",
        "label": "同行者需要特別留意的事（選填）",
        "short": "同行者備註",
        "type": "text",
        "placeholder": "例如：長輩同行、不想走太多路、不吃牛"
      },
      {
        "key": "wishes",
        "label": "想去的餐廳或體驗（最多 5 個，選填）",
        "short": "想去的餐廳或體驗",
        "type": "list",
        "count": 5,
        "placeholder": "店名，或想做的事"
      },
      {
        "key": "notes",
        "label": "備註（有什麼想先讓我知道的）",
        "short": "備註",
        "type": "textarea"
      }
    ],
    "other": [
      {
        "key": "about",
        "label": "想聊什麼？",
        "type": "textarea",
        "required": true,
        "placeholder": "你的目標、在意的事"
      }
    ]
  },
  "hide_items": [
    "AI 使用教學",
    "在日管家",
    "餐廳・票券代訂",
    "日本地陪・隨行翻譯"
  ],
  "_hide_items說明": "這裡列的細項只在需求填表隱藏，服務頁不受影響。",
  "scope_by_service": {
    "築": "服務範圍：大阪及周邊，以大阪市為主。",
    "旅": "服務範圍：大阪及周邊，以大阪市為主。"
  },
  "_scope說明": "選到哪個服務才顯示對應的範圍文字；AI 沒有地區限制所以不放。",
  "_showIf說明": "問題加上 showIf:{key,equals} 時，只有前面那題選到指定答案才會出現。",
  "_題型說明": "type: text / textarea / select / number / checks（可複選，選項在 options）/ list（count 個小欄位）。可加 hint（小字提示）、short（送出內容裡用的短名稱）、showIf（{key,equals} 或 {key,includes}）、warnIf（{gte,text}，數字達標時顯示提醒）。"
}