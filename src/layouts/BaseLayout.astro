---
import copy from '../data/site-copy.json';
export interface Props { title?: string; description?: string; schema?: any[]; type?: string; }
const { title = `${copy.site_name} — ${copy.motto_line1}，${copy.motto_line2}`, description = (copy as any).site_description || copy.hero_lede, schema = [], type = 'website' } = Astro.props;
const SITE = (Astro.site ?? new URL('https://8aker0.com')).href.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, SITE + '/').href;
// Site-wide identity: the same person and site on every page, so search and AI engines can connect them.
const person = {
  '@type': 'Person', '@id': `${SITE}/#person`,
  name: '林子翔', alternateName: ['Baker Lin', '巴', copy.site_name],
  url: `${SITE}/`, homeLocation: { '@type': 'Place', name: '大阪, 日本' },
  knowsLanguage: ['zh-Hant', 'ja', 'en'],
  knowsAbout: ['日本不動產', '民宿營運', '室內佈置', 'AI 工具', '跑步與運動'],
  sameAs: ['https://www.strava.com/athletes/103942910'],
};
const website = { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: copy.site_name, description: (copy as any).site_description || copy.hero_lede, inLanguage: 'zh-Hant-TW', publisher: { '@id': `${SITE}/#person` } };
const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': [website, person, ...schema] }).replace(/</g, '\\u003c');
const path = Astro.url.pathname;
const isHome = path === '/' || path === '';
import { pillars } from '../data/pillars';
// The Japanese serif and the Latin display face only draw a small, known set of characters
// (section numerals, pillar kanji, Japanese subtitles, vertical English labels), so request just those glyphs.
const glyphs = [...new Set([
  '壱弐参肆伍陸序結巻零・、。', 'したことは残す。済んだことは手放す。', String((copy as any).motto_ja || ''),
  ...pillars.flatMap((p) => [p.kanji, p.titleJp]),
  'お品書き松竹梅祈願所築歩旅',
  'StatusChaptersJournalWorksBodyHelloDirections', 'BEFOREAFTNo.VIDSCRNUBLGService', '0123456789',
].join(''))].join('');
const nav = [
  { href: '/#about', label: '初次見面' },
  { href: '/#works', label: '有點樣子' },
  { href: '/#journal', label: '日常紀錄' },
  { href: '/#chapters', label: '39・連載中' },
  { href: '/#kiganjo', label: '祈願所' },
];

