      open:function(t){partial(t,330,.11,.16,'sine',660);},close:function(t){partial(t,660,.1,.16,'sine',330);},turn:function(t){hiss(t,.16,.06,800,2400,1.2);},
      success:function(t){[1046,1318,1568,2093].forEach(function(f,i){partial(t+i*.08,f,.09,.55,'sine');});},error:function(t){partial(t,220,.15,.1,'triangle');partial(t+.11,196,.15,.13,'triangle');}},
    'd':{hover:function(t,o,j){thump(t,note(o.i,-1)*j,note(o.i,-1)*.85,.09,.12);velvet(t,.03,700);},
      press:function(t){thump(t,95,52,.4,.16);velvet(t,.16,480);},
      select:function(t){partial(t,note(0,-1),.12,.5,'sine',0,.3);partial(t+.02,note(3,-1),.09,.5,'sine',0,.3);},
      go:function(t){hiss(t,.35,.08,180,900,.6,'lowpass',.2);thump(t+.05,note(0,-1),note(3,-1),.12,.3);},
      open:function(t){hiss(t,.4,.08,150,1100,.6,'lowpass',.25);thump(t,70,110,.18,.35);},close:function(t){hiss(t,.35,.08,1100,150,.6,'lowpass',.2);thump(t,110,60,.18,.3);},
      turn:function(t,o){hiss(t,.22,.07,250,1400,.8,'lowpass',.15,o.dir*.3);thump(t+.04,note(o.dir<0?1:3,-1),0,.08,.18);},
      success:function(t){[0,2,4].forEach(function(n,k){partial(t+k*.06,note(n,-1),.11,1.6,'sine',0,.45);});},error:function(t){thump(t,90,60,.3,.14);thump(t+.15,75,50,.3,.16);}},
    'e':{hover:function(t,o,j){rhodes(t,note(o.i,0)*j,.05,.5,o.pan);},
      press:function(t){thump(t,130,70,.3,.09);hiss(t,.012,.12,1800,0,1,'lowpass',0);},
      select:function(t){rhodes(t,note(0,0),.08,1.1);rhodes(t+.05,note(3,0),.06,1.1);},
      go:function(t){rhodes(t,note(0,0),.07,.8);rhodes(t+.1,note(4,0),.06,.9);hiss(t,.25,.04,300,1500,.7,'lowpass',.2);},
      open:function(t){rhodes(t,note(0,-1),.08,.8);rhodes(t+.07,note(3,-1),.07,.8);},close:function(t){rhodes(t,note(3,-1),.07,.7);rhodes(t+.07,note(0,-1),.07,.8);},
