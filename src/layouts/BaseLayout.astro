<script is:inline>
(function(){
  var RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
  var top=document.getElementById('top');
  /* 捲動進度年輪：往下捲，年輪一圈一圈長出來（最多 7 圈），外圈的弧＝讀到哪；點一下回到頂端 */
  var PR=document.getElementById('pring'),PG=document.getElementById('pringG'),PA=document.getElementById('pringArc'),PRC=2*Math.PI*19,PRN=7,prRings=[];
  if(PG){for(var q=0;q<PRN;q++){var ci=document.createElementNS('http://www.w3.org/2000/svg','circle');ci.setAttribute('r',(2.5+q*2.25).toFixed(2));ci.style.opacity=0;PG.appendChild(ci);prRings.push(ci);}
    PA.setAttribute('stroke-dasharray','0 '+PRC);PR.addEventListener('click',function(){scrollTo({top:0,behavior:RM?'auto':'smooth'});});}
  function pring(f){if(!PR)return;PR.classList.toggle('show',scrollY>innerHeight*.5);var g=f*PRN;prRings.forEach(function(c,k){c.style.opacity=Math.max(0,Math.min(1,g-k))*(.35+.5*k/PRN);});PA.setAttribute('stroke-dasharray',(PRC*f).toFixed(1)+' '+PRC.toFixed(1));}
  var solidAt=document.body.classList.contains('home')?innerHeight*.6:40;
  function onScroll(){
    top.classList.toggle('solid',scrollY>solidAt);
    var h=document.documentElement.scrollHeight-innerHeight,f=h>0?Math.min(1,Math.max(0,scrollY/h)):0;pring(f);
  }
  addEventListener('scroll',onScroll,{passive:true});onScroll();
  var mb=document.getElementById('menuBtn'),dr=document.getElementById('drawer');
  function menu(o){document.body.classList.toggle('menu-open',o);mb.setAttribute('aria-expanded',o);mb.setAttribute('aria-label',o?'關閉選單':'開啟選單');}
  mb.addEventListener('click',function(){menu(!document.body.classList.contains('menu-open'));});
  dr.addEventListener('click',function(e){if(e.target.tagName==='A')menu(false);});
  addEventListener('keydown',function(e){if(e.key==='Escape')menu(false);});
  // reveal: sections and loose .rv elements surface once when they enter
  var targets=document.querySelectorAll('.sec,.rv:not(.sec .rv)');
  if(RM){targets.forEach(function(t){t.classList.add('in');});}
  else{var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:.12,rootMargin:'0px 0px -6% 0px'});
    targets.forEach(function(t){io.observe(t);});}
  // highlight current section in the nav
  var links=[].slice.call(document.querySelectorAll('.nav a'));
  var secs=links.map(function(a){var id=a.getAttribute('href').split('#')[1];return id&&document.getElementById(id);});
  if(secs.some(Boolean)){var so=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){links.forEach(function(a,i){a.classList.toggle('on',secs[i]===e.target);});}});},{rootMargin:'-45% 0px -50% 0px'});secs.forEach(function(s){if(s)so.observe(s);});}
})();
</script>
